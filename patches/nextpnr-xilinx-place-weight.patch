+int get_net_place_weight(const Context *ctx, const NetInfo *net)
+{
+    auto w = net->attrs.find(ctx->id("PLACE_WEIGHT"));
+    if (w == net->attrs.end())
+        return 1;
+    int64_t v = w->second.is_string ? std::atoll(w->second.as_string().c_str()) : w->second.as_int64();
+    return std::max<int64_t>(1, std::min<int64_t>(1000, v));
+}
+
 // Get the total estimated wirelength for a net
