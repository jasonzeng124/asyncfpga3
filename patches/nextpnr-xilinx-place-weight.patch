@@ -32,6 +32,14 @@ enum class MetricType
     WIRELENGTH
 };
 
+// A net's placement weight: the value of its PLACE_WEIGHT attribute, 1 when
+// it has none.  Both placers multiply the net's wirelength term by it, so a
+// netlist can say which nets it wants short without any of them being on a
+// timed path -- a handshake loop that classic STA cuts with --ignore-loops has
+// no criticality of its own, and every net in it is otherwise placed by the
+// same wirelength objective as a data bit with thirty siblings.
+int get_net_place_weight(const Context *ctx, const NetInfo *net);
+
 // Return the wirelength of a net
 wirelen_t get_net_metric(const Context *ctx, const NetInfo *net, MetricType type, float &tns);
 
