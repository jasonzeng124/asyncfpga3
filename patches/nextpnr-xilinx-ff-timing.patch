     info.clockToQ = getDelayFromNS(0.1);
     info.clock_port = xc7 ? id_CK : id_CLK;
     info.edge = RISING_EDGE;
+    if (xc7 && cell->type == id_SLICE_FFX && cell->bel != BelId()) {
+        // Slice flop timing from the prjxray CLB model. The main FFs
+        // (AFF..DFF, BEL_FF) are the REG_INIT_FF variant, the 5FFs
+        // (BEL_FF2) the FF_INIT variant; both are keyed on the slice
+        // instance. Ports there are CLK/DIN/CE/Q; ours CK/D/CE/Q.
+        int tt_id = locInfo(cell->bel).timing_index;
+        int inst_id = locInfo(cell->bel).bel_data[cell->bel.index].timing_inst;
+        int z = locInfo(cell->bel).bel_data[cell->bel.index].z;
+        IdString variant = ((z & 0xF) == BEL_FF2) ? id("FF_INIT") : id("REG_INIT_FF");
+        IdString clk = id("CLK");
+        DelayInfo d;
+        if (xc7_cell_timing_lookup(tt_id, inst_id, variant, clk, id_Q, d))
+            info.clockToQ = d;
+        IdString sig;
+        if (port == id_D)
+            sig = id("DIN");
+        else if (port == id_CE)
+            sig = id_CE;
+        if (sig != IdString()) {
+            if (xc7_cell_check_lookup(tt_id, inst_id, variant, TIMING_CHECK_SETUP, sig, clk, d))
+                info.setup = d;
+            if (xc7_cell_check_lookup(tt_id, inst_id, variant, TIMING_CHECK_HOLD, sig, clk, d))
+                info.hold = d;
+        }
+    }
     return info;
 }
 
@@ -2597,6 +2622,30 @@ bool Arch::xc7_cell_timing_lookup(int tt_id, int inst_id, IdString variant, IdSt
     return true;
 }
 
+bool Arch::xc7_cell_check_lookup(int tt_id, int inst_id, IdString variant, TimingCheckType type, IdString sig_port,
+                                 IdString clock_port, DelayInfo &value) const
+{
+    if (tt_id == -1 || inst_id == -1)
+        return false;
+    const InstanceTimingPOD &inst = chip_info->timing_data->tile_cell_timings[tt_id].instances[inst_id];
+    auto found_var = db_binary_search(
+            inst.celltypes.get(), inst.num_celltypes, [](const CellTimingPOD &ct) { return ct.variant_name; },
+            variant.index);
+    if (!found_var)
+        return false;
+    const CellTimingPOD &ct = *found_var;
+    // Checks are sorted by (sig_port, clock_port) only; setup and hold for
+    // the same pin pair are adjacent, so scan the run.
+    for (int i = 0; i < ct.num_checks; i++) {
+        const CellTimingCheckPOD &chk = ct.checks[i];
+        if (chk.sig_port == sig_port.index && chk.clock_port == clock_port.index && chk.check_type == type) {
+            value.delay = chk.max_value;
+            return true;
+        }
+    }
+    return false;
+}
