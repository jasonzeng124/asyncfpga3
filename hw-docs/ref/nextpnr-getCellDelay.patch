+// Not exposed via fn_wrapper_*: getCellDelay has a bool return plus a DelayQuad out-param, which none of the
+// existing fn_wrapper arities model. Bind it directly with a lambda instead; DelayQuad is already py::class_'d
+// in pybindings.cc so it can be returned as-is in the (found, delay) tuple.
+ctx_cls.def("getCellDelay", [](Context &ctx, ContextualWrapper<CellInfo &> cell, const std::string &fromPort,
+                                const std::string &toPort) {
+    DelayQuad dq;
+    bool found = ctx.getCellDelay(&(cell.base), ctx.id(fromPort), ctx.id(toPort), dq);
+    return py::make_tuple(found, dq);
+});
