# Fomu PVT pin constraints (iCE40UP5K-UWG30).
# Pin mapping from https://github.com/jay20162016/fomu_async's
# hdl/fomu_pvt.pcf (same author, cited as this project's inspiration in
# README.md) -- trimmed to just the pins fomu_top.sv actually uses.
set_io rgb0 A5
set_io rgb1 B5
set_io rgb2 C5
set_io clki F4
set_io usb_dn A2
set_io usb_dp A1
set_io usb_dp_pu A4
