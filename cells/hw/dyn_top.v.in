// Minimal I/O-bound wrapper so Dynamatic's xorshift can be placed and routed
// on the SAME part with the SAME toolchain our own kernels use.  Its only job
// is to get the port count under the pin count without putting anything on
// the kernel's own critical path: inputs come from registers, outputs are
// reduced to one register.  Whatever period nextpnr then reports for clk is
// the kernel's, not the wrapper's.
`default_nettype none
module dyn_top (input wire clk_p, output wire led_red, output wire led_green);
  wire clk;
  BUFG bg (.I(clk_p), .O(clk));

  reg [31:0] seed = 32'h1234_5678, rounds = 32'd10;
  reg rst = 1'b1, sv = 1'b0, rv = 1'b0, stv = 1'b0, o_rdy = 1'b1, e_rdy = 1'b1;
  reg [7:0] boot = 8'h0;
  always @(posedge clk) begin
    boot <= boot + 8'h1;
    rst  <= (boot < 8'h10);
    sv   <= boot[0]; rv <= boot[1]; stv <= boot[2];
    o_rdy <= boot[3]; e_rdy <= boot[4];
    seed   <= {seed[30:0],   seed[31] ^ seed[21]};
    rounds <= {rounds[30:0], rounds[31] ^ rounds[19]};
  end

  wire [31:0] out0;
  wire s_rdy, r_rdy, st_rdy, o_val, e_val;
  @KERNEL@ dut (
    .seed(seed), .seed_valid(sv), .rounds(rounds), .rounds_valid(rv),
    .start_valid(stv), .clk(clk), .rst(rst),
    .out0_ready(o_rdy), .end_ready(e_rdy),
    .seed_ready(s_rdy), .rounds_ready(r_rdy), .start_ready(st_rdy),
    .out0(out0), .out0_valid(o_val), .end_valid(e_val));

  reg acc = 1'b0, acc2 = 1'b0;
  always @(posedge clk) begin
    acc  <= ^out0 ^ o_val ^ e_val;
    acc2 <= s_rdy ^ r_rdy ^ st_rdy;
  end
  assign led_red = acc;
  assign led_green = acc2;
endmodule
`default_nettype wire
