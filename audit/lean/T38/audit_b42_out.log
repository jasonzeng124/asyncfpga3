                    (∀ (t : ℕ), a ≤ t → t ≤ e → x r.pc.1.cn t = r.pc.1.cv) →
                      (∀ k < r.pc.1.sn.length,
                          ∀ (t : ℕ), a ≤ t → t ≤ E k → x (r.pc.1.sn.getD k 0) t = r.pc.1.sv.getD k false) →
                        (∀ i < r.pc.2.length,
                            (r.pc.2.getD i default).r.mem = true →
                              1 ≤
                                  Formal.Cells.RaceCertPS.KRow.lo { g := 1, κ := κ } c (r.pc.2.getD i default).r
                                    (r.pc.2.getD i default).r.fb ∧
                                ∀ (t : ℕ),
                                  (Formal.Cells.CertPS.win { g := 1, κ := κ } c a e E r.pc.2 i).1 ≤
                                      t +
                                        Formal.Cells.RaceCertPS.KRow.hi { g := 1, κ := κ } c (r.pc.2.getD i default).r
                                          (r.pc.2.getD i default).r.fb →
                                    t < (Formal.Cells.CertPS.win { g := 1, κ := κ } c a e E r.pc.2 i).1 →
                                      x (r.pc.2.getD i default).r.q t = (r.pc.2.getD i default).r.w) →
                          (∀ i < r.pc.2.length, Formal.Cells.CertMarginPS.psum { g := 1, κ := κ } c r.pc.2 i ≤ PS) →
                            (∀ (k : ℕ), e + PS ≤ E k) →
                              e + PS ≤ Formal.Cells.CertPS.BIG →
                                (List.getD r.node.pins r.ja ([], 0)).2 = (r.pc.2.getD (r.pc.2.length - 1) default).r.q ∧
                                  (List.getD r.node.pins r.jf ([], 0)).2 = r.node.q ∧
                                    r.node.q = r.pc.1.cn ∧
                                      ∀ (u : ℕ),
                                        (Formal.Cells.CertPS.win { g := 1, κ := κ } c a e E r.pc.2
                                                (r.pc.2.length - 1)).1 ≤
