                                          u + Formal.Cells.RaceCertPS.KRow.lo { g := 1, κ := κ } c r.node r.ja ≤
                                              e + Formal.Cells.RaceCertPS.KRow.hi { g := 1, κ := κ } c r.node r.jf →
