exact_s1c2_cons : ∀ (k : Kappa),
  (∀ (c : Corner) (d : Arc → ℕ), (∀ (e : Arc), Scat k c (A_s1c2_cons e) (d e)) → Safe F2 G2 true (dlOf d)) ↔
    Below_s1c2_cons k
Bridge.exact_s1c2_cons : ∀ (k : Formal.Core.Substrate.Kappa),
  (∀ (c : Formal.Core.Substrate.Corner) (d : Formal.Cells.OnNetlistArbKappa.Arc → ℕ),
      (∀ (e : Formal.Cells.OnNetlistArbKappa.Arc),
          Formal.Core.Substrate.Scat k c (Formal.Cells.OnNetlistArbKappa.A_s1c2_cons e) (d e)) →
        Safe F2 G2 true (Formal.Cells.OnNetlistArbKappa.dlOf d)) ↔
    Below_s1c2_cons (Bridge.toK k)
