@skew_fval : ∀ {d p w : Nat},
  1 ≤ p →
    (fun t => delay ((skewA d w).w 2 0) (skewIn p 0) t ^^ delay ((skewA d w).w 2 1) (skewIn p 1) t) = pulse false p w
@ce_skew : ∀ {p d w d' lo : Nat},
  1 ≤ p →
    w < d →
      1 ≤ d' →
        d' ≤ w →
          lo ≤ d →
            (∀ (s : Nat → Sig), GLSRun (lut2 xor) (skewA d w) (skewIn p) s → ∀ (t : Nat), s 2 t = false) ∧
              (∀ (s : Nat → Sig), GLSRun (lut2 xor) (skewA d' w) (skewIn p) s → s 2 (p + d') = true) ∧
                (∀ (s : Nat → Sig), SemRun Sem.transport (lut2 xor) (skewA d w) (skewIn p) s → s 2 (p + d) = true) ∧
                  ∃ s, BandRun (lut2 xor) (skewA lo w) (skewA d w) (skewIn p) s ∧ s 2 (p + lo) = true
