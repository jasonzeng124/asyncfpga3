@Events9FullArb.design_verdict9arbnet_env : ∀ {N K : Nat} {d : Design} {net : Events5.Net4 N} {b : Events5.Bands4 net}
  {rn : Fin N → RNode} {rank : Fin N → Nat} {rw fuel : Nat} {x : Fin d.n → Sig},
  Recog6 d net b rn rank rw fuel →
    net.OK7 →
      ∀ {parts : List (List Nat)} {rs : Nat → Nat} {log : List Events9Par.LnP} {J : Array Events7.Jd},
        Events9Par.runLogP net b rs parts log = some J →
          ∀ (back line : (j : Fin N) → Fin (net.ar j) → Nat) (xS xw : Fin N → Nat) (xa : Fin N → List Events7.Arm)
            (hl : List Events9.HLn9) (gd : (j : Fin N) → Fin (net.ar j) → Events8.GD)
            (cp : (j : Fin N) → Fin (net.ar j) → Bool) (cxm : Fin N → Bool)
            (cl cg : (j : Fin N) → Fin (net.ar j) → Bool),
            (∀ (j : Fin N) (p : Fin (net.ar j)), cp j p = true → Events7.backOK7 net b J j p (back j p) = true) →
              (∀ (m : Fin N), cxm m = true → Events7.exclOK7 net b parts J m (xS m) (xa m) (xw m) = true) →
                (∀ (j : Fin N) (p : Fin (net.ar j)), cl j p = true → Events7.lineOK7 net b J j p (line j p) = true) →
                  (∀ (j : Fin N) (p : Fin (net.ar j)),
                      cg j p = true →
                        Events8.guardOK8 net b parts J (List.map (Events9.san J) hl) j p (gd j p) = true) →
                    ∀ (as : Fin K → ArbD N) (own : Fin N → Option (Fin K)),
                      (∀ (k : Fin K), ArbOK d net b rn fuel rw (as k)) →
                        OwnOK rn as own →
                          RsOK as rs →
                            FixShape net b rn →
                              ∀ (hsat : SatPinW d plG x),
                                (∀ (t : Nat), x (d.wire 0) t = false) →
                                  (∀ (t : Nat), x (d.wire 1) t = true) →
                                    ∀ {T : Nat},
                                      1 ≤ T →
                                        (∀ (t : Nat), x (d.wire rw) t = decide (t < T)) →
                                          ∀ (S T0 : Nat) (H : Fin K → Nat),
                                            (∀ (k : Fin K), ArbRowsOKSS d (as k) T S T0) →
                                              (∀ (k : Fin K), 1 ≤ plo d (PqQ (as k))) →
                                                (∀ (k : Fin K) (u : Nat),
                                                    S < u + phi d (PqQ (as k)) →
                                                      u ≤ S → 1 ≤ u → qS (as k) (u - 1) = qS (as k) u) →
                                                  (∀ (k : Fin K) (τ : Nat),
                                                      S < τ →
                                                        qS (as k) (τ - 1) ≠ qS (as k) τ → ∀ (u : Nat), τ ≤ u → ⋯) →
                                                    (∀ (k : Fin K), ArbEnv hsat rn (as k) T0 (H k)) →
                                                      (∀ (k : Fin K), ArbOrd hsat (as k) T0) →
                                                        ∀ (sel : Nat → Nat → Bool), ∃ cv, Exists ⋯
@arbEdgeSP_of_env : ∀ {N : Nat} {d : Design} {net : Events5.Net4 N} {b : Events5.Bands4 net} {rn : Fin N → RNode}
  {fuel rw : Nat} {x : Fin d.n → Sig} (hsat : SatPinW d plG x),
  (∀ (t : Nat), x (d.wire 0) t = false) →
    (∀ (t : Nat), x (d.wire 1) t = true) →
      ∀ {a : ArbD N},
        ArbOK d net b rn fuel rw a →
          1 ≤ plo d (PqQ a) →
            ∀ {S T0 H : Nat},
              (∀ (u : Nat), S < u + phi d (PqQ a) → u ≤ S → 1 ≤ u → qS a (u - 1) = qS a u) →
                (∀ (τ : Nat),
                    S < τ →
                      qS a (τ - 1) ≠ qS a τ →
                        ∀ (u : Nat),
                          τ ≤ u →
                            u ≤ τ + phi d (PqQ a) →
                              (r1S a (tau hsat (P1Q a) u), r2S a (tau hsat (P2Q a) u),
                                  x (d.wire rw) (tau hsat (PrQ a) u), aS rn a (tau hsat (PA a) u)) =
                                (r1S a (tau hsat (P1Q a) τ), r2S a (tau hsat (P2Q a) τ),
                                  x (d.wire rw) (tau hsat (PrQ a) τ), aS rn a (tau hsat (PA a) τ))) →
                  ArbEnv hsat rn a T0 H → ArbEdgeSP hsat rn a S T0 H
@c_of_pt : ∀ {s e y : Sig} {wr wq : Nat → Nat} {T0 : Nat} {a q : Sig} {f4 : Nat → Nat},
  (∀ (t : Nat), y t = (s (wr t) && e (wq t))) →
    (∀ (t : Nat), T0 < t → s (wr (t - 2)) = true → s (wr t) = false → a (f4 (wq t)) = true) →
      ∀ (t : Nat), T0 < t → s (wr t) = false → Settled a q f4 (wq t) → e (wq t) = true → y (t - 2) = false
