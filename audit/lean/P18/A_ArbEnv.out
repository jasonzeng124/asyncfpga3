fields:
  Formal.Core.XAudit.Events9ArbNet.RdEdgeNF.nore : ∀ (τ : Nat),
      1 ≤ τ → e (τ - 1) = true → e τ = false → ∀ (v : Nat), fQ τ ≤ v → v + loDr < τ + hiDq + 2 → s v = false
