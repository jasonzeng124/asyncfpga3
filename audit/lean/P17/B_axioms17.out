Formal.Cells.FiniteNetBoundN.gcd_hw_safe_fin_netBN : ∀ (a b : Nat)
  (ch : Fin Formal.Net.CapNet.Gcd.NC → Formal.Net.Handshake.Chan) (N : Formal.Cells.FiniteNetBoundN.FGcdNetN)
  (L : N.ι → Nat → Prop) (n : N.ι → Nat),
  Formal.Cells.FiniteNetBoundN.FGcdNetOKBN ch N L n →
    (∀ (o : Fin Formal.Net.CapNet.Gcd.NO),
        Formal.Cells.LutFbBridge2Env.isLink (Formal.Net.CapNet.Gcd.opAt o) = false →
          Formal.Net.CapNet.Cell ch (Formal.Net.CapNet.srcV a b) (Formal.Net.CapNet.Gcd.opAt o)) →
      (∀ (c : Fin Formal.Net.CapNet.Gcd.NC), Formal.Net.Ops.Held (ch c)) →
        (∃ y,
            Formal.Net.CapSafe.Good a b y ∧
              ∀ (o : Fin Formal.Net.CapNet.Gcd.NO),
                Formal.Net.CapNet.Forced ch (Formal.Net.CapNet.Gcd.omOf a b y) (Formal.Net.CapNet.Gcd.opAt o)) →
          (∀ (k e : Nat),
              Formal.Net.Handshake.TokAt (ch Formal.Net.CapNet.Gcd.out0) k e →
                (ch Formal.Net.CapNet.Gcd.out0).dat e = a.gcd b) ∧
            ∀ (t : Nat),
              Formal.Net.Ops.closedVals (ch Formal.Net.CapNet.Gcd.out0) t =
                List.replicate
                  (Formal.Net.Handshake.cnt (Formal.Net.Handshake.fallB (ch Formal.Net.CapNet.Gcd.out0).ack) t)
                  (a.gcd b)
