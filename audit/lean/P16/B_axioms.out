'Formal.Cells.FiniteNetBoundA.bound_censusA' depends on axioms: [propext]
'Formal.Cells.FiniteNetBoundA.gcd_hw_safe_fin_netBA' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Cells.FiniteNetBoundT.bound_censusT' depends on axioms: [propext]
'Formal.Cells.FiniteNetBoundT.gcd_hw_safe_fin_netBT' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Cells.BWit3.bwit_okA' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Cells.BWit3.gcd_hw_fin_netBA_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Cells.BWit3.gcd_hw_fin_netBA_consistent' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Cells.FiniteNetComb.fcomb_spec_cell' depends on axioms: [propext, Classical.choice, Quot.sound]
Formal.Cells.BWit3.gcd_hw_fin_netBA_witness : ∃ ch N L n,
  Formal.Cells.FiniteNetBoundA.FGcdNetOKBA ch N L n ∧
    (∀ (o : Fin Formal.Net.CapNet.Gcd.NO),
        Formal.Cells.LutFbBridge2Env.isLink (Formal.Net.CapNet.Gcd.opAt o) = false →
          Formal.Net.CapNet.Cell ch (Formal.Net.CapNet.srcV 12 18) (Formal.Net.CapNet.Gcd.opAt o)) ∧
      (∀ (c : Fin Formal.Net.CapNet.Gcd.NC), Formal.Net.Ops.Held (ch c)) ∧
        (∃ y,
            Formal.Net.CapSafe.Good 12 18 y ∧
              ∀ (o : Fin Formal.Net.CapNet.Gcd.NO),
                Formal.Net.CapNet.Forced ch (Formal.Net.CapNet.Gcd.omOf 12 18 y) (Formal.Net.CapNet.Gcd.opAt o)) ∧
          ∃ k e,
            Formal.Net.Handshake.TokAt (ch Formal.Net.CapNet.Gcd.out0) k e ∧ (ch Formal.Net.CapNet.Gcd.out0).dat e = 6
'Formal.Cells.BWit2.gcd_hw_fin_netBM_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Cells.BWit.gcd_hw_fin_netB_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
