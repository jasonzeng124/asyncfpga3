@b1_and : ∀ {s e y : Sig} {wr wq fQ : Nat → Nat} {loDr hiDr loDq hiDq loQ hiQ T0 : Nat},
  (∀ (t : Nat), y t = (s (wr t) && e (wq t))) →
    Warp loDr hiDr wr →
      Warp loDq hiDq wq →
        Warp loQ hiQ fQ →
          hiDr + hiDq + 2 ≤ T0 →
            loDr ≤ loQ + loDq →
              (∀ (τ : Nat), T0 < τ + hiDq + 2 → 1 ≤ τ → e (τ - 1) = true → e τ = false → s (fQ τ) = false) →
                (∀ (τ : Nat),
                    1 ≤ τ →
                      e (τ - 1) = true → e τ = false → ∀ (v : Nat), fQ τ ≤ v → v + loDr < τ + hiDq + 2 → s v = false) →
                  ∀ (t : Nat), T0 < t → s (wr t) = true → s (fQ (wq t)) = true → e (wq t) = false → y (t - 2) = false
'Formal.Core.XAudit.Events9ArbNet.b1_and' depends on axioms: [propext, Quot.sound]
'hnore_of_window' depends on axioms: [propext, Quot.sound]
