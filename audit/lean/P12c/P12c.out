@Formal.Core.DelayInvolution.ExpReal.expR_pulse_cancel_iff : ∀ {τ Tp : ℝ} (hτ : 0 < τ) (hTp : 0 < Tp) (a Δ : ℝ),
  0 < Δ → ((Formal.Core.DelayInvolution.ExpReal.expR τ Tp hτ hTp).channel [a, a + Δ] = [] ↔ Δ ≤ τ * Real.log 2)
@Formal.Core.DelayInvolution.ExpReal.exp_resolution : ∀ {τ Tp : ℝ} (hτ : 0 < τ) (hTp : 0 < Tp) {s : ℝ},
  0 < s →
    s < Tp + τ * Real.log 2 →
      s ≠
          Formal.Core.InvolutionLoop.crit (Formal.Core.DelayInvolution.ExpReal.expR τ Tp hτ hTp)
            (Formal.Core.DelayInvolution.ExpReal.wStar τ Tp) →
        ∃ m,
          Formal.Core.InvolutionLoop.Chain (Formal.Core.DelayInvolution.ExpReal.expR τ Tp hτ hTp) s m ∧
            Formal.Core.InvolutionLoop.wd (Formal.Core.DelayInvolution.ExpReal.expR τ Tp hτ hTp) s m ≤ 0 ∧
              (m % 2 = 1 ↔
                Formal.Core.InvolutionLoop.crit (Formal.Core.DelayInvolution.ExpReal.expR τ Tp hτ hTp)
                    (Formal.Core.DelayInvolution.ExpReal.wStar τ Tp) <
                  s)
@Formal.Core.DelayInvolution.ExpReal.bad_not_involution : ∀ {τ Tp : ℝ},
  0 < τ →
    0 < Tp →
      Tp < τ * Real.log 2 →
        -Formal.Core.DelayInvolution.ExpReal.badDelay τ Tp (-Formal.Core.DelayInvolution.ExpReal.badDelay τ Tp 0) ≠ 0
