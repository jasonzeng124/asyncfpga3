Formal.Core.XAudit.Events9Arb.core_of_settle : ∀ (B : Formal.Core.XAudit.Events8Arb.ArbBands)
  {r1 r2 rs a q R0 g1 g2 : Formal.Core.TraceDiscrete.Sig} (fr : Fin 5 → ℕ → ℕ) (f1 f2 : Fin 3 → ℕ → ℕ) (f4 : ℕ → ℕ),
  Formal.Core.XAudit.Events8Arb.Rd 5 B.r0 fr →
    Formal.Core.XAudit.Events8Arb.Rd 3 B.g1 f1 →
      Formal.Core.XAudit.Events8Arb.Rd 3 B.g2 f2 →
        Formal.Core.TraceDiscrete.Warp (B.st 4).1 (B.st 4).2 f4 →
          (∀ (t : ℕ),
              R0 t =
                Formal.Cells.o5B Formal.Cells.ArbBinary.ARB_ST
                  [r1 (fr 0 t), r2 (fr 1 t), q (fr 2 t), rs (fr 3 t), a (fr 4 t), true]) →
            (∀ (t : ℕ),
                g1 t =
                  Formal.Cells.o5B Formal.Cells.ArbBinary.GRANT
                    [r1 (f1 0 t), r2 (f1 1 t), q (f1 2 t), false, false, true]) →
              (∀ (t : ℕ),
                  g2 t =
                    Formal.Cells.o6B Formal.Cells.ArbBinary.GRANT
                      [r1 (f2 0 t), r2 (f2 1 t), q (f2 2 t), false, false, true]) →
                ∀ (T0 : ℕ),
                  (∀ t ≤ T0 + 2, g1 t = false ∧ g2 t = false ∧ R0 t = false) →
                    1 ≤ (B.g1 0).1 →
                      1 ≤ (B.g2 1).1 →
                        3 ≤ (B.r0 0).1 →
                          3 ≤ (B.r0 1).1 →
                            2 ≤ Formal.Core.XAudit.Events9Arb.kOf B →
                              Formal.Core.XAudit.Events9Arb.kOf B + 2 ≤ (B.g1 2).1 →
                                Formal.Core.XAudit.Events9Arb.kOf B + 2 ≤ (B.g2 2).1 →
                                  Formal.Core.XAudit.Events9Arb.kOf B + 4 ≤ (B.r0 2).1 →
                                    (B.g1 2).1 ≤ T0 →
                                      (B.g2 2).1 ≤ T0 →
                                        (B.r0 2).1 ≤ T0 + 2 →
                                          ∀ (H : ℕ),
                                            (∀ (v : ℕ),
                                                ∃ v' ≤ v,
                                                  v ≤ v' + H ∧
                                                    (v' = 0 ∨
                                                      Formal.Core.XAudit.Events9Arb.Ok a q f4
                                                        (v' + 1 - Formal.Core.XAudit.Events9Arb.kOf B))) →
                                              H + Formal.Core.XAudit.Events9Arb.kOf B + (B.st 4).2 ≤ 10 ^ 12 →
                                                Formal.Core.XAudit.Events9Arb.RdOK
                                                    (Formal.Core.XAudit.Events9Arb.Settled a q f4) r1 q g1 (f1 0) (f1 2)
                                                    T0 →
                                                  Formal.Core.XAudit.Events9Arb.RdOK
                                                      (Formal.Core.XAudit.Events9Arb.Settled a q f4) r2 (fun u => !q u)
                                                      g2 (f2 1) (f2 2) T0 →
                                                    Formal.Core.XAudit.Events9Arb.RdOK
                                                        (Formal.Core.XAudit.Events9Arb.Settled a q f4) r1 q
                                                        (fun t => r1 (fr 0 (t + 2)) && q (fr 2 (t + 2)))
                                                        (fun t => fr 0 (t + 2)) (fun t => fr 2 (t + 2)) T0 →
                                                      Formal.Core.XAudit.Events9Arb.RdOK
                                                          (Formal.Core.XAudit.Events9Arb.Settled a q f4) r2
                                                          (fun u => !q u)
                                                          (fun t => r2 (fr 1 (t + 2)) && !q (fr 2 (t + 2)))
                                                          (fun t => fr 1 (t + 2)) (fun t => fr 2 (t + 2)) T0 →
                                                        Formal.Core.XAudit.Events9Arb.CoreOf B r1 r2 a R0 g1 g2
