gcd_hw_fin_netB_witness : ∃ ch N L n,
  FiniteNetBound.FGcdNetOKB ch N L n ∧
    (∀ (o : Fin NO), LutFbBridge2Env.isLink (opAt o) = false → Cell ch (srcV 12 18) (opAt o)) ∧
      (∀ (c : Fin NC), Ops.Held (ch c)) ∧
        (∃ y, CapSafe.Good 12 18 y ∧ ∀ (o : Fin NO), Forced ch (omOf 12 18 y) (opAt o)) ∧
          ∃ k e, Handshake.TokAt (ch out0) k e ∧ (ch out0).dat e = 6
