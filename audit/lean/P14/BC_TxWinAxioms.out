@Formal.Net.CapstoneRefine.TxWin.count : ∀ {P : Formal.Net.Handshake.Chan} {sig : Nat → Nat → Formal.Net.Trace}
  {data : List Nat} {R : Nat → Nat → Prop} (self : Formal.Net.CapstoneRefine.TxWin P sig data R) (k : Nat),
  Formal.Net.CapstoneRefine.HasOff P k → Formal.Net.Handshake.cnt (Formal.Net.Handshake.riseB P.req) (self.τ k) = k
Formal.Net.CapstoneRefine.Out0Wit.out0_dag_witness : Formal.Net.CapstoneRefine.BCert
    (Formal.Net.CapNet.Wit.chW Formal.Net.CapNet.Gcd.out0) ∧
  Formal.Net.Ops.Held (Formal.Net.CapNet.Wit.chW Formal.Net.CapNet.Gcd.out0) ∧
    ∀ (k r t : Nat),
      Formal.Net.Ops.OffAt (Formal.Net.CapNet.Wit.chW Formal.Net.CapNet.Gcd.out0) k r →
        r < t →
          (∀ (s : Nat),
              r < s → s ≤ t → Formal.Net.Ops.inTx (Formal.Net.CapNet.Wit.chW Formal.Net.CapNet.Gcd.out0) s = true) →
            (Formal.Net.CapNet.Wit.chW Formal.Net.CapNet.Gcd.out0).dat t = Nat.gcd 12 18
'Formal.Net.CapstoneRefine.Out0Wit.out0_dag_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Net.CapstoneRefine.FinWit.fin_witness' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Net.CapstoneRefine.Out0Wit.out0_dag_cert' depends on axioms: [propext, Classical.choice, Quot.sound]
