gcd_hw_fin_netBM_witness : ∃ ch N L n,
  FiniteNetBoundM.FGcdNetOKBM ch N L n ∧
    (∀ (o : Fin NO), LutFbBridge2Env.isLink (opAt o) = false → Cell ch (srcV 12 18) (opAt o)) ∧
      (∀ (c : Fin NC), Held (ch c)) ∧
        (∃ y, CapSafe.Good 12 18 y ∧ ∀ (o : Fin NO), Forced ch (omOf 12 18 y) (opAt o)) ∧
          ∃ k e, TokAt (ch out0) k e ∧ (ch out0).dat e = 6
gcd_hw_safe_fin_netBM : ∀ (a b : Nat) (ch : Fin NC → Chan) (N : FGcdNetM) (L : N.ι → Nat → Prop) (n : N.ι → Nat),
  FiniteNetBoundM.FGcdNetOKBM ch N L n →
    (∀ (o : Fin NO), LutFbBridge2Env.isLink (opAt o) = false → Cell ch (srcV a b) (opAt o)) →
      (∀ (c : Fin NC), Held (ch c)) →
        (∃ y, CapSafe.Good a b y ∧ ∀ (o : Fin NO), Forced ch (omOf a b y) (opAt o)) →
          (∀ (k e : Nat), TokAt (ch out0) k e → (ch out0).dat e = a.gcd b) ∧
            ∀ (t : Nat), closedVals (ch out0) t = List.replicate (cnt (fallB (ch out0).ack) t) (a.gcd b)
