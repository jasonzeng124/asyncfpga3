            (∀ (o : Fin NO) (z : Fin NC) (w d : Nat), opAt o = K.src z w d → ∀ (t : Nat), (ch z).req t = e t) →
              (∀ (o : Fin NO) (z : Fin NC) (w d : Nat), opAt o = K.src z w d → ∀ (t : Nat), (ch z).dat t = srcV a b w) →
                e 0 = true ∧ k 0 = false →
                  q 0 = false →
                    (∀ (t : Nat), (ch out0).ack t = q t) →
                      (∀ (t t' : Nat), t ≤ t' → β t ≤ β t') →
                        (∀ (t : Nat), β t ≤ t) →
                          (∀ (z : Fin NC) (t t' : Nat), t ≤ t' → γ z t ≤ γ z t') →
                            (∀ (z : Fin NC) (t : Nat), γ z t ≤ t) →
                              (∀ (t t' : Nat), t ≤ t' → φ1 t ≤ φ1 t') →
                                (∀ (t : Nat), φ1 t ≤ t) →
                                  (∀ (t t' : Nat), t ≤ t' → φ0 t ≤ φ0 t') →
                                    (∀ (t : Nat), φ0 t ≤ t) →
                                      (∀ (t : Nat), e (t + 1) ≠ e t → k (β t) = !e (t + 1)) →
                                        (∀ (o : Fin NO) (z : Fin NC) (w d : Nat),
                                            opAt o = K.src z w d →
                                              ∀ (t : Nat), k (t + 1) ≠ k t → (ch z).ack (γ z t) = k (t + 1)) →
                                          (∀ (t : Nat), e (t + 1) ≠ e t → q (φ1 t) = e (t + 1)) →
                                            (∀ (t : Nat), q (t + 1) ≠ q t → e (φ0 t) = !q (t + 1)) →
                                              (∀ (r : Nat), OffAt (ch out0) 0 r → (ch out0).dat (r + 1) = a.gcd b) ∧
                                                ∀ (e' : Nat), TokAt (ch out0) 0 e' → (ch out0).dat e' = a.gcd b
