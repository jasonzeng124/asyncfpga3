                  List.replicate (cnt (fallB (ch IpowCap.out0).ack) t) (IpowHw.ipowSpec b e)
IpowHw.ipowSpec : Nat → Nat → Nat
gcd_rig_first : ∀ (a b : Nat),
  a < 2 ^ 31 →
    b < 2 ^ 31 →
      ∀ (ch : Fin NC → Chan),
        (∀ (o : Fin NO), CellR ch (srcV a b) (opAt o)) →
          (∀ (c : Fin NC), Held (ch c)) →
            H_ENV ch →
              (∀ (r : Nat), OffAt (ch out0) 0 r → (ch out0).dat (r + 1) = a.gcd b) ∧
                ∀ (e : Nat), TokAt (ch out0) 0 e → (ch out0).dat e = a.gcd b
