-- Auditor checks (pattern of CapstoneWitnessCells, against IpowCap's own opAt/srcV/start/out0)
theorem cells_all : Formal.Net.IpowCap.ops.all (fun k => kChk cdA (srcV 4294967295 3) k) = true := by decide +kernel

theorem w_cells : ∀ o : Fin Formal.Net.IpowCap.NO, Cell chW (srcV 4294967295 3) (Formal.Net.IpowCap.opAt o) := fun o =>
  kChk_sound (srcV 4294967295 3) (Formal.Net.IpowCap.opAt o) (List.all_eq_true.mp cells_all _ Formal.Net.IpowCap.getD_mem)

theorem cds_len : cds.length = Formal.Net.IpowCap.NC := by decide +kernel
theorem held_all : cds.all heldChk = true := by decide +kernel

theorem w_held : ∀ c : Fin Formal.Net.IpowCap.NC, Formal.Net.Ops.Held (chW c) := by
  intro c
  apply held_of
  apply List.all_eq_true.mp held_all
  unfold cdA
  have h : c.val < cds.length := by rw [cds_len]; exact c.isLt
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_mem h

theorem start_rq : (cdA Formal.Net.IpowCap.start).rq = [startRise, startFall] := by decide +kernel
theorem w_start_once : ∀ t, Handshake.cnt (Handshake.riseB (chW Formal.Net.IpowCap.start).req) t ≤ 1 :=
