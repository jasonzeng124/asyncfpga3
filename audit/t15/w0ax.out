Formal.Net.CViewPS.witness_n0 : ∀ (su Δo : ℕ) (va vb : ℕ → ℕ),
  ∃ x,
    Formal.Target.Behaves Formal.Net.CViewPS.p1
        (Formal.Target.circuit Formal.Target.DecodedPS.net Formal.Target.DecodedPS.boundary) x ∧
      Formal.Target.Env x Formal.Target.DecodedPS.boundary 400000 su Δo (some 0) va vb
'Formal.Net.CViewPS.witness_n0' depends on axioms: [propext, Classical.choice, Quot.sound]
'Formal.Net.CViewPS.witness_n0_correct' depends on axioms: [propext, Classical.choice, Quot.sound]
