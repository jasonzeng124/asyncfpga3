        ∀ (T0 T1 : ℕ),
          (∀ e ∈ Formal.Net.Compute.PS.Ushrsi0.maps.psi, ∀ (t : ℕ), T0 ≤ t → t ≤ T1 → x e.2.2 t = x e.2.2 T0) →
            ∀ (t : ℕ),
              T0 + Formal.Timing.SpecSettle.cScale p * Formal.Net.Compute.PS.Ushrsi0T.D ≤ t →
