    ∀ {x : Beh},
      Behaves p (circuit DecodedPS.net DecodedPS.boundary) x →
        ∃ c,
          0 ≤ c ∧
            c ≤ 1 ∧
              ∀ (R M A : ℕ),
                (∀ t < R, x rstPS t = true) →
                  0 < R →
                    (∀ (w : ℕ), memR w = true → startPS p w ≤ A) →
                      (∀ (w : ℕ),
                          memR w = true →
                            ∀ i < (Formal.Timing.Huffman.gAt cs 2500 w).k,
                              Formal.Timing.SpecLoop.sumMax p (arcsPS w i) ≤ M) →
                        ∀ (w : ℕ), memR w = true → ∀ (t : ℕ), A + 15 * M ≤ t → t ≤ R - 1 → x w t = valR w
