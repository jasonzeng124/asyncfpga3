# C-10h cert self-test: cyclic late side 1->2->3->1, 3->4; launch = pin 1, target = pin 4.
# shortest 1->4 = 100+50+30 = 180; data latest = 100.
# expected: pass +80, fail -20 (setup 100), lie (potential 500 claimed for 4: check rejects: CERTBAD)
graph 5
g 1 2 0 100 200 100 200 100 200 100 200 100 200 100 200
g 2 3 0 50 60 50 60 50 60 50 60 50 60 50 60
g 3 1 0 10 20 10 20 10 20 10 20 10 20 10 20
g 3 4 0 30 40 30 40 30 40 30 40 30 40 30 40
inst cert-pass
setup 0
data 1
arc 0 1 50 100
late 0 1 0 0 0 0
target 4 0
cap 180
pot 2 0 100 3 0 150
end
inst cert-fail
setup 100
data 1
arc 0 1 50 100
late 0 1 0 0 0 0
target 4 0
cap 180
pot 2 0 100 3 0 150
end
inst cert-lie
setup 0
data 1
arc 0 1 50 100
late 0 1 0 0 0 0
target 4 0
cap 500
pot 2 0 100 3 0 150
end
