(DELAYFILE
  (SDFVERSION "3.0")
  (DESIGN "top")
  (VENDOR "nextpnr")
  (PROGRAM "nextpnr")
  (DIVIDER /)
  (TIMESCALE 1ps)
  (CELL
    (CELLTYPE "top")
    (INSTANCE )
    (DELAY
      (ABSOLUTE
        (INTERCONNECT \$iopadmap\$ce_pair.q1\$intcell\$OBUF/OUT q1/PAD (0:0:0) (0:0:0))
        (INTERCONNECT \$iopadmap\$ce_pair.q2\$intcell\$OBUF/OUT q2/PAD (0:0:0) (0:0:0))
        (INTERCONNECT \$iopadmap\$ce_pair.a\$intcell\$IBUF/OUT u1.u/A4 (981:981:981) (981:981:981))
        (INTERCONNECT \$iopadmap\$ce_pair.b\$intcell\$IBUF/OUT u1.u/A3 (840:840:840) (840:840:840))
        (INTERCONNECT \$iopadmap\$ce_pair.c\$intcell\$IBUF/OUT u2.u/A4 (1167:1167:1167) (1167:1167:1167))
        (INTERCONNECT u1.u/O6 \$iopadmap\$ce_pair.q1\$intcell\$OBUF/IN (2051:2051:2051) (2051:2051:2051))
        (INTERCONNECT u1.u/O6 u1.u/A1 (295:295:295) (295:295:295))
        (INTERCONNECT u1.u/O6 u2.u/A1 (435:435:435) (435:435:435))
        (INTERCONNECT u2.u/O6 \$iopadmap\$ce_pair.q2\$intcell\$OBUF/IN (1952:1952:1952) (1952:1952:1952))
        (INTERCONNECT u2.u/O6 u2.u/A5 (295:295:295) (295:295:295))
        (INTERCONNECT \$iopadmap\$ce_pair.rst\$intcell\$IBUF/OUT u1.u/A2 (984:984:984) (984:984:984))
        (INTERCONNECT \$iopadmap\$ce_pair.rst\$intcell\$IBUF/OUT u2.u/A3 (1124:1124:1124) (1124:1124:1124))
        (INTERCONNECT \$PACKER_GND_DRV/Y u1.u/A5 (3465:3465:3465) (3465:3465:3465))
        (INTERCONNECT \$PACKER_GND_DRV/Y u1.u/A6 (3465:3465:3465) (3465:3465:3465))
        (INTERCONNECT \$PACKER_GND_DRV/Y u2.u/A2 (3435:3435:3435) (3435:3435:3435))
        (INTERCONNECT \$PACKER_GND_DRV/Y u2.u/A6 (3435:3435:3435) (3435:3435:3435))
      )
    )
  )
  (CELL
    (CELLTYPE "PAD")
    (INSTANCE a)
    )
  (CELL
    (CELLTYPE "PAD")
    (INSTANCE b)
    )
  (CELL
    (CELLTYPE "PAD")
    (INSTANCE c)
    )
  (CELL
    (CELLTYPE "PAD")
    (INSTANCE q1)
    )
  (CELL
    (CELLTYPE "PAD")
    (INSTANCE q2)
    )
  (CELL
    (CELLTYPE "PAD")
    (INSTANCE rst)
    )
  (CELL
    (CELLTYPE "SLICE_LUTX")
    (INSTANCE u1.u)
    (DELAY
      (ABSOLUTE
        (IOPATH A1 O6 (124:124:124) (124:124:124))
        (IOPATH A2 O6 (124:124:124) (124:124:124))
        (IOPATH A3 O6 (124:124:124) (124:124:124))
        (IOPATH A4 O6 (124:124:124) (124:124:124))
        (IOPATH A5 O6 (124:124:124) (124:124:124))
        (IOPATH A6 O6 (124:124:124) (124:124:124))
      )
    )
    )
  (CELL
    (CELLTYPE "SLICE_LUTX")
    (INSTANCE u2.u)
    (DELAY
      (ABSOLUTE
        (IOPATH A1 O6 (124:124:124) (124:124:124))
        (IOPATH A2 O6 (124:124:124) (124:124:124))
        (IOPATH A3 O6 (124:124:124) (124:124:124))
        (IOPATH A4 O6 (124:124:124) (124:124:124))
        (IOPATH A5 O6 (124:124:124) (124:124:124))
        (IOPATH A6 O6 (124:124:124) (124:124:124))
      )
    )
    )
  (CELL
    (CELLTYPE "PSEUDO_GND")
    (INSTANCE \$PACKER_GND_DRV)
    )
  (CELL
    (CELLTYPE "PSEUDO_VCC")
    (INSTANCE \$PACKER_VCC_DRV)
    )
  (CELL
    (CELLTYPE "IOB33_INBUF_EN")
    (INSTANCE \$iopadmap\$ce_pair.a\$intcell\$IBUF)
    )
  (CELL
    (CELLTYPE "IOB33_INBUF_EN")
    (INSTANCE \$iopadmap\$ce_pair.b\$intcell\$IBUF)
    )
  (CELL
    (CELLTYPE "IOB33_INBUF_EN")
    (INSTANCE \$iopadmap\$ce_pair.c\$intcell\$IBUF)
    )
  (CELL
    (CELLTYPE "IOB33_OUTBUF")
    (INSTANCE \$iopadmap\$ce_pair.q1\$intcell\$OBUF)
    )
  (CELL
    (CELLTYPE "IOB33_OUTBUF")
    (INSTANCE \$iopadmap\$ce_pair.q2\$intcell\$OBUF)
    )
  (CELL
    (CELLTYPE "IOB33_INBUF_EN")
    (INSTANCE \$iopadmap\$ce_pair.rst\$intcell\$IBUF)
    )
)
