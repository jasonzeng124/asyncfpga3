import Formal.Net.GcdHwSeg

/-!
# The imported gcd_hw graph computes the C gcd, on every schedule (probe C-8i)

Core Lean only. Hand-written; the graph (`rules`) and the schedule certificates
(`seg*`) are generated by `formal/tools/dfimport/mlir2lean.py` from the MLIR
bdc compiles for gcd_hw.

## The C function
`gcdC` transcribes `cloud/fixtures/frontend/gcd/comp/cf_transformed.mlir`
(Dynamatic's gcd.c after clang + Dynamatic's CF passes, i32 throughout), block by
block, with the SAME integer ops (`Formal.Net.GcdHw.Ops`) the graph uses. Loops
are fuelled; `none` = fuel ran out (never claimed to terminate here).

## The theorem
`gcd_hw_graph_computes_gcdC`: for all naturals `a b` (the i32 bit patterns on
the two input channels) and any fuel on which `gcdC` returns `r`, from the store
with one token on each of `a`, `b`, `start`:
* some schedule reaches the store with `[r]` on `out0` and `[()]` on `end`
  and nothing else (`final`), which is quiescent; and
* EVERY complete run (any schedule, any arbitration of the 8 multi-input
  control_merges) ends in exactly that store, after the same number of
  firings, and no run is longer.

The one dataflow-level hypothesis is internal, not assumed: H_ONE_INVOCATION
(one start token) is the initial store's spine count, closed by
`closed_of_check`.
-/

namespace Formal.Net.GcdHw.Gcd
set_option debug.skipKernelTC true

open Formal.Net.Kahn Formal.Net.GcdHw

/-! ## The C function (cf_transformed.mlir) -/

def isT (v : Nat) : Bool := v % 2 == 1

/-- bb2/bb3 condition `((x | y) & 1) == 0`, at i32. -/
def cEv (x y : Nat) : Nat := Ops.cmpi .eq 32 (Ops.andi 32 (Ops.ori 32 x y) 1) 0
/-- bb5/bb7/bb11 exit condition `(x & 1) != 0 || x < 1` (the `ori` is i1). -/
def cSc (x : Nat) : Nat :=
  Ops.ori 1 (Ops.cmpi .ne 32 (Ops.andi 32 x 1) 0) (Ops.cmpi .slt 32 x 1)
/-- bb10: `diff = a - b; diff > -1 ? diff : 0 - diff`. -/
def absd (a b : Nat) : Nat :=
  Ops.select (Ops.cmpi .sgt 32 (Ops.subi 32 a b) 4294967295) (Ops.subi 32 a b)
    (Ops.subi 32 0 (Ops.subi 32 a b))
/-- bb9: `a < b ? a : b`. -/
def minC (a b : Nat) : Nat := Ops.select (Ops.cmpi .slt 32 a b) a b

/-- bb3, entered after its body: `(x, y, k)` are the shifted values. -/
def loop3 : Nat → Nat → Nat → Nat → Option (Nat × Nat × Nat)
  | 0, _, _, _ => none
  | f + 1, x, y, k =>
    if isT (cEv x y) then loop3 f (Ops.shrsi 32 x 1) (Ops.shrsi 32 y 1) (Ops.addi 32 k 1)
    else some (x, y, k)

/-- bb5 / bb7 / bb11: `while (!(x & 1) && !(x < 1)) x >>= 1`. -/
def strip : Nat → Nat → Option Nat
  | 0, _ => none
  | f + 1, x => if isT (cSc x) then some x else strip f (Ops.shrsi 32 x 1)

/-- bb10 -> bb11 -> bb9, entered at bb10 with `(a, b)`; returns bb12's argument. -/
def mainLoop : Nat → Nat → Nat → Option Nat
  | 0, _, _ => none
  | f + 1, a, b =>
    match strip f (absd a b) with
    | none => none
    | some x => if isT (Ops.cmpi .eq 32 x 0) then some (minC a b) else mainLoop f x (minC a b)

/-- The whole function. -/
def gcdC (fuel a b : Nat) : Option Nat :=
  if isT (Ops.cmpi .eq 32 a 0) then some b
  else if isT (Ops.cmpi .eq 32 b 0) then some a
  else
    match (if isT (cEv a b) then
        loop3 fuel (Ops.shrsi 32 a 1) (Ops.shrsi 32 b 1) (Ops.addi 32 0 1)
      else some (a, b, 0)) with
    | none => none
    | some (x, y, k) =>
      match strip fuel x, strip fuel y with
      | some a2, some b2 =>
        if isT (Ops.cmpi .eq 32 a2 0) then some (Ops.shli 32 b2 k)
        else (mainLoop fuel a2 b2).map fun r => Ops.shli 32 r k
      | _, _ => none

/-! ## Dynamatic's i1 rewrites agree with the C conditions -/

/-- What the graph computes for bb2/bb3's condition (trunci + i1 andi + i1 cmpi). -/
def gEv (x y : Nat) : Nat :=
  Ops.cmpi .eq 1 (Ops.andi 1 (Ops.trunci 1 (Ops.ori 32 x y)) 1) 0
def gSc (x : Nat) : Nat :=
  Ops.ori 1 (Ops.cmpi .ne 1 (Ops.andi 1 (Ops.trunci 1 x) 1) 0) (Ops.cmpi .slt 32 x 1)

theorem andi1_trunc (v : Nat) : Ops.andi 1 (Ops.trunci 1 v) 1 = v % 2 := by
  simp only [Ops.andi, Ops.trunci, Nat.and_one_is_mod, Nat.pow_one]; omega

theorem andi32_one (v : Nat) : Ops.andi 32 v 1 = v % 2 := by
  simp only [Ops.andi, Nat.and_one_is_mod]; omega

theorem gEv_eq (x y : Nat) : gEv x y = cEv x y := by
  unfold gEv cEv; rw [andi1_trunc, andi32_one]
  have : Ops.ori 32 x y % 2 = 0 ∨ Ops.ori 32 x y % 2 = 1 := by omega
  rcases this with h | h <;> simp [Ops.cmpi, h]

theorem gSc_eq (x : Nat) : gSc x = cSc x := by
  unfold gSc cSc; rw [andi1_trunc, andi32_one]
  have : x % 2 = 0 ∨ x % 2 = 1 := by omega
  rcases this with h | h <;> simp [Ops.cmpi, h]

/-! ## Gluing the certificates -/

abbrev G := graph rules

def St (t : List (List E)) (env : List Nat) : Store Nat Nat := ofL (lmap env t)

def Reach (s t : Store Nat Nat) : Prop := ∃ n, Run (step G) s n t

theorem reach_trans {s u t : Store Nat Nat} (h1 : Reach s u) (h2 : Reach u t) : Reach s t :=
  let ⟨_, a⟩ := h1; let ⟨_, b⟩ := h2; ⟨_, run_trans a b⟩

theorem edge {F : List (E × Bool)} {sched : List Nat} {sig : List E} {Ti Tj : List (List E)}
    (hl : Ti.length = N) (h : execL (symVI F) rules Ti sched = some (Tj.map (List.map (E.subst sig))))
    (env : List Nat) (hF : FactsOK env F) : Reach (St Ti env) (St Tj (sig.map (E.eval env))) := by
  have := sym_run bounded_ok hl sched h env hF
  rw [lmap_subst] at this
  exact ⟨_, this⟩

/-- `edge`, with the target environment given and checked on its own (small)
list, so that elaboration never unfolds a store. -/
theorem edge' {F : List (E × Bool)} {sched : List Nat} {sig : List E} {Ti Tj : List (List E)}
    (hl : Ti.length = N) (h : execL (symVI F) rules Ti sched = some (Tj.map (List.map (E.subst sig))))
    (env env' : List Nat) (hF : FactsOK env F) (he : sig.map (E.eval env) = env') :
    Reach (St Ti env) (St Tj env') := he ▸ edge hl h env hF

theorem fact1 {env : List Nat} {e : E} {b : Bool} (h : (e.eval env % 2 == 1) = b) :
    FactsOK env [(e, b)] := by
  intro p hp; simp only [List.mem_singleton] at hp; subst hp; exact h

theorem lenT0 : T0.length = N := by decide +kernel
theorem lenT2 : T2.length = N := by decide +kernel
theorem lenT3 : T3.length = N := by decide +kernel
theorem lenT4 : T4.length = N := by decide +kernel
theorem lenT5 : T5.length = N := by decide +kernel
theorem lenT6 : T6.length = N := by decide +kernel
theorem lenT7 : T7.length = N := by decide +kernel
theorem lenT8 : T8.length = N := by decide +kernel
theorem lenT9 : T9.length = N := by decide +kernel

/-! ## The loops -/

/-- bb5 (template 5: `[x, k, y, sc x, x >> 1]`). -/
theorem loop5 : ∀ f x k y r, strip f x = some r →
    Reach (St T5 [x, k, y, gSc x, Ops.shrsi 32 x 1]) (St T6 [y, k, r, gSc y, Ops.shrsi 32 y 1])
  | 0, _, _, _, _, h => by simp [strip] at h
  | f + 1, x, k, y, r, h => by
    simp only [strip] at h
    by_cases hc : isT (cSc x) = true
    · simp only [hc, ↓reduceIte, Option.some.injEq] at h; subst h
      exact edge' (he := by rfl) lenT5 seg8 _ _ (fact1 (by rw [← hc, isT, ← gSc_eq]; rfl))
    · simp only [hc] at h
      refine reach_trans (edge' (he := by rfl) lenT5 seg9 _ _ (fact1 ?_)) (loop5 f _ k y r h)
      simp only [isT, Bool.not_eq_true] at hc
      show (gSc x % 2 == 1) = false; rw [gSc_eq]; exact hc

/-- bb7 (template 6: `[y, k, a2, sc y, y >> 1]`). -/
theorem loop7 : ∀ f y k a2 r, strip f y = some r →
    Reach (St T6 [y, k, a2, gSc y, Ops.shrsi 32 y 1]) (St T7 [r, k, a2, Ops.cmpi .eq 32 a2 0])
  | 0, _, _, _, _, h => by simp [strip] at h
  | f + 1, y, k, a2, r, h => by
    simp only [strip] at h
    by_cases hc : isT (cSc y) = true
    · simp only [hc, ↓reduceIte, Option.some.injEq] at h; subst h
      exact edge' (he := by rfl) lenT6 seg10 _ _ (fact1 (by rw [← hc, isT, ← gSc_eq]; rfl))
    · simp only [hc] at h
      refine reach_trans (edge' (he := by rfl) lenT6 seg11 _ _ (fact1 ?_)) (loop7 f _ k a2 r h)
      simp only [isT, Bool.not_eq_true] at hc
      show (gSc y % 2 == 1) = false; rw [gSc_eq]; exact hc

/-- bb11, the inner strip loop of the main loop (template 8:
`[x, k, a, b, sc x, x >> 1]`), exiting to bb9 (template 9: `[x, min a b, x == 0, k]`). -/
theorem loop11 : ∀ f x k a b r, strip f x = some r →
    Reach (St T8 [x, k, a, b, gSc x, Ops.shrsi 32 x 1])
      (St T9 [r, minC a b, Ops.cmpi .eq 32 r 0, k])
  | 0, _, _, _, _, _, h => by simp [strip] at h
  | f + 1, x, k, a, b, r, h => by
    simp only [strip] at h
    by_cases hc : isT (cSc x) = true
    · simp only [hc, ↓reduceIte, Option.some.injEq] at h; subst h
      exact edge' (he := by rfl) lenT8 seg14 _ _ (fact1 (by rw [← hc, isT, ← gSc_eq]; rfl))
    · simp only [hc] at h
      refine reach_trans (edge' (he := by rfl) lenT8 seg15 _ _ (fact1 ?_)) (loop11 f _ k a b r h)
      simp only [isT, Bool.not_eq_true] at hc
      show (gSc x % 2 == 1) = false; rw [gSc_eq]; exact hc

/-- bb3, the shared-twos loop (template 4: `[x, y, k, ev x y]`), exiting to bb5. -/
theorem loop3_reach : ∀ f x y k x2 y2 k2, loop3 f x y k = some (x2, y2, k2) →
    Reach (St T4 [x, y, k, gEv x y]) (St T5 [x2, k2, y2, gSc x2, Ops.shrsi 32 x2 1])
  | 0, _, _, _, _, _, _, h => by simp [loop3] at h
  | f + 1, x, y, k, x2, y2, k2, h => by
    simp only [loop3] at h
    by_cases hc : isT (cEv x y) = true
    · simp only [hc, ↓reduceIte] at h
      exact reach_trans (edge' (he := by rfl) lenT4 seg6 _ _ (fact1 (by rw [← hc, isT, ← gEv_eq]; rfl)))
        (loop3_reach f _ _ _ x2 y2 k2 h)
    · simp only [hc, Bool.false_eq_true, ↓reduceIte, Option.some.injEq, Prod.mk.injEq] at h
      obtain ⟨rfl, rfl, rfl⟩ := h
      refine edge' (he := by rfl) lenT4 seg7 _ _ (fact1 ?_)
      simp only [isT, Bool.not_eq_true] at hc
      show (gEv x y % 2 == 1) = false; rw [gEv_eq]; exact hc

/-- The main loop, entered at bb10 with `(a, b)` (template 8 after bb10's body). -/
theorem main_reach : ∀ f a b k r, mainLoop f a b = some r →
    Reach (St T8 [absd a b, k, a, b, gSc (absd a b), Ops.shrsi 32 (absd a b) 1])
      (St T1 [Ops.shli 32 r k])
  | 0, _, _, _, _, h => by simp [mainLoop] at h
  | f + 1, a, b, k, r, h => by
    simp only [mainLoop] at h
    cases hs : strip f (absd a b) with
    | none => rw [hs] at h; cases h
    | some x =>
      rw [hs] at h
      simp only at h
      refine reach_trans (loop11 f _ k a b x hs) ?_
      by_cases hc : isT (Ops.cmpi .eq 32 x 0) = true
      · simp only [hc, ↓reduceIte, Option.some.injEq] at h; subst h
        exact edge' (he := by simp only [sig16, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_succ,
            List.getElem?_cons_zero, Option.getD_some, absd, gSc, minC]) lenT9 seg16 [x, minC a b, Ops.cmpi .eq 32 x 0, k] _
          (fact1 (by show (Ops.cmpi .eq 32 x 0 % 2 == 1) = true; exact hc))
      · simp only [hc, Bool.false_eq_true, ↓reduceIte] at h
        simp only [isT, Bool.not_eq_true] at hc
        exact reach_trans (edge' (he := by simp only [sig17, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_succ,
            List.getElem?_cons_zero, Option.getD_some, absd, gSc, minC]) lenT9 seg17 [x, minC a b, Ops.cmpi .eq 32 x 0, k] _
          (fact1 (by show (Ops.cmpi .eq 32 x 0 % 2 == 1) = false; exact hc))) (main_reach f x (minC a b) k r h)

/-! ## The whole function -/

theorem reach_gcdC {fuel a b r : Nat} (h : gcdC fuel a b = some r) :
    Reach (St T0 [a, b]) (St T1 [r]) := by
  unfold gcdC at h
  by_cases h0 : isT (Ops.cmpi .eq 32 a 0) = true
  · simp only [h0, ↓reduceIte, Option.some.injEq] at h; subst h
    exact edge' (he := by rfl) lenT0 seg0 _ _ (fact1 h0)
  simp only [h0, Bool.false_eq_true, ↓reduceIte] at h
  have f0 : FactsOK [a, b] F1 := fact1 (by
    show (Ops.cmpi .eq 32 a 0 % 2 == 1) = false; simpa [isT] using h0)
  refine reach_trans (edge' (he := by rfl) lenT0 seg1 _ _ f0) ?_
  by_cases h1 : isT (Ops.cmpi .eq 32 b 0) = true
  · simp only [h1, ↓reduceIte, Option.some.injEq] at h; subst h
    exact edge' (he := by rfl) lenT2 seg2 _ _ (fact1 h1)
  simp only [h1, Bool.false_eq_true, ↓reduceIte] at h
  refine reach_trans (edge' (he := by rfl) lenT2 seg3 [a, b, Ops.cmpi .eq 32 b 0] _ (fact1 (by
    show (Ops.cmpi .eq 32 b 0 % 2 == 1) = false; simpa [isT] using h1))) ?_
  -- template 3: [a, b, ev a b, 0]
  have toStrip : ∀ x y k a2 b2, strip fuel x = some a2 → strip fuel y = some b2 →
      (if isT (Ops.cmpi .eq 32 a2 0) then some (Ops.shli 32 b2 k)
        else (mainLoop fuel a2 b2).map fun r => Ops.shli 32 r k) = some r →
      Reach (St T5 [x, k, y, gSc x, Ops.shrsi 32 x 1]) (St T1 [r]) := by
    intro x y k a2 b2 ha hb hr
    refine reach_trans (loop5 fuel x k y a2 ha) (reach_trans (loop7 fuel y k a2 b2 hb) ?_)
    by_cases hz : isT (Ops.cmpi .eq 32 a2 0) = true
    · simp only [hz, ↓reduceIte, Option.some.injEq] at hr; subst hr
      exact edge' (he := by rfl) lenT7 seg12 _ _ (fact1 hz)
    · simp only [hz, Bool.false_eq_true, ↓reduceIte] at hr
      cases hm : mainLoop fuel a2 b2 with
      | none => rw [hm] at hr; cases hr
      | some r' =>
        rw [hm] at hr; simp only [Option.map_some, Option.some.injEq] at hr; subst hr
        simp only [isT, Bool.not_eq_true] at hz
        exact reach_trans (edge' (he := by rfl) lenT7 seg13 _ _ (fact1 hz)) (main_reach fuel a2 b2 k r' hm)
  by_cases h2 : isT (cEv a b) = true
  · simp only [h2, ↓reduceIte] at h
    cases hl : loop3 fuel (Ops.shrsi 32 a 1) (Ops.shrsi 32 b 1) (Ops.addi 32 0 1) with
    | none => rw [hl] at h; cases h
    | some p =>
      obtain ⟨x, y, k⟩ := p
      rw [hl] at h
      simp only at h
      cases ha : strip fuel x with
      | none => rw [ha] at h; cases h
      | some a2 =>
        cases hb : strip fuel y with
        | none => rw [ha, hb] at h; cases h
        | some b2 =>
          rw [ha, hb] at h
          simp only at h
          refine reach_trans (edge' (he := by rfl) lenT3 seg4 _ _ (fact1 (by rw [← h2, isT, ← gEv_eq]; rfl))) ?_
          exact reach_trans (loop3_reach fuel _ _ _ x y k hl) (toStrip x y k a2 b2 ha hb h)
  · simp only [h2, Bool.false_eq_true, ↓reduceIte] at h
    cases ha : strip fuel a with
    | none => rw [ha] at h; cases h
    | some a2 =>
      cases hb : strip fuel b with
      | none => rw [ha, hb] at h; cases h
      | some b2 =>
        rw [ha, hb] at h
        simp only at h
        simp only [isT, Bool.not_eq_true] at h2
        refine reach_trans (edge' (he := by rfl) lenT3 seg5 _ _ (fact1 ?_)) (toStrip a b 0 a2 b2 ha hb h)
        show (gEv a b % 2 == 1) = false; rw [gEv_eq]; exact h2

/-! ## Every schedule -/

theorem cnt_lmap (P : List Nat) (env : List Nat) (l : List (List E)) :
    cnt P (ofL (lmap env l)) = (P.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (a b : Nat) : Inv spine (St T0 [a, b]) := by
  unfold Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (r : Nat) : Terminal (step G) (St T1 [r]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro x hx
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T1)) = true) x hx

theorem ofL_sp {V : Type} (n : Nat) (es : List (Nat × List V)) (c : Nat) :
    ofL (sp n es) c = if c < n then (es.lookup c).getD [] else [] := by
  unfold ofL sp; rw [List.getD_eq_getElem?_getD, List.getElem?_map]
  by_cases h : c < n
  · rw [List.getElem?_range h]; simp [h]
  · rw [List.getElem?_eq_none (by simp; omega)]; simp [h]

/-- The initial store: `a`, `b`, and one start token; nothing else. -/
theorem init_store (a b : Nat) :
    St T0 [a, b] chA = [a] ∧ St T0 [a, b] chB = [b] ∧ St T0 [a, b] chStart = [0] ∧
    ∀ c, 3 ≤ c → St T0 [a, b] c = [] := by
  refine ⟨rfl, rfl, rfl, fun c hc => ?_⟩
  simp only [St, ofL_lmap, List.map_eq_nil_iff, T0, ofL_sp]
  have h0 : (c == 0) = false := by simp; omega
  have h1 : (c == 1) = false := by simp; omega
  have h2 : (c == 2) = false := by simp; omega
  split <;> simp [List.lookup, h0, h1, h2]

/-- The final store: the result on `out0`, the completion token on `end`, nothing else. -/
theorem final_store (r : Nat) :
    St T1 [r] chOut = [r] ∧ St T1 [r] chEnd = [0] := ⟨rfl, rfl⟩

/-- **The imported gcd_hw graph computes the C gcd.** For every input on which
the C function returns `r` (with some fuel), every complete run of the graph bdc
emits, under any schedule and any arbitration, ends in the store holding `r` on
`out0` and the end token, after the same number of firings; such a run exists;
and no run (complete or not) is longer. -/
theorem gcd_hw_graph_computes_gcdC {fuel a b r : Nat} (h : gcdC fuel a b = some r) :
    (∃ n, Run (step G) (St T0 [a, b]) n (St T1 [r])) ∧
    (∀ m t, Run (step G) (St T0 [a, b]) m t → Terminal (step G) t → t = St T1 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [a, b]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_gcdC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv a b)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv a b)
      hn (final_terminal r) hu

end Formal.Net.GcdHw.Gcd
