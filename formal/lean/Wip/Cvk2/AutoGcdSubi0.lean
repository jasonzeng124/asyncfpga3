/-! ## The whole function, on every schedule -/

theorem reach_kC {fuel a₀ b₀ r : Nat} (h : kC fuel a₀ b₀ = some r) :
    Reach (St T0 [a₀, b₀]) (St T1 [r]) :=
  sim_call Tm Reach reach_trans P L K ρ Is 1 GE M hG cover hM (by decide) rfl
    (hin a₀ b₀) (hI0 a₀ b₀) h

theorem cnt_lmap (Q : List Nat) (env : List Nat) (l : List (List E)) :
    cnt Q (ofL (lmap env l)) = (Q.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (a₀ b₀ : Nat) : Formal.Net.GcdHw.Inv spine (St T0 [a₀, b₀]) := by
  unfold Formal.Net.GcdHw.Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (r : Nat) : Terminal (step G) (St T1 [r]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro x hx
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T1)) = true) x hx

/-- **The imported graph computes the C function `gcd`** (generated proof). -/
theorem auto_computes {fuel a₀ b₀ r : Nat} (h : kC fuel a₀ b₀ = some r) :
    (∃ n, Run (step G) (St T0 [a₀, b₀]) n (St T1 [r])) ∧
    (∀ m t, Run (step G) (St T0 [a₀, b₀]) m t → Terminal (step G) t → t = St T1 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [a₀, b₀]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_kC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv a₀ b₀)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv a₀ b₀)
      hn (final_terminal r) hu

end Formal.Net.AutoGcdSubi0
