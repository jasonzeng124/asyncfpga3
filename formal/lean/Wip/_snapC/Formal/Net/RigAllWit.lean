import Formal.Net.RigAllWitCells

/-!
# Probe C-wit: `gcd_rig_all` (C-8s3) is not vacuous

One explicit run `chR` of the concrete 465-channel gcd_hw network inside gcd_rig's environment
(`RigAllWitData`, generated by `formal/tools/capwit2/gen_wit.py rig`; unit-delay gate models,
a = 12, b = 18 = gcd_rig.v's vector idx 2, whose expected gcd in the rig's own table is 6)
meets every hypothesis of `gcd_rig_all` at once:
* `CellR` (H_CELLS without `Src.iz`): the three source requests start HIGH, as gcd_rig's
  `uenv1` (`bd_c2n_set`) holds them through reset;
* H_BUNDLE;
* `RigEnv` (the uenv1/uenv0 C(a, ¬b) gate facts on `start.req` and `out0.ack`);
* and the range `a, b < 2^31`.
It runs three invocations: start is high at reset release and re-offered at 432 and 865; out0
offers at 430, 863 and 1296, and two tokens close (acknowledge falls) at 474 and 907, all
carrying 6. The invocations overlap as C-8s3 describes: start's re-offer at 432 comes while
out0's first handshake is still open (its acknowledge falls only at 474).

`gcd_rig_all_witness_consistent` applies `gcd_rig_all` to the run.
-/

namespace Formal.Net.CapNet.RigWit
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.CapNet Formal.Net.CapNet.Gcd

/-- **A non-quiet joint witness for `gcd_rig_all`** with three invocations, two of them latched,
the second overlapping the first's return-to-zero. -/
theorem gcd_rig_all_witness :
    ∃ ch : Fin NC → Chan,
      (∀ o : Fin NO, CellR ch (srcV 12 18) (opAt o)) ∧        -- H_CELLS without Src.iz
      (∀ c, Held (ch c)) ∧                                    -- H_BUNDLE
      RigEnv (ch start).req (ch out0).ack ∧                   -- H_ENV (uenv1/uenv0)
      -- start: high at reset release, re-offered at 432 and 865
      (ch start).req 0 = true ∧ OffAt (ch start) 0 432 ∧ OffAt (ch start) 1 865 ∧
      -- out0 offers three tokens, each carrying 6
      (OffAt (ch out0) 0 430 ∧ (ch out0).dat 431 = 6) ∧
      (OffAt (ch out0) 1 863 ∧ (ch out0).dat 864 = 6) ∧
      (OffAt (ch out0) 2 1296 ∧ (ch out0).dat 1297 = 6) ∧
      -- and latches two of them, the first closing after start's re-offer at 432
      (TokAt (ch out0) 0 474 ∧ (ch out0).dat 474 = 6) ∧
      (TokAt (ch out0) 1 907 ∧ (ch out0).dat 907 = 6) :=
  ⟨chR, r_cells, r_held, r_env, r_start.1, r_start.2.1, r_start.2.2.1, r_out0⟩

theorem gcd_12_18' : Nat.gcd 12 18 = 6 := by decide

/-- The theorem applied to the witness: everything out0 offers or latches in `chR` is 6, and
the witness does latch twice. -/
theorem gcd_rig_all_witness_consistent :
    (∀ k r, OffAt (chR out0) k r → (chR out0).dat (r + 1) = 6) ∧
    (∀ k e, TokAt (chR out0) k e → (chR out0).dat e = 6) ∧
    TokAt (chR out0) 0 474 ∧ TokAt (chR out0) 1 907 := by
  have h := gcd_rig_all 12 18 (by decide) (by decide) chR r_cells r_held r_env
  rw [gcd_12_18'] at h
  exact ⟨h.1, h.2, r_out0.2.2.2.1.1, r_out0.2.2.2.2.1⟩

end Formal.Net.CapNet.RigWit
