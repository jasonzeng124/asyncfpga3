  first | rfl | (simp only [ρ, P, List.getD, List.map, List.cons.injEq, and_true]; auto_ops)

theorem hI0 (b₀ e₀ : Nat) : InvH (Is.getD 0 []) (P.entry.map (E.eval [b₀, e₀])) := by
  first | rfl | (simp only [InvH, Is, P, List.getD, List.map, List.cons.injEq, and_true]; auto_ops)

/-! ## The whole function, on every schedule -/

theorem reach_kC {fuel b₀ e₀ r : Nat} (h : kC fuel b₀ e₀ = some r) :
    Reach (St T0 [b₀, e₀]) (St T2 [r]) :=
  sim_call Tm Reach reach_trans P L K ρ Is 2 GE M hG cover hM (by decide) rfl
    (hin b₀ e₀) (hI0 b₀ e₀) h

theorem cnt_lmap (Q : List Nat) (env : List Nat) (l : List (List E)) :
    cnt Q (ofL (lmap env l)) = (Q.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (b₀ e₀ : Nat) : Formal.Net.GcdHw.Inv spine (St T0 [b₀, e₀]) := by
  unfold Formal.Net.GcdHw.Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (r : Nat) : Terminal (step G) (St T2 [r]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro x hx
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T2)) = true) x hx

/-- **The imported graph computes the C function `ipow`** (generated proof). -/
theorem auto_computes {fuel b₀ e₀ r : Nat} (h : kC fuel b₀ e₀ = some r) :
    (∃ n, Run (step G) (St T0 [b₀, e₀]) n (St T2 [r])) ∧
    (∀ m t, Run (step G) (St T0 [b₀, e₀]) m t → Terminal (step G) t → t = St T2 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [b₀, e₀]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_kC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv b₀ e₀)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv b₀ e₀)
      hn (final_terminal r) hu

end Formal.Net.AutoIpow
