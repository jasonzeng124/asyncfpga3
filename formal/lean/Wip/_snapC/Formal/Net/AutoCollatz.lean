    (o2_20 (List.map (E.eval σ) [(.var 0), (.var 1), (.sel (.bin (.cmpi .eq) 1 (.bin .andi 1 (.un .trunci 1 (.var 0)) (.lit 1)) (.lit 0)) (.bin .shrsi 32 (.var 0) (.lit 1)) (.bin .addi 32 (.bin .addi 32 (.var 0) (.bin .shli 32 (.var 0) (.lit 1))) (.lit 1)))])
      (tr_hyp (by decide +kernel) (by decide +kernel) hI) (tr_isT (by decide +kernel) h))

/-- Under T2's invariant and the C outcome, the segment's fact has outcome false, its new environment is ρ of the C's new state, and the target invariant holds. -/
theorem o2 : ∀ σ : List Nat,
    List.map (E.eval σ) [] = List.map (E.eval σ) [] →
    isT (E.eval σ (.bin (.cmpi .ne) 32 (.var 0) (.lit 1))) = true →
    isT (E.eval σ (.bin (.cmpi .eq) 32 (.bin (.cmpi .ne) 32 (.var 0) (.lit 1)) (.lit 0))) = false ∧
    List.map (E.eval σ) [(.sel (.bin (.cmpi .eq) 1 (.bin .andi 1 (.un .trunci 1 (.var 0)) (.lit 1)) (.lit 0)) (.bin .shrsi 32 (.var 0) (.lit 1)) (.bin .addi 32 (.bin .addi 32 (.var 0) (.bin .shli 32 (.var 0) (.lit 1))) (.lit 1))), (.bin .addi 32 (.var 1) (.lit 1)), (.bin (.cmpi .eq) 32 (.sel (.bin (.cmpi .eq) 1 (.bin .andi 1 (.un .trunci 1 (.var 0)) (.lit 1)) (.lit 0)) (.bin .shrsi 32 (.var 0) (.lit 1)) (.bin .addi 32 (.bin .addi 32 (.var 0) (.bin .shli 32 (.var 0) (.lit 1))) (.lit 1))) (.lit 1))] =
      List.map (E.eval σ) [(.sel (.bin (.cmpi .eq) 32 (.bin .andi 32 (.var 0) (.lit 1)) (.lit 0)) (.bin .shrsi 32 (.var 0) (.lit 1)) (.bin .addi 32 (.bin .muli 32 (.lit 3) (.var 0)) (.lit 1))), (.bin .addi 32 (.var 1) (.lit 1)), (.bin (.cmpi .eq) 32 (.bin (.cmpi .ne) 32 (.sel (.bin (.cmpi .eq) 32 (.bin .andi 32 (.var 0) (.lit 1)) (.lit 0)) (.bin .shrsi 32 (.var 0) (.lit 1)) (.bin .addi 32 (.bin .muli 32 (.lit 3) (.var 0)) (.lit 1))) (.lit 1)) (.lit 0))] ∧
    List.map (E.eval σ) [] = List.map (E.eval σ) [] :=
  fun σ hI h => ⟨o2_1 σ hI h, map_cons_eq (o2_2 σ hI h) (map_cons_eq (o2_10 σ hI h) (map_cons_eq (o2_11 σ hI h) (rfl))), rfl⟩

theorem m2 : MatchSem P ρ Is ⟨2, ce0, g3⟩ :=
  matchSem_of (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) o2

/-! ### T2 with C edge 1 (test 0 false) and graph segment 2 -/

theorem o3_1 (σ : List Nat) (hI : List.map (E.eval σ) [] = List.map (E.eval σ) [])
    (h : isT (E.eval σ (.bin (.cmpi .ne) 32 (.var 0) (.lit 1))) = false) :
    isT (E.eval σ (.bin (.cmpi .eq) 32 (.bin (.cmpi .ne) 32 (.var 0) (.lit 1)) (.lit 0))) = true := by
  simp only [E.eval] at h  ⊢
  auto_ops

theorem o3_2 (σ : List Nat) (hI : List.map (E.eval σ) [] = List.map (E.eval σ) [])
    (h : isT (E.eval σ (.bin (.cmpi .ne) 32 (.var 0) (.lit 1))) = false) :
    E.eval σ (.var 1) = E.eval σ (.var 1) := rfl

/-- Under T2's invariant and the C outcome, the segment's fact has outcome true, its new environment is ρ of the C's new state, and the target invariant holds. -/
theorem o3 : ∀ σ : List Nat,
    List.map (E.eval σ) [] = List.map (E.eval σ) [] →
    isT (E.eval σ (.bin (.cmpi .ne) 32 (.var 0) (.lit 1))) = false →
    isT (E.eval σ (.bin (.cmpi .eq) 32 (.bin (.cmpi .ne) 32 (.var 0) (.lit 1)) (.lit 0))) = true ∧
    List.map (E.eval σ) [(.var 1)] =
      List.map (E.eval σ) [(.var 1)] ∧
    List.map (E.eval σ) [] = List.map (E.eval σ) [] :=
  fun σ hI h => ⟨o3_1 σ hI h, map_cons_eq (o3_2 σ hI h) (rfl), rfl⟩

theorem m3 : MatchSem P ρ Is ⟨2, ce1, g2⟩ :=
  matchSem_of (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) o3

theorem hM : ∀ m ∈ M, MatchSem P ρ Is m := by
  intro m hm
  simp only [M, List.mem_cons, List.not_mem_nil, or_false] at hm
  rcases hm with rfl | rfl | rfl | rfl
  · exact m0
  · exact m1
  · exact m2
  · exact m3

theorem hin (n₀ : Nat) : (ρ.getD 0 []).map (E.eval (P.entry.map (E.eval [n₀]))) = [n₀] := by
  first | rfl | (simp only [ρ, P, List.getD, List.map, List.cons.injEq, and_true]; auto_ops)

theorem hI0 (n₀ : Nat) : InvH (Is.getD 0 []) (P.entry.map (E.eval [n₀])) := by
  first | rfl | (simp only [InvH, Is, P, List.getD, List.map, List.cons.injEq, and_true]; auto_ops)

/-! ## The whole function, on every schedule -/

theorem reach_kC {fuel n₀ r : Nat} (h : kC fuel n₀ = some r) :
    Reach (St T0 [n₀]) (St T1 [r]) :=
  sim_call Tm Reach reach_trans P L K ρ Is 1 GE M hG cover hM (by decide) rfl
    (hin n₀) (hI0 n₀) h

theorem cnt_lmap (Q : List Nat) (env : List Nat) (l : List (List E)) :
    cnt Q (ofL (lmap env l)) = (Q.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (n₀ : Nat) : Formal.Net.GcdHw.Inv spine (St T0 [n₀]) := by
  unfold Formal.Net.GcdHw.Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (r : Nat) : Terminal (step G) (St T1 [r]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro x hx
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T1)) = true) x hx

/-- **The imported graph computes the C function `collatz`** (generated proof). -/
theorem auto_computes {fuel n₀ r : Nat} (h : kC fuel n₀ = some r) :
    (∃ n, Run (step G) (St T0 [n₀]) n (St T1 [r])) ∧
    (∀ m t, Run (step G) (St T0 [n₀]) m t → Terminal (step G) t → t = St T1 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [n₀]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_kC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv n₀)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv n₀)
      hn (final_terminal r) hu

end Formal.Net.AutoCollatz
