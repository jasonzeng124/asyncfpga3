import Formal.Net.XorshiftHwSeg

/-!
# The imported xorshift graph computes the C xorshift32, on every schedule (probe C-8y2)

Core Lean only. Hand-written; `rules` and `seg*` are GENERATED by
`formal/tools/dfimport/mlir2lean.py` (unchanged tool, run with
`--ns Formal.Net.XorshiftHw`) from `cloud/fixtures/frontend/xorshift/comp/handshake_transformed.mlir`.

## The C function
`xorshiftC` transcribes `kernels/xorshift/xorshift.c` by hand (NOT the MLIR, NOT a run's
output): `unsigned x = (unsigned)seed; int i = 0; while (i < rounds) { x = x ^ (x << 13);
x = x ^ (x >> 17); x = x ^ (x << 5); i = i + 1; } return (int)x;` with `int`/`unsigned` as
32-bit patterns (`Nat`), `<<` truncating (`Ops.shli 32`), `>>` on the unsigned `x` LOGICAL
(`Ops.shrui 32`), `i < rounds` SIGNED (`Ops.cmpi .slt 32`), `i + 1` wrapping. The casts are the
identity on bit patterns. The loop is fuelled; `none` = fuel ran out.

Dynamatic rotated the loop (the entry tests `rounds > 0` once, i.e. `0 < rounds`; the body
ends with the test on `i + 1`) and fused the round into two comps (`gX`, equal to the C round
by `rfl`). `i = 0` reaches the graph as `extui(i1 false)`.

## Theorems
* `xorshift_hw_graph_computes_xorshiftC`: if `xorshiftC fuel seed rounds = some r`, a complete
  run exists, every complete run (any schedule, any arbitration of the 2 two-input
  control_merges) ends with exactly `[r]` on `out0` and the end token, and no run is longer.
* `xorshiftC_total`: the C loop terminates within fuel `rounds + 1` when `rounds < 2^31`
  (a non-negative i32) and within fuel 1 otherwise (negative i32: no iteration), so
  `xorshift_hw_graph_computes` is unconditional for every i32 `rounds < 2^32` and every
  `seed`, with `r = xsSpec seed rounds`.
-/

namespace Formal.Net.XorshiftHw

open Formal.Net.Kahn Formal.Net.GcdHw

/-! ## The C function (kernels/xorshift/xorshift.c) -/

def isT (v : Nat) : Bool := v % 2 == 1

/-- One round: `x ^= x << 13; x ^= x >> 17; x ^= x << 5` (unsigned 32-bit). -/
def roundC (x : Nat) : Nat :=
  let x1 := Ops.xori 32 x (Ops.shli 32 x 13)
  let x2 := Ops.xori 32 x1 (Ops.shrui 32 x1 17)
  Ops.xori 32 x2 (Ops.shli 32 x2 5)

/-- `while (i < rounds) { x = roundC x; i = i + 1; } return x;` -/
def xsLoop : Nat → Nat → Nat → Nat → Option Nat
  | 0, _, _, _ => none
  | f + 1, r, x, i =>
    if isT (Ops.cmpi .slt 32 i r) then xsLoop f r (roundC x) (Ops.addi 32 i 1) else some x

def xorshiftC (fuel seed rounds : Nat) : Option Nat := xsLoop fuel rounds seed 0

/-! ## What the graph computes -/

/-- The fused regions `shli0+xori0+shrui0+xori1` and `shli1+xori2`. -/
def gX (x : Nat) : Nat :=
  Ops.xori 32 (Ops.xori 32 (Ops.xori 32 x (Ops.shli 32 x 13))
      (Ops.shrui 32 (Ops.xori 32 x (Ops.shli 32 x 13)) 17))
    (Ops.shli 32 (Ops.xori 32 (Ops.xori 32 x (Ops.shli 32 x 13))
      (Ops.shrui 32 (Ops.xori 32 x (Ops.shli 32 x 13)) 17)) 5)

/-- The graph's round is the C round. -/
theorem gX_eq (x : Nat) : gX x = roundC x := rfl

/-- The rotated entry test `rounds > 0` is the C test `0 < rounds` at `i = 0`. -/
theorem sgt_slt (r : Nat) : Ops.cmpi .sgt 32 r 0 = Ops.cmpi .slt 32 0 r := rfl

theorem extui10 : Ops.extui 1 0 = 0 := by decide

/-! ## Gluing the certificates (same scheme as C-8i / C-8v) -/

abbrev G := graph rules

def St (t : List (List E)) (env : List Nat) : Store Nat Nat := ofL (lmap env t)

def Reach (s t : Store Nat Nat) : Prop := ∃ n, Run (step G) s n t

theorem reach_trans {s u t : Store Nat Nat} (h1 : Reach s u) (h2 : Reach u t) : Reach s t :=
  let ⟨_, a⟩ := h1; let ⟨_, b⟩ := h2; ⟨_, run_trans a b⟩

theorem edge {F : List (E × Bool)} {sched : List Nat} {sig : List E} {Ti Tj : List (List E)}
    (hl : Ti.length = N) (h : execL (symVI F) rules Ti sched = some (Tj.map (List.map (E.subst sig))))
    (env : List Nat) (hF : FactsOK env F) : Reach (St Ti env) (St Tj (sig.map (E.eval env))) := by
  have := sym_run bounded_ok hl sched h env hF
  rw [lmap_subst] at this
  exact ⟨_, this⟩

theorem edge' {F : List (E × Bool)} {sched : List Nat} {sig : List E} {Ti Tj : List (List E)}
    (hl : Ti.length = N) (h : execL (symVI F) rules Ti sched = some (Tj.map (List.map (E.subst sig))))
    (env env' : List Nat) (hF : FactsOK env F) (he : sig.map (E.eval env) = env') :
    Reach (St Ti env) (St Tj env') := he ▸ edge hl h env hF

theorem fact1 {env : List Nat} {e : E} {b : Bool} (h : (e.eval env % 2 == 1) = b) :
    FactsOK env [(e, b)] := by
  intro p hp; simp only [List.mem_singleton] at hp; subst hp; exact h

theorem lenT0 : T0.length = N := by decide +kernel
theorem lenT1 : T1.length = N := by decide +kernel

/-! ## One lemma per certified segment -/

/-- The C loop-head state `(x, i)` with the pending test `i < rounds` (template 1:
`[rounds, x, i, i < rounds]`). -/
def gC (i r : Nat) : Nat := Ops.cmpi .slt 32 i r

theorem e0 (seed r : Nat) (hc : (Ops.cmpi .sgt 32 r 0 % 2 == 1) = true) :
    Reach (St T0 [seed, r])
      (St T1 [r, gX seed, Ops.addi 32 (Ops.extui 1 0) 1, gC (Ops.addi 32 (Ops.extui 1 0) 1) r]) :=
  edge' lenT0 seg0 [seed, r] _ (fact1 hc) (by
    simp only [sig0, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_zero,
      List.getElem?_cons_succ, Option.getD_some, gX, gC])

theorem e1 (seed r : Nat) (hc : (Ops.cmpi .sgt 32 r 0 % 2 == 1) = false) :
    Reach (St T0 [seed, r]) (St T2 [seed]) :=
  edge' lenT0 seg1 [seed, r] _ (fact1 hc) (by
    simp only [sig1, List.map, E.eval, List.getD, List.getElem?_cons_zero, Option.getD_some])

theorem e2 (r x i c : Nat) (hc : (c % 2 == 1) = true) :
    Reach (St T1 [r, x, i, c]) (St T1 [r, gX x, Ops.addi 32 i 1, gC (Ops.addi 32 i 1) r]) :=
  edge' lenT1 seg2 [r, x, i, c] _ (fact1 hc) (by
    simp only [sig2, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_succ,
      List.getElem?_cons_zero, Option.getD_some, gX, gC])

theorem e3 (r x i c : Nat) (hc : (c % 2 == 1) = false) :
    Reach (St T1 [r, x, i, c]) (St T2 [x]) :=
  edge' lenT1 seg3 [r, x, i, c] _ (fact1 hc) (by
    simp only [sig3, List.map, E.eval, List.getD, List.getElem?_cons_succ,
      List.getElem?_cons_zero, Option.getD_some])

/-! ## The loop and the whole function -/

theorem loop_reach (r : Nat) : ∀ f x i res, xsLoop f r x i = some res →
    Reach (St T1 [r, x, i, gC i r]) (St T2 [res]) := by
  intro f; induction f with
  | zero => intro _ _ _ h; simp [xsLoop] at h
  | succ f ih =>
    intro x i res h
    simp only [xsLoop] at h
    by_cases hc : isT (gC i r) = true
    · simp only [gC] at hc
      simp only [hc, ↓reduceIte] at h
      have s2 := e2 r x i (gC i r) hc
      rw [gX_eq] at s2
      exact reach_trans s2 (ih _ _ res h)
    · simp only [gC] at hc
      simp only [hc, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at h
      subst h; exact e3 r x i (gC i r) (by simpa [isT, gC] using hc)

theorem reach_xorshiftC {fuel seed r res : Nat} (h : xorshiftC fuel seed r = some res) :
    Reach (St T0 [seed, r]) (St T2 [res]) := by
  unfold xorshiftC at h
  cases fuel with
  | zero => simp [xsLoop] at h
  | succ f =>
    simp only [xsLoop] at h
    by_cases hc : isT (Ops.cmpi .slt 32 0 r) = true
    · simp only [hc, ↓reduceIte] at h
      have s0 := e0 seed r (by rw [sgt_slt]; exact hc)
      rw [gX_eq, extui10] at s0
      exact reach_trans s0 (loop_reach r f _ _ res h)
    · simp only [hc, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at h
      subst h; exact e1 seed r (by rw [sgt_slt]; simpa [isT] using hc)

/-! ## Every schedule -/

theorem cnt_lmap (P : List Nat) (env : List Nat) (l : List (List E)) :
    cnt P (ofL (lmap env l)) = (P.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (seed r : Nat) : GcdHw.Inv spine (St T0 [seed, r]) := by
  unfold GcdHw.Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (x : Nat) : Terminal (step G) (St T2 [x]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro y hy
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T2)) = true) y hy

theorem ofL_sp {V : Type} (n : Nat) (es : List (Nat × List V)) (c : Nat) :
    ofL (sp n es) c = if c < n then (es.lookup c).getD [] else [] := by
  unfold ofL sp; rw [List.getD_eq_getElem?_getD, List.getElem?_map]
  by_cases h : c < n
  · rw [List.getElem?_range h]; simp [h]
  · rw [List.getElem?_eq_none (by simp; omega)]; simp [h]

/-- The initial store: `seed`, `rounds`, and one start token; nothing else. -/
theorem init_store (seed r : Nat) :
    St T0 [seed, r] chSeed = [seed] ∧ St T0 [seed, r] chRounds = [r] ∧
    St T0 [seed, r] chStart = [0] ∧ ∀ c, 3 ≤ c → St T0 [seed, r] c = [] := by
  refine ⟨rfl, rfl, rfl, fun c hc => ?_⟩
  simp only [St, ofL_lmap, List.map_eq_nil_iff, T0, ofL_sp]
  have h0 : (c == 0) = false := by simp; omega
  have h1 : (c == 1) = false := by simp; omega
  have h2 : (c == 2) = false := by simp; omega
  split <;> simp [List.lookup, h0, h1, h2]

/-- The final store: the result on `out0`, the end token on `end`, nothing else. -/
theorem final_store (x : Nat) :
    St T2 [x] chOut = [x] ∧ St T2 [x] chEnd = [0] ∧
    ∀ c, c ≠ chOut → c ≠ chEnd → St T2 [x] c = [] := by
  refine ⟨rfl, rfl, fun c h1 h2 => ?_⟩
  simp only [St, ofL_lmap, List.map_eq_nil_iff, T2, ofL_sp]
  have h4 : (c == 4) = false := by simp [chEnd] at h2; simpa using h2
  have h54 : (c == 54) = false := by simp [chOut] at h1; simpa using h1
  split <;> simp [List.lookup, h4, h54]

/-- **The imported xorshift graph computes the C xorshift32, whenever the C loop returns.** -/
theorem xorshift_hw_graph_computes_xorshiftC {fuel seed r res : Nat}
    (h : xorshiftC fuel seed r = some res) :
    (∃ k, Run (step G) (St T0 [seed, r]) k (St T2 [res])) ∧
    (∀ m t, Run (step G) (St T0 [seed, r]) m t → Terminal (step G) t →
      t = St T2 [res] ∧ t chOut = [res] ∧ t chEnd = [0]) ∧
    (∃ k, ∀ m u, Run (step G) (St T0 [seed, r]) m u → m ≤ k) := by
  obtain ⟨k, hk⟩ := reach_xorshiftC h
  refine ⟨⟨k, hk⟩, fun m t ht hT => ?_, ⟨k, fun m u hu => ?_⟩⟩
  · have e := (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv seed r)
      hk (final_terminal res) ht hT).1
    subst e; exact ⟨rfl, (final_store res).1, (final_store res).2.1⟩
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv seed r)
      hk (final_terminal res) hu

theorem closedG : Closed (step G) (GcdHw.Inv spine) :=
  closed_of_check spine rules spine_nodup spine_ok

/-! ## Termination: the C loop always returns -/

/-- `i < rounds` (signed) for `i ≤ rounds < 2^31`: exactly `i < rounds`. -/
theorem slt_iff {i r : Nat} (hi : i < 2 ^ 31) (hr : r < 2 ^ 31) :
    isT (Ops.cmpi .slt 32 i r) = decide (i < r) := by
  have hi' : i % 2 ^ 32 = i := Nat.mod_eq_of_lt (by omega)
  have hr' : r % 2 ^ 32 = r := Nat.mod_eq_of_lt (by omega)
  simp only [Ops.cmpi, Ops.flip, Ops.b2n, isT, hi', hr', Nat.reduceSub, Nat.reducePow]
  have e1 : (i + 2147483648) % 4294967296 = i + 2147483648 := Nat.mod_eq_of_lt (by omega)
  have e2 : (r + 2147483648) % 4294967296 = r + 2147483648 := Nat.mod_eq_of_lt (by omega)
  rw [e1, e2]
  by_cases h : i < r
  · simp [h]
  · simp [show ¬ (i + 2147483648 < r + 2147483648) by omega, h]

/-- For a negative i32 `rounds` (`2^31 ≤ r < 2^32`), `0 < rounds` is false. -/
theorem slt0_neg {r : Nat} (h1 : 2 ^ 31 ≤ r) (h2 : r < 2 ^ 32) : isT (Ops.cmpi .slt 32 0 r) = false := by
  have hr' : r % 2 ^ 32 = r := Nat.mod_eq_of_lt h2
  simp only [Ops.cmpi, Ops.flip, Ops.b2n, isT, hr', Nat.reduceSub, Nat.reducePow, Nat.zero_mod,
    Nat.zero_add]
  have e2 : (r + 2147483648) % 4294967296 = r - 2147483648 := by omega
  rw [e2]
  have : ¬ (2147483648 % 4294967296 < r - 2147483648) := by omega
  simp [this]

/-- The C result: `rounds` rounds when `rounds` is a non-negative i32, none otherwise. -/
def xsSpec (seed r : Nat) : Nat := if r < 2 ^ 31 then Nat.repeat roundC r seed else seed

theorem loop_total (r : Nat) (hr : r < 2 ^ 31) : ∀ k x i, i + k = r →
    xsLoop (k + 1) r x i = some (Nat.repeat roundC k x) := by
  intro k
  induction k with
  | zero =>
    intro x i h
    simp only [xsLoop, Nat.repeat]
    rw [slt_iff (by omega) hr]; simp; omega
  | succ k ih =>
    intro x i h
    rw [xsLoop]
    rw [slt_iff (by omega) hr]
    have hlt : i < r := by omega
    simp only [hlt, decide_true, ↓reduceIte]
    have hi1 : Ops.addi 32 i 1 = i + 1 := by simp only [Ops.addi]; exact Nat.mod_eq_of_lt (by omega)
    rw [hi1, ih (roundC x) (i + 1) (by omega)]
    congr 1
    -- Nat.repeat f (k+1) x = f (Nat.repeat f k x); we need Nat.repeat f k (f x)
    clear ih hi1 hlt h
    induction k generalizing x with
    | zero => rfl
    | succ k ihk => simp only [Nat.repeat] at ihk ⊢; rw [ihk]

/-- **The C loop always returns**, with `xsSpec`, on every i32 `rounds` and every `seed`. -/
theorem xorshiftC_total (seed : Nat) {r : Nat} (hr : r < 2 ^ 32) :
    xorshiftC (r + 1) seed r = some (xsSpec seed r) := by
  unfold xorshiftC xsSpec
  by_cases h : r < 2 ^ 31
  · simp only [h, ↓reduceIte]
    exact loop_total r h r seed 0 (by omega)
  · simp only [h, ↓reduceIte]
    simp only [xsLoop]
    rw [slt0_neg (by omega) hr]; rfl

/-- **The imported xorshift graph computes `xsSpec` on every i32 input**: unconditional. -/
theorem xorshift_hw_graph_computes (seed : Nat) {r : Nat} (hr : r < 2 ^ 32) :
    (∃ k, Run (step G) (St T0 [seed, r]) k (St T2 [xsSpec seed r])) ∧
    (∀ m t, Run (step G) (St T0 [seed, r]) m t → Terminal (step G) t →
      t = St T2 [xsSpec seed r] ∧ t chOut = [xsSpec seed r] ∧ t chEnd = [0]) ∧
    (∃ k, ∀ m u, Run (step G) (St T0 [seed, r]) m u → m ≤ k) :=
  xorshift_hw_graph_computes_xorshiftC (xorshiftC_total seed hr)

/-- The kernel's own `main` vector, on the C transcription (seed 2463534242, 4 rounds):
NOT a run's output; the value is whatever the transcription evaluates to. -/
example : (xorshiftC 5 2463534242 4).isSome = true := by decide +kernel

end Formal.Net.XorshiftHw
