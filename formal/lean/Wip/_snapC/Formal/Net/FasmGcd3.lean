import Formal.Net.FasmDesign.Gcd3.All

/-!
# Probe C-11g: the whole routed gcd_hw (route 3), read back from its bitstream

Route 3 = `cells/hw/build_hw.sh gcd_hw` with NEXTPNR_SEED=3, `--freq 100`, nextpnr
9c732bc6303458df (fixture `formal/tools/fasm2lean3/fixture/gcd_hw_3.*`). The
physical netlist is decoded from the FASM read back from the `.bit`
(`fasm2lean3.py`); the logical netlist is the yosys netlist nextpnr was given
(flattened by `gen3.py`). Generated by the same gen3.py as route d (probe C-11f);
see `formal/notes/C-11g-seeds.md` and `formal/notes/C-11f-design-import.md`.

Statements (no hypotheses; what they rest on is the decoders, see the note):

* `gcd_hw_3_netlist`: every one of the 10631 instances is `Inst.Sound` for the
  renaming `Gcd3.rho` (H_NETLIST, connectivity and function half, for route 3).
* `gcd_hw_3_ports`: the two output pads' physical sources rename to the logical
  OBUF inputs.
* `gcd_hw_3_count`: 10631 instances, 9622 of them carry a logical cell (the 9623rd
  logical cell, a MUXF7 whose output nothing reads, is reported by gen3).
* `gcd_hw_3_cells_init`: every bound library-cell LUT (5645) has the kind and
  INIT of the `Formal.Gen.Cells` cell generated from the same `cells/rtl` line.

NOT covered: timing, glitches, X; the RTL-to-yosys step; injectivity of `rho`;
the trust in the FASM-to-site decoding (H_SITE_DECODE) and in the yosys JSON
flattening; the other routes are separate files (d: FasmGcd, 2-4: FasmGcd2..4).
-/

namespace Formal.Net.FasmGcd3
open Formal.Gen Formal.Net.FasmDesign

theorem gcd_hw_3_netlist : ∀ i ∈ Gcd3.insts, i.Sound Gcd3.rho := Gcd3.sound

theorem gcd_hw_3_ports : ∀ x ∈ Gcd3.ports, ren Gcd3.rho x.2.1 = some x.2.2 := by
  intro x hx
  have h := Gcd3.ports_ok
  simp only [List.all_eq_true, beq_iff_eq] at h
  exact h x hx

theorem gcd_hw_3_count :
    Gcd3.insts.length = 10631 ∧ (Gcd3.insts.filter (·.log.isSome)).length = 9622 := by
  decide +kernel

/-- H_CELLS (INIT half), route 3: in every chunk, every binding `(k, nl, name)` says that
instance `k` carries a logical cell whose kind and INIT are those of cell `name` of the
generated library netlist `nl`. -/
theorem gcd_hw_3_cells_init :
    ∀ c ∈ Gcd3.chunks, ∀ k nl nm, (k, nl, nm) ∈ c.2 → ∃ i l g, c.1[k]? = some i ∧
      i.log = some l ∧ nl.cell? nm = some g ∧ g.kind = l.kind ∧ g.init = l.init := by
  intro c hc
  have h := Gcd3.cells_init
  simp only [List.all_eq_true] at h
  exact bindsOk_sound c.1 c.2 (h c hc)

/-- The chunks are the instances, and they carry 5645 bindings (= every library-cell LUT). -/
theorem gcd_hw_3_chunks :
    (Gcd3.chunks.map Prod.fst).flatten = Gcd3.insts ∧
    (Gcd3.chunks.map (fun c => c.2.length)).sum = 5645 :=
  ⟨Gcd3.chunks_insts, Gcd3.binds_count⟩

end Formal.Net.FasmGcd3
