/-- **The imported graph computes the C function `varshift`** (generated proof). -/
theorem auto_computes {fuel x₀ n₀ r : Nat} (h : kC fuel x₀ n₀ = some r) :
    (∃ n, Run (step G) (St T0 [x₀, n₀]) n (St T2 [r])) ∧
    (∀ m t, Run (step G) (St T0 [x₀, n₀]) m t → Terminal (step G) t → t = St T2 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [x₀, n₀]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_kC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv x₀ n₀)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv x₀ n₀)
      hn (final_terminal r) hu

end Formal.Net.AutoApVarshiftOrig
