import Formal.Net.CapstoneWitnessTok

/-! C-8t generator (not built): fires the first enabled GcdHw rule until none is enabled,
from `X0 A B`, and prints `Formal/Net/CapstoneWitnessRun.lean` (chunked certificates). -/

open Formal.Net Formal.Net.GcdHw Formal.Net.GcdHw.Gcd Formal.Net.CapNet.Wit

def firstEnabled (x : TL) : Option (Nat × TL) :=
  (List.range rules.length).findSome? fun l => (tstepL x l).map fun y => (l, y)

partial def runAll (x : TL) (acc : Array Nat) : Array Nat × TL :=
  match firstEnabled x with
  | some (l, y) => runAll y (acc.push l)
  | none => (acc, x)

def spStr (L : List (List Nat)) : String :=
  let es := (L.zipIdx.filter fun p => !p.1.isEmpty).map fun p => s!"({p.2}, {p.1})"
  s!"sp {L.length} [{", ".intercalate es}]"

def tlStr (x : TL) : String := s!"⟨{spStr x.s}, {spStr x.cn}, {spStr x.pr}⟩"

def gen (A B : Nat) (chunk : Nat) : IO Unit := do
  let (ls, yf) := runAll (X0 A B) #[]
  let ls := ls.toList
  IO.eprintln s!"firings: {ls.length}; final store = lmap [gcd] T1: {decide (yf.s = lmap [Nat.gcd A B] T1)}"
  let mut out := s!"import Formal.Net.CapstoneWitnessTok

/-!
# GENERATED by formal/lean/Wip/C8t/RunGen.lean -- DO NOT EDIT

Probe C-8t: one complete traced run of the GcdHw token graph from `init {A} {B}` (the first
enabled rule fires at every step; {ls.length} firings), as chunked kernel certificates
`texecL Y_k ls_k = some Y_(k+1)` with literal intermediate states.
-/

namespace Formal.Net.CapNet.Wit
open Formal.Net Formal.Net.GcdHw Formal.Net.GcdHw.Gcd

set_option maxRecDepth 100000

"
  let mut x := X0 A B
  let mut rest := ls
  let mut k := 0
  out := out ++ s!"def Y0 : TL := X0 {A} {B}\n\n"
  while !rest.isEmpty do
    let c := rest.take chunk
    rest := rest.drop chunk
    let y := (texecL x c).get!
    out := out ++ s!"def ls{k} : List Nat := {c}\n\ndef Y{k+1} : TL := {tlStr y}\n\n"
    out := out ++ s!"theorem cert{k} : texecL Y{k} ls{k} = some Y{k+1} := by decide +kernel\n\n"
    x := y
    k := k + 1
  out := out ++ "theorem run0 : texecL Y0 ls0 = some Y1 := cert0\n"
  let mut lsAll := "ls0"
  for i in [1:k] do
    out := out ++ s!"theorem run{i} : texecL Y0 ({lsAll} ++ ls{i}) = some Y{i+1} := texecL_trans run{i-1} cert{i}\n"
    lsAll := s!"({lsAll} ++ ls{i})"
  out := out ++ s!"\ndef lsAll : List Nat := {lsAll}\n\ndef Yf : TL := Y{k}\n\ntheorem run_all : texecL Y0 lsAll = some Yf := run{k-1}\n\nend Formal.Net.CapNet.Wit\n"
  IO.println out

#eval gen 12 18 25
