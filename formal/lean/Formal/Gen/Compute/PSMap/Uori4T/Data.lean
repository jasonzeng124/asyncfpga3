/-- One step of `pickR`: on index list `0 :: ds` take the gate, on `(d+1) :: ds` skip it. -/
def stepP (g : Gate) (ih : List Nat → List Gate) : List Nat → List Gate
  | [] => []
  | 0 :: ds => g :: ih ds
  | (d + 1) :: ds => ih (d :: ds)

/-- `pickR l ds`: skip `ds[0]` entries of `l`, take one, skip `ds[1]`, take one, ... (a bare recursor:
cheap for the kernel). -/
noncomputable def pickR (l : List Gate) : List Nat → List Gate :=
  @List.rec Gate (fun _ => List Nat → List Gate) (fun _ => []) (fun g _ ih => stepP g ih) l

/-- A search tree node -> value (0 when absent). -/
inductive NT where
  | lf
  | nd (k v : Nat) (l r : NT)

def NT.find : NT → Nat → Nat
  | .lf, _ => 0
  | .nd k v l r, n => cond (Nat.blt n k) (NT.find l n) (cond (Nat.blt k n) (NT.find r n) v)

