  unfold D at hc
  rcases List.mem_append.mp hc with hc | h
  case inr => exact mem_chunk sub073 gin073 h
  rcases List.mem_append.mp hc with hc | h
  case inr => exact mem_chunk sub072 gin072 h
  rcases List.mem_append.mp hc with hc | h
