  | 0 :: ds => g :: ih ds
  | (d + 1) :: ds => ih (d :: ds)

/-- `pickR l ds`: skip `ds[0]` entries of `l`, take one, skip `ds[1]`, take one, ... (a bare recursor:
cheap for the kernel). -/
noncomputable def pickR (l : List Gate) : List Nat → List Gate :=
  @List.rec Gate (fun _ => List Nat → List Gate) (fun _ => []) (fun g _ ih => stepP g ih) l

