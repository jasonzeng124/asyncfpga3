theorem mem_chunk {gs : List Gate} {ds : List GC} (hs : subOK gs ds = true)
    (hg : ∀ g ∈ gs, g ∈ DecodedPS.net.gates) {c : GC} (h : c ∈ ds) :
    ∃ g ∈ DecodedPS.net.gates, GC.ofGate g = c := by
  obtain ⟨g, h1, h2⟩ := subOK_sound gs ds hs c h
  exact ⟨g, hg g h1, h2⟩

