/-- The unit's depth. -/
def D : Nat := 2872

/-- The unit's input nodes (every node of the untimed certificate's input map). -/
def known : List Nat := Formal.Gen.Compute.PSMap.Ucmpi8.maps.psi.map (fun e => e.2.2)

/-- A gate's output and pins have depth at most `D`. -/
def bnd (g : Gate) : Bool := decide (SN g.out ≤ D) &&
  (List.range g.k).all fun i => decide (SN (g.ins.getD i 0) ≤ D)

/-- What each piece file decides. -/
noncomputable def pieceOK (i : Nat) : Bool :=
  Formal.Timing.SpecSettle.certOKN SN (Kof oAll known i) (A i) && ((A i).map Gate.out == oAll.getD i []) && (A i).all bnd


