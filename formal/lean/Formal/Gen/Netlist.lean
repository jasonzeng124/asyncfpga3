import Formal.Cells.Prelim

/-!
# Probe 11d: generated netlists of the whole cell library, and their interpreter

`Formal/Gen/Cells.lean` is GENERATED by `formal/tools/gen/yosys2lean.py` from
the yosys JSON of every module of `cells/rtl/*.v` (`formal/tools/gen/gen.sh`;
drift check `gen.sh --check`). This file is the hand-written half: the data
types and ONE interpreter for all of them. It extends 11a's
`Formal/Net/Import/Netlist.lean` (copied, not imported) with every primitive
the library synthesizes to.

## Primitive models (each is a named modelling choice; see the fidelity table in
`formal/notes/C-11d-gen.md`)

Every primitive is evaluated through ONE table-lookup function `Sem.lut`, so
the binary (`lutB`) and Kleene (`lutK`, hypothesis H_KLEENE_LUT of
`Formal.Cells.Prelim`) readings come from the same code:

* `LUTk`, `LUT6_2`: the INIT table (`O5` = lower 32 bits over I0..I4), as in
  `Formal.Cells.Prelim` (shard B).
* `MUXF7`, `MUXF8`: a 2:1 mux `S ? I1 : I0` (table `MUX_INIT`). The Kleene
  reading is `K3.mux`, which is how H_KLEENE_LUT models a pass-transistor mux.
* `CARRY4`: the cells_sim.v equations, gate by gate: carry-in `CI | CYINIT`,
  `CO[i] = S[i] ? c[i] : DI[i]` (a mux), `O[i] = S[i] xor c[i]`. (H_CARRY4_SIM:
  the silicon's CYINIT is a static mux, not an OR; they agree whenever one of
  CI/CYINIT is tied 0, which is how yosys instantiates it.)
* `FDRE/FDSE/FDCE/FDPE`: **H_FF_MS** -- a master-slave latch pair. The
  importer adds a synthetic state net `M` (the master, named `<Q>$master`):
  `M' = C ? M : (R/S ? 0/1 : (CE ? D : Q))`, `Q' = C ? M : Q`, with
  CLR/PRE (FDCE/FDPE) forcing both. In the unit-step reading below, `Q`
  takes the value `D` had in the last step before `C` rose: an ideal
  edge-triggered flop, setup/hold and CK->Q not modelled (that is the timing
  layer's job). INIT (power-up value) is recorded, not used: the state is an
  argument of every theorem.
* `LDCE/LDPE`: `Q' = CLR/PRE ? 0/1 : (G & GE ? D : Q)`.
* `BUFG`: identity (H_BUF_IDENTITY: a zero-delay wire; its ~ns insertion
  delay is a timing fact, not a logic one).
* `RAMB18E1`/`RAMB36E1`: **OPAQUE**. Imported with every pin and net, but its
  outputs evaluate to `none`, so any statement that depends on them fails to
  prove instead of being vacuous.

## Two views of a netlist

1. **Gate view** (`Netlist.gate`): any cell's output as a function of the
   values on its input NETS, given by name. This is the gate-level relation the
   trace/delay proofs need (every gate output is a variable, as in shard B's
   interleaving models), and what `Proofs*.lean` match against B's
   transcriptions. `Netlist.lutIs` pins a cell's kind, INIT and pin -> net map.
2. **Step view** (`Netlist.next`, `outs`): 11a's unit-step reading. The
   `state` nets (sequential outputs, LUT outputs read back by their own cell,
   then DFS back edges, see the generator) hold values; every other net is a
   combinational function of inputs and state; `next` gives every state net's
   driver evaluated on that. Delay lines are wires in this reading.

Every function returns `Option`: a missing pin, an undriven net, an opaque
driver or an uncut cycle gives `none`, so a theorem `... = some v` also
certifies that the netlist is well formed there.
-/

namespace Formal.Gen
open Formal.Cells

/-- Primitive pins (UNISIM names, multi-bit CARRY4 pins bit-blasted). `M` is
the synthetic master node of a flip-flop; `other` names an opaque cell's pins. -/
inductive Pin where
  | I | I0 | I1 | I2 | I3 | I4 | I5 | O | O5 | O6
  | S | CI | CYINIT | DI0 | DI1 | DI2 | DI3 | S0 | S1 | S2 | S3
  | O0 | O1 | O2 | O3 | CO0 | CO1 | CO2 | CO3
  | C | CE | D | R | CLR | PRE | G | GE | Q | M
  | other (name : String)
  deriving DecidableEq, Repr

inductive Src where
  | net (n : Nat)
  | const (b : Bool)
  deriving DecidableEq, Repr

inductive Kind where
  | lut (k : Nat)
  | lut6_2
  | muxf7 | muxf8
  | carry4
  | fdre | fdse | fdce | fdpe
  | ldce | ldpe
  | buf (prim : String)
  /-- Not modelled: outputs evaluate to `none`. -/
  | opaque (prim : String) (outs : List String)
  deriving DecidableEq, Repr

structure Cell where
  name : String
  kind : Kind
  /-- LUT INIT (bit `j` = output at address `j`, I0 = LSB); FF/latch INIT bit. -/
  init : Nat
  keep : Bool
  conn : List (Pin × Src)
  /-- Input pins read inverted (`IS_<pin>_INVERTED = 1` on a flip-flop or
  latch: the 7-series slice has a programmable clock/enable inverter). -/
  inv : List Pin := []
  deriving Repr

structure Netlist where
  top : String
  /-- The `targets.txt` line this netlist was synthesized from. -/
  target : String
  inputs : List (String × Nat)
  /-- Output ports; a port may be tied to a constant or be an input net. -/
  outputs : List (String × Src)
  state : List Nat
  /-- The subset of `state` cut only to break a combinational cycle (step 3 of
  the generator's cut); empty for every library cell. -/
  cut : List Nat
  nets : List (Nat × String)
  cells : List Cell
  deriving Repr

/-- A value domain: how a table is read, and what a tie drives. -/
structure Sem (V : Type) where
  lut : Nat → List V → V
  const : Bool → V

/-- Decidability of `∀` over `K3` (local; `Formal.Cells.Prelim` has none). -/
instance K3.decForall {P : K3 → Prop} [DecidablePred P] : Decidable (∀ k, P k) :=
  if h : P .f ∧ P .t ∧ P .x then
    isTrue (fun k => by cases k <;> simp_all)
  else
    isFalse (fun H => h ⟨H _, H _, H _⟩)

def boolSem : Sem Bool := ⟨lutB, id⟩
def kleeneSem : Sem K3 := ⟨lutK, K3.ofBool⟩

/-! ## Primitive tables -/

/-- `[I0, I1, S]`: `S ? I1 : I0`. -/
def MUX_INIT : Nat := 0xCA
def OR2_INIT : Nat := 0xE
def NOT_INIT : Nat := 0x1
def XOR2_INIT : Nat := 0x6
/-- Sync flip-flops, slave: `[C, CE, R|S, D, Q, M]`, `C ? M : Q`. -/
def FFQ_SYNC : Nat := 0xFFFFAAAA55550000
def FDRE_M : Nat := 0xAAFBAAEA00510040
def FDSE_M : Nat := 0xFFFBFFEA55515540
/-- Async: `[C, CE, CLR|PRE, D, Q, M]`. -/
def FDCE_Q : Nat := 0x0F0F0A0A05050000
def FDCE_M : Nat := 0x0F0B0E0A05010400
def FDPE_Q : Nat := 0xFFFFFAFAF5F5F0F0
def FDPE_M : Nat := 0xFFFBFEFAF5F1F4F0
/-- `[CLR|PRE, D, G, GE, Q]`. -/
def LDCE_INIT : Nat := 0x45554000
def LDPE_INIT : Nat := 0xEFFFEAAA

/-- The tables are the equations of the module doc (checked exhaustively). -/
theorem prim_tables :
    (∀ a b s : Bool, lutB MUX_INIT [a, b, s] = (if s then b else a)) ∧
    (∀ a b : Bool, lutB OR2_INIT [a, b] = (a || b)) ∧
    (∀ a : Bool, lutB NOT_INIT [a] = !a) ∧
    (∀ a b : Bool, lutB XOR2_INIT [a, b] = (a ^^ b)) ∧
    (∀ c ce x d q m : Bool, lutB FFQ_SYNC [c, ce, x, d, q, m] = (if c then m else q)) ∧
    (∀ c ce d r q m : Bool, lutB FDRE_M [c, ce, d, r, q, m] =
        (if c then m else if r then false else if ce then d else q)) ∧
    (∀ c ce d s q m : Bool, lutB FDSE_M [c, ce, d, s, q, m] =
        (if c then m else if s then true else if ce then d else q)) ∧
    (∀ c ce clr d q m : Bool, lutB FDCE_Q [c, ce, clr, d, q, m] =
        (if clr then false else if c then m else q)) ∧
    (∀ c ce clr d q m : Bool, lutB FDCE_M [c, ce, clr, d, q, m] =
        (if clr then false else if c then m else if ce then d else q)) ∧
    (∀ c ce pre d q m : Bool, lutB FDPE_Q [c, ce, pre, d, q, m] =
        (if pre then true else if c then m else q)) ∧
    (∀ c ce pre d q m : Bool, lutB FDPE_M [c, ce, pre, d, q, m] =
        (if pre then true else if c then m else if ce then d else q)) ∧
    (∀ clr d g ge q : Bool, lutB LDCE_INIT [clr, d, g, ge, q] =
        (if clr then false else if g && ge then d else q)) ∧
    (∀ pre d g ge q : Bool, lutB LDPE_INIT [pre, d, g, ge, q] =
        (if pre then true else if g && ge then d else q)) := by
  decide +kernel

/-- The Kleene mux of H_KLEENE_LUT is exactly `K3.mux` (MUXF7/F8, CARRY4's CO). -/
theorem mux_kleene : ∀ a b s : K3, lutK MUX_INIT [a, b, s] = K3.mux s a b := by
  decide +kernel

/-! ## Pins and the cell function -/

/-- Input pins in evaluation order. Sequential cells read back their own
outputs (`Q`, `M`), which are state nets. -/
def inPins : Kind → List Pin
  | .lut k => [Pin.I0, .I1, .I2, .I3, .I4, .I5].take k
  | .lut6_2 => [.I0, .I1, .I2, .I3, .I4, .I5]
  | .muxf7 | .muxf8 => [.I0, .I1, .S]
  | .carry4 => [.CI, .CYINIT, .DI0, .DI1, .DI2, .DI3, .S0, .S1, .S2, .S3]
  | .fdre => [.C, .CE, .D, .R, .Q, .M]
  | .fdse => [.C, .CE, .D, .S, .Q, .M]
  | .fdce => [.C, .CE, .CLR, .D, .Q, .M]
  | .fdpe => [.C, .CE, .PRE, .D, .Q, .M]
  | .ldce => [.CLR, .D, .G, .GE, .Q]
  | .ldpe => [.PRE, .D, .G, .GE, .Q]
  | .buf _ => [.I]
  | .opaque _ _ => []

def outPins : Kind → List Pin
  | .lut _ | .muxf7 | .muxf8 | .buf _ => [.O]
  | .lut6_2 => [.O5, .O6]
  | .carry4 => [.O0, .O1, .O2, .O3, .CO0, .CO1, .CO2, .CO3]
  | .fdre | .fdse | .fdce | .fdpe => [.Q, .M]
  | .ldce | .ldpe => [.Q]
  | .opaque _ os => os.map .other

/-- CARRY4: the four carries `c[0..4]` from `[CI, CYINIT, DI0..3, S0..3]`. -/
def carries {V : Type} (sem : Sem V) (ins : List V) : Option (List V) :=
  match ins with
  | [ci, cy, d0, d1, d2, d3, s0, s1, s2, s3] =>
    let c0 := sem.lut OR2_INIT [ci, cy]
    let c1 := sem.lut MUX_INIT [d0, c0, s0]
    let c2 := sem.lut MUX_INIT [d1, c1, s1]
    let c3 := sem.lut MUX_INIT [d2, c2, s2]
    let c4 := sem.lut MUX_INIT [d3, c3, s3]
    some [c0, c1, c2, c3, c4, s0, s1, s2, s3]
  | _ => none

/-- The value on output pin `p` of `c`, given its input pin values in
`inPins` order. -/
def Cell.out {V : Type} (sem : Sem V) (c : Cell) (p : Pin) (ins0 : List V) : Option V :=
  let ins := if c.inv.isEmpty then ins0 else
    ((inPins c.kind).zip ins0).map fun (q, v) => if c.inv.contains q then sem.lut NOT_INIT [v] else v
  match c.kind, p with
  | .lut _, .O => some (sem.lut c.init ins)
  | .lut6_2, .O6 => some (sem.lut c.init ins)
  | .lut6_2, .O5 => some (sem.lut (c.init % 2 ^ 32) (ins.take 5))
  | .muxf7, .O | .muxf8, .O => some (sem.lut MUX_INIT ins)
  | .buf _, .O => ins.head?
  | .carry4, p => do
    let cs ← carries sem ins
    let o (i : Nat) : Option V := do
      let s ← cs[5 + i]?; let c ← cs[i]?; pure (sem.lut XOR2_INIT [s, c])
    match p with
    | .O0 => o 0 | .O1 => o 1 | .O2 => o 2 | .O3 => o 3
    | .CO0 => cs[1]? | .CO1 => cs[2]? | .CO2 => cs[3]? | .CO3 => cs[4]?
    | _ => none
  | .fdre, .Q | .fdse, .Q => some (sem.lut FFQ_SYNC ins)
  | .fdre, .M => some (sem.lut FDRE_M ins)
  | .fdse, .M => some (sem.lut FDSE_M ins)
  | .fdce, .Q => some (sem.lut FDCE_Q ins)
  | .fdce, .M => some (sem.lut FDCE_M ins)
  | .fdpe, .Q => some (sem.lut FDPE_Q ins)
  | .fdpe, .M => some (sem.lut FDPE_M ins)
  | .ldce, .Q => some (sem.lut LDCE_INIT ins)
  | .ldpe, .Q => some (sem.lut LDPE_INIT ins)
  | _, _ => none

def Kind.isOpaque : Kind → Bool
  | .opaque _ _ => true
  | _ => false

/-! ## Step view (11a's interpreter, extended) -/

/-- The cell output pin driving net `n` (opaque cells drive nothing the
interpreter can read). The importer rejects multiply driven nets. -/
def Netlist.driver (nl : Netlist) (n : Nat) : Option (Cell × Pin) :=
  nl.cells.findSome? fun c =>
    if c.kind.isOpaque then none else
    (outPins c.kind).findSome? fun p =>
      if c.conn.lookup p = some (.net n) then some (c, p) else none

def evalNet {V : Type} (sem : Sem V) (nl : Netlist) (env : List (Nat × V)) :
    Nat → Nat → Option V
  | 0, _ => none
  | fuel + 1, n =>
    match env.lookup n with
    | some v => some v
    | none =>
      match nl.driver n with
      | none => none
      | some (c, p) => do
        let ins ← (inPins c.kind).mapM fun q =>
          match c.conn.lookup q with
          | some (.const b) => some (sem.const b)
          | some (.net m) => evalNet sem nl env fuel m
          | none => none
        c.out sem p ins

def evalSrc {V : Type} (sem : Sem V) (nl : Netlist) (env : List (Nat × V)) (fuel : Nat) :
    Option Src → Option V
  | some (.const b) => some (sem.const b)
  | some (.net m) => evalNet sem nl env fuel m
  | none => none

def Netlist.fuel (nl : Netlist) : Nat := nl.cells.length + 1

/-- Inputs (declaration order) and state nets (`state` order) bound to values. -/
def Netlist.env {V : Type} (nl : Netlist) (ins st : List V) : List (Nat × V) :=
  (nl.inputs.map Prod.snd).zip ins ++ nl.state.zip st

def Netlist.next {V : Type} (sem : Sem V) (nl : Netlist) (ins st : List V) :
    Option (List V) :=
  let env := nl.env ins st
  nl.state.mapM fun s => do
    let (c, p) ← nl.driver s
    let vs ← (inPins c.kind).mapM fun q => evalSrc sem nl env nl.fuel (c.conn.lookup q)
    c.out sem p vs

def Netlist.outs {V : Type} (sem : Sem V) (nl : Netlist) (ins st : List V) :
    Option (List V) :=
  nl.outputs.mapM fun (_, s) => evalSrc sem nl (nl.env ins st) nl.fuel (some s)

/-- One output port, by name (`none` if absent or not computable, e.g.
driven by an opaque cell). -/
def Netlist.outNamed {V : Type} (sem : Sem V) (nl : Netlist) (port : String) (ins st : List V) :
    Option V := do
  let s ← nl.outputs.lookup port
  evalSrc sem nl (nl.env ins st) nl.fuel (some s)

/-- Bits of `n`, least significant first (for word-level statements). -/
def bitsOf : Nat → Nat → List Bool
  | 0, _ => []
  | k + 1, n => n.testBit 0 :: bitsOf k (n / 2)

def Netlist.run {V : Type} (sem : Sem V) (nl : Netlist) (inp : Nat → List V) (s0 : List V) :
    Nat → Option (List V)
  | 0 => some s0
  | t + 1 => (nl.run sem inp s0 t).bind (nl.next sem (inp t))

/-! ## Gate view -/

def Netlist.cell? (nl : Netlist) (name : String) : Option Cell :=
  nl.cells.find? (·.name == name)

def Netlist.netName (nl : Netlist) (n : Nat) : String := (nl.nets.lookup n).getD "?"

/-- The net id of a (best) net name; `0` (never a yosys net) if absent. -/
def Netlist.netId (nl : Netlist) (s : String) : Nat :=
  ((nl.nets.find? (·.2 == s)).map (·.1)).getD 0

/-- Cell `name`'s output `p` with its input NETS read from `env` (ties are
constants). Sequential cells read their `Q`/`M` from `env` too. -/
def Netlist.gate {V : Type} (sem : Sem V) (nl : Netlist) (name : String) (p : Pin)
    (env : List (Nat × V)) : Option V := do
  let c ← nl.cell? name
  let ins ← (inPins c.kind).mapM fun q =>
    match c.conn.lookup q with
    | some (.const b) => some (sem.const b)
    | some (.net m) => env.lookup m
    | none => none
  c.out sem p ins

/-- Same, with the input nets given by NAME (`netId`). -/
def Netlist.gateN {V : Type} (sem : Sem V) (nl : Netlist) (name : String) (p : Pin)
    (env : List (String × V)) : Option V :=
  nl.gate sem name p (env.map fun (s, v) => (nl.netId s, v))

/-- A source as text: a net name, or `"0"`/`"1"`. -/
def Netlist.srcName (nl : Netlist) : Src → String
  | .net n => nl.netName n
  | .const b => if b then "1" else "0"

/-- A cell's input pins (in `inPins` order) and output pins, as net names. -/
def Netlist.pinMap (nl : Netlist) (name : String) : Option (List String × List String) := do
  let c ← nl.cell? name
  let i ← (inPins c.kind).mapM fun q => (c.conn.lookup q).map nl.srcName
  let o ← (outPins c.kind).mapM fun q => (c.conn.lookup q).map nl.srcName
  pure (i, o)

/-- Cell `name` exists, has this kind and INIT, reads exactly these nets (in
`inPins` order, `"0"`/`"1"` for ties) and drives these nets. -/
def Netlist.lutIs (nl : Netlist) (name : String) (k : Kind) (init : Nat)
    (ins outs : List String) : Bool :=
  match nl.cell? name with
  | some c => c.kind == k && c.init == init && nl.pinMap name == some (ins, outs)
  | none => false

/-- What pin `p` of cell `name` is connected to, as text. -/
def Netlist.pinNet (nl : Netlist) (name : String) (p : Pin) : Option String := do
  let c ← nl.cell? name
  let s ← c.conn.lookup p
  pure (nl.srcName s)

/-- The name of the cell driving the net called `net`. -/
def Netlist.driverName (nl : Netlist) (net : String) : Option String :=
  (nl.driver (nl.netId net)).map (·.1.name)

/-- Cell `name`'s INIT (`none` if there is no such cell). -/
def Netlist.initOf (nl : Netlist) (name : String) : Option Nat := (nl.cell? name).map Cell.init

def Netlist.inputNames (nl : Netlist) : List String := nl.inputs.map Prod.fst
def Netlist.outputNames (nl : Netlist) : List String := nl.outputs.map Prod.fst
def Netlist.stateNames (nl : Netlist) : List String := nl.state.map nl.netName
def Netlist.cellNames (nl : Netlist) : List String := nl.cells.map Cell.name

end Formal.Gen
