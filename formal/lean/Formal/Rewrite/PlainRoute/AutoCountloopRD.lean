  fun σ hI h => ⟨o2_1 σ hI h, map_cons_eq (o2_2 σ hI h) (map_cons_eq (o2_3 σ hI h) (map_cons_eq (o2_4 σ hI h) (map_cons_eq (o2_5 σ hI h) (map_cons_eq (o2_6 σ hI h) (rfl))))), rfl⟩

theorem m2 : MatchSem P ρ Is ⟨1, ce0, g2⟩ :=
  matchSem_of (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) o2

/-! ### T1 with C edge 1 (test 0 false) and graph segment 3 -/

theorem o3_1 (σ : List Nat) (hI : List.map (E.eval σ) [] = List.map (E.eval σ) [])
    (h : isT (E.eval σ (.bin (.cmpi .slt) 32 (.var 3) (.var 1))) = false) :
    isT (E.eval σ (.bin (.cmpi .slt) 32 (.var 3) (.var 1))) = false := by
  simp only [E.eval] at h  ⊢
  auto_ops

theorem o3_2 (σ : List Nat) (hI : List.map (E.eval σ) [] = List.map (E.eval σ) [])
    (h : isT (E.eval σ (.bin (.cmpi .slt) 32 (.var 3) (.var 1))) = false) :
    E.eval σ (.var 2) = E.eval σ (.var 2) := rfl

/-- Under T1's invariant and the C outcome, the segment's fact has outcome false, its new environment is ρ of the C's new state, and the target invariant holds. -/
theorem o3 : ∀ σ : List Nat,
    List.map (E.eval σ) [] = List.map (E.eval σ) [] →
    isT (E.eval σ (.bin (.cmpi .slt) 32 (.var 3) (.var 1))) = false →
    isT (E.eval σ (.bin (.cmpi .slt) 32 (.var 3) (.var 1))) = false ∧
    List.map (E.eval σ) [(.var 2)] =
      List.map (E.eval σ) [(.var 2)] ∧
    List.map (E.eval σ) [] = List.map (E.eval σ) [] :=
  fun σ hI h => ⟨o3_1 σ hI h, map_cons_eq (o3_2 σ hI h) (rfl), rfl⟩

theorem m3 : MatchSem P ρ Is ⟨1, ce1, g3⟩ :=
  matchSem_of (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) o3

theorem hM : ∀ m ∈ M, MatchSem P ρ Is m := by
  intro m hm
  simp only [M, List.mem_cons, List.not_mem_nil, or_false] at hm
  rcases hm with rfl | rfl | rfl | rfl
  · exact m0
  · exact m1
  · exact m2
  · exact m3

theorem hin (a₀ n₀ : Nat) : (ρ.getD 0 []).map (E.eval (P.entry.map (E.eval [a₀, n₀]))) = [a₀, n₀] := by
  first | rfl | (simp only [ρ, P, List.getD, List.map, List.cons.injEq, and_true]; auto_ops)

theorem hI0 (a₀ n₀ : Nat) : InvH (Is.getD 0 []) (P.entry.map (E.eval [a₀, n₀])) := by
  first | rfl | (simp only [InvH, Is, P, List.getD, List.map, List.cons.injEq, and_true]; auto_ops)

/-! ## The whole function, on every schedule -/

theorem reach_kC {fuel a₀ n₀ r : Nat} (h : kC fuel a₀ n₀ = some r) :
    Reach (St T0 [a₀, n₀]) (St T2 [r]) :=
  sim_call Tm Reach reach_trans P L K ρ Is 2 GE M hG cover hM (by decide) rfl
    (hin a₀ n₀) (hI0 a₀ n₀) h

theorem cnt_lmap (Q : List Nat) (env : List Nat) (l : List (List E)) :
    cnt Q (ofL (lmap env l)) = (Q.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (a₀ n₀ : Nat) : Formal.Net.GcdHw.Inv spine (St T0 [a₀, n₀]) := by
  unfold Formal.Net.GcdHw.Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (r : Nat) : Terminal (step G) (St T2 [r]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro x hx
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T2)) = true) x hx

/-- Non-vacuity of the hypothesis of `auto_computes`: the transcription returns on (3, 5) (value from autoproof's Python run of this automaton; re-checked here by the kernel). -/
theorem witness : kC 10000 3 5 = some 17 := by decide +kernel

/-- **The imported graph computes the C function `countloop`** (generated proof). -/
theorem auto_computes {fuel a₀ n₀ r : Nat} (h : kC fuel a₀ n₀ = some r) :
    (∃ n, Run (step G) (St T0 [a₀, n₀]) n (St T2 [r])) ∧
    (∀ m t, Run (step G) (St T0 [a₀, n₀]) m t → Terminal (step G) t → t = St T2 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [a₀, n₀]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_kC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv a₀ n₀)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv a₀ n₀)
      hn (final_terminal r) hu

end Formal.Net.AutoCountloopRD
