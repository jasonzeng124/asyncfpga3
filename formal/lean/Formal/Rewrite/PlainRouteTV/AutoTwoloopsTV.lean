/-- **The imported graph computes the C function `twoloops`** (generated proof). -/
theorem auto_computes {fuel a₀ n₀ r : Nat} (h : kC fuel a₀ n₀ = some r) :
    (∃ n, Run (step G) (St T0 [a₀, n₀]) n (St T4 [r])) ∧
    (∀ m t, Run (step G) (St T0 [a₀, n₀]) m t → Terminal (step G) t → t = St T4 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [a₀, n₀]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_kC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv a₀ n₀)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv a₀ n₀)
      hn (final_terminal r) hu

