    Reach (St T0 [a₀, n₀]) (St T4 [r]) :=
  sim_call Tm Reach reach_trans P L K ρ Is 4 GE M hG cover hM (by decide) rfl
    (hin a₀ n₀) (hI0 a₀ n₀) h

theorem cnt_lmap (Q : List Nat) (env : List Nat) (l : List (List E)) :
    cnt Q (ofL (lmap env l)) = (Q.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (a₀ n₀ : Nat) : Formal.Net.GcdHw.Inv spine (St T0 [a₀, n₀]) := by
  unfold Formal.Net.GcdHw.Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (r : Nat) : Terminal (step G) (St T4 [r]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro x hx
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T4)) = true) x hx

