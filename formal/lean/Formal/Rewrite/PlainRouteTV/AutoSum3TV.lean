    E.eval σ (.var 1) = E.eval σ (.var 1) := rfl

theorem o2_3 (σ : List Nat) (hI : List.map (E.eval σ) [] = List.map (E.eval σ) [])
    (h : isT (E.eval σ (.bin (.cmpi .slt) 32 (.var 4) (.var 2))) = true) :
    E.eval σ (.bin .addi 32 (.var 2) (.lit 4294967295)) = E.eval σ (.bin .addi 32 (.var 2) (.lit 4294967295)) := rfl

theorem o2_4 (σ : List Nat) (hI : List.map (E.eval σ) [] = List.map (E.eval σ) [])
    (h : isT (E.eval σ (.bin (.cmpi .slt) 32 (.var 4) (.var 2))) = true) :
    E.eval σ (.bin .addi 32 (.bin .xori 32 (.var 3) (.var 1)) (.var 4)) = E.eval σ (.bin .addi 32 (.bin .xori 32 (.var 3) (.var 1)) (.var 4)) := rfl

theorem o2_5 (σ : List Nat) (hI : List.map (E.eval σ) [] = List.map (E.eval σ) [])
    (h : isT (E.eval σ (.bin (.cmpi .slt) 32 (.var 4) (.var 2))) = true) :
