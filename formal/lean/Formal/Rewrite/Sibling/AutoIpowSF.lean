macro "auto_ops2_pre" : tactic => `(tactic| (
  try simp only [E.eval, BOp.ev, UOp.ev, Ops.addi, Ops.subi, Ops.muli, Ops.andi, Ops.ori,
    Ops.xori, Ops.shli, Ops.shrui, Ops.trunci, Ops.extui, Nat.shiftLeft_eq,
