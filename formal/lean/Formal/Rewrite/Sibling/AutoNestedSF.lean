    Reach (Tm g.src env) (Tm g.dst (g.sig.map (E.eval env))) := by
  intro g hg env hf
  simp only [GE, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact edge (Ti := T0) (Tj := T1) lenT0 seg0 env (fact1 hf)
  · exact edge (Ti := T0) (Tj := T2) lenT0 seg1 env (fact1 hf)
  · exact edge (Ti := T1) (Tj := T3) lenT1 seg2 env (fact1 hf)
  · exact edge (Ti := T1) (Tj := T4) lenT1 seg3 env (fact1 hf)
  · exact edge (Ti := T3) (Tj := T3) lenT3 seg4 env (fact1 hf)
  · exact edge (Ti := T3) (Tj := T4) lenT3 seg5 env (fact1 hf)
  · exact edge (Ti := T4) (Tj := T1) lenT4 seg6 env (fact1 hf)
  · exact edge (Ti := T4) (Tj := T2) lenT4 seg7 env (fact1 hf)

