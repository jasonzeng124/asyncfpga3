    (by decide +kernel) (by decide +kernel) (map_cons_eq rfl (map_cons_eq rfl (map_cons_eq (o6_5 σ hI h) (rfl))))
    (o6_6 (List.map (E.eval σ) [(.var 0), (.var 1), (.bin .addi 32 (.var 0) (.lit 4294967295))])
      (tr_hyp (by decide +kernel) (by decide +kernel) hI) (tr_isT (by decide +kernel) h) (abs_lt (j := 2) (o := .addi) (w := 32) (a := (.var 0)) (b := (.lit 4294967295)) (by decide +kernel) (by decide)))

/-- Under T3's invariant and the C outcome, the segment's fact has outcome true, its new environment is ρ of the C's new state, and the target invariant holds. -/
theorem o6 : ∀ σ : List Nat,
    List.map (E.eval σ) [] = List.map (E.eval σ) [] →
    isT (E.eval σ (.bin (.cmpi .sgt) 32 (.var 0) (.lit 0))) = true →
    isT (E.eval σ (.bin (.cmpi .sgt) 32 (.var 0) (.lit 0))) = true ∧
    List.map (E.eval σ) [(.un .trunci 32 (.bin .shrui 65 (.bin .addi 65 (.bin .addi 65 (.bin .muli 32 (.var 1) (.var 0)) (.bin .shli 65 (.bin (.cmpi .sgt) 32 (.bin .addi 32 (.var 0) (.lit 4294967295)) (.lit 0)) (.lit 32))) (.bin .shli 65 (.bin .addi 32 (.var 0) (.lit 4294967295)) (.lit 33))) (.lit 0))), (.un .trunci 32 (.bin .shrui 65 (.bin .addi 65 (.bin .addi 65 (.bin .muli 32 (.var 1) (.var 0)) (.bin .shli 65 (.bin (.cmpi .sgt) 32 (.bin .addi 32 (.var 0) (.lit 4294967295)) (.lit 0)) (.lit 32))) (.bin .shli 65 (.bin .addi 32 (.var 0) (.lit 4294967295)) (.lit 33))) (.lit 33))), (.un .trunci 1 (.bin .shrui 65 (.bin .addi 65 (.bin .addi 65 (.bin .muli 32 (.var 1) (.var 0)) (.bin .shli 65 (.bin (.cmpi .sgt) 32 (.bin .addi 32 (.var 0) (.lit 4294967295)) (.lit 0)) (.lit 32))) (.bin .shli 65 (.bin .addi 32 (.var 0) (.lit 4294967295)) (.lit 33))) (.lit 32)))] =
      List.map (E.eval σ) [(.bin .muli 32 (.var 1) (.var 0)), (.bin .subi 32 (.var 0) (.lit 1)), (.bin (.cmpi .sgt) 32 (.bin .subi 32 (.var 0) (.lit 1)) (.lit 0))] ∧
    List.map (E.eval σ) [] = List.map (E.eval σ) [] :=
  fun σ hI h => ⟨o6_1 σ hI h, map_cons_eq (o6_2 σ hI h) (map_cons_eq (o6_3 σ hI h) (map_cons_eq (o6_4 σ hI h) (rfl))), rfl⟩

theorem m6 : MatchSem P ρ Is ⟨3, ce2, g6⟩ :=
  matchSem_of (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) o6

