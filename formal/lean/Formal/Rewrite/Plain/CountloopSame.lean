import Formal.Rewrite.Plain.CountloopOrig
import Formal.Rewrite.Plain.CountloopPlain

/-!
# Formal.Rewrite.Plain.CountloopSame — the PLAIN loop-test rewrite of countloop computes the same function (shard A, 2026-11-18)

**Problem, plainly.** The corrected rewrite (A19) is slower (A20). The fast form tests `slt(i, n - 1)` with no
correction, which is exact only under the loop's own invariant. Does `formal/tools-A/rewrite/out/countloop_plain.mlir`
(ring_dec.py --plain on research's fixture, md5 d562c024) compute the same as the fixture?

**Proved** (`same`): for every input `(a, n)` and fuel on which the C (`kernels/countloop/countloop.c`, cfront's
transcription, identical in both files) returns `r`, every complete run of EITHER graph, under any schedule, ends
with `[r]` on the output, and both have a complete run. The graphs: dfimport of the fixture (`CountloopOrig`) and of
the plain rewrite (`CountloopPlain`); both proofs generated by `tools-A/rewrite/autoproof_x.py` (C's autoproof plus
`v ± 1` candidates and signed-inequality invariants; here it found the ring value `n - 1` and `sle(i, n)`,
`1 ≤ n`, `1 ≤ i` in the loop) and checked by Lean.

**Not covered:** inputs on which the C does not return (it always does for countloop, but `kC` totality is not proved
here); token level only.
-/

namespace Formal.Rewrite.Plain.CountloopSame

open Formal.Net.Kahn Formal.Net.GcdHw

theorem kC_eq (fuel a n : Nat) :
    Formal.Net.AutoApClPlain.kC fuel a n = Formal.Net.AutoApClorig.kC fuel a n := rfl

theorem same {fuel a n r : Nat} (h : Formal.Net.AutoApClorig.kC fuel a n = some r) :
    ((∃ k, Run (step Formal.Net.AutoApClorig.G) (Formal.Net.AutoApClorig.St Formal.Rewrite.ApClorigHw.T0 [a, n]) k
        (Formal.Net.AutoApClorig.St Formal.Rewrite.ApClorigHw.T2 [r])) ∧
      ∀ m t, Run (step Formal.Net.AutoApClorig.G) (Formal.Net.AutoApClorig.St Formal.Rewrite.ApClorigHw.T0 [a, n]) m t →
        Terminal (step Formal.Net.AutoApClorig.G) t → t = Formal.Net.AutoApClorig.St Formal.Rewrite.ApClorigHw.T2 [r]) ∧
    ((∃ k, Run (step Formal.Net.AutoApClPlain.G) (Formal.Net.AutoApClPlain.St Formal.Rewrite.ApClPlainHw.T0 [a, n]) k
        (Formal.Net.AutoApClPlain.St Formal.Rewrite.ApClPlainHw.T2 [r])) ∧
      ∀ m t, Run (step Formal.Net.AutoApClPlain.G) (Formal.Net.AutoApClPlain.St Formal.Rewrite.ApClPlainHw.T0 [a, n]) m t →
        Terminal (step Formal.Net.AutoApClPlain.G) t → t = Formal.Net.AutoApClPlain.St Formal.Rewrite.ApClPlainHw.T2 [r]) := by
  have h1 := Formal.Net.AutoApClorig.auto_computes h
  have h2 := Formal.Net.AutoApClPlain.auto_computes (by rw [kC_eq]; exact h)
  exact ⟨⟨h1.1, h1.2.1⟩, ⟨h2.1, h2.2.1⟩⟩

end Formal.Rewrite.Plain.CountloopSame
