import Formal.Rewrite.Ring.Quadrec
import Formal.Rewrite.ChanInv
import Formal.Rewrite.Swap
import Formal.Rewrite.PlainArith

/-!
# Formal.Rewrite.Plain.QuadrecPlainGen — the PLAIN loop test on quadrec, from the graph alone (shard A, 2026-11-18; GENERATED by formal/tools-A/rewrite/gen_plain_gen.py from CountloopPlainGen)

**Problem, plainly.** The plain test `slt(i, n - 1)` (no correction) is the fast one (FOR-RESEARCH A21), but it is
exact only because of the loop: the counter never reaches INT_MAX at the test and `n - 1` is never INT_MAX. Can that be
proved from the dataflow graph itself, without the C source (as `CountloopPlainGen` does for countloop)?

**Proved** (`plain_forward`, `plain_backward`): with `rules` = dfimport of research's quadrec fixture and `rs2p` =
the ring rewrite plus the moved, PLAIN test (`rs2` of Ring.Quadrec with the test `slt(i, m)`), from any store that
holds tokens only on the three argument channels: every complete run of `rules` is matched by a complete run of `rs2p`
ending in the same store outside the changed channels, and vice versa. How: `same_forward`/`same_backward` (corrected
form, any-graph theorems) + a reachable-state channel invariant of `rs2` (ChanInv: counter channels `NotMax`, ring
channels `NotMax`, the ring entry `NotMin`; two branch pairs: the loop guard `n > 0` and the loop test) + `Swap` (the
corrected and plain tests agree on every input satisfying it).

**Not covered:** token level only; the tie of `rs2p` to `out/quadrec_plain.mlir` is `QuadrecPlainTie` (Rename).
-/

namespace Formal.Rewrite.Plain.QuadrecPlainGen

open Formal.Net.Kahn Formal.Net.GcdHw Formal.Rewrite.IncCmp Formal.Rewrite.Ring.Quadrec
open Formal.Rewrite.ChanInv Formal.Rewrite.Ring.QuadrecHw

/-- The plain graph: `rs2` with the loop test `slt(i, m)`. -/
def rs2p : List Rule := rs2.set 43 (.comp [111, 73] 81 fSlt)

/-- Channel classes: 1 = never INT_MAX, 2 = never INT_MIN, 0 = unconstrained. -/
def cls (ch : Nat) : Nat :=
  if ch ∈ [25, 49, 50, 70, 71, 72, 73, 109, 111] then 1 else if ch = 44 then 2 else 0

def Q (ch v : Nat) : Prop := if cls ch = 1 then NotMax v else if cls ch = 2 then NotMin v else True

theorem Q_cls {a b : Nat} (h : cls a = cls b) (v : Nat) (hv : Q a v) : Q b v := by
  unfold Q at *; rw [← h]; exact hv

theorem Q_zero {a : Nat} (h : cls a = 0) (v : Nat) : Q a v := by
  unfold Q; rw [h]; simp

/-- A sufficient, decidable safety check for the rules whose outputs are unconstrained or copy their input's class. -/
def safeB : Rule → Bool
  | .fork i os => os.all (fun o => cls o == 0 || cls o == cls i)
  | .mux _ ds o _ => cls o == 0 || ds.all (fun d => cls d == cls o)
  | .branch _ d t f => (cls t == 0 || cls t == cls d) && (cls f == 0 || cls f == cls d)
  | .comp _ o _ => cls o == 0
  | .cm _ res idx _ => cls res == 0 && cls idx == 0
  | .sink _ => true

theorem safeB_ok (r : Rule) (h : safeB r = true) : RuleSafe Q r := by
  cases r with
  | fork i os =>
    refine fork_safe (fun o ho v hv => ?_)
    simp only [safeB, List.all_eq_true, Bool.or_eq_true, beq_iff_eq] at h
    rcases h o ho with h0 | h1
    · exact Q_zero h0 v
    · exact Q_cls h1.symm v hv
  | mux s ds o iw =>
    refine mux_safe (fun d hd v hv => ?_)
    simp only [safeB, Bool.or_eq_true, beq_iff_eq, List.all_eq_true] at h
    rcases h with h0 | h1
    · exact Q_zero h0 v
    · exact Q_cls (h1 d hd) v hv
  | branch c d t f =>
    refine branch_safe (fun v hv => ⟨?_, ?_⟩)
    all_goals simp only [safeB, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at h
    · rcases h.1 with h0 | h1
      · exact Q_zero h0 v
      · exact Q_cls h1.symm v hv
    · rcases h.2 with h0 | h1
      · exact Q_zero h0 v
      · exact Q_cls h1.symm v hv
  | comp ins o e =>
    simp only [safeB, beq_iff_eq] at h
    exact comp_safe_triv (fun v => Q_zero h v)
  | cm i res idx k =>
    simp only [safeB, Bool.and_eq_true, beq_iff_eq] at h
    exact cm_safe (fun v _ => Q_zero h.1 v) (Q_zero h.2 k)
  | sink i => exact sink_safe

theorem len_rs2p : rs2p.length = 66 := by decide +kernel

/-- The two branch pairs of `rs2`: the loop guard `n > 0` (cond_br4) and the loop test (cond_br6). -/
def pGuard : Pair where
  lF := 1
  lA := 0
  lC := 4
  lK := 5
  lB := 24
  e := 1
  d0 := 10
  d := 10
  x := 11
  c := 14
  cb := 19
  k := 12
  t := 44
  f := 45
  os := [15, 16, 17, 18, 19, 20, 21]
  hasA := false
  fA := E.var 0
  F := E.bin (BOp.cmpi Pred.sgt) 32 (E.var 0) (E.var 1)

def pTest : Pair where
  lF := 41
  lA := 42
  lC := 43
  lK := 44
  lB := 45
  e := 50
  d0 := 110
  d := 79
  x := 111
  c := 81
  cb := 88
  k := 73
  t := 49
  f := 89
  os := [82, 83, 84, 85, 86, 87, 88]
  hasA := true
  fA := fInc
  F := fSltXor

def privB (p : Pair) (l : Nat) (r : Rule) : Bool :=
  l == p.lF || (p.hasA && l == p.lA) || l == p.lC || l == p.lK || l == p.lB ||
  (r.insL ++ r.outsL).all (fun ch => !decide (ch ∈ [p.d0, p.d, p.x, p.c, p.cb]))

theorem priv_of (p : Pair) (h : (List.range rs2.length).all
    (fun l => match rs2[l]? with | some r => privB p l r | none => true) = true) :
    ∀ l r, rs2[l]? = some r → l ≠ p.lF → (p.hasA = true → l ≠ p.lA) → l ≠ p.lC → l ≠ p.lK → l ≠ p.lB →
      ∀ ch, ch ∈ r.insL ∨ ch ∈ r.outsL → ch ≠ p.d0 ∧ ch ≠ p.d ∧ ch ≠ p.x ∧ ch ≠ p.c ∧ ch ≠ p.cb := by
  intro l r hr h1 h2 h3 h4 h5 ch hch
  have := of_check (rs := rs2) (privB p) h l r hr
  simp only [privB, Bool.or_eq_true, beq_iff_eq, Bool.and_eq_true, List.all_eq_true, h1, h3, h4, h5,
    false_or, or_false] at this
  rcases this with ⟨hA, hl⟩ | hall
  · exact absurd hl (h2 hA)
  · have := hall ch (List.mem_append.mpr hch)
    simp only [Bool.not_eq_true', decide_eq_false_iff_not, List.mem_cons, List.not_mem_nil, or_false,
      not_or] at this
    exact ⟨this.1, this.2.1, this.2.2.1, this.2.2.2.1, this.2.2.2.2⟩

theorem okGuard : PairOK rs2 Q pGuard where
  hF := by decide +kernel
  hA := by intro h; cases h
  hA0 := fun _ => rfl
  hC := by decide +kernel
  hK := by decide +kernel
  hcb := by decide
  hos := by decide
  hB := by decide +kernel
  hnd := by decide
  hnd0 := by intro h; cases h
  priv := priv_of pGuard (by decide +kernel)
  hP := by
    intro v w h
    change E.eval [v, w] (E.bin (BOp.cmpi Pred.sgt) 32 (E.var 0) (E.var 1)) % 2 = 1 at h
    change Q 44 v
    simp only [E.eval, BOp.ev, List.getD_cons_zero, List.getD_cons_succ] at h
    simp only [Q, cls]; simp
    exact sgt_true v w h
  hfalse := by intro v; exact Q_zero (by decide) v

theorem okTest : PairOK rs2 Q pTest where
  hF := by decide +kernel
  hA := by intro _; decide +kernel
  hA0 := by intro h; cases h
  hC := by decide +kernel
  hK := by decide +kernel
  hcb := by decide
  hos := by decide
  hB := by decide +kernel
  hnd := by decide
  hnd0 := by intro _; decide
  priv := priv_of pTest (by decide +kernel)
  hP := by
    intro v w h
    change fSltXor.eval [v, w] % 2 = 1 at h
    change Q 49 (fInc.eval [v])
    simp only [Q, cls]; simp
    exact test_true_inc v w h
  hfalse := by intro v; exact Q_zero (by decide) v

theorem safe_all : ∀ l r, rs2[l]? = some r → (∀ p ∈ [pGuard, pTest], l ≠ p.lB) → RuleSafe Q r := by
  intro l r hr hl
  by_cases l8 : l = 9
  · subst l8
    have : r = .comp [23] 25 (.un .extui 1 (.var 0)) := by
      have h := hr; rw [show rs2[9]? = some (.comp [23] 25 (.un .extui 1 (.var 0))) by decide +kernel] at h
      exact (Option.some.inj h).symm
    subst this
    refine comp1_safe (fun v _ => ?_)
    simp only [Q, cls]; simp only [E.eval, UOp.ev, List.getD_cons_zero]; simp
    exact extui_notmax v
  by_cases l42 : l = 65
  · subst l42
    have : r = .comp [44] 109 gDec := by
      have h := hr; rw [show rs2[65]? = some (.comp [44] 109 gDec) by decide +kernel] at h
      exact (Option.some.inj h).symm
    subst this
    refine comp1_safe (fun v hv => ?_)
    simp only [Q, cls] at hv ⊢; simp at hv ⊢
    exact dec_notmax v hv
  have hB := of_check (rs := rs2) (fun l r => l == 9 || l == 65 || l == 24 || l == 45 || safeB r)
    (by decide +kernel) l r hr
  simp only [Bool.or_eq_true, beq_iff_eq, l8, l42, false_or] at hB
  have h12 : l ≠ 24 := hl pGuard (by simp)
  have h30 : l ≠ 45 := hl pTest (by simp)
  simp only [h12, h30, false_or] at hB
  exact safeB_ok r hB

/-- The channel invariant holds at every store reachable in `rs2` from a store with tokens only on the arguments. -/
theorem inv_rs2 {σ0 : Store Nat Nat} (h0 : ∀ ch, ch ≠ 0 → ch ≠ 1 → ch ≠ 2 → σ0 ch = []) :
    ∀ m s, Run (step (graph rs2)) σ0 m s → SInvS Q s := by
  intro m s hr
  have hS : SInv Q σ0 := by
    intro ch v hv
    by_cases a : ch = 0
    · subst a; exact Q_zero (by decide) v
    by_cases b : ch = 1
    · subst b; exact Q_zero (by decide) v
    by_cases c : ch = 2
    · subst c; exact Q_zero (by decide) v
    rw [h0 ch a b c] at hv; cases hv
  have := chan_inv safe_all (by
      intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl
      · exact okGuard
      · exact okTest) hS (by
      intro p hp; simp only [List.mem_cons, List.not_mem_nil, or_false] at hp
      rcases hp with rfl | rfl <;> simp [pGuard, pTest, h0]) hr
  exact this.1

theorem agree (a b : Nat) (ha : Q 111 a) (hb : Q 73 b) : fSltXor.eval [a, b] = fSlt.eval [a, b] := by
  simp only [Q, cls] at ha hb; simp at ha hb
  exact xor_eq_plain a b ha hb

theorem hC2 : rs2[43]? = some (.comp [111, 73] 81 fSltXor) := by decide +kernel
theorem hC2p : rs2p[43]? = some (.comp [111, 73] 81 fSlt) := by decide +kernel
theorem hsame2 : ∀ l, l ≠ 43 → rs2p[l]? = rs2[l]? := by
  intro l hl; simp only [rs2p]; rw [List.getElem?_set_ne (by omega)]

theorem plain_forward {σ0 t : Store Nat Nat} {n : Nat} (h0 : ∀ ch, ch ≠ 0 → ch ≠ 1 → ch ≠ 2 → σ0 ch = [])
    (hr : Run (step (graph rules)) σ0 n t) (ht : Terminal (step (graph rules)) t) :
    ∃ t' m, Run (step (graph rs2p)) σ0 m t' ∧ Terminal (step (graph rs2p)) t' ∧
      ∀ ch, ch ∉ changed → t' ch = t ch := by
  obtain ⟨t2, m, r2, ht2, o2⟩ := same_forward (fun ch hc => h0 ch (by simp [changed] at hc; omega)
    (by simp [changed] at hc; omega) (by simp [changed] at hc; omega)) hr ht
  have hinv := inv_rs2 h0
  exact ⟨t2, m, swap_run hC2 hC2p hsame2 agree hinv r2,
    (swap_terminal hC2 hC2p hsame2 agree (hinv m t2 r2)).mpr ht2, o2⟩

theorem plain_backward {σ0 t' : Store Nat Nat} {n : Nat} (h0 : ∀ ch, ch ≠ 0 → ch ≠ 1 → ch ≠ 2 → σ0 ch = [])
    (hr : Run (step (graph rs2p)) σ0 n t') (ht : Terminal (step (graph rs2p)) t') :
    ∃ t m, Run (step (graph rules)) σ0 m t ∧ Terminal (step (graph rules)) t ∧
      ∀ ch, ch ∉ changed → t ch = t' ch := by
  have hinv := inv_rs2 h0
  have r2 := swap_run_back hC2 hC2p hsame2 agree hinv hr
  have ht2 := (swap_terminal hC2 hC2p hsame2 agree (hinv n t' r2)).mp ht
  exact same_backward (fun ch hc => h0 ch (by simp [changed] at hc; omega)
    (by simp [changed] at hc; omega) (by simp [changed] at hc; omega)) r2 ht2

end Formal.Rewrite.Plain.QuadrecPlainGen
