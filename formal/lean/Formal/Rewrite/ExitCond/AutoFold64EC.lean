theorem auto_computes {fuel v₀ r : Nat} (h : kC fuel v₀ = some r) :
    (∃ n, Run (step G) (St T0 [v₀]) n (St T2 [r])) ∧
    (∀ m t, Run (step G) (St T0 [v₀]) m t → Terminal (step G) t → t = St T2 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [v₀]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_kC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv v₀)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv v₀)
      hn (final_terminal r) hu

