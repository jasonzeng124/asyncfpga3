/-- **`bdc_amerge3_0` (two cascaded `bd_arbiter`s) is a correct 3-input
control_merge (speed independent, under named hypotheses).** In every state
reachable from reset, with unbounded delays on every gate output of both
arbiters and of the wrapper and on the three `g2 -> index` fork branches,
under H_RT1 (both arbiters), H_RT2 (arbiter 2), H_RT2_CASCADE (arbiter 1,
served by arbiter 2's `ua1`), H_BUNDLED_IDX, H_IDX_ACK_FORK, H_DELAY_BUF, the
isochrony listed in `AMerge3`'s module doc and H_ARB_RESOLVED (`q1`, `q2`
Boolean):
* `spec`: each output transaction carries exactly one input token, the one
  the two arbiter states name; only that client is acknowledged, once, after
  the server acknowledged its token (no token lost or duplicated through the
  cascade);
* `persist`: no gate or control wire other than the two decision nodes and
  the index data cone has its excitation withdrawn;
* `live`: while a client waits and the others are at rest, some circuit or
  server step is allowed (no stranded token, no deadlock in the cascade);
* `good`: exclusion: neither arbiter ever has both grants high; and in the
  broad window the 2-bit index names the owner (client 0 -> 0, 1 -> 1,
  2 -> 2; never 3). -/
theorem amerge3_ok {s} (h : (sys gI hOK).Reach s) : Sys.Props (sys gI hOK) s := by
  rw [gI_eq_gE] at h ⊢; exact (Sys.sound amerge3_check h).2

/-- Not vacuous: each client wins and is served with its own index: client 0
through both arbiters (`index = 00`), client 1 through both arbiters
(`index = 01`), client 2 at arbiter 2 (`index = 10`). -/
theorem amerge3_serves :
    (∃ s, (sys gI hOK).Reach s ∧ tb s 19 = true ∧ tb s 7 = true ∧ tb s 15 = false ∧ tb s 16 = false) ∧
    (∃ s, (sys gI hOK).Reach s ∧ tb s 19 = true ∧ tb s 8 = true ∧ tb s 15 = true ∧ tb s 16 = false) ∧
    (∃ s, (sys gI hOK).Reach s ∧ tb s 19 = true ∧ tb s 14 = true ∧ tb s 16 = true) :=
  ⟨⟨42740913, Sys.run_reach [0, 4, 5, 10, 11, 18, 19, 13, 7] Sys.Reach.init
      (by decide +kernel), by decide⟩,
   ⟨85765466, Sys.run_reach [1, 3, 4, 6, 10, 11, 20, 15, 18, 19, 13, 8] Sys.Reach.init
      (by decide +kernel), by decide⟩,
   ⟨166548996, Sys.run_reach [2, 9, 10, 12, 21, 22, 16, 18, 19, 14] Sys.Reach.init
      (by decide +kernel), by decide⟩⟩

/-! ## Each hypothesis is needed (kernel-checked runs) -/

/-- **Without H_RT1** arbiter 2's grants overlap: client 0 is served through
the cascade and leaves; client 2 waits; `z_ack` falls, `q2` flips and `g22`
rises while `g12`'s fall is still pending. -/
theorem amerge3_needs_rt1 :
    ∃ s, (sys gI ⟨false, true, true, true, false⟩).Reach s ∧ good s = false :=
  ⟨33569444, Sys.run_reach [0, 2, 4, 5, 10, 11, 18, 19, 13, 7, 0, 4, 10, 18, 19, 9, 12]
    Sys.Reach.init (by decide +kernel), by decide⟩

/-- **Without H_RT2 (arbiter 2)** the next `z_ack` rise withdraws the fall of
`acc1_ack` (`uarb2.ua1`), the previous arbiter-1 transaction's acknowledge. -/
theorem amerge3_needs_rt2 :
    ∃ s, (sys gI ⟨true, false, true, true, false⟩).Reach s ∧
      (sys gI ⟨true, false, true, true, false⟩).can s 19 = true ∧
      exv gI ⟨true, false, true, true, false⟩ s 13 = true ∧
      exv gI ⟨true, false, true, true, false⟩ (fire s 19) 13 = false :=
  ⟨65353380, Sys.run_reach [0, 2, 4, 5, 10, 11, 18, 19, 13, 7, 0, 4, 10, 11, 18, 19, 9, 10, 12,
      21, 22, 16, 18] Sys.Reach.init (by decide +kernel),
    by decide +kernel, by decide +kernel, by decide +kernel⟩

/-- **Without H_RT2_CASCADE** (the new obligation of the cascade): client 0
is served through both arbiters; client 1 waits at arbiter 1; on the next
round arbiter 2 acknowledges arbiter 1 again (`acc1_ack` rises) while
arbiter 1's previous acknowledge `in0_ack` is still excited to fall: the
fall is withdrawn (a runt on `in0_ack`). -/
theorem amerge3_needs_rt2_cascade :
    ∃ s, (sys gI ⟨true, true, false, true, false⟩).Reach s ∧
      (sys gI ⟨true, true, false, true, false⟩).can s 13 = true ∧
      exv gI ⟨true, true, false, true, false⟩ s 7 = true ∧
      exv gI ⟨true, true, false, true, false⟩ (fire s 13) 7 = false :=
  ⟨119311578, Sys.run_reach [0, 1, 4, 5, 10, 11, 18, 19, 13, 7, 0, 4, 5, 10, 11, 18, 19, 13, 3,
      4, 6, 10, 11, 20, 15, 18, 19] Sys.Reach.init (by decide +kernel),
    by decide +kernel, by decide +kernel, by decide +kernel⟩

/-- **Without H_BUNDLED_IDX** client 2 wins and `z_req` rises before the
index LUTs have seen `g22`: the consumer samples index 0. -/
theorem amerge3_needs_bundled_idx :
    ∃ s, (sys gI ⟨true, true, true, false, false⟩).Reach s ∧ good s = false :=
  ⟨25429508, Sys.run_reach [2, 9, 10, 18] Sys.Reach.init (by decide +kernel), by decide⟩

