/-- **`bdc_muxn3_32` is a correct 3-way loop-header mux (speed independent,
the N = 3 generalisation of `MergeMuxSI.mux_ok`).** In every state reachable
from reset, with unbounded delays on every gate (the three inferred decode
LUT3s, the three joins, the `|j` LUT3, the delay line, the three acknowledge
C-elements) and on the three `j -> ua` fork branches, under H_CTL_HOLD,
H_MUX_RTZ, H_S_RANGE, H_DELAY_BUF and the isochronic forks
`ctl_req -> sel*`, `z_ack -> {ua*, ctl}` and `s -> {sel*, data}` (H_S_PIN):
* `spec`: one output transaction per control token, carrying the token of
  the input `s` selects; only that input is acknowledged, once, after the
  server acknowledged it; the other two inputs' tokens are untouched;
* `persist`: no gate or wire (decodes included) ever has its excitation
  withdrawn;
* `live`: with a control token and the selected input's token present (or a
  transaction returning to zero), some circuit/server step is allowed;
* `good`: the three joins are one-hot (so the `|j` LUT sees at most one
  moving input), and in the broad window `s` names the owner (the data LUTs
  select the owner's data). -/
theorem muxn3_ok {s} (h : (sys gI hOK).Reach s) : Sys.Props (sys gI hOK) s := by
  rw [gI_eq_gE] at h ⊢; exact (Sys.sound muxn3_check h).2

/-- Not vacuous: each input is selected and served; and input 2 is served
while inputs 0 and 1 hold requests that stay unacknowledged. -/
theorem muxn3_serves :
    (∃ s, (sys gI hOK).Reach s ∧ tb s 15 = true ∧ tb s 16 = true) ∧
    (∃ s, (sys gI hOK).Reach s ∧ tb s 15 = true ∧ tb s 17 = true) ∧
    (∃ s, (sys gI hOK).Reach s ∧ tb s 15 = true ∧ tb s 18 = true ∧
      tb s 0 = true ∧ tb s 1 = true ∧ tb s 16 = false ∧ tb s 17 = false) :=
  ⟨⟨155832905, Sys.run_reach [0, 3, 6, 9, 12, 14, 15, 19, 16] Sys.Reach.init
      (by decide +kernel), by decide⟩,
   ⟨177394842, Sys.run_reach [1, 4, 3, 7, 10, 12, 14, 15, 20, 17] Sys.Reach.init
      (by decide +kernel), by decide⟩,
   ⟨216324399, Sys.run_reach [0, 1, 2, 5, 3, 8, 11, 12, 14, 15, 21, 18] Sys.Reach.init
      (by decide +kernel), by decide⟩⟩

/-- **Without H_CTL_HOLD** the index may move while `ctl_req` is high: from
reset (`s = 0`), the control token arrives (`ctl_req` rises, decode 0 is
excited), then `s0` flips: decode 0's excitation is withdrawn (a runt on
`sel[0]` into `uj0`; with a requesting input 0 it can half-fire the join). -/
theorem muxn3_needs_hold :
    ∃ s, (sys gI ⟨false, true, false⟩).Reach s ∧
      (sys gI ⟨false, true, false⟩).can s 4 = true ∧
      exv gI ⟨false, true, false⟩ s 6 = true ∧
      exv gI ⟨false, true, false⟩ (fire s 4) 6 = false :=
  ⟨8, Sys.run_reach [3] Sys.Reach.init (by decide +kernel), by decide +kernel,
    by decide +kernel, by decide +kernel⟩

/-- **Without H_MUX_RTZ** (as for `bd_mux`, `MergeMuxSI.mux_needs_rtz`): the
input-0 transaction completes up to `z_ack` falling, `in0_ack` is excited to
fall; a new control token selects input 1, whose join fires, and the server
raises `z_ack` again before `ua0` has fallen: its fall is withdrawn. -/
theorem muxn3_needs_rtz :
    ∃ s, (sys gI ⟨true, false, false⟩).Reach s ∧
      (sys gI ⟨true, false, false⟩).can s 15 = true ∧
      exv gI ⟨true, false, false⟩ s 16 = true ∧
      exv gI ⟨true, false, false⟩ (fire s 15) 16 = false :=
  ⟨159470746, Sys.run_reach [0, 1, 3, 6, 9, 12, 14, 15, 3, 6, 19, 16, 0, 9, 12, 14, 15, 4, 3, 7,
      10, 12, 14, 19] Sys.Reach.init (by decide +kernel),
    by decide +kernel, by decide +kernel, by decide +kernel⟩

