import Formal.Target.Spec

/-!
# Formal.Cells.Ua1Static — the ua1 margin, from the decoded arcs, at Spec's own window ends

Shard B, THE goal, S3. The simulated counterexample (JOURNAL-B 2026-11-01; `tools-B/target/out/
cex_ua1_README.md`) needs arbiter 0's acknowledge C-element ua1 (`SLICE_X2Y18.DLUT.O6`) to see its set
condition for less than its own feedback loop. Its tightest forcing episode is ended by a causal path from
ua1's own output (client controller, ugrant's g, back to ua1's pin A5; 17 arcs) and its loop is the 6-hop
route plus pin A1 (7 arcs).

## Problem, plainly
With every delay inside Spec's `Adm` window (g = 1, corner 1/2), can that path be faster than the loop?

## Results (decided on the generated arc data, integer ps as Spec's delays are)
* `ua1_holds_at_015`: at κ = 0.15 the path's smallest admissible total (each arc at the ceiling of its
  window's lower end) is at least the loop's largest (each at the floor of its upper end): fb_switch's
  timing premise holds for this episode whatever the delays.
* `ua1_fails_at_016`: at κ = 0.16 the path's smallest total is below the loop's largest: the premise can be
  violated by admissible delays (the simulation shows it is, and that ua1 then oscillates).
The simulated threshold (0.155/0.159 at this corner, with the same per-pin choice) agrees.

## Not covered
The arcs are GENERATED data (tools-B/target/ua1arcs.py from the lean2json rebuild of
`Formal/Target/Net`), not yet linked by an equality to `Formal.Target.Decoded.net`; that the episode is
exactly this path (causality, a network fact); anything about the dynamics (the oscillation itself is
simulation; SpecFb.fb_runt_oscillates is its generic Lean form).
-/

namespace Formal.Cells.Ua1Static

open Formal.Target

/-- GENERATED by tools-B/target/ua1arcs.py from the decoded target (lean2json output): the arcs of the
causal path that ends ua1's tightest forcing episode (ua1 output -> client -> ugrant g -> ua1 pin A5),
and of ua1's feedback loop (route + pin A1), as Spec `Arc`s. -/
def ua1Path : List Arc := [⟨0, 0, 0, 0⟩, ⟨38, 47, 114, 138⟩, ⟨33, 60, 111, 153⟩, ⟨0, 0, 0, 0⟩, ⟨0, 0, 0, 0⟩, ⟨83, 104, 202, 250⟩, ⟨0, 0, 0, 0⟩, ⟨38, 47, 114, 138⟩, ⟨34, 51, 103, 133⟩, ⟨0, 0, 0, 0⟩, ⟨0, 0, 0, 0⟩, ⟨217, 270, 516, 640⟩, ⟨0, 0, 0, 0⟩, ⟨38, 47, 114, 138⟩, ⟨0, 0, 0, 0⟩, ⟨0, 0, 0, 0⟩, ⟨78, 98, 191, 237⟩]
def ua1Loop : List Arc := [⟨0, 0, 0, 0⟩, ⟨38, 47, 114, 138⟩, ⟨36, 53, 103, 133⟩, ⟨33, 51, 113, 147⟩, ⟨0, 0, 0, 0⟩, ⟨0, 0, 0, 0⟩, ⟨219, 272, 521, 646⟩]

/-- Smallest admissible integer delay of an arc (Spec `Adm`, guard g, scatter κ, corner c). -/
def lo (g κ c : ℚ) (e : Arc) : Int :=
  Rat.ceil (max ((1 - κ) * lerp e.fmin e.smin c) ((e.fmin : ℚ) / g))

/-- Largest admissible integer delay of an arc. -/
def hi (g κ c : ℚ) (e : Arc) : Int :=
  Rat.floor (min ((1 + κ) * lerp e.fmax e.smax c) ((e.smax : ℚ) * g))

def pathLo (g κ c : ℚ) : Int := (ua1Path.map (lo g κ c)).sum
def loopHi (g κ c : ℚ) : Int := (ua1Loop.map (hi g κ c)).sum

theorem ua1_holds_at_015 : loopHi 1 (15/100) (1/2) ≤ pathLo 1 (15/100) (1/2) := by decide +kernel

theorem ua1_fails_at_016 : pathLo 1 (16/100) (1/2) < loopHi 1 (16/100) (1/2) := by decide +kernel

/-- The numbers (ps): κ = 0.15: path >= 865, loop <= 852; κ = 0.16: path >= 852, loop <= 860. -/
theorem ua1_numbers : pathLo 1 (15/100) (1/2) = 865 ∧ loopHi 1 (15/100) (1/2) = 852 ∧
    pathLo 1 (16/100) (1/2) = 852 ∧ loopHi 1 (16/100) (1/2) = 860 := by decide +kernel

end Formal.Cells.Ua1Static
