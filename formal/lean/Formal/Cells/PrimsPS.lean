def carryTab : List (Nat × Nat) := [(3, 0x1e),
  (5, 0x10ef1fe0),
  (7, 0x1000efff1f00e0ff10ffef001fffe000),
  (9, 0x10000000efffffff1f000000e0ffffff10ff0000ef00ffff1fff0000e000ffff1000ffffefff00001f00ffffe0ff000010ffffffef0000001fffffffe0000000),
