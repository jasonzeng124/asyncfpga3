import Formal.Cells.CertArbPS
import Formal.Cells.ArbServer

/-!
# Formal.Cells.ArbServerPS — five of THE target's arbiters settle before their server answers (every behaviour)

Shard B, 2026-11-07. Instance of `ArbServer.target_arbs_settle_of` for the arbiters with a post-reset chain
certificate from the state q to its A0 pin node (`CertArbPS`, GENERATED by tools-B/ps/gen_certs_ps.py from
ctlcert.py chains): ucontrol_merge10.uarb1 (SLICE_X38Y51.B, arbs[0]), SLICE_X14Y18.A (arbs[5]), SLICE_X14Y19.A
(arbs[6]), SLICE_X18Y24.A (arbs[7]), SLICE_X39Y21.C (arbs[8]).

**Plainly:** in every behaviour of THE circuit with H_ARB(T) (`ArbOK T arbs x`), at its corner, for each of these
arbiters: if q is unchanged on `[a, e]`, the certificate's static side inputs and memory states hold, and the state
LUT's other inputs are constant on `[t1, t2]` with `t2 ≤ e + psum` (the server path's summed lower bands, ≥ ~1.5 ns
at the fast corner and κ = 0 for these five, Python), then q is constant on `[t1 + T, t2]`: when T is below the
server path's delay, the state has settled before the server's answer can reach the state LUT.
-/

namespace Formal.Cells.ArbServerPS
open Formal.Target Formal.Target.DecodedPS Formal.Cells.CertPS Formal.Cells.ArbServer Formal.Cells.CertArbPS

def rowsA : List ARowS :=
  [⟨arbs.getD 0 ⟨0, []⟩, c000⟩, ⟨arbs.getD 5 ⟨0, []⟩, c001⟩, ⟨arbs.getD 6 ⟨0, []⟩, c002⟩,
   ⟨arbs.getD 7 ⟨0, []⟩, c003⟩, ⟨arbs.getD 8 ⟨0, []⟩, c004⟩]

set_option maxRecDepth 100000 in
theorem rowsA_arb : rowsA.all (fun r => arbCertOK r.A r.pc) = true := by decide +kernel

theorem getD_mem {i : Nat} (h : i < arbs.length) : arbs.getD i ⟨0, []⟩ ∈ arbs := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h, Option.getD_some]
  exact List.getElem_mem h

theorem rowsA_full : ∀ r ∈ rowsA, r.A ∈ arbs ∧ certOK r.pc.1 r.pc.2 = true ∧ arbCertOK r.A r.pc = true := by
  have hc : ∀ pc ∈ certs, certOK pc.1 pc.2 = true := List.all_eq_true.1 certs_ok
  have ha := List.all_eq_true.1 rowsA_arb
  intro r hr
  refine ⟨?_, ?_, ha r hr⟩
  · simp only [rowsA, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl | rfl
    · exact getD_mem (i := 0) (by decide)
    · exact getD_mem (i := 5) (by decide)
    · exact getD_mem (i := 6) (by decide)
    · exact getD_mem (i := 7) (by decide)
    · exact getD_mem (i := 8) (by decide)
  · simp only [rowsA, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl | rfl <;>
      exact hc _ (by simp [certs, certs00, certs01, certs02, certs03])

/-- **Five arbiters of THE target settle before their server answers** (see the module docstring). -/
theorem target_arbs_settle : type_of% (@target_arbs_settle_of rowsA rowsA_full) := @target_arbs_settle_of rowsA rowsA_full

end Formal.Cells.ArbServerPS
