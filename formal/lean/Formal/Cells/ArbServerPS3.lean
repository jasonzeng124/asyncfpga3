import Formal.Cells.CertArbPS3
import Formal.Cells.ArbServerPS

/-!
# Formal.Cells.ArbServerPS3 — two more arbiters of THE target settle before their server answers (every behaviour)

Shard B, 2026-11-07. As `ArbServerPS`, for SLICE_X39Y24.A (arbs[1]) and SLICE_X16Y31.A (arbs[3]), with the chain
certificates `CertArbPS3` (GENERATED by tools-B/ps/gen_certs_ps.py from ctlcert.py chains on the simb.py dump d3, after
the fix reading nodes absent from a dump as False). Python bounds on the server path's summed lower bands (fast corner,
κ = 0): 1945 ps (arbs[1]) and 719 ps (arbs[3]).

**Plainly:** in every behaviour of THE circuit with H_ARB(T), at its corner, for each of these two arbiters: if q is
unchanged on `[a, e]`, the certificate's static side inputs and memory states hold, and the state LUT's other inputs
are constant on `[t1, t2]` with `t2 ≤ e + psum`, then q is constant on `[t1 + T, t2]`.
-/

namespace Formal.Cells.ArbServerPS3
open Formal.Target Formal.Target.DecodedPS Formal.Cells.CertPS Formal.Cells.ArbServer Formal.Cells.CertArbPS3

def rowsA : List ARowS := [⟨arbs.getD 1 ⟨0, []⟩, c000⟩, ⟨arbs.getD 3 ⟨0, []⟩, c001⟩]

set_option maxRecDepth 100000 in
theorem rowsA_arb : rowsA.all (fun r => arbCertOK r.A r.pc) = true := by decide +kernel

theorem rowsA_full : ∀ r ∈ rowsA, r.A ∈ arbs ∧ certOK r.pc.1 r.pc.2 = true ∧ arbCertOK r.A r.pc = true := by
  have hc : ∀ pc ∈ certs, certOK pc.1 pc.2 = true := List.all_eq_true.1 certs_ok
  have ha := List.all_eq_true.1 rowsA_arb
  intro r hr
  refine ⟨?_, ?_, ha r hr⟩
  · simp only [rowsA, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl
    · exact Formal.Cells.ArbServerPS.getD_mem (i := 1) (by decide)
    · exact Formal.Cells.ArbServerPS.getD_mem (i := 3) (by decide)
  · simp only [rowsA, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl <;> exact hc _ (by simp [certs, certs00])

/-- **Two more arbiters of THE target settle before their server answers** (see the module docstring). -/
theorem target_arbs_settle : type_of% (@target_arbs_settle_of rowsA rowsA_full) := @target_arbs_settle_of rowsA rowsA_full

end Formal.Cells.ArbServerPS3
