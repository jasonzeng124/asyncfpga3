import Formal.Cells.ArbA0Fork
import Formal.Cells.ArbHeldTimed2

/-!
# Probe Bar: the A0 fork (rule J', per-pin site pins) and RT2 / RT2b on the 36 routed gcd_hw arbiters

Shard B, 2026-10-27. Core Lean (no Mathlib). Note: `formal/notes/B-gcd-arb-a0.md`.
Generated by the scratchpad `Bar/gen.py` from `Bar/out/a0.json` (head: `Bar/head.lean`).

## Routes and data

C-10e's four gcd_hw routes (seeds 2, 3, 4, d; `BDC_SELECT_PADS`, `BD_RLOC=v4`, no `--freq`),
REBUILT by this probe with nextpnr sha256 9c732bc6303458df (cells/verify/toolchain.sh all ok).
The FASM, routed JSON and SDF of every seed are byte-identical to C's `results/sha_*.txt`.
Elements are extracted per `bd_arbiter` (UNTRUSTED front end `Bar/a0extract.py`, built on
tcheck's `Prjx`: prjxray RC tree over the FASM's ON pips, site-pin (Inpin) delay of the
PHYSICAL pin, per-pin LUT arcs from prjxray-db), as 4-corner values [FMIN, FMAX, SMIN, SMAX].

Every row below is a box `(lo, hi)` of element records `X` (Nat ps):
* corner rows `<seed>_<inst>_<C>` for C in FMIN FMAX SMIN SMAX: `lo = ⌊v_C⌋`, `hi = ⌈v_C⌉`
  (the integer rounding hull of the one-corner point, H_ONE_CORNER);
* box rows `<seed>_<inst>_BOX`: `lo = ⌊FMIN⌋`, `hi = ⌈SMAX⌉` for every element independently
  (H_INDEP: each element anywhere in its fast-min .. slow-max range).

## The element record `X` (one arbiter, both clients)

A0 net (driver = the server's acknowledge) as a 3-sink tree, sinks ustate I4, ua1 I1, ua2 I1:
`ac` shared by all three; `dS1`/`dS2`/`d12` the extra segment shared by exactly one pair
(ustate & ua1 / ustate & ua2 / ua1 & ua2; the other two are 0); `es e1 e2` the sink-only
wires; `ps p1 p2` the site-pin delays. q net: prefix `cq`, suffix `qs` to ustate's own q pin
(with site pin), `qgw` to ugrant's q pin without its site pin `pqg`. r_k: prefix (cancels,
not carried), suffixes `rsk` (ustate) and `rgk` (ugrant), with site pins. `gwk`/`pgk` grant
route to ua_k without / with only its site pin. `fak` ua_k's feedback. Arcs: `aq` ustate O6
(flat over its pins: checked by the extractor), `aRq aR1 aR2` ustate O5 per pin, `ag1q ag1r`
ugrant O5 per pin, `ag2` ugrant O6 (flat: checked), `ac1 ac2` ua_k O6 (flat over A0/g/fb: checked).

## Results (statements)

* `fork1_box_iff` / `fork2_box_iff` (7g's exact condition, both directions, any box):
  every record in the box, every run of 7g's per-pin gate relations (real INITs) has no early
  acknowledge for client k  ↔  `0 ≤ fm_k lo hi` where `fm_k = early_k(lo) − late_k(hi)`.
  `fork1_counter` / `fork2_counter`: when `fm_k < 0`, the worst record in the box has, on every
  run, `A_k` high at an explicit instant (7g `client_k_counter`).
* `rt2_excl` / `rt2b_excl` (7h/7j ack exclusion, every server with H_SERVER_MIN):
  if the record realises `X` (`Real7`) and the five server-free margins are ≥ 0, then A1 and
  A2 are never high together across the handover.
* `rt2_box_iff` / `rt2b_box_iff`: for a server bound `S ≥ 0`, RT2 (resp. RT2b) holds for every
  realising record in the box with `smin = S`  ↔  each of its four margins at its own worst
  box point plus `k·S` is ≥ 0 (exact for the arc-form condition; the worst points are
  realisable by `mk7`).
* Per row: `<row>_vec` (the 12 margins, kernel-evaluated), `<row>_wf`; headline theorems at
  the end.
-/

namespace Formal.Cells.OnGcdArbA0

open Formal.Cells

structure X where
  ac : Nat
  dS1 : Nat
  dS2 : Nat
  d12 : Nat
  es : Nat
  e1 : Nat
  e2 : Nat
  ps : Nat
  p1 : Nat
  p2 : Nat
  cq : Nat
  qs : Nat
  qgw : Nat
  pqg : Nat
  rs1 : Nat
  rg1 : Nat
  rs2 : Nat
  rg2 : Nat
  gw1 : Nat
  pg1 : Nat
  gw2 : Nat
  pg2 : Nat
  fa1 : Nat
  fa2 : Nat
  aq : Nat
  aRq : Nat
  aR1 : Nat
  aR2 : Nat
  ag1q : Nat
  ag1r : Nat
  ag2 : Nat
  ac1 : Nat
  ac2 : Nat
deriving Repr

/-- Field-wise `a ≤ b`. -/
def X.le (a b : X) : Prop :=
  a.ac ≤ b.ac ∧ a.dS1 ≤ b.dS1 ∧ a.dS2 ≤ b.dS2 ∧ a.d12 ≤ b.d12 ∧ a.es ≤ b.es ∧ a.e1 ≤ b.e1 ∧
  a.e2 ≤ b.e2 ∧ a.ps ≤ b.ps ∧ a.p1 ≤ b.p1 ∧ a.p2 ≤ b.p2 ∧ a.cq ≤ b.cq ∧ a.qs ≤ b.qs ∧
  a.qgw ≤ b.qgw ∧ a.pqg ≤ b.pqg ∧ a.rs1 ≤ b.rs1 ∧ a.rg1 ≤ b.rg1 ∧ a.rs2 ≤ b.rs2 ∧
  a.rg2 ≤ b.rg2 ∧ a.gw1 ≤ b.gw1 ∧ a.pg1 ≤ b.pg1 ∧ a.gw2 ≤ b.gw2 ∧ a.pg2 ≤ b.pg2 ∧
  a.fa1 ≤ b.fa1 ∧ a.fa2 ≤ b.fa2 ∧ a.aq ≤ b.aq ∧ a.aRq ≤ b.aRq ∧ a.aR1 ≤ b.aR1 ∧
  a.aR2 ≤ b.aR2 ∧ a.ag1q ≤ b.ag1q ∧ a.ag1r ≤ b.ag1r ∧ a.ag2 ≤ b.ag2 ∧ a.ac1 ≤ b.ac1 ∧
  a.ac2 ≤ b.ac2

instance (a b : X) : Decidable (X.le a b) := by unfold X.le; infer_instance

/-- H_BOX: `x` lies in the box `[lo, hi]`. -/
def Xin (lo hi x : X) : Prop := lo.le x ∧ x.le hi

/-- Data well-formedness of a row: `lo ≤ hi`, and the loops of ustate and ua_k positive at `lo`. -/
def wf (lo hi : X) : Bool :=
  decide (lo.le hi) && decide (0 < lo.aq + lo.cq + lo.qs) && decide (0 < lo.ac1 + lo.fa1) &&
    decide (0 < lo.ac2 + lo.fa2)

/-! ## The A0 fork (7g, `ArbA0Fork`) -/

/-- H_INST_FORK1: 7g's delay record for client 1. `c` = the A0 prefix shared by ustate's and
ua1's branches; every other field is the routed suffix / site pin / per-pin arc. -/
def fdl1 (x : X) : ArbA0Fork.Dl :=
  { c := x.ac + x.dS1, wSt := x.dS2 + x.es, pSt := x.ps, aSt := x.aq, wQf := x.cq + x.qs,
    pQf := 0, wQG := x.cq + x.qgw, pQG := x.pqg, aG := x.ag1q, wGC := x.gw1, pGC := x.pg1,
    wAC := x.d12 + x.e1, pAC := x.p1, aC := x.ac1, wCf := x.fa1, pCf := 0 }

/-- H_INST_FORK2: the same for client 2 (g2 = ugrant O6). -/
def fdl2 (x : X) : ArbA0Fork.Dl :=
  { c := x.ac + x.dS2, wSt := x.dS1 + x.es, pSt := x.ps, aSt := x.aq, wQf := x.cq + x.qs,
    pQf := 0, wQG := x.cq + x.qgw, pQG := x.pqg, aG := x.ag2, wGC := x.gw2, pGC := x.pg2,
    wAC := x.d12 + x.e2, pAC := x.p2, aC := x.ac2, wCf := x.fa2, pCf := 0 }

/-- The fdl's full A0 routes are the tree's (sanity: prefix + suffix + site pin). -/
theorem fdl1_routes (x : X) :
    (fdl1 x).c + (fdl1 x).wSt + (fdl1 x).pSt = x.ac + x.dS1 + x.dS2 + x.es + x.ps ∧
    (fdl1 x).c + (fdl1 x).wAC + (fdl1 x).pAC = x.ac + x.dS1 + x.d12 + x.e1 + x.p1 := by
  unfold fdl1; simp only; omega

theorem fdl2_routes (x : X) :
    (fdl2 x).c + (fdl2 x).wSt + (fdl2 x).pSt = x.ac + x.dS1 + x.dS2 + x.es + x.ps ∧
    (fdl2 x).c + (fdl2 x).wAC + (fdl2 x).pAC = x.ac + x.dS2 + x.d12 + x.e2 + x.p2 := by
  unfold fdl2; simp only; omega

/-- Rule J' late / early for client k. -/
def late1 (x : X) : Nat := x.d12 + x.e1 + x.p1
def early1 (x : X) : Nat := x.dS2 + x.es + x.ps + x.aq + x.cq + x.qgw + x.pqg + x.ag1q + x.gw1 + x.pg1
def late2 (x : X) : Nat := x.d12 + x.e2 + x.p2
def early2 (x : X) : Nat := x.dS1 + x.es + x.ps + x.aq + x.cq + x.qgw + x.pqg + x.ag2 + x.gw2 + x.pg2

theorem late1_eq (x : X) : (fdl1 x).late = late1 x := by unfold fdl1 ArbA0Fork.Dl.late late1; rfl
theorem early1_eq (x : X) : (fdl1 x).early = early1 x := by
  unfold fdl1 ArbA0Fork.Dl.early early1; simp only; omega
theorem late2_eq (x : X) : (fdl2 x).late = late2 x := by unfold fdl2 ArbA0Fork.Dl.late late2; rfl
theorem early2_eq (x : X) : (fdl2 x).early = early2 x := by
  unfold fdl2 ArbA0Fork.Dl.early early2; simp only; omega

/-- Exact box margin of the fork (ps): earliest early chain minus latest late branch. -/
def fm1 (lo hi : X) : Int := (early1 lo : Int) - late1 hi
def fm2 (lo hi : X) : Int := (early2 lo : Int) - late2 hi

/-- The worst record of the box for client k: the late branch at `hi`, the rest at `lo`. -/
def wf1 (lo hi : X) : X := { lo with d12 := hi.d12, e1 := hi.e1, p1 := hi.p1 }
def wf2 (lo hi : X) : X := { lo with d12 := hi.d12, e2 := hi.e2, p2 := hi.p2 }

theorem wf1_in (lo hi : X) (h : lo.le hi) : Xin lo hi (wf1 lo hi) := by
  simp only [Xin, wf1, X.le] at *; omega
theorem wf2_in (lo hi : X) (h : lo.le hi) : Xin lo hi (wf2 lo hi) := by
  simp only [Xin, wf2, X.le] at *; omega

/-- No early acknowledge for client k on any run of 7g's gate relations with delays `x`. -/
def Safe1 (x : X) : Prop :=
  ∀ T0 a0 q g A, ArbA0Fork.Run ArbA0Fork.F1 ArbA0Fork.G1 false (fdl1 x) T0 a0 q g A → ∀ t, A t = false
def Safe2 (x : X) : Prop :=
  ∀ T0 a0 q g A, ArbA0Fork.Run ArbA0Fork.F2 ArbA0Fork.G2 true (fdl2 x) T0 a0 q g A → ∀ t, A t = false

/-- **Fork, client 1, exact over the box (both directions).** Hypotheses: `lo ≤ hi`
(H_BOX well-formed), ustate's and ua1's loops positive at `lo` (H_LOOP_ST, H_LOOP_UA). -/
theorem fork1_box_iff (lo hi : X) (hle : lo.le hi) (hq : 0 < lo.aq + lo.cq + lo.qs)
    (hc : 0 < lo.ac1 + lo.fa1) :
    (∀ x, Xin lo hi x → Safe1 x) ↔ 0 ≤ fm1 lo hi := by
  constructor
  · intro hs
    have hin := wf1_in lo hi hle
    have hq' : 0 < (fdl1 (wf1 lo hi)).dQf := by
      unfold fdl1 wf1 ArbA0Fork.Dl.dQf; simp only; omega
    have hc' : 0 < (fdl1 (wf1 lo hi)).dCf := by
      unfold fdl1 wf1 ArbA0Fork.Dl.dCf; simp only; omega
    obtain ⟨a0, q, g, A, R⟩ := ArbA0Fork.run_exists ArbA0Fork.F1 ArbA0Fork.G1 true
      (fdl1 (wf1 lo hi)) 1 ArbA0Fork.F1_hold ArbA0Fork.F1_go ArbA0Fork.G1_vals.1 (by omega) hq' hc'
    have := (ArbA0Fork.client1_iff R).1 (hs _ hin 1 a0 q g A R)
    rw [late1_eq, early1_eq] at this
    simp only [fm1, late1, early1, wf1] at this ⊢; omega
  · intro hm x hx T0 a0 q g A R
    apply (ArbA0Fork.client1_iff R).2
    rw [late1_eq, early1_eq]
    simp only [Xin, X.le, fm1, late1, early1] at hx hm ⊢; omega

theorem fork2_box_iff (lo hi : X) (hle : lo.le hi) (hq : 0 < lo.aq + lo.cq + lo.qs)
    (hc : 0 < lo.ac2 + lo.fa2) :
    (∀ x, Xin lo hi x → Safe2 x) ↔ 0 ≤ fm2 lo hi := by
  constructor
  · intro hs
    have hin := wf2_in lo hi hle
    have hq' : 0 < (fdl2 (wf2 lo hi)).dQf := by
      unfold fdl2 wf2 ArbA0Fork.Dl.dQf; simp only; omega
    have hc' : 0 < (fdl2 (wf2 lo hi)).dCf := by
      unfold fdl2 wf2 ArbA0Fork.Dl.dCf; simp only; omega
    obtain ⟨a0, q, g, A, R⟩ := ArbA0Fork.run_exists ArbA0Fork.F2 ArbA0Fork.G2 false
      (fdl2 (wf2 lo hi)) 1 ArbA0Fork.F2_hold ArbA0Fork.F2_go ArbA0Fork.G2_vals.1 (by omega) hq' hc'
    have := (ArbA0Fork.client2_iff R).1 (hs _ hin 1 a0 q g A R)
    rw [late2_eq, early2_eq] at this
    simp only [fm2, late2, early2, wf2] at this ⊢; omega
  · intro hm x hx T0 a0 q g A R
    apply (ArbA0Fork.client2_iff R).2
    rw [late2_eq, early2_eq]
    simp only [Xin, X.le, fm2, late2, early2] at hx hm ⊢; omega

/-- **Fork counter-trace, client 1**: if `fm1 < 0`, on every run with the worst box record,
ua1's acknowledge is high at `T0 + aC + c + early` (7g `client1_counter`); the record is in
the box. -/
theorem fork1_counter (lo hi : X) (hle : lo.le hi) (hm : fm1 lo hi < 0) :
    Xin lo hi (wf1 lo hi) ∧
    ∀ T0 a0 q g A, ArbA0Fork.Run ArbA0Fork.F1 ArbA0Fork.G1 false (fdl1 (wf1 lo hi)) T0 a0 q g A →
      A (T0 + (fdl1 (wf1 lo hi)).aC + (fdl1 (wf1 lo hi)).c + (fdl1 (wf1 lo hi)).early) = true := by
  refine ⟨wf1_in lo hi hle, fun T0 a0 q g A R => ArbA0Fork.client1_counter R ?_⟩
  rw [late1_eq, early1_eq]; simp only [fm1, late1, early1, wf1] at hm ⊢; omega

theorem fork2_counter (lo hi : X) (hle : lo.le hi) (hm : fm2 lo hi < 0) :
    Xin lo hi (wf2 lo hi) ∧
    ∀ T0 a0 q g A, ArbA0Fork.Run ArbA0Fork.F2 ArbA0Fork.G2 true (fdl2 (wf2 lo hi)) T0 a0 q g A →
      A (T0 + (fdl2 (wf2 lo hi)).aC + (fdl2 (wf2 lo hi)).c + (fdl2 (wf2 lo hi)).early) = true := by
  refine ⟨wf2_in lo hi hle, fun T0 a0 q g A R => ArbA0Fork.client2_counter R ?_⟩
  rw [late2_eq, early2_eq]; simp only [fm2, late2, early2, wf2] at hm ⊢; omega

/-! ## RT2 / RT2b (7h / 7j) -/

section RT2
open ArbHeldTimed ArbHeldTimed2

/-- The three full A0 routes (with site pins). -/
def As (x : X) : Int := x.ac + x.dS1 + x.dS2 + x.es + x.ps
def A1r (x : X) : Int := x.ac + x.dS1 + x.d12 + x.e1 + x.p1
def A2r (x : X) : Int := x.ac + x.dS2 + x.d12 + x.e2 + x.p2
/-- A0 fall at the A0 driver to the R0 change (A0 → ustate → q → own q pin → O5). -/
def Rsrv (x : X) : Int := As x + x.aq + (x.cq + x.qs) + x.aRq

/-- H_INST_RT2: 7h's record `D` realises `x`. Flat O6 arcs are the per-pin ones (checked flat),
rise = fall (prjxray has no edge split), the r_k prefix `crk` is any common value. -/
def Real7 (x : X) (D : Dl) : Prop :=
  D.wa0s = As x ∧ D.wa01 = A1r x ∧ D.wa02 = A2r x ∧ D.qf = x.aq ∧ D.qr = x.aq ∧
  D.wfb = x.cq + x.qs ∧ D.Rrq = x.aRq ∧ D.wq = x.cq + x.qgw + x.pqg ∧
  D.c1f = x.ac1 ∧ D.c1r = x.ac1 ∧ D.c2f = x.ac2 ∧ D.c2r = x.ac2 ∧ D.wfa1 = x.fa1 ∧
  D.wfa2 = x.fa2 ∧ D.wr1g - D.wr1s = (x.rg1 : Int) - x.rs1 ∧
  D.wr2g - D.wr2s = (x.rg2 : Int) - x.rs2 ∧ D.g1f1 = x.ag1r ∧ D.Rf1 = x.aR1 ∧
  D.Rf2 = x.aR2 ∧ D.wg1 = x.gw1 + x.pg1 ∧ D.wg2 = x.gw2 + x.pg2 ∧ D.g2r = x.ag2 ∧
  D.g2f = x.ag2 ∧ D.g1rq = x.ag1q

/-- RT2's four server-free margins (client 1 releases) and 7h's A0Fork (client 2's side). -/
def mP (x : X) : Int := Rsrv x - (x.ac1 + x.fa1)
def mG (x : X) : Int := x.rs1 + x.aR1 + Rsrv x + A1r x - (x.rg1 + x.ag1r + x.gw1 + x.pg1 + x.ac1 + x.fa1)
def mA (x : X) : Int := Rsrv x + A2r x + x.ac2 - (A1r x + x.ac1)
def mGG (x : X) : Int := x.rs1 + x.aR1 + Rsrv x + A2r x + x.ac2 - (x.rg1 + x.ag1r + x.gw1 + x.pg1 + x.ac1)
def mF (x : X) : Int := As x + x.aq + (x.cq + x.qgw + x.pqg) + x.ag2 + (x.gw2 + x.pg2) - A2r x
/-- RT2b's (client 2 releases) and 7j's A0Fork2 (client 1's side). -/
def nP (x : X) : Int := Rsrv x - (x.ac2 + x.fa2)
def nG (x : X) : Int := x.rs2 + x.aR2 + Rsrv x + A2r x - (x.rg2 + x.ag2 + x.gw2 + x.pg2 + x.ac2 + x.fa2)
def nA (x : X) : Int := Rsrv x + A1r x + x.ac1 - (A2r x + x.ac2)
def nGG (x : X) : Int := x.rs2 + x.aR2 + Rsrv x + A1r x + x.ac1 - (x.rg2 + x.ag2 + x.gw2 + x.pg2 + x.ac2)
def nF (x : X) : Int := As x + x.aq + (x.cq + x.qgw + x.pqg) + x.ag1q + (x.gw1 + x.pg1) - A1r x

/-- 7h's A0Fork on a realising record IS 7g's client-2 condition on `fdl2`. -/
theorem a0fork_iff (x : X) (D : Dl) (h : Real7 x D) : A0Fork D ↔ 0 ≤ mF x := by
  obtain ⟨h1, _, h3, h4, _, _, _, h8, _, _, _, _, _, _, _, _, _, _, _, _, h21, h22, _, _⟩ := h
  simp only [A0Fork, mF, As, A2r] at *
  constructor <;> intro <;> omega

theorem a0fork2_iff (x : X) (D : Dl) (h : Real7 x D) : A0Fork2 D ↔ 0 ≤ nF x := by
  obtain ⟨h1, h2, _, _, h5, _, _, h8, _, _, _, _, _, _, _, _, _, _, _, h20, _, _, _, h24⟩ := h
  simp only [A0Fork2, nF, As, A1r] at *
  constructor <;> intro <;> omega

theorem mF_fork (x : X) : mF x = (early2 x : Int) - late2 x := by
  unfold mF early2 late2 As A2r; omega
theorem nF_fork (x : X) : nF x = (early1 x : Int) - late1 x := by
  unfold nF early1 late1 As A1r; omega

theorem rt2_iff (x : X) (D : Dl) (h : Real7 x D) :
    RT2 D ↔ (0 ≤ mP x + D.smin ∧ 0 ≤ mG x + 2 * D.smin ∧ 0 ≤ mA x + D.smin ∧
      0 ≤ mGG x + 2 * D.smin) := by
  obtain ⟨h1, h2, h3, h4, _, h6, h7, _, h9, _, _, h12, h13, _, h15, _, h17, h18, _, h20, _, _, _, _⟩ := h
  simp only [mP, mG, mA, mGG, Rsrv, As, A1r, A2r] at *
  constructor
  · rintro ⟨p, g, a, gg⟩
    exact ⟨by omega, by omega, by omega, by omega⟩
  · rintro ⟨p, g, a, gg⟩
    exact ⟨by omega, by omega, by omega, by omega⟩

theorem rt2b_iff (x : X) (D : Dl) (h : Real7 x D) :
    RT2b D ↔ (0 ≤ nP x + D.smin ∧ 0 ≤ nG x + 2 * D.smin ∧ 0 ≤ nA x + D.smin ∧
      0 ≤ nGG x + 2 * D.smin) := by
  obtain ⟨h1, h2, h3, _, h5, h6, h7, _, _, h10, h11, _, _, h14, _, h16, _, _, h19, _, h21, _, h23, _⟩ := h
  simp only [nP, nG, nA, nGG, Rsrv, As, A1r, A2r] at *
  constructor
  · rintro ⟨p, g, a, gg⟩
    exact ⟨by omega, by omega, by omega, by omega⟩
  · rintro ⟨p, g, a, gg⟩
    exact ⟨by omega, by omega, by omega, by omega⟩

/-- **Ack exclusion across a client-1 release, every server (H_SERVER_MIN, any smin ≥ 0).**
7h `rt2_exclusion_arcs` on a record realising `x`, given the five server-free margins. -/
theorem rt2_excl (x : X) (hP : 0 ≤ mP x) (hG : 0 ≤ mG x) (hA : 0 ≤ mA x) (hGG : 0 ≤ mGG x)
    (hF : 0 ≤ mF x) {D : Dl} {s : Sigs} {t0 ta TA TA2 Hz : Int}
    (h : Real7 x D) (R : Run D s) (S : Scn D s t0 ta TA TA2 Hz) :
    ∀ t, t < Hz → (s.A1 t && s.A2 t) = false := by
  have hn := D.H_NONNEG
  exact rt2_exclusion_arcs R S ((rt2_iff x D h).2 ⟨by omega, by omega, by omega, by omega⟩)
    ((a0fork_iff x D h).2 hF)

/-- **Ack exclusion across a client-2 release** (7j `rt2_exclusion2_arcs`). -/
theorem rt2b_excl (x : X) (hP : 0 ≤ nP x) (hG : 0 ≤ nG x) (hA : 0 ≤ nA x) (hGG : 0 ≤ nGG x)
    (hF : 0 ≤ nF x) {D : Dl} {s : Sigs} {t0 ta TA TA2 Hz : Int}
    (h : Real7 x D) (R : Run D s) (S : Scn2 D s t0 ta TA TA2 Hz) :
    ∀ t, t < Hz → (s.A1 t && s.A2 t) = false := by
  have hn := D.H_NONNEG
  exact rt2_exclusion2_arcs R S ((rt2b_iff x D h).2 ⟨by omega, by omega, by omega, by omega⟩)
    ((a0fork2_iff x D h).2 hF)

/-- A valid 7h record realising `x`, server `S` (non-vacuity of `Real7`, and the witness for
box exactness). Fields RT2 / RT2b / A0Fork do not read are set to the realised arcs or 0. -/
def mk7 (x : X) (S : Int) (hS : 0 ≤ S) (hq : 0 < x.aq + x.cq + x.qs) (h1 : 0 < x.ac1 + x.fa1)
    (h2 : 0 < x.ac2 + x.fa2) : Dl where
  wr1s := x.rs1
  wr2s := x.rs2
  wr1g := x.rg1
  wr2g := x.rg2
  wfb := x.cq + x.qs
  wa0s := As x
  wq := x.cq + x.qgw + x.pqg
  wg1 := x.gw1 + x.pg1
  wa01 := A1r x
  wfa1 := x.fa1
  wg2 := x.gw2 + x.pg2
  wa02 := A2r x
  wfa2 := x.fa2
  qr := x.aq
  qf := x.aq
  Rr1 := x.aR1
  Rf1 := x.aR1
  Rr2 := x.aR2
  Rf2 := x.aR2
  Rrq := x.aRq
  Rfq := x.aRq
  g1r1 := x.ag1r
  g1f1 := x.ag1r
  g1r2 := 0
  g1f2 := 0
  g1rq := x.ag1q
  g1fq := x.ag1q
  g2r := x.ag2
  g2f := x.ag2
  c1r := x.ac1
  c1f := x.ac1
  c2r := x.ac2
  c2f := x.ac2
  smin := S
  H_NONNEG := by unfold As A1r A2r; omega
  H_RISE_LE_FALL := by omega
  H_LOOP_POS := by omega

theorem mk7_real (x : X) (S : Int) (hS : 0 ≤ S) (hq) (h1) (h2) :
    Real7 x (mk7 x S hS hq h1 h2) := by
  unfold Real7 mk7; simp

/-! ### Worst box points, one per margin (negative-coefficient fields at `hi`) -/

def wP (lo hi : X) : X := { lo with ac1 := hi.ac1, fa1 := hi.fa1 }
def wG (lo hi : X) : X :=
  { lo with rg1 := hi.rg1, ag1r := hi.ag1r, gw1 := hi.gw1, pg1 := hi.pg1, ac1 := hi.ac1, fa1 := hi.fa1 }
def wA (lo hi : X) : X := { lo with e1 := hi.e1, p1 := hi.p1, ac1 := hi.ac1 }
def wGG (lo hi : X) : X :=
  { lo with rg1 := hi.rg1, ag1r := hi.ag1r, gw1 := hi.gw1, pg1 := hi.pg1, ac1 := hi.ac1 }
def vP (lo hi : X) : X := { lo with ac2 := hi.ac2, fa2 := hi.fa2 }
def vG (lo hi : X) : X :=
  { lo with rg2 := hi.rg2, ag2 := hi.ag2, gw2 := hi.gw2, pg2 := hi.pg2, ac2 := hi.ac2, fa2 := hi.fa2 }
def vA (lo hi : X) : X := { lo with e2 := hi.e2, p2 := hi.p2, ac2 := hi.ac2 }
def vGG (lo hi : X) : X :=
  { lo with rg2 := hi.rg2, ag2 := hi.ag2, gw2 := hi.gw2, pg2 := hi.pg2, ac2 := hi.ac2 }

theorem wP_min (lo hi x : X) (h : Xin lo hi x) : mP (wP lo hi) ≤ mP x := by
  simp only [Xin, X.le, mP, wP, Rsrv, As] at h ⊢; omega
theorem wG_min (lo hi x : X) (h : Xin lo hi x) : mG (wG lo hi) ≤ mG x := by
  simp only [Xin, X.le, mG, wG, Rsrv, As, A1r] at h ⊢; omega
theorem wA_min (lo hi x : X) (h : Xin lo hi x) : mA (wA lo hi) ≤ mA x := by
  simp only [Xin, X.le, mA, wA, Rsrv, As, A1r, A2r] at h ⊢; omega
theorem wGG_min (lo hi x : X) (h : Xin lo hi x) : mGG (wGG lo hi) ≤ mGG x := by
  simp only [Xin, X.le, mGG, wGG, Rsrv, As, A2r] at h ⊢; omega
theorem vP_min (lo hi x : X) (h : Xin lo hi x) : nP (vP lo hi) ≤ nP x := by
  simp only [Xin, X.le, nP, vP, Rsrv, As] at h ⊢; omega
theorem vG_min (lo hi x : X) (h : Xin lo hi x) : nG (vG lo hi) ≤ nG x := by
  simp only [Xin, X.le, nG, vG, Rsrv, As, A2r] at h ⊢; omega
theorem vA_min (lo hi x : X) (h : Xin lo hi x) : nA (vA lo hi) ≤ nA x := by
  simp only [Xin, X.le, nA, vA, Rsrv, As, A1r, A2r] at h ⊢; omega
theorem vGG_min (lo hi x : X) (h : Xin lo hi x) : nGG (vGG lo hi) ≤ nGG x := by
  simp only [Xin, X.le, nGG, vGG, Rsrv, As, A1r] at h ⊢; omega

theorem wP_in (lo hi : X) (h : lo.le hi) : Xin lo hi (wP lo hi) := by
  simp only [Xin, X.le, wP] at *; omega
theorem wG_in (lo hi : X) (h : lo.le hi) : Xin lo hi (wG lo hi) := by
  simp only [Xin, X.le, wG] at *; omega
theorem wA_in (lo hi : X) (h : lo.le hi) : Xin lo hi (wA lo hi) := by
  simp only [Xin, X.le, wA] at *; omega
theorem wGG_in (lo hi : X) (h : lo.le hi) : Xin lo hi (wGG lo hi) := by
  simp only [Xin, X.le, wGG] at *; omega
theorem vP_in (lo hi : X) (h : lo.le hi) : Xin lo hi (vP lo hi) := by
  simp only [Xin, X.le, vP] at *; omega
theorem vG_in (lo hi : X) (h : lo.le hi) : Xin lo hi (vG lo hi) := by
  simp only [Xin, X.le, vG] at *; omega
theorem vA_in (lo hi : X) (h : lo.le hi) : Xin lo hi (vA lo hi) := by
  simp only [Xin, X.le, vA] at *; omega
theorem vGG_in (lo hi : X) (h : lo.le hi) : Xin lo hi (vGG lo hi) := by
  simp only [Xin, X.le, vGG] at *; omega

theorem w_in (lo hi : X) (h : lo.le hi) :
    Xin lo hi (wP lo hi) ∧ Xin lo hi (wG lo hi) ∧ Xin lo hi (wA lo hi) ∧ Xin lo hi (wGG lo hi) ∧
    Xin lo hi (vP lo hi) ∧ Xin lo hi (vG lo hi) ∧ Xin lo hi (vA lo hi) ∧ Xin lo hi (vGG lo hi) :=
  ⟨wP_in lo hi h, wG_in lo hi h, wA_in lo hi h, wGG_in lo hi h, vP_in lo hi h, vG_in lo hi h,
   vA_in lo hi h, vGG_in lo hi h⟩

/-- RT2 for every realising record in the box, with server bound `S`. -/
def BoxRT2 (lo hi : X) (S : Int) : Prop := ∀ x D, Xin lo hi x → Real7 x D → D.smin = S → RT2 D
def BoxRT2b (lo hi : X) (S : Int) : Prop := ∀ x D, Xin lo hi x → Real7 x D → D.smin = S → RT2b D

/-- The loop hypotheses hold at every box point once they hold at `lo`. -/
theorem loops_in (lo hi x : X) (h : Xin lo hi x) (hq : 0 < lo.aq + lo.cq + lo.qs)
    (h1 : 0 < lo.ac1 + lo.fa1) (h2 : 0 < lo.ac2 + lo.fa2) :
    0 < x.aq + x.cq + x.qs ∧ 0 < x.ac1 + x.fa1 ∧ 0 < x.ac2 + x.fa2 := by
  unfold Xin X.le at h; omega

/-- **RT2 over the box, exact for the arc-form condition (both directions).** -/
theorem rt2_box_iff (lo hi : X) (S : Int) (hS : 0 ≤ S) (hle : lo.le hi)
    (hq : 0 < lo.aq + lo.cq + lo.qs) (h1 : 0 < lo.ac1 + lo.fa1) (h2 : 0 < lo.ac2 + lo.fa2) :
    BoxRT2 lo hi S ↔ (0 ≤ mP (wP lo hi) + S ∧ 0 ≤ mG (wG lo hi) + 2 * S ∧
      0 ≤ mA (wA lo hi) + S ∧ 0 ≤ mGG (wGG lo hi) + 2 * S) := by
  have hw := w_in lo hi hle
  constructor
  · intro hb
    have get : ∀ y, Xin lo hi y → (0 ≤ mP y + S ∧ 0 ≤ mG y + 2 * S ∧ 0 ≤ mA y + S ∧
        0 ≤ mGG y + 2 * S) := by
      intro y hy
      obtain ⟨l1, l2, l3⟩ := loops_in lo hi y hy hq h1 h2
      have := (rt2_iff y _ (mk7_real y S hS l1 l2 l3)).1 (hb y _ hy (mk7_real y S hS l1 l2 l3) rfl)
      simpa [mk7] using this
    exact ⟨(get _ hw.1).1, (get _ hw.2.1).2.1, (get _ hw.2.2.1).2.2.1, (get _ hw.2.2.2.1).2.2.2⟩
  · rintro ⟨a, b, c, d⟩ x D hx hr hs
    rw [rt2_iff x D hr, hs]
    have := wP_min lo hi x hx; have := wG_min lo hi x hx
    have := wA_min lo hi x hx; have := wGG_min lo hi x hx
    omega

theorem rt2b_box_iff (lo hi : X) (S : Int) (hS : 0 ≤ S) (hle : lo.le hi)
    (hq : 0 < lo.aq + lo.cq + lo.qs) (h1 : 0 < lo.ac1 + lo.fa1) (h2 : 0 < lo.ac2 + lo.fa2) :
    BoxRT2b lo hi S ↔ (0 ≤ nP (vP lo hi) + S ∧ 0 ≤ nG (vG lo hi) + 2 * S ∧
      0 ≤ nA (vA lo hi) + S ∧ 0 ≤ nGG (vGG lo hi) + 2 * S) := by
  have hw := w_in lo hi hle
  constructor
  · intro hb
    have get : ∀ y, Xin lo hi y → (0 ≤ nP y + S ∧ 0 ≤ nG y + 2 * S ∧ 0 ≤ nA y + S ∧
        0 ≤ nGG y + 2 * S) := by
      intro y hy
      obtain ⟨l1, l2, l3⟩ := loops_in lo hi y hy hq h1 h2
      have := (rt2b_iff y _ (mk7_real y S hS l1 l2 l3)).1 (hb y _ hy (mk7_real y S hS l1 l2 l3) rfl)
      simpa [mk7] using this
    exact ⟨(get _ hw.2.2.2.2.1).1, (get _ hw.2.2.2.2.2.1).2.1, (get _ hw.2.2.2.2.2.2.1).2.2.1,
      (get _ hw.2.2.2.2.2.2.2).2.2.2⟩
  · rintro ⟨a, b, c, d⟩ x D hx hr hs
    rw [rt2b_iff x D hr, hs]
    have := vP_min lo hi x hx; have := vG_min lo hi x hx
    have := vA_min lo hi x hx; have := vGG_min lo hi x hx
    omega

/-- 7h's A0Fork over the box is 7g's client-2 fork margin (and 7j's A0Fork2 client 1's). -/
theorem a0fork_box (lo hi x : X) (h : Xin lo hi x) (hm : 0 ≤ fm2 lo hi) : 0 ≤ mF x := by
  rw [mF_fork]; simp only [Xin, X.le, fm2, early2, late2] at h hm ⊢; omega
theorem a0fork2_box (lo hi x : X) (h : Xin lo hi x) (hm : 0 ≤ fm1 lo hi) : 0 ≤ nF x := by
  rw [nF_fork]; simp only [Xin, X.le, fm1, early1, late1] at h hm ⊢; omega

/-- **Server-free ack exclusion over a whole box** (both directions of the handover): if every
server-free margin at its worst box point is ≥ 0 and both forks hold, every realising record
of every box point keeps A1 and A2 exclusive, for every server. -/
theorem box_excl (lo hi : X)
    (hP : 0 ≤ mP (wP lo hi)) (hG : 0 ≤ mG (wG lo hi)) (hA : 0 ≤ mA (wA lo hi))
    (hGG : 0 ≤ mGG (wGG lo hi)) (hF2 : 0 ≤ fm2 lo hi)
    (x : X) (hx : Xin lo hi x) {D : Dl} {s : Sigs} {t0 ta TA TA2 Hz : Int}
    (h : Real7 x D) (R : Run D s) (S : Scn D s t0 ta TA TA2 Hz) :
    ∀ t, t < Hz → (s.A1 t && s.A2 t) = false :=
  rt2_excl x (Int.le_trans hP (wP_min lo hi x hx)) (Int.le_trans hG (wG_min lo hi x hx))
    (Int.le_trans hA (wA_min lo hi x hx)) (Int.le_trans hGG (wGG_min lo hi x hx))
    (a0fork_box lo hi x hx hF2) h R S

theorem box_excl2 (lo hi : X)
    (hP : 0 ≤ nP (vP lo hi)) (hG : 0 ≤ nG (vG lo hi)) (hA : 0 ≤ nA (vA lo hi))
    (hGG : 0 ≤ nGG (vGG lo hi)) (hF1 : 0 ≤ fm1 lo hi)
    (x : X) (hx : Xin lo hi x) {D : Dl} {s : Sigs} {t0 ta TA TA2 Hz : Int}
    (h : Real7 x D) (R : Run D s) (S : Scn2 D s t0 ta TA TA2 Hz) :
    ∀ t, t < Hz → (s.A1 t && s.A2 t) = false :=
  rt2b_excl x (Int.le_trans hP (vP_min lo hi x hx)) (Int.le_trans hG (vG_min lo hi x hx))
    (Int.le_trans hA (vA_min lo hi x hx)) (Int.le_trans hGG (vGG_min lo hi x hx))
    (a0fork2_box lo hi x hx hF1) h R S

/-- RT2 for every realising record in the box whose server is at least `S` (H_SERVER_MIN with
`smin ≥ S`). -/
theorem rt2_box_ge (lo hi : X) (S : Int)
    (h : 0 ≤ mP (wP lo hi) + S ∧ 0 ≤ mG (wG lo hi) + 2 * S ∧ 0 ≤ mA (wA lo hi) + S ∧
      0 ≤ mGG (wGG lo hi) + 2 * S)
    (x : X) (D : Dl) (hx : Xin lo hi x) (hr : Real7 x D) (hs : S ≤ D.smin) : RT2 D := by
  obtain ⟨a, b, c, d⟩ := h
  rw [rt2_iff x D hr]
  have := wP_min lo hi x hx; have := wG_min lo hi x hx
  have := wA_min lo hi x hx; have := wGG_min lo hi x hx
  omega

theorem rt2b_box_ge (lo hi : X) (S : Int)
    (h : 0 ≤ nP (vP lo hi) + S ∧ 0 ≤ nG (vG lo hi) + 2 * S ∧ 0 ≤ nA (vA lo hi) + S ∧
      0 ≤ nGG (vGG lo hi) + 2 * S)
    (x : X) (D : Dl) (hx : Xin lo hi x) (hr : Real7 x D) (hs : S ≤ D.smin) : RT2b D := by
  obtain ⟨a, b, c, d⟩ := h
  rw [rt2b_iff x D hr]
  have := vP_min lo hi x hx; have := vG_min lo hi x hx
  have := vA_min lo hi x hx; have := vGG_min lo hi x hx
  omega

/-- **Ack exclusion over a box with a server lower bound `S`** (client-1 release). -/
theorem box_excl_srv (lo hi : X) (S : Int)
    (h : 0 ≤ mP (wP lo hi) + S ∧ 0 ≤ mG (wG lo hi) + 2 * S ∧ 0 ≤ mA (wA lo hi) + S ∧
      0 ≤ mGG (wGG lo hi) + 2 * S) (hF2 : 0 ≤ fm2 lo hi)
    (x : X) (hx : Xin lo hi x) {D : Dl} {s : Sigs} {t0 ta TA TA2 Hz : Int}
    (hr : Real7 x D) (hs : S ≤ D.smin) (R : Run D s) (Sc : Scn D s t0 ta TA TA2 Hz) :
    ∀ t, t < Hz → (s.A1 t && s.A2 t) = false :=
  rt2_exclusion_arcs R Sc (rt2_box_ge lo hi S h x D hx hr hs) ((a0fork_iff x D hr).2 (a0fork_box lo hi x hx hF2))

theorem box_excl2_srv (lo hi : X) (S : Int)
    (h : 0 ≤ nP (vP lo hi) + S ∧ 0 ≤ nG (vG lo hi) + 2 * S ∧ 0 ≤ nA (vA lo hi) + S ∧
      0 ≤ nGG (vGG lo hi) + 2 * S) (hF1 : 0 ≤ fm1 lo hi)
    (x : X) (hx : Xin lo hi x) {D : Dl} {s : Sigs} {t0 ta TA TA2 Hz : Int}
    (hr : Real7 x D) (hs : S ≤ D.smin) (R : Run D s) (Sc : Scn2 D s t0 ta TA TA2 Hz) :
    ∀ t, t < Hz → (s.A1 t && s.A2 t) = false :=
  rt2_exclusion2_arcs R Sc (rt2b_box_ge lo hi S h x D hx hr hs) ((a0fork2_iff x D hr).2 (a0fork2_box lo hi x hx hF1))

end RT2

/-- The 10 margins of a row: forks (7g, exact), RT2's four, RT2b's four (worst box points,
server-free). -/
def vec (lo hi : X) : List Int :=
  [fm1 lo hi, fm2 lo hi, mP (wP lo hi), mG (wG lo hi), mA (wA lo hi), mGG (wGG lo hi),
   nP (vP lo hi), nG (vG lo hi), nA (vA lo hi), nGG (vGG lo hi)]

/-- A row: name, box, and `srv`: the UNTRUSTED graph lower bound on the server's response
(H_SERVER_GRAPH: min routed path ustate O5 (R0) -> A0 driver output in C-10j's prjxray-priced
timing graph, at the row's fastest column). -/
structure Row where
  name : String
  lo : X
  hi : X
  srv : Int

/-- every margin of the row ≥ 0 -/
def Row.allOk (r : Row) : Bool := (vec r.lo r.hi).all (fun m => decide (0 ≤ m))

theorem allOk_sound (r : Row) (h : r.allOk = true) :
    0 ≤ fm1 r.lo r.hi ∧ 0 ≤ fm2 r.lo r.hi ∧ 0 ≤ mP (wP r.lo r.hi) ∧ 0 ≤ mG (wG r.lo r.hi) ∧
    0 ≤ mA (wA r.lo r.hi) ∧ 0 ≤ mGG (wGG r.lo r.hi) ∧ 0 ≤ nP (vP r.lo r.hi) ∧
    0 ≤ nG (vG r.lo r.hi) ∧ 0 ≤ nA (vA r.lo r.hi) ∧ 0 ≤ nGG (vGG r.lo r.hi) := by
  unfold Row.allOk vec at h
  simp only [List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true, decide_eq_true_eq] at h
  omega

theorem wf_sound (lo hi : X) (h : wf lo hi = true) :
    lo.le hi ∧ 0 < lo.aq + lo.cq + lo.qs ∧ 0 < lo.ac1 + lo.fa1 ∧ 0 < lo.ac2 + lo.fa2 := by
  unfold wf at h; simp only [Bool.and_eq_true, decide_eq_true_eq] at h
  exact ⟨h.1.1.1, h.1.1.2, h.1.2, h.2⟩

/-- **Everything for one row whose margins are all ≥ 0**: both forks safe on every record and
run in the box, and A1/A2 exclusive across both handovers for every server. -/
theorem row_all (r : Row) (hw : wf r.lo r.hi = true) (ho : r.allOk = true) :
    (∀ x, Xin r.lo r.hi x → Safe1 x ∧ Safe2 x) ∧
    (∀ x, Xin r.lo r.hi x → ∀ (D : ArbHeldTimed.Dl) (s : ArbHeldTimed.Sigs) (t0 ta TA TA2 Hz : Int),
      Real7 x D → ArbHeldTimed.Run D s → ArbHeldTimed.Scn D s t0 ta TA TA2 Hz →
      ∀ t, t < Hz → (s.A1 t && s.A2 t) = false) ∧
    (∀ x, Xin r.lo r.hi x → ∀ (D : ArbHeldTimed.Dl) (s : ArbHeldTimed.Sigs) (t0 ta TA TA2 Hz : Int),
      Real7 x D → ArbHeldTimed.Run D s → ArbHeldTimed2.Scn2 D s t0 ta TA TA2 Hz →
      ∀ t, t < Hz → (s.A1 t && s.A2 t) = false) := by
  obtain ⟨hle, hq, h1, h2⟩ := wf_sound _ _ hw
  obtain ⟨f1, f2, a, b, c, d, e, f, g, i⟩ := allOk_sound r ho
  refine ⟨fun x hx => ⟨(fork1_box_iff _ _ hle hq h1).2 f1 x hx, (fork2_box_iff _ _ hle hq h2).2 f2 x hx⟩,
    fun x hx D s t0 ta TA TA2 Hz h R S => box_excl _ _ a b c d f2 x hx h R S,
    fun x hx D s t0 ta TA TA2 Hz h R S => box_excl2 _ _ e f g i f1 x hx h R S⟩

/-- forks ≥ 0, and RT2 / RT2b's margins ≥ 0 with server bound `srv` -/
def Row.okSrv (r : Row) : Bool :=
  decide (0 ≤ fm1 r.lo r.hi ∧ 0 ≤ fm2 r.lo r.hi ∧
    (0 ≤ mP (wP r.lo r.hi) + r.srv ∧ 0 ≤ mG (wG r.lo r.hi) + 2 * r.srv ∧
      0 ≤ mA (wA r.lo r.hi) + r.srv ∧ 0 ≤ mGG (wGG r.lo r.hi) + 2 * r.srv) ∧
    (0 ≤ nP (vP r.lo r.hi) + r.srv ∧ 0 ≤ nG (vG r.lo r.hi) + 2 * r.srv ∧
      0 ≤ nA (vA r.lo r.hi) + r.srv ∧ 0 ≤ nGG (vGG r.lo r.hi) + 2 * r.srv))

/-- **Everything for one row, with the server bound**: both forks safe on every record and run
of the box, and A1/A2 exclusive across both handovers for every server answering in at least
`srv` (H_SERVER_MIN with `smin ≥ srv`). -/
theorem row_srv (r : Row) (hw : wf r.lo r.hi = true) (ho : r.okSrv = true) :
    (∀ x, Xin r.lo r.hi x → Safe1 x ∧ Safe2 x) ∧
    (∀ x, Xin r.lo r.hi x → ∀ (D : ArbHeldTimed.Dl) (s : ArbHeldTimed.Sigs) (t0 ta TA TA2 Hz : Int),
      Real7 x D → r.srv ≤ D.smin → ArbHeldTimed.Run D s → ArbHeldTimed.Scn D s t0 ta TA TA2 Hz →
      ∀ t, t < Hz → (s.A1 t && s.A2 t) = false) ∧
    (∀ x, Xin r.lo r.hi x → ∀ (D : ArbHeldTimed.Dl) (s : ArbHeldTimed.Sigs) (t0 ta TA TA2 Hz : Int),
      Real7 x D → r.srv ≤ D.smin → ArbHeldTimed.Run D s → ArbHeldTimed2.Scn2 D s t0 ta TA TA2 Hz →
      ∀ t, t < Hz → (s.A1 t && s.A2 t) = false) := by
  have hw' := wf_sound _ _ hw
  unfold Row.okSrv at ho; simp only [decide_eq_true_eq] at ho
  obtain ⟨f1, f2, h2, h2b⟩ := ho
  refine ⟨fun x hx => ⟨(fork1_box_iff _ _ hw'.1 hw'.2.1 hw'.2.2.1).2 f1 x hx,
      (fork2_box_iff _ _ hw'.1 hw'.2.1 hw'.2.2.2).2 f2 x hx⟩,
    fun x hx D s t0 ta TA TA2 Hz h hs R S => box_excl_srv _ _ _ h2 f2 x hx h hs R S,
    fun x hx D s t0 ta TA TA2 Hz h hs R S => box_excl2_srv _ _ _ h2b f1 x hx h hs R S⟩


