/-- **Headline (one consistent corner, with the graph server bound).** For every corner row:
both A0 forks safe (7g, every record of the rounding hull, every run), and A1/A2 exclusive
across both handovers for every server answering in at least the row's `srv`. -/
theorem gcd_corner_srv : ∀ r ∈ cornerRows,
    (∀ x, Xin r.lo r.hi x → Safe1 x ∧ Safe2 x) ∧
    (∀ x, Xin r.lo r.hi x → ∀ (D : ArbHeldTimed.Dl) (s : ArbHeldTimed.Sigs) (t0 ta TA TA2 Hz : Int),
      Real7 x D → r.srv ≤ D.smin → ArbHeldTimed.Run D s → ArbHeldTimed.Scn D s t0 ta TA TA2 Hz →
      ∀ t, t < Hz → (s.A1 t && s.A2 t) = false) ∧
    (∀ x, Xin r.lo r.hi x → ∀ (D : ArbHeldTimed.Dl) (s : ArbHeldTimed.Sigs) (t0 ta TA TA2 Hz : Int),
      Real7 x D → r.srv ≤ D.smin → ArbHeldTimed.Run D s → ArbHeldTimed2.Scn2 D s t0 ta TA TA2 Hz →
      ∀ t, t < Hz → (s.A1 t && s.A2 t) = false) := by
  intro r hr
  have hw : cornerRows.all (fun r => wf r.lo r.hi) = true := cornerRows_wf
  have ho : cornerRows.all Row.okSrv = true := by decide
  rw [List.all_eq_true] at hw ho
  exact row_srv r (hw r hr) (ho r hr)


