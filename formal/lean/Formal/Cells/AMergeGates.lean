import Formal.Core.LutList
open Formal.Core.LutList

/-!
# Probe Cm, part 1: every LUT of `bdc_amerge2_0`, `bdc_amerge3_0`, `bdc_muxn3_32`

The three modules are GENERATED by `bdc/emit.py` (`emit_amerge`, `emit_muxn`)
and are not in `cells/rtl/`. They instantiate library cells (`bd_arbiter`,
`bd_c2`, a `(* keep *)` LUT1 `uor`, `bd_delay_gated`) and leave the rest as
behavioural Verilog (`assign won = g2 | ack`, the index priority chain, the
decode `ctl_req & (s == k)`, `|j`, the data muxes) for yosys to map.

## Library LUTs (real INITs from `cells/rtl/`)

| cell | INIT | pins `[I0..I5]` |
|---|---|---|
| `bd_arbiter.ustate` LUT6_2 (O6 = q, O5 = R0) | `FFF0_FFB2_ACAC_ACAC` | r1 r2 q rst A0 1 |
| `bd_arbiter.ugrant` LUT6_2 (O5 = g1, O6 = g2) | `0C0C_0C0C_A0A0_A0A0` | r1 r2 q 0 0 1 |
| `bd_c2` (`ua1`, `ua2`, muxn `uj_k`, `ua_k`) | `00E8_00E8_00E8_00E8` | a b q rst 0 0 |
| `uor` LUT1 | `2` | the anchor's input |

## Inferred LUTs: hypothesis **H_YOSYS_MAP**

The LUTs below are what yosys 0.62 (openXC7, `~/dev2/lib/fpgatoolchain`)
produced for the three modules, synthesised alone with `build_hw.sh`'s exact
script (`synth_xilinx -flatten ... -run begin:map_luts`, `abc -luts
2:2,3,6:5,10,20`, LUT techmap, `opt_lut_ins`, `-run finalize:`) on the Verilog
`bdc/emit.py` emits for gcd_hw (`--no-top --probe n138`, bdc knobs unset).
Both modules are `(* keep_hierarchy *)`, so flattening the whole design cannot
merge these LUTs with logic outside the module; the mapping of the module in
isolation is the mapping in the design PROVIDED abc makes the same choice in
context (H_YOSYS_MAP). Test: dump the LUT cells of `uut.*control_merge*` and
`uut.umux*` from the gcd_hw synthesis JSON and compare INIT and pin order with
this table (the probe's `dump.py` does that in a few seconds).

| module | output | INIT | pins `[I0..]` |
|---|---|---|---|
| amerge2 | `index` | `E` (LUT2) | g2, in1_ack |
| amerge3 | `index[1]` | `E` (LUT2) | g2(arb2), in2_ack |
| amerge3 | `index[0]` | `000E` (LUT4) | in1_ack, g2(arb1), g2(arb2), in2_ack |
| muxn3 | `sel[0]` | `10` (LUT3) | s[0], s[1], ctl_req |
| muxn3 | `sel[1]` | `40` (LUT3) | s[1], s[0], ctl_req |
| muxn3 | `sel[2]` | `40` (LUT3) | s[0], s[1], ctl_req |
| muxn3 | `udly.gate` = `\|j` | `FE` (LUT3) | j[2], j[1], j[0] |
| muxn3 | `z_data[b]` (each of 32) | `F0AA_CCF0` (LUT5) | in2[b], in1[b], in0[b], s[0], s[1] |

(amerge2's 1-bit `z_data` LUT4 `CCCA` exists only in the module in
isolation: gcd_hw's control_merges carry no data (`W = 0`, `.z_data()`
unconnected), so it is removed in the design.)

Every Boolean equation below is PROVED from the INIT (`decide`), and the
Kleene facts are evaluated with Prelim's `lutK` (hypothesis H_KLEENE_LUT).
-/

namespace Formal.Cells.AMergeGates
open Formal.Cells

/-! ## INIT constants -/

def ARB_ST : Nat := 0xFFF0FFB2ACACACAC
def GRANT : Nat := 0x0C0C0C0CA0A0A0A0
def C2 : Nat := 0x00E800E800E800E8
def BUF1 : Nat := 0x2
def IDX2 : Nat := 0xE
def IDX3L : Nat := 0x000E
def SEL0 : Nat := 0x10
def SEL1 : Nat := 0x40
def SEL2 : Nat := 0x40
def OR3 : Nat := 0xFE
def DM5 : Nat := 0xF0AACCF0

/-! ## Gate functions (pins as instantiated, `rst = 0`) -/

/-- `ustate` O6: the arbiter's state node `q` (own output on I2). -/
def stA (r1 r2 q a0 : Bool) : Bool := o6B ARB_ST [r1, r2, q, false, a0, true]
/-- `ustate` O5: `R0`. -/
def r0A (r1 r2 q a0 : Bool) : Bool := o5B ARB_ST [r1, r2, q, false, a0, true]
/-- `ugrant` O5: `g1`. -/
def gr1 (r1 r2 q : Bool) : Bool := o5B GRANT [r1, r2, q, false, false, true]
/-- `ugrant` O6: `g2`. -/
def gr2 (r1 r2 q : Bool) : Bool := o6B GRANT [r1, r2, q, false, false, true]
/-- `bd_c2` (own output on I2). -/
def c2 (a b q : Bool) : Bool := lutB C2 [a, b, q, false, false, false]
/-- `uor` LUT1. -/
def buf1 (a : Bool) : Bool := lutB BUF1 [a]
/-- amerge2 `index`, amerge3 `index[1]`: LUT2 on `[g2, ack]`. -/
def idx2 (g a : Bool) : Bool := lutB IDX2 [g, a]
/-- amerge3 `index[0]`: LUT4 on `[in1_ack, g2(arb1), g2(arb2), in2_ack]`. -/
def idx3l (a1 g1 g2 a2 : Bool) : Bool := lutB IDX3L [a1, g1, g2, a2]
/-- muxn3 decodes. -/
def sel0 (s0 s1 c : Bool) : Bool := lutB SEL0 [s0, s1, c]
def sel1 (s0 s1 c : Bool) : Bool := lutB SEL1 [s1, s0, c]
def sel2 (s0 s1 c : Bool) : Bool := lutB SEL2 [s0, s1, c]
/-- muxn3 `|j` on `[j2, j1, j0]`. -/
def or3 (j0 j1 j2 : Bool) : Bool := lutB OR3 [j2, j1, j0]
/-- muxn3 data bit on `[in2, in1, in0, s0, s1]`. -/
def dm5 (d0 d1 d2 s0 s1 : Bool) : Bool := lutB DM5 [d2, d1, d0, s0, s1]

/-! ## INIT = equation -/

theorem stA_eq (r1 r2 q a0 : Bool) :
    stA r1 r2 q a0 = (if a0 then q else ((r1 && !r2) || (q && !(!r1 && r2)))) := by
  cases r1 <;> cases r2 <;> cases q <;> cases a0 <;> decide
theorem r0A_eq (r1 r2 q a0 : Bool) : r0A r1 r2 q a0 = ((r1 && q) || (r2 && !q)) := by
  cases r1 <;> cases r2 <;> cases q <;> cases a0 <;> decide
theorem gr1_eq (r1 r2 q : Bool) : gr1 r1 r2 q = (r1 && q) := by
  cases r1 <;> cases r2 <;> cases q <;> decide
theorem gr2_eq (r1 r2 q : Bool) : gr2 r1 r2 q = (r2 && !q) := by
  cases r1 <;> cases r2 <;> cases q <;> decide
theorem c2_eq (a b q : Bool) : c2 a b q = ((a && b) || (q && (a || b))) := by
  cases a <;> cases b <;> cases q <;> decide
theorem buf1_eq (a : Bool) : buf1 a = a := by cases a <;> decide
theorem idx2_eq (g a : Bool) : idx2 g a = (g || a) := by cases g <;> cases a <;> decide
/-- `index[0] = won1 & ~won2`, the emitted priority chain's low bit. -/
theorem idx3l_eq (a1 g1 g2 a2 : Bool) :
    idx3l a1 g1 g2 a2 = ((g1 || a1) && !(g2 || a2)) := by
  cases a1 <;> cases g1 <;> cases g2 <;> cases a2 <;> decide
/-- The decodes are `ctl_req & (s == k)` with `s = s1 s0`. -/
theorem sel0_eq (s0 s1 c : Bool) : sel0 s0 s1 c = (c && !s0 && !s1) := by
  cases s0 <;> cases s1 <;> cases c <;> decide
theorem sel1_eq (s0 s1 c : Bool) : sel1 s0 s1 c = (c && s0 && !s1) := by
  cases s0 <;> cases s1 <;> cases c <;> decide
theorem sel2_eq (s0 s1 c : Bool) : sel2 s0 s1 c = (c && !s0 && s1) := by
  cases s0 <;> cases s1 <;> cases c <;> decide
theorem or3_eq (j0 j1 j2 : Bool) : or3 j0 j1 j2 = (j0 || j1 || j2) := by
  cases j0 <;> cases j1 <;> cases j2 <;> decide
/-- The data LUT is `(s == 2) ? in2 : (s == 1) ? in1 : in0` (so `s = 3`
reads `in0`). -/
theorem dm5_eq (d0 d1 d2 s0 s1 : Bool) :
    dm5 d0 d1 d2 s0 s1 = (if !s0 && s1 then d2 else if s0 && !s1 then d1 else d0) := by
  cases d0 <;> cases d1 <;> cases d2 <;> cases s0 <;> cases s1 <;> decide

/-! ## Kleene facts (H_KLEENE_LUT): what can and cannot glitch -/

open K3 in
/-- The index LUT holds 1 while either input is 1, whatever the other does:
`won = g2 | ack` does not glitch when `g2` falls under a high `ack` (the
owner-2 transaction's tail) or `ack` rises under a high `g2`. -/
theorem idx2_hold : lutK IDX2 [x, t] = t ∧ lutK IDX2 [t, x] = t := by decide

open K3 in
/-- ...but with both inputs moving (a stale `ack` falling while a new `g2`
rises) the LUT can output `x`: that window is the bundling obligation
H_BUNDLED_IDX, not a structural property. -/
theorem idx2_both_moving : lutK IDX2 [x, x] = x := by decide

open K3 in
/-- amerge3 `index[0]` is pinned to 0 while arbiter 2's `won` is 1 (either of
its two pins), whatever arbiter 1's pins do; and pinned to 1 while arbiter 1's
`won` holds through one high pin and arbiter 2's pins are low. -/
theorem idx3l_hold :
    lutK IDX3L [x, x, t, x] = f ∧ lutK IDX3L [x, x, x, t] = f ∧
    lutK IDX3L [t, x, f, f] = t ∧ lutK IDX3L [x, t, f, f] = t := by decide

open K3 in
/-- The decodes ignore `s` while `ctl_req` is low (no glitch while the index
moves between tokens), for any intermediate value on both `s` pins. -/
theorem sel_idle :
    lutK SEL0 [x, x, f] = f ∧ lutK SEL1 [x, x, f] = f ∧ lutK SEL2 [x, x, f] = f := by decide

open K3 in
/-- ...and they are NOT protected against `s` moving while `ctl_req` is high:
a single `s` pin at `x` with `ctl_req` high gives `x` on the decodes it could
switch (the setup/hold obligation H_S_PIN). -/
theorem sel_needs_setup :
    lutK SEL0 [x, f, t] = x ∧ lutK SEL1 [f, x, t] = x ∧ lutK SEL2 [x, t, t] = x := by decide

open K3 in
/-- `|j` holds 1 while any join is 1 (the one-hot claim of the `bdc_muxn`
header makes at most one input move, so the OR passes a clean edge). -/
theorem or3_hold : lutK OR3 [t, x, x] = t ∧ lutK OR3 [x, t, x] = t ∧ lutK OR3 [x, x, t] = t := by
  decide

/-! ## The gate set, as a structure

The models in `AMerge2`/`AMerge3`/`MuxN3` are parametrised by the gate
functions. `gI` is the definition used in every theorem (the real INITs
through `lutB`); `gE` is the same gates as Boolean equations, which the kernel
evaluates faster. `gI_eq_gE` (from the INIT = equation lemmas above) lets a
certificate be checked on `gE` and the theorem be stated on `gI`. -/

structure Gates where
  stA : Bool → Bool → Bool → Bool → Bool
  r0A : Bool → Bool → Bool → Bool → Bool
  gr1 : Bool → Bool → Bool → Bool
  gr2 : Bool → Bool → Bool → Bool
  c2 : Bool → Bool → Bool → Bool
  buf1 : Bool → Bool
  idx2 : Bool → Bool → Bool
  idx3l : Bool → Bool → Bool → Bool → Bool
  sel0 : Bool → Bool → Bool → Bool
  sel1 : Bool → Bool → Bool → Bool
  sel2 : Bool → Bool → Bool → Bool
  or3 : Bool → Bool → Bool → Bool

/-- The gates from their real INITs. -/
def gI : Gates := ⟨stA, r0A, gr1, gr2, c2, buf1, idx2, idx3l, sel0, sel1, sel2, or3⟩

/-- The same gates as Boolean equations. -/
def gE : Gates :=
  ⟨fun r1 r2 q a0 => if a0 then q else ((r1 && !r2) || (q && !(!r1 && r2))),
   fun r1 r2 q _ => (r1 && q) || (r2 && !q),
   fun r1 _ q => r1 && q,
   fun _ r2 q => r2 && !q,
   fun a b q => (a && b) || (q && (a || b)),
   fun a => a,
   fun g a => g || a,
   fun a1 g1 g2 a2 => (g1 || a1) && !(g2 || a2),
   fun s0 s1 c => c && !s0 && !s1,
   fun s0 s1 c => c && s0 && !s1,
   fun s0 s1 c => c && !s0 && s1,
   fun j0 j1 j2 => j0 || j1 || j2⟩

theorem gI_eq_gE : gI = gE := by
  simp only [gI, gE, Gates.mk.injEq]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> funext <;>
    simp only [stA_eq, r0A_eq, gr1_eq, gr2_eq, c2_eq, buf1_eq, idx2_eq, idx3l_eq,
      sel0_eq, sel1_eq, sel2_eq, or3_eq]

end Formal.Cells.AMergeGates
