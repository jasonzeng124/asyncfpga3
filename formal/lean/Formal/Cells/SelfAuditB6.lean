/-! ## 1. Shifting a run left by one tick -/

theorem st1 {x : Nat → Bool} (h0 : x 0 = false) (h : x 1 ≠ x 0 → x 1 = false) : x 1 = false := by
  cases h1 : x 1
  · rfl
  · have := h (by rw [h1, h0]; decide)
    rw [h1] at this; exact this

theorem ctlB_000 : Formal.Cells.LinkHandshake.ctlB false false false false = false := by decide

theorem fork_sh {a : Chan} {os : List Chan} (F : Fork.Fork a os)
    (hr : a.req 0 = false) (ha : ∀ o ∈ os, o.ack 0 = false) :
    Fork.Fork (rtC (shf 1) a) (os.map (rtC (shf 1))) := by
  refine ⟨by simpa using F.ne, ?_, ?_, ?_, ?_, ?_⟩
  · intro o ho; obtain ⟨o, hm, rfl⟩ := List.mem_map.1 ho
    exact rt_guard (shf_mono 1) o.req (fun s s' => o.req s' = a.req s) (F.wire o hm)
  · intro t hne o ho; obtain ⟨o, hm, rfl⟩ := List.mem_map.1 ho
    exact rt_guard (shf_mono 1) a.ack (fun s s' => o.ack s = a.ack s') (fun t h => F.cel t h o hm) t hne
  · intro o ho t; obtain ⟨o, hm, rfl⟩ := List.mem_map.1 ho; exact F.dat o hm _
  · show a.ack 1 = false
    refine st1 F.initA (fun hne => ?_)
    obtain ⟨o, hm⟩ := List.exists_mem_of_ne_nil os F.ne
    exact (F.cel 0 hne o hm).symm.trans (ha o hm)
  · intro o ho; obtain ⟨o, hm, rfl⟩ := List.mem_map.1 ho
    show o.req 1 = false
    exact st1 (F.initO o hm) (fun hne => (F.wire o hm 0 hne).trans hr)

theorem join_sh {g : List Nat → Nat} {is : List Chan} {o : Chan} (J : Join.Join g is o)
    (hr : ∀ i ∈ is, i.req 0 = false) (ha : o.ack 0 = false) :
    Join.Join g (is.map (rtC (shf 1))) (rtC (shf 1) o) := by
  refine ⟨by simpa using J.ne, ?_, ?_, ?_, ?_, ?_⟩
  · intro t hne i hi; obtain ⟨i, hm, rfl⟩ := List.mem_map.1 hi
    exact rt_guard (shf_mono 1) o.req (fun s s' => i.req s = o.req s') (fun t h => J.cel t h i hm) t hne
  · intro i hi; obtain ⟨i, hm, rfl⟩ := List.mem_map.1 hi
    exact rt_guard (shf_mono 1) i.ack (fun s s' => i.ack s' = o.ack s) (J.wire i hm)
  · intro t; simp only [List.map_map]; exact J.dat _
  · show o.req 1 = false
    refine st1 J.initO (fun hne => ?_)
    obtain ⟨i, hm⟩ := List.exists_mem_of_ne_nil is J.ne
    exact (J.cel 0 hne i hm).symm.trans (hr i hm)
  · intro i hi; obtain ⟨i, hm, rfl⟩ := List.mem_map.1 hi
    show i.ack 1 = false
    exact st1 (J.initI i hm) (fun hne => (J.wire i hm 0 hne).trans ha)

theorem steer_sh {sel : Nat → Bool} {f : Nat → Nat} {j : Chan} {out : Bool → Chan}
    (S : Steer.Steer sel f j out) (hr : j.req 0 = false) (ha : ∀ b, (out b).ack 0 = false) :
    Steer.Steer sel f (rtC (shf 1) j) (fun b => rtC (shf 1) (out b)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro b
    exact rt_guard (shf_mono 1) (out b).req
      (fun s s' => (out b).req s' = (j.req s && (sel (j.dat s) == b))) (S.lut b)
  · exact rt_guard (shf_mono 1) j.ack (fun s s' => j.ack s' = ((out true).ack s || (out false).ack s)) S.orr
  · intro b t; exact S.dat b _
  · show j.ack 1 = false
    exact st1 S.initJ (fun hne => by
      have := S.orr 0 hne; rw [ha true, ha false] at this; exact this)
  · intro b; show (out b).req 1 = false
    exact st1 (S.initO b) (fun hne => by have := S.lut b 0 hne; rw [hr] at this; exact this)

theorem mux_sh {sel : Nat → Bool} {x y c z : Chan} {j0 j1 : Trace}
    (M : Mux.Mux sel x y c z j0 j1) (hx : x.req 0 = false) (hy : y.req 0 = false)
    (hz : z.ack 0 = false) :
    Mux.Mux sel (rtC (shf 1) x) (rtC (shf 1) y) (rtC (shf 1) c) (rtC (shf 1) z)
      (rtT (shf 1) j0) (rtT (shf 1) j1) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact rt_guard (shf_mono 1) j0 (fun s s' => x.req s = j0 s' ∧ (c.req s && !sel (c.dat s)) = j0 s') M.cj0
  · exact rt_guard (shf_mono 1) j1 (fun s s' => y.req s = j1 s' ∧ (c.req s && sel (c.dat s)) = j1 s') M.cj1
  · exact rt_guard (shf_mono 1) z.req (fun s s' => z.req s' = (j0 s || j1 s)) M.zr
  · exact rt_guard (shf_mono 1) x.ack (fun s s' => j0 s = x.ack s' ∧ z.ack s = x.ack s') M.xa
  · exact rt_guard (shf_mono 1) y.ack (fun s s' => j1 s = y.ack s' ∧ z.ack s = y.ack s') M.ya
  · exact rt_guard (shf_mono 1) c.ack (fun s s' => c.ack s' = z.ack s) M.ca
  · intro t; exact M.dat _
  · show j0 1 = false; exact st1 M.i0 (fun hne => (M.cj0 0 hne).1.symm.trans hx)
  · show j1 1 = false; exact st1 M.i1 (fun hne => (M.cj1 0 hne).1.symm.trans hy)
  · show z.req 1 = false
    exact st1 M.iz (fun hne => by have := M.zr 0 hne; rw [M.i0, M.i1] at this; exact this)
  · show x.ack 1 = false; exact st1 M.ix (fun hne => (M.xa 0 hne).1.symm.trans M.i0)
  · show y.ack 1 = false; exact st1 M.iy (fun hne => (M.ya 0 hne).1.symm.trans M.i1)
  · show c.ack 1 = false; exact st1 M.ic (fun hne => (M.ca 0 hne).trans hz)

theorem muxn_sh {sel : Nat → Nat} {xs : Nat → Chan} {c z : Chan} {j : Nat → Trace}
    (M : MuxN.MuxN sel xs c z j) (hx : ∀ k, k < 3 → (xs k).req 0 = false) (hz : z.ack 0 = false) :
    MuxN.MuxN sel (fun k => rtC (shf 1) (xs k)) (rtC (shf 1) c) (rtC (shf 1) z)
      (fun k => rtT (shf 1) (j k)) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro k hk
    exact rt_guard (shf_mono 1) (j k)
      (fun s s' => (xs k).req s = j k s' ∧ (c.req s && (sel (c.dat s) == k)) = j k s') (M.cj k hk)
  · exact rt_guard (shf_mono 1) z.req (fun s s' => z.req s' = (j 0 s || j 1 s || j 2 s)) M.zr
  · intro k hk
    exact rt_guard (shf_mono 1) (xs k).ack (fun s s' => j k s = (xs k).ack s' ∧ z.ack s = (xs k).ack s')
      (M.xa k hk)
  · exact rt_guard (shf_mono 1) c.ack (fun s s' => c.ack s' = z.ack s) M.ca
  · intro t; exact M.dat _
  · intro k hk; show j k 1 = false
    exact st1 (M.ij k hk) (fun hne => (M.cj k hk 0 hne).1.symm.trans (hx k hk))
  · show z.req 1 = false
    exact st1 M.iz (fun hne => by
      have := M.zr 0 hne
      rw [M.ij 0 (by decide), M.ij 1 (by decide), M.ij 2 (by decide)] at this; exact this)
  · intro k hk; show (xs k).ack 1 = false
    exact st1 (M.ix k hk) (fun hne => (M.xa k hk 0 hne).1.symm.trans (M.ij k hk))
  · show c.ack 1 = false; exact st1 M.ic (fun hne => (M.ca 0 hne).trans hz)

theorem amerge_sh {x y z : Chan} {g1 g2 : Trace} (M : CM.AMerge x y z g1 g2)
    (hx : x.req 0 = false) (hy : y.req 0 = false) :
    CM.AMerge (rtC (shf 1) x) (rtC (shf 1) y) (rtC (shf 1) z) (rtT (shf 1) g1) (rtT (shf 1) g2) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact rt_guard (shf_mono 1) g1
      (fun s s' => g1 s' = x.req s ∧ (g1 s' = true → g2 s = false ∧ z.ack s = false)) M.H_ARB1
  · exact rt_guard (shf_mono 1) g2
      (fun s s' => g2 s' = y.req s ∧ (g2 s' = true → g1 s = false ∧ z.ack s = false)) M.H_ARB2
  · intro t; exact M.H_ARB_EXCL _
  · exact rt_guard (shf_mono 1) z.req (fun s s' => z.req s' = (g1 s || g2 s)) M.zr
  · intro t h1 h2
    exact M.H_AMERGE_RTZ (t + 1) h1 h2
  · exact rt_guard (shf_mono 1) x.ack (fun s s' => g1 s = x.ack s' ∧ z.ack s = x.ack s') M.xa
  · exact rt_guard (shf_mono 1) y.ack (fun s s' => g2 s = y.ack s' ∧ z.ack s = y.ack s') M.ya
  · intro t; exact M.dat _
  · show g1 1 = false; exact st1 M.i1 (fun hne => (M.H_ARB1 0 hne).1.trans hx)
  · show g2 1 = false; exact st1 M.i2 (fun hne => (M.H_ARB2 0 hne).1.trans hy)
  · show z.req 1 = false
    exact st1 M.iz (fun hne => by have := M.zr 0 hne; rw [M.i1, M.i2] at this; exact this)
  · show x.ack 1 = false; exact st1 M.ix (fun hne => (M.xa 0 hne).1.symm.trans M.i1)
  · show y.ack 1 = false; exact st1 M.iy (fun hne => (M.ya 0 hne).1.symm.trans M.i2)

theorem link_sh {i o : Chan} {c : Trace} (L : Link.Link i o c)
    (hr : i.req 0 = false) (ha : o.ack 0 = false) :
    Link.Link (rtC (shf 1) i) (rtC (shf 1) o) (rtT (shf 1) c) := by
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact rt_guard (shf_mono 1) c
      (fun s s' => c s' = Formal.Cells.LinkHandshake.ctlB (i.req s) (o.ack s) (c s) false)
      L.H_CEL_SI
  · exact rt_guard (shf_mono 1) i.ack (fun s s' => i.ack s' = c s) L.H_ACK_DI
  · exact rt_guard (shf_mono 1) o.req (fun s s' => o.req s' = c s) L.H_REQ_DI
  · intro t; exact L.H_LATCH_OPEN _
  · intro t h; exact L.H_LATCH_HOLD (t + 1) h
  · show c 1 = false
    exact st1 L.ic (fun hne => by
      have := L.H_CEL_SI 0 hne; rw [hr, ha, L.ic, ctlB_000] at this; exact this)
  · show i.ack 1 = false; exact st1 L.ii (fun hne => (L.H_ACK_DI 0 hne).trans L.ic)
  · show o.req 1 = false; exact st1 L.io (fun hne => (L.H_REQ_DI 0 hne).trans L.ic)

theorem sink_sh {c : Chan} (S : Gcd.Sink c) (hr : c.req 0 = false) : Gcd.Sink (rtC (shf 1) c) := by
  refine ⟨?_, ?_⟩
  · exact rt_guard (shf_mono 1) c.ack (fun s s' => c.ack s' = c.req s) S.wire
  · show c.ack 1 = false; exact st1 S.init (fun hne => (S.wire 0 hne).trans hr)

/-- **Shifting left by one tick preserves every non-source cell model**, when every request
and acknowledge of the run is low at tick 0. -/
theorem cell_sh1 {n : Nat} {ch : Fin n → Chan} {sv : Nat → Nat} (k : K n) (hk : isSrcK k = false)
    (hc : Cell ch sv k) (hR : ∀ c, (ch c).req 0 = false) (hA : ∀ c, (ch c).ack 0 = false) :
    Cell (fun c => rtC (shf 1) (ch c)) sv k := by
  cases k with
  | forkG i os =>
    show Fork.Fork _ (os.map (fun c => rtC (shf 1) (ch c)))
    rw [show os.map (fun c => rtC (shf 1) (ch c)) = (os.map ch).map (rtC (shf 1)) by simp [List.map_map]]
    exact fork_sh hc (hR i) (fun o ho => by obtain ⟨c, _, rfl⟩ := List.mem_map.1 ho; exact hA c)
  | forkH i os l h d hs' =>
    show Fork.Fork _ ((os.map Prod.fst).map (fun c => rtC (shf 1) (ch c)))
    rw [show (os.map Prod.fst).map (fun c => rtC (shf 1) (ch c)) =
      ((os.map Prod.fst).map ch).map (rtC (shf 1)) by simp [List.map_map]]
    exact fork_sh hc (hR i) (fun o ho => by obtain ⟨c, _, rfl⟩ := List.mem_map.1 ho; exact hA c)
  | join ins o e js jw =>
    show Join.Join _ (ins.map (fun c => rtC (shf 1) (ch c))) _
    rw [show ins.map (fun c => rtC (shf 1) (ch c)) = (ins.map ch).map (rtC (shf 1)) by simp [List.map_map]]
    exact join_sh hc (fun i hi => by obtain ⟨c, _, rfl⟩ := List.mem_map.1 hi; exact hR c) (hA o)
  | bjoin ins o ec ed =>
    show Join.Join _ (ins.map (fun c => rtC (shf 1) (ch c))) _
    rw [show ins.map (fun c => rtC (shf 1) (ch c)) = (ins.map ch).map (rtC (shf 1)) by simp [List.map_map]]
    exact join_sh hc (fun i hi => by obtain ⟨c, _, rfl⟩ := List.mem_map.1 hi; exact hR c) (hA o)
  | steerC j t f => exact steer_sh hc (hR j) (fun b => hA _)
  | steerD j t f fd sw => exact steer_sh hc (hR j) (fun b => hA _)
  | mux c x y z mw =>
    obtain ⟨j0, j1, M⟩ := hc
    exact ⟨rtT (shf 1) j0, rtT (shf 1) j1, mux_sh M (hR x) (hR y) (hA z)⟩
  | muxn c x0 x1 x2 z nw =>
    obtain ⟨j, M⟩ := hc
    exact ⟨fun k => rtT (shf 1) (j k), muxn_sh M (fun k _ => hR _) (hA z)⟩
  | amerge x y z w =>
    obtain ⟨g1, g2, M⟩ := hc
    exact ⟨rtT (shf 1) g1, rtT (shf 1) g2, amerge_sh M (hR x) (hR y)⟩
  | link i o =>
    obtain ⟨c, L⟩ := hc
    exact ⟨rtT (shf 1) c, link_sh L (hR i) (hA o)⟩
  | src z which d => simp [isSrcK] at hk
  | sink i => exact sink_sh hc (hR i)

/-! ## 2. The rig-env run of C's network -/

/-- The event-list run (tick 0 = before release). -/
def Y : Fin NC → Chan := wch rcd
/-- The run in C's rig convention: tick 0 = release. -/
def chS : Fin NC → Chan := shiftRun 1 Y

/-- `env_c` (= every source request), `in_ack`, `env_c0` (= out0.ack). -/
def eS : Trace := (chS start).req
def kS : Trace := fun t => bv kL (t + 1)
def qS : Trace := (chS out0).ack

theorem kc1 : (ops.take 90).all (fun k => isSrcK k || kChk rcd (srcV RA RB) k) = true := by
  decide +kernel
theorem kc2 : ((ops.drop 90).take 90).all (fun k => isSrcK k || kChk rcd (srcV RA RB) k) = true := by
  decide +kernel
theorem kc3 : (((ops.drop 90).drop 90).take 90).all (fun k => isSrcK k || kChk rcd (srcV RA RB) k) = true := by
  decide +kernel
theorem kc4 : (((ops.drop 90).drop 90).drop 90).all (fun k => isSrcK k || kChk rcd (srcV RA RB) k) = true := by
  decide +kernel

theorem kc_all : ops.all (fun k => isSrcK k || kChk rcd (srcV RA RB) k) = true := by
  rw [← List.take_append_drop 90 ops, List.all_append, kc1, ← List.take_append_drop 90 (ops.drop 90),
    List.all_append, kc2, ← List.take_append_drop 90 ((ops.drop 90).drop 90), List.all_append, kc3,
    kc4]; rfl

/-- H_KER: every non-source operator meets C's cell model on `chS`. -/
theorem w_ker : ∀ o : Fin NO, isSrcK (opAt o) = false → Cell chS (srcV RA RB) (opAt o) := by
  intro o hns
  have h := List.all_eq_true.mp kc_all _ (getD_mem (o := o))
  rw [hns, Bool.false_or] at h
  exact cell_sh1 (opAt o) hns (kChk_sound (srcV RA RB) (opAt o) h) (fun c => bv_zero _) (fun c => bv_zero _)

theorem rcds_len : rcds.length = NC := by decide +kernel
theorem held_all6 : rcds.all heldChk = true := by decide +kernel

/-- H_BUNDLE on `chS`. -/
theorem w_bundle : ∀ c : Fin NC, Held (chS c) := by
  intro c
  apply held_rt (shf_mono 1)
  apply held_of
  apply List.all_eq_true.mp held_all6
  unfold rcd
  have h : c.val < rcds.length := by rw [rcds_len]; exact c.isLt
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_mem h

/-- The per-source facts: same request list as `start`, constant bus `srcV a b w`, and the
fork's c3 `k` moves only to that source's acknowledge (H_C3, read map `id`). -/
def srcOK (a b : Nat) (kl : List Nat) : Bool :=
  ops.all fun k => match k with
    | .src z w _ => ((rcd z).rq == (rcd start).rq) && ((rcd z).dt == []) &&
        ((rcd z).d0 == srcV a b w) && kl.all (fun s => s == 0 || (bv (rcd z).ak s == bv kl (s + 1)))
    | _ => true

theorem srcOK_t : srcOK RA RB kL = true := by decide +kernel

theorem src_facts {o : Fin NO} {z : Fin NC} {w : Nat} {d : Nat} (h : opAt o = .src z w d) :
    (rcd z).rq = (rcd start).rq ∧ (rcd z).dt = [] ∧ (rcd z).d0 = srcV RA RB w ∧
      kL.all (fun s => s == 0 || (bv (rcd z).ak s == bv kL (s + 1))) = true := by
  have := List.all_eq_true.mp srcOK_t _ (getD_mem (o := o))
  rw [h] at this
  simp only [Bool.and_eq_true, beq_iff_eq] at this
  exact ⟨this.1.1.1, this.1.1.2, this.1.2, this.2⟩

/-- The env's step relations (uenv1's b half, M1, M0), at the toggle points. -/
def envOK (kl : List Nat) : Bool :=
  (rcd start).rq.all (fun s => s == 0 || (bv kl s == !bv (rcd start).rq (s + 1))) &&
  (rcd start).rq.all (fun s => s == 0 || (bv (rcd out0).ak s == bv (rcd start).rq (s + 1))) &&
  (rcd out0).ak.all (fun s => s == 0 || (bv (rcd start).rq s == !bv (rcd out0).ak (s + 1)))

theorem envOK_t : envOK kL = true := by decide +kernel

theorem stepS {L : List Nat} {P : Nat → Bool} (h : L.all (fun s => s == 0 || P s) = true) {t : Nat}
    (hne : bv L (t + 1 + 1) ≠ bv L (t + 1)) : P (t + 1) = true := by
  have := List.all_eq_true.mp h _ (mem_of_ne hne)
  simpa using this

theorem envOK_parts :
    (rcd start).rq.all (fun s => s == 0 || (bv kL s == !bv (rcd start).rq (s + 1))) = true ∧
    (rcd start).rq.all (fun s => s == 0 || (bv (rcd out0).ak s == bv (rcd start).rq (s + 1))) = true ∧
    (rcd out0).ak.all (fun s => s == 0 || (bv (rcd start).rq s == !bv (rcd out0).ak (s + 1))) = true := by
  have h := envOK_t
  simp only [envOK, Bool.and_eq_true] at h
  exact ⟨h.1.1, h.1.2, h.2⟩

theorem w_fork_wire : ∀ o z w d, opAt o = .src z w d → ∀ t, (chS z).req t = eS t := by
  intro o z w d h t
  show bv (rcd z).rq (t + 1) = bv (rcd start).rq (t + 1)
  rw [(src_facts h).1]

theorem w_dat : ∀ o z w d, opAt o = .src z w d → ∀ t, (chS z).dat t = srcV RA RB w := by
  intro o z w d h t
  show nv (rcd z).d0 (rcd z).dt (t + 1) = srcV RA RB w
  rw [(src_facts h).2.1, (src_facts h).2.2.1]; rfl

theorem w_rel : eS 0 = true ∧ kS 0 = false := by
  refine ⟨?_, ?_⟩ <;> decide +kernel

theorem w_rel0 : qS 0 = false := by decide +kernel

theorem w_uenv1 : ∀ t, eS (t + 1) ≠ eS t → kS (id t) = !eS (t + 1) := by
  intro t hne
  have := stepS envOK_parts.1 hne
  exact beq_iff_eq.mp this

theorem w_c3 : ∀ o z w d, opAt o = .src z w d → ∀ t, kS (t + 1) ≠ kS t →
    (chS z).ack ((fun _ => id) z t) = kS (t + 1) := by
  intro o z w d h t hne
  have := stepS (src_facts h).2.2.2 hne
  exact beq_iff_eq.mp this

theorem w_m1 : ∀ t, eS (t + 1) ≠ eS t → qS (id t) = eS (t + 1) := by
  intro t hne
  have := stepS envOK_parts.2.1 hne
  exact beq_iff_eq.mp this

theorem w_m0 : ∀ t, qS (t + 1) ≠ qS t → eS (id t) = !qS (t + 1) := by
  intro t hne
  have := stepS envOK_parts.2.2 hne
  exact beq_iff_eq.mp this

/-- out0's first token closes (its acknowledge falls) at tick 474 of `chS`, carrying 6. -/
theorem rig_env_latch : TokAt (chS out0) 0 474 ∧ (chS out0).dat 474 = 6 := by
  refine ⟨⟨?_, ?_⟩, ?_⟩ <;> decide +kernel

/-- The env re-offers (`e` rises again at 432) before out0's ack falls: a genuine second lap
starts, as M0/M1 force (audit P7: any witness must be a ≥ 2-lap run). -/
theorem rig_env_relap : riseB eS 432 = true ∧ fallB eS 99 = true := by
  refine ⟨?_, ?_⟩ <;> decide +kernel

/-- **Joint non-vacuity of `RigSrc.gcd_rig_first_env`**: every hypothesis is discharged on
the one run `chS` (all read maps `id`), the theorem is applied to them, and out0 latches. -/
theorem rig_env_feeds :
    (∀ e', TokAt (chS out0) 0 e' → (chS out0).dat e' = Nat.gcd 12 18) ∧
    TokAt (chS out0) 0 474 ∧ (chS out0).dat 474 = 6 := by
  have h := Formal.Cells.RigSrc.gcd_rig_first_env 12 18 (by decide) (by decide) chS eS kS qS
    id id id (fun _ => id) w_ker w_bundle w_fork_wire w_dat w_rel w_rel0 (fun _ => rfl)
    (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ _ h => h) (fun _ _ => Nat.le_refl _)
    (fun _ _ h => h) (fun _ => Nat.le_refl _) (fun _ _ h => h) (fun _ => Nat.le_refl _)
    w_uenv1 w_c3 w_m1 w_m0
  exact ⟨h.2, rig_env_latch⟩

/-! ## 3. `ResetGcdNetR5.re_reset_binary`: a run from the all-zero state -/

section R5
open Formal.Cells Formal.Cells.TernarySound Formal.Cells.ResetGcd

/-- rst held at 1, every data input 0. -/
def r5inp : Nat → Nat → Bool := fun _ n => n == 0
/-- Unit-delay simulation from the all-zero power-up state. -/
def r5v : Nat → Nat → Bool := simB ResetGcdR5.rNet r5inp (fun _ => false)

theorem r5_rst_held : ∀ k, 0 < k → k ≤ 100 → TernaryPhases.InputsIn ResetGcdR5.rNet r5v gA k := by
  intro k hk _ n hn
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
  show K3.admits (gA n) (match ResetGcdR5.rNet.node n with
    | .input => r5inp (k' + 1) n
    | .gate init pins => lutB init (pinsB (fun _ i => simB ResetGcdR5.rNet r5inp (fun _ => false) k' i) pins 0)) = true
  rw [hn]
  by_cases h0 : n = 0
  · subst h0; rfl
  · unfold gA; rw [if_neg h0]
    generalize r5inp (k' + 1) n = b
    cases b <;> rfl

/-- **Non-vacuity of `re_reset_binary` on the R5 network**: from the all-zero state, every
control node shows its reset value on ticks 23..100. -/
theorem r5_reset_witness (n : Nat) (hc : ResetGcdR5.rCtl n = true) :
    ∀ k, 23 ≤ k → k ≤ 100 → r5v k n = ResetGcdR5.rR n :=
  ResetGcdR5.re_reset_binary (unitRun _ _ _) (unitDelay_run _ _ _) 100 r5_rst_held n hc

/-- The witness is not the trivial one in its state: node 287 (a reset-1 arbiter state)
starts at 0. -/
theorem r5_moves : r5v 0 287 = false ∧ ResetGcdR5.rCtl 287 = true ∧ ResetGcdR5.rR 287 = true := by
  refine ⟨rfl, ?_, ?_⟩ <;> decide +kernel

/-- The same witness on the C-10e synthesized network (`ResetGcdNetRe`). -/
def rev : Nat → Nat → Bool := simB ResetGcdRe.rNet r5inp (fun _ => false)

theorem re_rst_held : ∀ k, 0 < k → k ≤ 100 → TernaryPhases.InputsIn ResetGcdRe.rNet rev gA k := by
  intro k hk _ n hn
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
  show K3.admits (gA n) (match ResetGcdRe.rNet.node n with
    | .input => r5inp (k' + 1) n
    | .gate init pins => lutB init (pinsB (fun _ i => simB ResetGcdRe.rNet r5inp (fun _ => false) k' i) pins 0)) = true
  rw [hn]
  by_cases h0 : n = 0
  · subst h0; rfl
  · unfold gA; rw [if_neg h0]
    generalize r5inp (k' + 1) n = b
    cases b <;> rfl

/-- **Non-vacuity of `ResetGcdRe.re_reset_binary`** (all-zero start, unit delay). -/
theorem re_reset_witness (n : Nat) (hc : ResetGcdRe.rCtl n = true) :
    ∀ k, 23 ≤ k → k ≤ 100 → rev k n = ResetGcdRe.rR n :=
  ResetGcdRe.re_reset_binary (unitRun _ _ _) (unitDelay_run _ _ _) 100 re_rst_held n hc

end R5

end Formal.Cells.SelfAuditB6
