/-!
# Probe Bp: which physical LUT pin carries which logical input (from the bits)

Notes: `formal/notes/B-pin-assign.md`.

For every library-cell LUT in C's bitstream fixtures (ce_pair seeds 1..4,
`Formal.Net.Fasm.CePairS<n>`; bd_link W=3 + bd_arbiter seeds 1..4,
`Formal.Net.FasmLink.S<n>`, both GENERATED by shard C's importer from the FASM
read back from each `.bit`, drift-checked by C's check.sh) this file proves two
facts about a pin map `pm` (logical non-constant input j of the cell, in the
cell's I0.. order, sits on physical pin `pm[j]`, 0-based, 0 = A1):

* `_o6` / `_o5` (`Realizes`): the PHYSICAL INIT, with every unmapped physical
  pin at its tie value as the bits wire it, computes the cell's REAL logical
  INIT (cells/rtl) on the permuted inputs, for all Boolean inputs;
* `_src`: the physical pins in `pm` are wired (active pips, per C's importer) to
  the nets the logical inputs name: the cell's own output for its feedback,
  the neighbour LUT or port for the others.

Together: "logical input j is on physical pin pm[j]" is a consequence of the
bits, not a guess. The INIT alone does NOT fix the map for inputs that are
symmetric in the cell function (bd_c2n: a and q; bd_c2: a, b and q); the
source fact is what separates them (`c2n_init_symmetric` below shows the
swapped map also realizes the INIT, so the `_src` half is necessary).

No timing is modelled here. Site-pin delays (prjxray-db tile json) and the
derived per-pin terms are in the notes; they are arithmetic on these maps.
-/

namespace Formal.Cells.PinAssign
open Formal.Cells Formal.Net.Fasm

/-- Real INITs from cells/rtl (bd_ce.v, bd_arb.v, bd_latch.v). -/
def initC2 : Nat := 0x00E800E800E800E8
def initC2n : Nat := 0x00B200B200B200B2
def initUstate : Nat := 0xFFF0FFB2ACACACAC
def initUgrant : Nat := 0x0C0C0C0CA0A0A0A0
def initLatPair : Nat := 0xFF33CC00B8B8B8B8
def initLatOdd : Nat := 0xB8B8B8B8B8B8B8B8

/-- Logical pin vectors I0..I5 from the cell's non-constant inputs (constant
pins as in the RTL instantiation). -/
def vec4 (v : List Bool) : List Bool := v.take 4 ++ [false, false]
def vecUstate (v : List Bool) : List Bool := v.take 5 ++ [true]
def vecUgrant (v : List Bool) : List Bool := v.take 3 ++ [false, false, true]
def vecLatPair (v : List Bool) : List Bool := v.take 5 ++ [true]
def vecLatOdd (v : List Bool) : List Bool := v.take 3 ++ [false, false, false]

/-- Position of `k` in `pm`. -/
def posIn (k : Nat) : List Nat → Nat → Option Nat
  | [], _ => none
  | x :: xs, n => if x = k then some n else posIn k xs (n + 1)

/-- The physical pin vector A1..A6: a tied pin carries its tie, a mapped pin
carries its logical input's value, an unmapped untied pin reads `false`
(the maps below map every untied pin; `_o6` would fail otherwise for a pin the
INIT depends on). -/
def physVec (pins : List Src) (pm : List Nat) (vs : List Bool) : List Bool :=
  (List.range 6).map fun k =>
    match (pins[k]? : Option Src) with
    | some (Src.const v) => v
    | _ => match posIn k pm 0 with
      | some j => vs.getD j false
      | none => false

/-- All Boolean vectors of length `n`. -/
def allVecs : Nat → List (List Bool)
  | 0 => [[]]
  | n + 1 => (allVecs n).flatMap fun v => [false :: v, true :: v]

theorem mem_allVecs : ∀ (v : List Bool), v ∈ allVecs v.length
  | [] => by simp [allVecs]
  | b :: v => by
    simp only [allVecs, List.length_cons, List.mem_flatMap]
    exact ⟨v, mem_allVecs v, by cases b <;> simp⟩

/-- The physical LUT output `o`, on the permuted inputs, equals the logical
function `F` on the logical vector, for every Boolean input of length `nv`. -/
def Realizes (L : PLut) (o : LOut) (F : List Bool → Bool) (vec : List Bool → List Bool)
    (pm : List Nat) (nv : Nat) : Bool :=
  (allVecs nv).all fun vs => L.fn o (physVec L.pins pm vs) == F (vec vs)

theorem Realizes.sound {L : PLut} {o : LOut} {F : List Bool → Bool} {vec : List Bool → List Bool}
    {pm : List Nat} {nv : Nat} (h : Realizes L o F vec pm nv = true) :
    ∀ vs : List Bool, vs.length = nv → L.fn o (physVec L.pins pm vs) = F (vec vs) := by
  intro vs hl
  have hm : vs ∈ allVecs nv := hl ▸ mem_allVecs vs
  have := List.all_eq_true.mp h vs hm
  simpa using this

