import Formal.Net.PipeDeadData

/-!
# Probe C-pipe: under a pipelined environment the gcd_hw network can DEADLOCK, with every gate fast

**Problem, plainly.** THE goal (formal/PROGRAM.md, owner 2026-10-31) lets the environment offer
pair k+1 as soon as pair k's input handshake completes, and asks that every pair be answered.
C's liveness theorems for gcd_hw (C-8z: `gcd_hw_live_final`) assume H_START_ONCE (start offered
at most once) and the open H_NO_DEADLOCK''. This file shows what happens without H_START_ONCE.

**Proved (kernel):** there is a run `chD` of the 465-channel CapNet network in which
* every non-source operator meets its cell model with explicit internal traces (`CellI`), and
  every channel is bundled (`Held`);
* every gate of every non-source operator, arbiter grants included, has the STEP property:
  excited toward `v` at tick `t` ⇒ shows `v` at `t + 1` (so `BndG 1`: every gate fires within
  one tick; nothing is merely slow);
* the source channels a, b, start obey the four-phase protocol and offer gcd_rig.v's vector 9
  (a = 65536, b = 4096) TWICE: their requests rise at ticks 0 and 142;
* out0's request is low at EVERY tick: neither result is ever offered;
* at tick `tEnd` (265) no gate of any non-source operator is excited (`QuietNS`): the network
  is stuck, not slow.

**Not shown:** unit delays only (one assignment, not the band); the model is the CapNet network
built from bdc's graph and link plan, not the bitstream. Data: `PipeDeadData` (generated by
formal/tools/pipe/gen_deadwit.py from formal/tools/pipe/hwsim.py; untrusted, re-checked here).
-/

namespace Formal.Net.CapNet.PipeDead
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.CapNet Formal.Net.CapNet.Gcd
open Formal.Net.CapNet.Live Formal.Net.CapNet.Wit Formal.Net.CapNet.LiveWit

set_option maxRecDepth 100000

def isSrc {n : Nat} : K n → Bool
  | .src .. => true
  | _ => false

/-! ## Cell models and bundling -/

def nsChk (k : K NC) : Bool := isSrc k || kChk cdD (srcV 0 0) k

theorem dcells1 : (ops.take 180).all nsChk = true := by decide +kernel
theorem dcells2 : (ops.drop 180).all nsChk = true := by decide +kernel

theorem dcells_all : ops.all nsChk = true := by
  rw [← List.take_append_drop 180 ops, List.all_append, dcells1, dcells2]; rfl

theorem d_cells : ∀ p : Fin NO, isSrc (opAt p) = false → CellI chD (srcV 0 0) (itrW cdD) p (opAt p) := by
  intro p hs
  have h : nsChk (opAt p) = true := List.all_eq_true.mp dcells_all _ getD_mem
  simp only [nsChk, hs, Bool.false_or] at h
  exact cellI_of (srcV 0 0) p h

theorem cdsD_len : cdsD.length = NC := by decide +kernel

theorem dheld_all : cdsD.all heldChk = true := by decide +kernel

theorem d_held : ∀ c : Fin NC, Held (chD c) := by
  intro c
  apply held_of
  apply List.all_eq_true.mp dheld_all
  unfold cdD
  have h : c.val < cdsD.length := by rw [cdsD_len]; exact c.isLt
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_mem h

/-! ## Every non-source gate fires within one tick -/

def stepNS (lo hi : Nat) : Bool :=
  (List.range' lo (hi - lo)).all (fun i => if h : i < NO then isSrc (opAt ⟨i, h⟩) || opStep cdD ⟨i, h⟩
    else true)

theorem dstep1 : stepNS 0 120 = true := by decide +kernel
theorem dstep2 : stepNS 120 240 = true := by decide +kernel
theorem dstep3 : stepNS 240 367 = true := by decide +kernel

theorem stepNS_get {lo hi : Nat} (h : stepNS lo hi = true) (p : Fin NO) (h1 : lo ≤ p.val) (h2 : p.val < hi)
    (hs : isSrc (opAt p) = false) : opStep cdD p = true := by
  have hm : p.val ∈ List.range' lo (hi - lo) := List.mem_range'_1.mpr ⟨h1, by omega⟩
  have := List.all_eq_true.mp h p.val hm
  simp only [p.isLt, dite_true, Bool.or_eq_true] at this
  rcases this with e | e
  · rw [hs] at e; cases e
  · exact e

theorem NO_eq : NO = 367 := rfl

theorem d_step : ∀ p : Fin NO, isSrc (opAt p) = false → opStep cdD p = true := by
  intro p hs
  have := Nat.lt_of_lt_of_eq p.isLt NO_eq
  by_cases h1 : p.val < 120
  · exact stepNS_get dstep1 p (by omega) h1 hs
  by_cases h2 : p.val < 240
  · exact stepNS_get dstep2 p (by omega) h2 hs
  · exact stepNS_get dstep3 p (by omega) this hs

/-- H_BOUNDED_DELAY with `H = 1` for every gate of every non-source operator, grants included. -/
theorem d_bnd : ∀ p, isSrc (opAt p) = false →
    ∀ g ∈ gatesK p (opAt p) ++ grantsK p (opAt p), BndG 1 (gsAt chD (itrW cdD)) g :=
  fun p hp g hg => bnd_of_step (step_all (d_step p hp) g hg)

/-! ## The environment -/

/-- The four-phase protocol on an environment-driven channel: its request changes only to the
negation of its acknowledge. No timing. -/
def FourPhaseEnv (z : Chan) : Prop := ∀ t, z.req (t + 1) ≠ z.req t → z.req (t + 1) = !z.ack t

def envChkD (z : Fin NC) : Bool := (cdD z).rq.all (fun e => bv (cdD z).rq (e + 1) == !bv (cdD z).ak e)

theorem env_sound {z : Fin NC} (h : envChkD z = true) : FourPhaseEnv (chD z) := by
  intro t hmv
  have := Formal.Net.CapNet.Wit.step_of h hmv
  simpa [chD, wch, CD.ch] using this

def cA : Fin NC := ⟨0, by decide⟩
def cB : Fin NC := ⟨1, by decide⟩
def cS : Fin NC := ⟨2, by decide⟩

/-- The three sources are exactly channels 0, 1, 2 (a, b, start). -/
theorem srcs : ops.filterMap (fun k => match k with | .src z w _ => some (z.val, w) | _ => none) =
    [(0, 0), (1, 1), (2, 2)] := by decide +kernel

theorem d_env : FourPhaseEnv (chD cA) ∧ FourPhaseEnv (chD cB) ∧ FourPhaseEnv (chD cS) :=
  ⟨env_sound (by decide +kernel), env_sound (by decide +kernel), env_sound (by decide +kernel)⟩

/-- Two offers of vector 9 on a and b, and two on start: the requests rise at ticks 0 and 142
(and at no other tick), with the data 65536 and 4096 while each is offered. -/
theorem d_offers :
    (cdD cA).rq.length = 4 ∧ (cdD cB).rq.length = 4 ∧
    OffAt (chD cA) 0 0 ∧ OffAt (chD cA) 1 142 ∧ OffAt (chD cB) 0 0 ∧ OffAt (chD cB) 1 142 ∧
    OffAt (chD cS) 0 0 ∧ OffAt (chD cS) 1 142 ∧
    (∀ t, (chD cA).dat t = 65536) ∧ (∀ t, (chD cB).dat t = 4096) := by
  refine ⟨by decide +kernel, by decide +kernel, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩,
    ⟨?_, ?_⟩, ?_, ?_⟩ <;> try decide +kernel
  · intro t; show nv (cdD cA).d0 (cdD cA).dt t = 65536
    have h : (cdD cA).dt = [] := by decide +kernel
    rw [h]; rfl
  · intro t; show nv (cdD cB).d0 (cdD cB).dt t = 4096
    have h : (cdD cB).dt = [] := by decide +kernel
    rw [h]; rfl

/-! ## out0 never requests, and the network is stuck -/

theorem d_out0 : ∀ t, (chD out0).req t = false := by
  intro t
  have h : (cdD out0).rq = [] := by decide +kernel
  show bv (cdD out0).rq t = false
  rw [h]; rfl

/-- Quiescent for every non-source operator: no gate excited toward a value it does not show. -/
def QuietNS (s : GS) : Prop :=
  ∀ p : Fin NO, isSrc (opAt p) = false → ∀ g ∈ gatesK p (opAt p) ++ grantsK p (opAt p),
    ∀ v, g.exc v s → g.out s = v

def qOne (t : Nat) (p : Fin NO) (g : GE) : Bool :=
  (!evEF cdD (outK (opAt p)) g.eT t || evF cdD (outK (opAt p)) g.out t) &&
  (!evEF cdD (outK (opAt p)) g.eF t || !evF cdD (outK (opAt p)) g.out t)

def quietChk (t : Nat) : Bool :=
  (List.range NO).all (fun i => if h : i < NO then
    isSrc (opAt ⟨i, h⟩) || (gatesE (opAt ⟨i, h⟩)).all (qOne t ⟨i, h⟩) else true)

theorem quiet_of {t : Nat} (h : quietChk t = true) : QuietNS (gsAt chD (itrW cdD) t) := by
  intro p hs g hg v hex
  have hp := List.all_eq_true.mp h p.val (List.mem_range.mpr p.isLt)
  simp only [p.isLt, dite_true, hs, Bool.false_or] at hp
  obtain ⟨ge, hge, rfl⟩ := mem_gatesE hg
  have hq := List.all_eq_true.mp hp ge hge
  simp only [qOne, Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true'] at hq
  simp only [toG, chD] at hex ⊢
  rw [evE_gs] at hex
  rw [evS_gs]
  cases v
  · simp only [Bool.cond_false] at hex
    rcases hq.2 with h' | h'
    · rw [hex] at h'; cases h'
    · exact h'
  · simp only [Bool.cond_true] at hex
    rcases hq.1 with h' | h'
    · rw [hex] at h'; cases h'
    · exact h'

theorem d_quiet : QuietNS (gsAt chD (itrW cdD) tEnd) := quiet_of (by decide +kernel)

/-- **Deadlock under a pipelined environment.** A run of the gcd_hw CapNet network meeting every
non-source cell model (`CellI`), bundling on every channel, the one-tick step property for every
non-source gate (arbiter grants included), with four-phase sources that offer gcd_rig's vector 9
twice (requests rising at ticks 0 and 142), in which out0 never requests, and which is quiescent
(no non-source gate excited) at tick 265. -/
theorem gcd_hw_pipelined_deadlock :
    ∃ (ch : Fin NC → Chan) (itr : Itr),
      (∀ p : Fin NO, isSrc (opAt p) = false → CellI ch (srcV 0 0) itr p (opAt p)) ∧
      (∀ c, Held (ch c)) ∧
      (∀ p, isSrc (opAt p) = false → ∀ g ∈ gatesK p (opAt p) ++ grantsK p (opAt p),
        BndG 1 (gsAt ch itr) g) ∧
      (FourPhaseEnv (ch cA) ∧ FourPhaseEnv (ch cB) ∧ FourPhaseEnv (ch cS)) ∧
      (OffAt (ch cA) 0 0 ∧ OffAt (ch cA) 1 142 ∧ OffAt (ch cB) 0 0 ∧ OffAt (ch cB) 1 142 ∧
        OffAt (ch cS) 0 0 ∧ OffAt (ch cS) 1 142) ∧
      (∀ t, (ch cA).dat t = 65536) ∧ (∀ t, (ch cB).dat t = 4096) ∧
      (∀ t, (ch out0).req t = false) ∧
      QuietNS (gsAt ch itr 265) := by
  obtain ⟨-, -, h1, h2, h3, h4, h5, h6, h7, h8⟩ := d_offers
  exact ⟨chD, itrW cdD, d_cells, d_held, d_bnd, d_env, ⟨h1, h2, h3, h4, h5, h6⟩, h7, h8, d_out0, d_quiet⟩

end Formal.Net.CapNet.PipeDead
