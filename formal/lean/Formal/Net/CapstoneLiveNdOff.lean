import Formal.Net.CapstoneLiveNd
import Formal.Net.CapstoneLiveNdCert

/-!
# Probe C-8z (4): every channel of gcd_hw offers at most `4L + 11` tokens

H_OFFER_BOUND for ALL 465 channels, at all times, from the spine bound (8u,
`gcd_hw_spine_offers_bounded`, under H_WALK_ENDS `L`) and local counting rules, one per
operator kind:

* **up** (the producer cannot offer more than it was offered): a fork output, join output,
  steer output or link output rises at most as often as the request it follows
  (`up_fork`, `up_join`, `up_steer`, `up_link`); an arbiter or mux output at most as often as
  its two data inputs together (`up_amerge`, `up_mux`); the 3-way mux output as its three
  data inputs (`up_muxn`).
* **dn** (backpressure: a channel offers at most one more token than it has seen
  acknowledged, and its acknowledge follows the consumer's): `off c ≤ off d + 1` for an
  input `c` and output `d` of a fork, join, mux, 3-way mux or arbiter; `+ 2` across a link
  (`dn_link`: its C-element follows the inverted output acknowledge); a steer input offers at
  most `off t + off f + 1` (`dn_steer`).

The certificate (`CapstoneLiveNdCert.cert`, generated by `Wip/C8z/offcert.py`) assigns each
channel a rule, its bound `al * L + be` and a round `ord`; every rule uses only channels of
strictly smaller round, so the derivation is well founded. `certOK` is checked by the
kernel; `off_cert` proves the bounds by strong induction on the round. The free-running
`a`/`b` sources are bounded by the `dn` rules (backpressure from the join that waits for
the single `start` token): their offers stay finite without any environment hypothesis.

`gcd_hw_offers_bounded`: every channel, every time: `#offers ≤ 4L + 11`.
-/

namespace Formal.Net.CapNet.Live.Nd
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.CapNet Formal.Net.CapNet.Gcd
open Formal.Net.CapNet.Live
open Formal.Net.CapSafe (Good)
open Formal.Cells.LinkHandshake (ctlB ctlB_eq)

/-- Offers (request rises) of a channel before `T`. -/
def off (c : Chan) (T : Nat) : Nat := cnt (riseB c.req) T

/-! ## Generic counting facts -/

theorem fall_le_rise (s : Trace) (t : Nat) : cnt (fallB s) t ≤ cnt (riseB s) t + bn (s 0) := by
  have key : ∀ t, cnt (fallB s) t + bn (s t) = cnt (riseB s) t + bn (s 0) := by
    intro t
    induction t with
    | zero => simp [cnt]
    | succ t ih =>
      simp only [cnt, riseB, fallB, bn] at ih ⊢
      by_cases h0 : s t = true <;> by_cases h1 : s (t + 1) = true <;> simp [h0, h1] at ih ⊢ <;> omega
  have := key t; simp only [bn] at this ⊢; split at this <;> omega

theorem or_rises (f g : Trace) (t : Nat) :
    cnt (riseB (fun u => f u || g u)) t ≤ cnt (riseB f) t + cnt (riseB g) t := by
  have := cnt_le_sum [f, g] (fun x u => riseB x u) (riseB (fun u => f u || g u)) (by
    intro u hu
    simp only [riseB, Bool.and_eq_true, Bool.not_eq_eq_eq_not, Bool.not_true, Bool.or_eq_false_iff,
      Bool.or_eq_true] at hu
    obtain ⟨⟨h1, h2⟩, h3⟩ := hu
    rcases h3 with h3 | h3
    · exact ⟨f, by simp, by simp [riseB, h1, h3]⟩
    · exact ⟨g, by simp, by simp [riseB, h2, h3]⟩) t
  simpa using this

theorem fol0 {x g : Trace} (hf : ∀ t, x (t + 1) ≠ x t → g t = x (t + 1)) (h0 : g 0 = false)
    (T : Nat) : cnt (riseB x) T ≤ cnt (riseB g) T := by
  have := follow_rises x g hf T; simp [bn, h0] at this; exact this

theorem off_le_ack {c : Chan} (hp : Protocol c) (T : Nat) : off c T ≤ cnt (riseB c.ack) T + 1 := by
  have h1 := rise_inv hp T
  have h2 := fall_le_rise c.ack T
  rw [show bn (c.ack 0) = 0 by simp [bn, hp.1.2]] at h2
  unfold off; split at h1 <;> omega

theorem ack_le_off {c : Chan} (hp : Protocol c) (T : Nat) : cnt (riseB c.ack) T ≤ off c T := by
  refine fol0 (fun t ht => ?_) hp.1.1 T
  have := (hp.2 t).2 ht
  cases h1 : c.ack (t + 1) <;> cases h2 : c.ack t <;> cases h3 : c.req t <;> simp_all

/-- The link C-element follows its input request. -/
theorem link_c_req {i o : Chan} {cn : Trace} (L : Link.Link i o cn) :
    ∀ t, cn (t + 1) ≠ cn t → i.req t = cn (t + 1) := by
  intro t ht
  have e := L.H_CEL_SI t ht
  rw [ctlB_eq] at e
  cases h1 : cn (t + 1) <;> cases h2 : cn t <;> cases h3 : i.req t <;> cases h4 : o.ack t <;> simp_all

/-- The link C-element follows the inverted output acknowledge. -/
theorem link_c_nack {i o : Chan} {cn : Trace} (L : Link.Link i o cn) :
    ∀ t, cn (t + 1) ≠ cn t → (fun u => !o.ack u) t = cn (t + 1) := by
  intro t ht
  have e := L.H_CEL_SI t ht
  rw [ctlB_eq] at e
  cases h1 : cn (t + 1) <;> cases h2 : cn t <;> cases h3 : i.req t <;> cases h4 : o.ack t <;> simp_all

/-! ## Up rules -/

theorem up_fork {a : Chan} {os : List Chan} (F : Fork.Fork a os) (hp : Protocol a) {o : Chan}
    (ho : o ∈ os) (T : Nat) : off o T ≤ off a T :=
  fol0 (fun t ht => (F.wire o ho t ht).symm) hp.1.1 T

theorem up_join {g : List Nat → Nat} {is : List Chan} {o : Chan} (J : Join.Join g is o) {i : Chan}
    (hi : i ∈ is) (hp : Protocol i) (T : Nat) : off o T ≤ off i T :=
  fol0 (fun t ht => J.cel t ht i hi) hp.1.1 T

theorem up_steer {sel : Nat → Bool} {f : Nat → Nat} {j : Chan} {out : Bool → Chan}
    (S : Steer.Steer sel f j out) (hh : Held j) (hp : Protocol j) (b : Bool) (T : Nat) :
    off (out b) T ≤ off j T := by
  have h1 := fol0 (x := (out b).req) (g := fun u => j.req u && (sel (j.dat u) == b))
    (fun t ht => (S.lut b t ht).symm) (by simp [hp.1.1]) T
  have h2 := and_rises j.req (fun u => sel (j.dat u) == b) (fun t h0 h1 => by
    rw [hh t (by simp [inTx, h0]) (by simp [inTx, h1])]) T
  unfold off; omega

theorem up_link {i o : Chan} {cn : Trace} (L : Link.Link i o cn) (hp : Protocol i) (T : Nat) :
    off o T ≤ off i T := by
  have h1 := fol0 (x := o.req) (g := cn) (fun t ht => (L.H_REQ_DI t ht).symm) L.ic T
  have h2 := fol0 (link_c_req L) hp.1.1 T
  unfold off; omega

theorem up_amerge {x y z : Chan} {g1 g2 : Trace} (A : CM.AMerge x y z g1 g2) (hx : Protocol x)
    (hy : Protocol y) (T : Nat) : off z T ≤ off x T + off y T := by
  have h1 := fol0 (x := z.req) (g := fun u => g1 u || g2 u) (fun t ht => (A.zr t ht).symm)
    (by simp [A.i1, A.i2]) T
  have h2 := or_rises g1 g2 T
  have h3 := fol0 (fun t ht => (A.H_ARB1 t ht).1.symm) hx.1.1 T
  have h4 := fol0 (fun t ht => (A.H_ARB2 t ht).1.symm) hy.1.1 T
  unfold off; omega

theorem up_mux {sel : Nat → Bool} {x y c z : Chan} {j0 j1 : Trace} (M : Mux.Mux sel x y c z j0 j1)
    (hx : Protocol x) (hy : Protocol y) (T : Nat) : off z T ≤ off x T + off y T := by
  have h1 := fol0 (x := z.req) (g := fun u => j0 u || j1 u) (fun t ht => (M.zr t ht).symm)
    (by simp [M.i0, M.i1]) T
  have h2 := or_rises j0 j1 T
  have h3 := fol0 (fun t ht => (M.cj0 t ht).1) hx.1.1 T
  have h4 := fol0 (fun t ht => (M.cj1 t ht).1) hy.1.1 T
  unfold off; omega

theorem up_muxn {sel : Nat → Nat} {xs : Nat → Chan} {c z : Chan} {j : Nat → Trace}
    (M : MuxN.MuxN sel xs c z j) (hx : ∀ k, k < 3 → Protocol (xs k)) (T : Nat) :
    off z T ≤ off (xs 0) T + off (xs 1) T + off (xs 2) T := by
  have h1 := fol0 (x := z.req) (g := fun u => (j 0 u || j 1 u) || j 2 u)
    (fun t ht => (M.zr t ht).symm) (by simp [M.ij 0 (by decide), M.ij 1 (by decide), M.ij 2 (by decide)]) T
  have h2 := or_rises (fun u => j 0 u || j 1 u) (j 2) T
  have h3 := or_rises (j 0) (j 1) T
  have h4 := fol0 (fun t ht => (M.cj 0 (by decide) t ht).1) (hx 0 (by decide)).1.1 T
  have h5 := fol0 (fun t ht => (M.cj 1 (by decide) t ht).1) (hx 1 (by decide)).1.1 T
  have h6 := fol0 (fun t ht => (M.cj 2 (by decide) t ht).1) (hx 2 (by decide)).1.1 T
  unfold off; omega

/-! ## Down rules -/

/-- An input whose acknowledge follows the output's acknowledge offers at most one more. -/
theorem dn_gen {i o : Chan} (hi : Protocol i) (ho : Protocol o)
    (hf : ∀ t, i.ack (t + 1) ≠ i.ack t → o.ack t = i.ack (t + 1)) (T : Nat) :
    off i T ≤ off o T + 1 := by
  have h1 := off_le_ack hi T
  have h2 := fol0 hf ho.1.2 T
  have h3 := ack_le_off ho T
  omega

theorem dn_fork {a : Chan} {os : List Chan} (F : Fork.Fork a os) (ha : Protocol a) {o : Chan}
    (ho : o ∈ os) (hpo : Protocol o) (T : Nat) : off a T ≤ off o T + 1 :=
  dn_gen ha hpo (fun t ht => F.cel t ht o ho) T

theorem dn_join {g : List Nat → Nat} {is : List Chan} {o : Chan} (J : Join.Join g is o) {i : Chan}
    (hi : i ∈ is) (hpi : Protocol i) (hpo : Protocol o) (T : Nat) : off i T ≤ off o T + 1 :=
  dn_gen hpi hpo (fun t ht => (J.wire i hi t ht).symm) T

theorem dn_link {i o : Chan} {cn : Trace} (L : Link.Link i o cn) (hi : Protocol i) (ho : Protocol o)
    (T : Nat) : off i T ≤ off o T + 2 := by
  have h1 := off_le_ack hi T
  have h2 := fol0 (x := i.ack) (g := cn) (fun t ht => (L.H_ACK_DI t ht).symm) L.ic T
  have h3 := follow_rises cn (fun u => !o.ack u) (link_c_nack L) T
  have h4 : cnt (riseB (fun u => !o.ack u)) T = cnt (fallB o.ack) T := by
    congr 1; funext u; simp [riseB, fallB]
  have h5 := fall_le_rise o.ack T
  have h6 := ack_le_off ho T
  simp only [bn, ho.1.2] at h3 h5
  simp at h3 h5
  omega

theorem dn_steer {sel : Nat → Bool} {f : Nat → Nat} {j : Chan} {out : Bool → Chan}
    (S : Steer.Steer sel f j out) (hj : Protocol j) (ht : Protocol (out true))
    (hf : Protocol (out false)) (T : Nat) : off j T ≤ off (out true) T + off (out false) T + 1 := by
  have h1 := off_le_ack hj T
  have h2 := fol0 (x := j.ack) (g := fun u => (out true).ack u || (out false).ack u)
    (fun t h => (S.orr t h).symm) (by simp [ht.1.2, hf.1.2]) T
  have h3 := or_rises (out true).ack (out false).ack T
  have h4 := ack_le_off ht T
  have h5 := ack_le_off hf T
  omega

/-! ## The certificate checker -/

def upOK (c d : Fin NC) : K NC → Bool
  | .forkG i os => i == d && os.contains c
  | .forkH i os _ _ _ _ => i == d && (os.map Prod.fst).contains c
  | .join ins o _ _ _ => o == c && ins.contains d
  | .bjoin ins o _ _ => o == c && ins.contains d
  | .steerC j t f => j == d && (t == c || f == c)
  | .steerD j t f _ _ => j == d && (t == c || f == c)
  | .link i o => i == d && o == c
  | _ => false

def up2OK (c d e : Fin NC) : K NC → Bool
  | .amerge x y z _ => z == c && x == d && y == e
  | .mux _ x y z _ => z == c && x == d && y == e
  | _ => false

def up3OK (c d e f : Fin NC) : K NC → Bool
  | .muxn _ x0 x1 x2 z _ => z == c && x0 == d && x1 == e && x2 == f
  | _ => false

def dnOK (c d : Fin NC) (k : Nat) : K NC → Bool
  | .forkG i os => i == c && os.contains d && decide (1 ≤ k)
  | .forkH i os _ _ _ _ => i == c && (os.map Prod.fst).contains d && decide (1 ≤ k)
  | .join ins o _ _ _ => ins.contains c && o == d && decide (1 ≤ k)
  | .bjoin ins o _ _ => ins.contains c && o == d && decide (1 ≤ k)
  | .mux cc x y z _ => (cc == c || x == c || y == c) && z == d && decide (1 ≤ k)
  | .muxn cc x0 x1 x2 z _ => (cc == c || x0 == c || x1 == c || x2 == c) && z == d && decide (1 ≤ k)
  | .amerge x y z _ => (x == c || y == c) && z == d && decide (1 ≤ k)
  | .link i o => i == c && o == d && decide (2 ≤ k)
  | _ => false

def dn2OK (c d e : Fin NC) : K NC → Bool
  | .steerC j t f => j == c && t == d && f == e
  | .steerD j t f _ _ => j == c && t == d && f == e
  | _ => false

def entOf (c : Fin NC) : Ent := cert.getD c.val ⟨.sp, 0, 0, 0⟩

def ruleOK (c : Fin NC) (e : Ent) : Rl → Bool
  | .sp => sp c && decide (1 ≤ e.al)
  | .up d => upOK c d (opAt (prodOf c)) && decide ((entOf d).ord < e.ord) &&
      decide ((entOf d).al ≤ e.al) && decide ((entOf d).be ≤ e.be)
  | .up2 d f => up2OK c d f (opAt (prodOf c)) && decide ((entOf d).ord < e.ord) &&
      decide ((entOf f).ord < e.ord) && decide ((entOf d).al + (entOf f).al ≤ e.al) &&
      decide ((entOf d).be + (entOf f).be ≤ e.be)
  | .up3 d f g => up3OK c d f g (opAt (prodOf c)) && decide ((entOf d).ord < e.ord) &&
      decide ((entOf f).ord < e.ord) && decide ((entOf g).ord < e.ord) &&
      decide ((entOf d).al + (entOf f).al + (entOf g).al ≤ e.al) &&
      decide ((entOf d).be + (entOf f).be + (entOf g).be ≤ e.be)
  | .dn d k => dnOK c d k (opAt (consOf c)) && decide ((entOf d).ord < e.ord) &&
      decide ((entOf d).al ≤ e.al) && decide ((entOf d).be + k ≤ e.be)
  | .dn2 d f => dn2OK c d f (opAt (consOf c)) && decide ((entOf d).ord < e.ord) &&
      decide ((entOf f).ord < e.ord) && decide ((entOf d).al + (entOf f).al ≤ e.al) &&
      decide ((entOf d).be + (entOf f).be + 1 ≤ e.be)

def entOK (c : Fin NC) : Bool := ruleOK c (entOf c) (entOf c).r

theorem certOK : (List.finRange NC).all entOK = true := by decide +kernel

theorem cert_small : (List.finRange NC).all (fun c => decide ((entOf c).al ≤ 4) &&
    decide ((entOf c).be ≤ 11)) = true := by decide +kernel

/-! ## Soundness of each rule on the network -/

theorem mem_map_of_contains {ch : Fin NC → Chan} {l : List (Fin NC)} {c : Fin NC}
    (h : l.contains c = true) : ch c ∈ l.map ch := List.mem_map.mpr ⟨c, by simpa using h, rfl⟩

section
variable {a b : Nat} {ch : Fin NC → Chan}
variable (H_CELLS : ∀ o : Fin NO, Cell ch (srcV a b) (opAt o))
variable (H_BUNDLE : ∀ c, Held (ch c))
include H_CELLS H_BUNDLE

theorem up_sound (c d : Fin NC) (h : upOK c d (opAt (prodOf c)) = true) (T : Nat) :
    off (ch c) T ≤ off (ch d) T := by
  have hP := gcd_hw_protocol a b ch H_CELLS H_BUNDLE
  have C := H_CELLS (prodOf c)
  cases hk : opAt (prodOf c) with
  | forkG i os =>
    rw [hk] at h C; simp only [upOK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨rfl, h2⟩ := h
    exact up_fork C (hP _) (mem_map_of_contains h2) T
  | forkH i os l hh dd hs =>
    rw [hk] at h C; simp only [upOK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨rfl, h2⟩ := h
    exact up_fork C (hP _) (mem_map_of_contains h2) T
  | join ins o e js jw =>
    rw [hk] at h C; simp only [upOK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨rfl, h2⟩ := h
    exact up_join C (mem_map_of_contains h2) (hP _) T
  | bjoin ins o ec ed =>
    rw [hk] at h C; simp only [upOK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨rfl, h2⟩ := h
    exact up_join C (mem_map_of_contains h2) (hP _) T
  | steerC j t f =>
    rw [hk] at h C; simp only [upOK, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at h
    obtain ⟨rfl, h2 | h2⟩ := h
    · subst h2; exact up_steer C (H_BUNDLE _) (hP _) true T
    · subst h2; exact up_steer C (H_BUNDLE _) (hP _) false T
  | steerD j t f fd sw =>
    rw [hk] at h C; simp only [upOK, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq] at h
    obtain ⟨rfl, h2 | h2⟩ := h
    · subst h2; exact up_steer C (H_BUNDLE _) (hP _) true T
    · subst h2; exact up_steer C (H_BUNDLE _) (hP _) false T
  | link i o =>
    rw [hk] at h C; simp only [upOK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨rfl, rfl⟩ := h
    obtain ⟨cn, L⟩ := C
    exact up_link L (hP _) T
  | _ => rw [hk] at h; simp [upOK] at h

theorem up2_sound (c d e : Fin NC) (h : up2OK c d e (opAt (prodOf c)) = true) (T : Nat) :
    off (ch c) T ≤ off (ch d) T + off (ch e) T := by
  have hP := gcd_hw_protocol a b ch H_CELLS H_BUNDLE
  have C := H_CELLS (prodOf c)
  cases hk : opAt (prodOf c) with
  | amerge x y z w =>
    rw [hk] at h C; simp only [up2OK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h
    obtain ⟨g1, g2, A⟩ := C
    exact up_amerge A (hP _) (hP _) T
  | mux cc x y z mw =>
    rw [hk] at h C; simp only [up2OK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h
    obtain ⟨j0, j1, M⟩ := C
    exact up_mux M (hP _) (hP _) T
  | _ => rw [hk] at h; simp [up2OK] at h

theorem up3_sound (c d e f : Fin NC) (h : up3OK c d e f (opAt (prodOf c)) = true) (T : Nat) :
    off (ch c) T ≤ off (ch d) T + off (ch e) T + off (ch f) T := by
  have hP := gcd_hw_protocol a b ch H_CELLS H_BUNDLE
  have C := H_CELLS (prodOf c)
  cases hk : opAt (prodOf c) with
  | muxn cc x0 x1 x2 z nw =>
    rw [hk] at h C; simp only [up3OK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨⟨rfl, rfl⟩, rfl⟩, rfl⟩ := h
    obtain ⟨j, M⟩ := C
    exact up_muxn M (fun k _ => hP _) T
  | _ => rw [hk] at h; simp [up3OK] at h

theorem dn_sound (c d : Fin NC) (k : Nat) (h : dnOK c d k (opAt (consOf c)) = true) (T : Nat) :
    off (ch c) T ≤ off (ch d) T + k := by
  have hP := gcd_hw_protocol a b ch H_CELLS H_BUNDLE
  have C := H_CELLS (consOf c)
  cases hk : opAt (consOf c) with
  | forkG i os =>
    rw [hk] at h C; simp only [dnOK, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨⟨rfl, h2⟩, h3⟩ := h
    have := dn_fork C (hP _) (mem_map_of_contains h2) (hP _) T; omega
  | forkH i os l hh dd hs =>
    rw [hk] at h C; simp only [dnOK, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨⟨rfl, h2⟩, h3⟩ := h
    have := dn_fork C (hP _) (mem_map_of_contains h2) (hP _) T; omega
  | join ins o e js jw =>
    rw [hk] at h C; simp only [dnOK, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨⟨h2, rfl⟩, h3⟩ := h
    have := dn_join C (mem_map_of_contains h2) (hP _) (hP _) T; omega
  | bjoin ins o ec ed =>
    rw [hk] at h C; simp only [dnOK, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨⟨h2, rfl⟩, h3⟩ := h
    have := dn_join C (mem_map_of_contains h2) (hP _) (hP _) T; omega
  | mux cc x y z mw =>
    rw [hk] at h C; simp only [dnOK, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq,
      decide_eq_true_eq] at h
    obtain ⟨⟨h2, rfl⟩, h3⟩ := h
    obtain ⟨j0, j1, M⟩ := C
    rcases h2 with (rfl | rfl) | rfl
    · have := dn_gen (hP _) (hP _) (fun t ht => (M.ca t ht).symm) T; omega
    · have := dn_gen (hP _) (hP _) (fun t ht => (M.xa t ht).2) T; omega
    · have := dn_gen (hP _) (hP _) (fun t ht => (M.ya t ht).2) T; omega
  | muxn cc x0 x1 x2 z nw =>
    rw [hk] at h C; simp only [dnOK, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq,
      decide_eq_true_eq] at h
    obtain ⟨⟨h2, rfl⟩, h3⟩ := h
    obtain ⟨j, M⟩ := C
    rcases h2 with ((rfl | rfl) | rfl) | rfl
    · have := dn_gen (hP _) (hP _) (fun t ht => (M.ca t ht).symm) T; omega
    · have := dn_gen (i := ch x0) (o := ch z) (hP _) (hP _) (fun t ht => (M.xa 0 (by decide) t ht).2) T; omega
    · have := dn_gen (i := ch x1) (o := ch z) (hP _) (hP _) (fun t ht => (M.xa 1 (by decide) t ht).2) T; omega
    · have := dn_gen (i := ch x2) (o := ch z) (hP _) (hP _) (fun t ht => (M.xa 2 (by decide) t ht).2) T; omega
  | amerge x y z w =>
    rw [hk] at h C; simp only [dnOK, Bool.and_eq_true, Bool.or_eq_true, beq_iff_eq,
      decide_eq_true_eq] at h
    obtain ⟨⟨h2, rfl⟩, h3⟩ := h
    obtain ⟨g1, g2, A⟩ := C
    rcases h2 with rfl | rfl
    · have := dn_gen (hP _) (hP _) (fun t ht => (A.xa t ht).2) T; omega
    · have := dn_gen (hP _) (hP _) (fun t ht => (A.ya t ht).2) T; omega
  | link i o =>
    rw [hk] at h C; simp only [dnOK, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
    obtain ⟨⟨rfl, rfl⟩, h3⟩ := h
    obtain ⟨cn, L⟩ := C
    have := dn_link L (hP _) (hP _) T; omega
  | _ => rw [hk] at h; simp [dnOK] at h

theorem dn2_sound (c d e : Fin NC) (h : dn2OK c d e (opAt (consOf c)) = true) (T : Nat) :
    off (ch c) T ≤ off (ch d) T + off (ch e) T + 1 := by
  have hP := gcd_hw_protocol a b ch H_CELLS H_BUNDLE
  have C := H_CELLS (consOf c)
  cases hk : opAt (consOf c) with
  | steerC j t f =>
    rw [hk] at h C; simp only [dn2OK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h
    exact dn_steer C (hP _) (hP _) (hP _) T
  | steerD j t f fd sw =>
    rw [hk] at h C; simp only [dn2OK, Bool.and_eq_true, beq_iff_eq] at h
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := h
    exact dn_steer C (hP _) (hP _) (hP _) T
  | _ => rw [hk] at h; simp [dn2OK] at h

/-- **The certificate is sound.** Given the spine bound `L`, every channel `c` offers at
most `al c * L + be c` tokens, at every time. -/
theorem off_cert (L : Nat) (hsp : ∀ c, sp c = true → ∀ T, off (ch c) T ≤ L) :
    ∀ c T, off (ch c) T ≤ (entOf c).al * L + (entOf c).be := by
  suffices H : ∀ n, ∀ c, (entOf c).ord = n → ∀ T, off (ch c) T ≤ (entOf c).al * L + (entOf c).be by
    intro c T; exact H _ c rfl T
  intro n
  refine Nat.strongRecOn n ?_
  intro n ih
  · intro c hn T
    have ok := List.all_eq_true.mp certOK c (List.mem_finRange c)
    have IH : ∀ d, (entOf d).ord < (entOf c).ord → off (ch d) T ≤ (entOf d).al * L + (entOf d).be :=
      fun d hd => ih _ (by omega) d rfl T
    unfold entOK at ok
    generalize (entOf c).r = r at ok
    cases r with
    | sp =>
      simp only [ruleOK, Bool.and_eq_true, decide_eq_true_eq] at ok
      have := hsp c ok.1 T
      have := Nat.mul_le_mul_right L ok.2
      omega
    | up d =>
      simp only [ruleOK, Bool.and_eq_true, decide_eq_true_eq] at ok
      obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := ok
      have := up_sound H_CELLS H_BUNDLE c d h1 T
      have := IH d h2
      have := Nat.mul_le_mul_right L h3
      omega
    | up2 d f =>
      simp only [ruleOK, Bool.and_eq_true, decide_eq_true_eq] at ok
      obtain ⟨⟨⟨⟨h1, h2⟩, h2'⟩, h3⟩, h4⟩ := ok
      have := up2_sound H_CELLS H_BUNDLE c d f h1 T
      have := IH d h2
      have := IH f h2'
      have := Nat.mul_le_mul_right L h3
      rw [Nat.add_mul] at this
      omega
    | up3 d f g =>
      simp only [ruleOK, Bool.and_eq_true, decide_eq_true_eq] at ok
      obtain ⟨⟨⟨⟨⟨h1, h2⟩, h2'⟩, h2''⟩, h3⟩, h4⟩ := ok
      have := up3_sound H_CELLS H_BUNDLE c d f g h1 T
      have := IH d h2
      have := IH f h2'
      have := IH g h2''
      have := Nat.mul_le_mul_right L h3
      rw [Nat.add_mul, Nat.add_mul] at this
      omega
    | dn d k =>
      simp only [ruleOK, Bool.and_eq_true, decide_eq_true_eq] at ok
      obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := ok
      have := dn_sound H_CELLS H_BUNDLE c d k h1 T
      have := IH d h2
      have := Nat.mul_le_mul_right L h3
      omega
    | dn2 d f =>
      simp only [ruleOK, Bool.and_eq_true, decide_eq_true_eq] at ok
      obtain ⟨⟨⟨⟨h1, h2⟩, h2'⟩, h3⟩, h4⟩ := ok
      have := dn2_sound H_CELLS H_BUNDLE c d f h1 T
      have := IH d h2
      have := IH f h2'
      have := Nat.mul_le_mul_right L h3
      rw [Nat.add_mul] at this
      omega

end

/-- **Every channel of gcd_hw offers at most `4L + 11` tokens, at every time**, under
H_CELLS, H_BUNDLE, H_START_ONCE, H_WALK and H_WALK_ENDS `L`. -/
theorem gcd_hw_offers_bounded (a b L : Nat) (ch : Fin NC → Chan)
    (H_CELLS : ∀ o : Fin NO, Cell ch (srcV a b) (opAt o))
    (H_BUNDLE : ∀ c, Held (ch c))
    (H_START_ONCE : ∀ t, cnt (riseB (ch start).req) t ≤ 1)
    (y : CapSafe.TS) (hy : Good a b y) (H_WALK : WalkOK (σY a b y) (omOf a b y))
    (H_WALK_ENDS : (walk (σY a b y) L).cur = none) :
    ∀ c T, cnt (riseB (ch c).req) T ≤ 4 * L + 11 := by
  intro c T
  have h := off_cert H_CELLS H_BUNDLE L (fun c hc T => by
    have := gcd_hw_spine_offers_bounded a b L ch H_CELLS H_BUNDLE H_START_ONCE y hy H_WALK
      H_WALK_ENDS c hc T
    unfold off; omega) c T
  have hs := List.all_eq_true.mp cert_small c (List.mem_finRange c)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hs
  have := Nat.mul_le_mul_right L hs.1
  unfold off at h
  omega

end Formal.Net.CapNet.Live.Nd

namespace Formal.Net.CapNet.Live.Nd
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.CapNet Formal.Net.CapNet.Gcd
open Formal.Net.CapNet.Live
open Formal.Net.CapSafe (Good)

/-- **gcd_hw circuit liveness with an explicit bound.** Under the cell, bundling,
one-invocation, token-walk and delay hypotheses, and the one open network obligation
H_NO_DEADLOCK', the circuit closes its first `out0` token before
`(1168 * (8L + 23) + 1) * (H + 1)` ticks, carrying `Nat.gcd a b`. `L` is the length of the
token-level spine walk for `(a, b)` (H_WALK_ENDS), `H` the per-gate delay bound. -/
theorem gcd_hw_live_bounded (a b H L : Nat) (ch : Fin NC → Chan) (itr : Itr)
    (H_CELLS : ∀ p : Fin NO, CellI ch (srcV a b) itr p (opAt p))
    (H_BUNDLE : ∀ c, Held (ch c))
    (H_START_ONCE : ∀ t, cnt (riseB (ch start).req) t ≤ 1)
    (y : CapSafe.TS) (hy : Good a b y) (H_WALK : WalkOK (σY a b y) (omOf a b y))
    (H_WALK_ENDS : (walk (σY a b y) L).cur = none)
    (H_BOUNDED_DELAY' : ∀ p, p ≠ prodOf start → ∀ g ∈ gatesK p (opAt p), BndG H (gsAt ch itr) g)
    (H_START_ENV : StartEnv H (ch start))
    (H_ARB_UNCONTESTED_BOUNDED : ∀ p x u z w, opAt p = .amerge x u z w →
      ArbUnc H (ch x) (ch u) (ch z) (itr p 0) (itr p 1))
    (H_NO_DEADLOCK' : ∀ t, cnt (fallB (ch out0).ack) t = 0 →
      ¬ (Quiet2 (gsAt ch itr t) ∧
         (cnt (riseB (ch start).req) t = 0 → (ch start).ack t = false → (ch start).req t = true))) :
    ∃ e, e < (1168 * (8 * L + 23) + 1) * (H + 1) ∧ TokAt (ch out0) 0 e ∧
      (ch out0).dat e = Nat.gcd a b := by
  have hC : ∀ p : Fin NO, Cell ch (srcV a b) (opAt p) := fun p => cellI_cell _ (H_CELLS p)
  have hO := gcd_hw_offers_bounded a b L ch hC H_BUNDLE H_START_ONCE y hy H_WALK H_WALK_ENDS
  obtain ⟨e, he, h1, h2⟩ := gcd_hw_live_nd a b H L (4 * L + 11) ch itr H_CELLS H_BUNDLE
    H_START_ONCE y hy H_WALK H_WALK_ENDS H_BOUNDED_DELAY' H_START_ENV H_ARB_UNCONTESTED_BOUNDED
    H_NO_DEADLOCK' (fun c _ T _ => hO c T)
  have hm : 2 * max L (4 * L + 11) + 1 = 8 * L + 23 := by omega
  rw [hm] at he
  exact ⟨e, he, h1, h2⟩

end Formal.Net.CapNet.Live.Nd
