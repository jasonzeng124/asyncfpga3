import Formal.Net.CapstoneWitnessCells
import Formal.Net.CapstoneWitnessWalk
import Formal.Net.CapstoneWitnessRun

/-!
# Probe C-8t: a joint, non-vacuous witness for the hypotheses of `gcd_hw_circuit_safe''`

`gcd_hw_joint_witness`: there is a circuit run `ch` of the concrete 465-channel gcd_hw network
on a = 12, b = 18 that satisfies ALL FOUR hypotheses of `gcd_hw_circuit_safe''` together
(H_CELLS, H_BUNDLE, H_START_ONCE, H_WALK) and in which out0 actually latches a token
(its acknowledge falls), carrying 6 = gcd 12 18.

* The run (`chW`, `CapstoneWitnessData`) is a unit-delay simulation of the gate models,
  generated by `formal/tools/capwit/gen_data.py` and checked entirely by the kernel
  (`CapstoneWitnessCells`), so the generator is not trusted.
* The token run `y` of H_WALK (`Yf.ts`, `CapstoneWitnessRun`) is a complete traced run of the
  GcdHw graph from `init 12 18`, certified in chunks; `Good` follows by `good_of_texec`.
* H_WALK is decided for that `y` by `walkChk` (the walk ends after fewer than 80 steps).

`gcd_hw_witness_consistent` then applies the safety theorem to the witness: the latched value
6 is, as it must be, `Nat.gcd 12 18`.

What this does NOT show: anything about other inputs, other schedules, or real delays. It is a
satisfiability (non-vacuity) result: the hypotheses are jointly consistent with a run that
delivers a result. It says nothing about whether the hypotheses hold of the silicon.
-/

namespace Formal.Net.CapNet.Wit
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.CapNet Formal.Net.CapNet.Gcd
  Formal.Net.CapSafe Formal.Net.GcdHw Formal.Net.GcdHw.Gcd

set_option maxRecDepth 100000

theorem ofL_rep (n : Nat) : ofL (List.replicate n ([] : List Nat)) = fun _ => [] := by
  funext c
  simp only [ofL, List.getD_eq_getElem?_getD, List.getElem?_replicate]
  split <;> rfl

theorem Y0_ok : Y0.ok := by
  refine ⟨?_, ?_, ?_⟩ <;> decide +kernel

theorem Y0_ts : Y0.ts = ⟨init A0 B0, fun _ => [], fun _ => []⟩ := by
  simp only [TL.ts, Y0, X0, ofL_rep]; rfl

theorem Yf_final : Yf.s = lmap [Nat.gcd A0 B0] T1 := by decide +kernel

/-- The complete token run used for H_WALK. -/
def yW : TS := Yf.ts

theorem yW_good : Good A0 B0 yW := by
  have h := (texecL_ok lsAll Y0_ok run_all).1
  rw [Y0_ts] at h
  exact good_of_texec h (by show ofL Yf.s = St T1 [Nat.gcd A0 B0]; rw [Yf_final]; rfl)

theorem walk_chk : walkChk (σY A0 B0 yW) (omOf A0 B0 yW) 80 (walk (σY A0 B0 yW) 0) = true := by
  decide +kernel

theorem yW_walk : WalkOK (σY A0 B0 yW) (omOf A0 B0 yW) := walkOK_of walk_chk

/-- **Joint non-vacuity of `gcd_hw_circuit_safe''`** (a = 12, b = 18): one circuit run meets all
four hypotheses, and out0 latches a token, whose value is 6 = gcd 12 18. -/
theorem gcd_hw_joint_witness :
    ∃ ch : Fin NC → Chan,
      (∀ o : Fin NO, Cell ch (srcV 12 18) (opAt o)) ∧
      (∀ c, Held (ch c)) ∧
      (∀ t, cnt (riseB (ch start).req) t ≤ 1) ∧
      (∃ y, Good 12 18 y ∧ WalkOK (σY 12 18 y) (omOf 12 18 y)) ∧
      (∃ k e, TokAt (ch out0) k e ∧ (ch out0).dat e = 6) :=
  ⟨chW, w_cells, w_held, w_start_once, ⟨yW, yW_good, yW_walk⟩, ⟨0, out0Close, w_out0⟩⟩

theorem gcd_12_18 : Nat.gcd 12 18 = 6 := by decide

/-- Sanity check: the safety theorem applied to the witness run gives the same value. -/
theorem gcd_hw_witness_consistent :
    (∀ k e, TokAt (chW out0) k e → (chW out0).dat e = 6) ∧ TokAt (chW out0) 0 out0Close := by
  have h := gcd_hw_circuit_safe'' 12 18 chW w_cells w_held w_start_once ⟨yW, yW_good, yW_walk⟩
  rw [gcd_12_18] at h
  exact ⟨h.1, w_out0.1⟩

end Formal.Net.CapNet.Wit
