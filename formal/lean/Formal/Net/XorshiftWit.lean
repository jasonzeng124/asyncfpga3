import Formal.Net.XorshiftWitData
import Formal.Net.KernelCapXorshift

/-!
# Probe C-wit: `xorshift_circuit_safe` (C-8y2) is not vacuous

One explicit run `chX` of the concrete 94-channel xorshift network (`XorshiftWitData`,
generated by `formal/tools/capwit2/gen_wit.py xorshift`: every gate of every cell model with
delay 1, each source offers once, sinks acknowledge after one tick) on seed = 2463534242,
rounds = 4 (the inputs of `kernels/xorshift/xorshift.c`'s own `main`) meets H_CELLS, H_BUNDLE
and H_START_ONCE and latches 2008045182 on out0.

The expected value 2008045182 is what the C function returns for these inputs
(`formal/tools/capwit2/expected.sh` compiles the function extracted from the .c file); it is
not read from the run. `xs_expected` checks it against the Lean transcription `xsSpec`, and
`xorshift_witness_consistent` applies `xorshift_circuit_safe` to the run.

Checks: `decide +kernel` over the event lists with C-8t's checker (`CapstoneWitnessLib`);
no `native_decide`.
-/

namespace Formal.Net.KCap.XorshiftWit
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.CapNet Formal.Net.CapNet.Wit
open Formal.Net.KCap Formal.Net.KCap.XorshiftInst

set_option maxRecDepth 100000

attribute [local instance] xorKD

/-- The run. -/
def chX : Fin XorshiftCap.NC → Chan := wch cdA

theorem xcells : XorshiftCap.ops.all (fun k => kChk cdA (CapNet.srcV 2463534242 4) k) = true := by
  decide +kernel

theorem ops_len : XorshiftCap.ops.length = XorshiftCap.NO := by decide +kernel

theorem getD_mem' {o : Fin XorshiftCap.NO} : KCap.opAt o ∈ XorshiftCap.ops := by
  show XorshiftCap.ops.getD o.val (K.sink 0) ∈ XorshiftCap.ops
  have h : o.val < XorshiftCap.ops.length := by rw [ops_len]; exact o.isLt
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_mem h

theorem x_cells : ∀ o : Fin XorshiftCap.NO, Cell chX (CapNet.srcV 2463534242 4) (KCap.opAt o) :=
  fun o => kChk_sound (CapNet.srcV 2463534242 4) (KCap.opAt o) (List.all_eq_true.mp xcells _ getD_mem')

theorem cds_len : cds.length = XorshiftCap.NC := by decide +kernel
theorem held_all : cds.all heldChk = true := by decide +kernel

theorem x_held : ∀ c : Fin XorshiftCap.NC, Held (chX c) := by
  intro c
  apply held_of
  apply List.all_eq_true.mp held_all
  unfold cdA
  have h : c.val < cds.length := by rw [cds_len]; exact c.isLt
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_mem h

theorem start_rq : (cdA XorshiftCap.start).rq = [0, 37] := by decide +kernel

theorem x_start_once : ∀ t, cnt (riseB (chX XorshiftCap.start).req) t ≤ 1 :=
  once_of start_rq (by decide)

theorem x_out0 : TokAt (chX XorshiftCap.out0) 0 263 ∧ (chX XorshiftCap.out0).dat 263 = 2008045182 := by
  refine ⟨⟨?_, ?_⟩, ?_⟩ <;> decide +kernel

/-- The C result for the witness inputs agrees with the Lean transcription. -/
theorem xs_expected : XorshiftHw.xsSpec 2463534242 4 = 2008045182 := by decide +kernel

/-- **A non-quiet joint witness for `xorshift_circuit_safe`.** -/
theorem xorshift_joint_witness :
    ∃ ch : Fin XorshiftCap.NC → Chan,
      (∀ o : Fin XorshiftCap.NO, Cell ch (CapNet.srcV 2463534242 4) (KCap.opAt o)) ∧   -- H_CELLS
      (∀ c, Held (ch c)) ∧                                                            -- H_BUNDLE
      (∀ t, Handshake.cnt (riseB (ch XorshiftCap.start).req) t ≤ 1) ∧                 -- H_START_ONCE
      (∃ k e, TokAt (ch XorshiftCap.out0) k e ∧ (ch XorshiftCap.out0).dat e = 2008045182) :=
  ⟨chX, x_cells, x_held, x_start_once, 0, 263, x_out0⟩

theorem xorshift_witness_consistent :
    (∀ k e, TokAt (chX XorshiftCap.out0) k e → (chX XorshiftCap.out0).dat e = 2008045182) ∧
    TokAt (chX XorshiftCap.out0) 0 263 := by
  have h := (xorshift_circuit_safe 2463534242 4 (by decide) chX x_cells x_held x_start_once).1
  rw [xs_expected] at h
  exact ⟨h, x_out0.1⟩

end Formal.Net.KCap.XorshiftWit
