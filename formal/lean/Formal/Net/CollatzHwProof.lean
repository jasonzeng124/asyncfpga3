import Formal.Net.CollatzHwSeg

/-!
# The imported collatz graph computes the C collatz step count, on every schedule (probe C-8v)

Core Lean only. Hand-written; `rules` and `seg*` are GENERATED by
`formal/tools/dfimport/mlir2lean.py` (unchanged tool, run with
`--ns Formal.Net.CollatzHw`) from `cloud/fixtures/frontend/collatz/comp/handshake_transformed.mlir`,
the MLIR `cells/hw/build_bench.sh collatz` feeds bdc.

## The C function
`collatzC` transcribes `kernels/collatz/collatz.c` by hand: `int steps = 0;
while (n != 1) { if ((n & 1) == 0) n = n >> 1; else n = 3 * n + 1;
steps = steps + 1; } return steps;`, `int` = i32 bit pattern, wrap-around
arithmetic (the hardware's; C leaves signed overflow undefined). Fuelled.

**Termination is NOT claimed** (it is the Collatz conjecture for positive `n`,
and false for `n = 0` and for some negative i32 `n`, e.g. -1 -> -2 -> -1).
Every result here is conditional on the C loop returning within some fuel,
except the finite range checked by `decide` in `collatz_terminates_small`.

Dynamatic rewrote the graph: the loop is rotated (entry tests `n == 1`, the
body ends with the test on the new `n`), `n != 1` became `n == 1` with swapped
branches, `(n & 1) == 0` became an i1 `trunci`/`andi`/`cmpi`, and `3 * n + 1`
became `(n + (n << 1)) + 1` (strength reduction). `gN_eq` proves all of this
agrees with the C.

## Theorems
* `collatz_hw_graph_computes_collatzC`: if `collatzC fuel n = some r`, then a
  complete run exists, every complete run (any schedule, any arbitration of the
  2 two-input control_merges) ends with exactly `[r]` on `out0` and the end
  token, after the same number of firings, and no run is longer.
* `collatz_hw_graph_live` / `_no_infinite_run` / `_maximal`: liveness under the
  same hypothesis (the C loop terminates on `n`), no fairness assumption.
* `collatz_terminates_small`: for `1 <= n < 256` the hypothesis holds (fuel
  200), checked by kernel `decide` on the C transcription; so for those inputs
  the graph results are unconditional (`collatz_hw_graph_small`).
-/

namespace Formal.Net.CollatzHw

open Formal.Net.Kahn Formal.Net.GcdHw

/-! ## The C function (kernels/collatz/collatz.c) -/

def isT (v : Nat) : Bool := v % 2 == 1

/-- `n = (n & 1) == 0 ? n >> 1 : 3 * n + 1` (the if/else of the loop body). -/
def stepC (n : Nat) : Nat :=
  if isT (Ops.cmpi .eq 32 (Ops.andi 32 n 1) 0) then Ops.shrsi 32 n 1
  else Ops.addi 32 (Ops.muli 32 3 n) 1

/-- `while (n != 1) { n = stepC n; steps = steps + 1; } return steps;` -/
def colLoop : Nat → Nat → Nat → Option Nat
  | 0, _, _ => none
  | f + 1, n, s =>
    if isT (Ops.cmpi .ne 32 n 1) then colLoop f (stepC n) (Ops.addi 32 s 1) else some s

def collatzC (fuel n : Nat) : Option Nat := colLoop fuel n 0

/-! ## What the graph computes, and Dynamatic's rewrites -/

/-- The fused regions `shli0+addi2+addi0` and `andi0+cmpi1+shrsi0+select0`. -/
def gN (n : Nat) : Nat :=
  Ops.select (Ops.cmpi .eq 1 (Ops.andi 1 (Ops.trunci 1 n) 1) 0) (Ops.shrsi 32 n 1)
    (Ops.addi 32 (Ops.addi 32 n (Ops.shli 32 n 1)) 1)
/-- `cmpi0` / `cmpi2`: `n == 1`. -/
def gE (n : Nat) : Nat := Ops.cmpi .eq 32 n 1

theorem andi1_trunc (v : Nat) : Ops.andi 1 (Ops.trunci 1 v) 1 = v % 2 := by
  simp only [Ops.andi, Ops.trunci, Nat.and_one_is_mod, Nat.pow_one]; omega

theorem andi32_one (v : Nat) : Ops.andi 32 v 1 = v % 2 := by
  simp only [Ops.andi, Nat.and_one_is_mod]; omega

/-- Strength reduction `3 * n + 1 = (n + (n << 1)) + 1` holds at i32. -/
theorem three_n (n : Nat) :
    Ops.addi 32 (Ops.addi 32 n (Ops.shli 32 n 1)) 1 = Ops.addi 32 (Ops.muli 32 3 n) 1 := by
  simp only [Ops.addi, Ops.shli, Ops.muli, Nat.shiftLeft_eq, Nat.pow_one, Nat.reducePow]
  omega

/-- The graph's loop body computes the C body. -/
theorem gN_eq (n : Nat) : gN n = stepC n := by
  unfold gN stepC; rw [andi1_trunc, andi32_one, three_n]
  have : n % 2 = 0 ∨ n % 2 = 1 := by omega
  rcases this with h | h <;> simp [Ops.cmpi, Ops.select, Ops.b2n, isT, h]

/-- `n != 1` (C) is the negation of `n == 1` (graph). -/
theorem ne_eq_not (n : Nat) : isT (Ops.cmpi .ne 32 n 1) = !isT (gE n) := by
  unfold gE Ops.cmpi
  by_cases h : n % 2 ^ 32 = 1 % 2 ^ 32 <;> simp [h, Ops.b2n, isT]

theorem extui10 : Ops.extui 1 0 = 0 := by decide

/-! ## Gluing the certificates (same scheme as C-8i) -/

abbrev G := graph rules

def St (t : List (List E)) (env : List Nat) : Store Nat Nat := ofL (lmap env t)

def Reach (s t : Store Nat Nat) : Prop := ∃ n, Run (step G) s n t

theorem reach_trans {s u t : Store Nat Nat} (h1 : Reach s u) (h2 : Reach u t) : Reach s t :=
  let ⟨_, a⟩ := h1; let ⟨_, b⟩ := h2; ⟨_, run_trans a b⟩

theorem edge {F : List (E × Bool)} {sched : List Nat} {sig : List E} {Ti Tj : List (List E)}
    (hl : Ti.length = N) (h : execL (symVI F) rules Ti sched = some (Tj.map (List.map (E.subst sig))))
    (env : List Nat) (hF : FactsOK env F) : Reach (St Ti env) (St Tj (sig.map (E.eval env))) := by
  have := sym_run bounded_ok hl sched h env hF
  rw [lmap_subst] at this
  exact ⟨_, this⟩

theorem edge' {F : List (E × Bool)} {sched : List Nat} {sig : List E} {Ti Tj : List (List E)}
    (hl : Ti.length = N) (h : execL (symVI F) rules Ti sched = some (Tj.map (List.map (E.subst sig))))
    (env env' : List Nat) (hF : FactsOK env F) (he : sig.map (E.eval env) = env') :
    Reach (St Ti env) (St Tj env') := he ▸ edge hl h env hF

theorem fact1 {env : List Nat} {e : E} {b : Bool} (h : (e.eval env % 2 == 1) = b) :
    FactsOK env [(e, b)] := by
  intro p hp; simp only [List.mem_singleton] at hp; subst hp; exact h

theorem lenT0 : T0.length = N := by decide +kernel
theorem lenT2 : T2.length = N := by decide +kernel

/-! ## One lemma per certified segment -/

theorem e0 (n : Nat) (hc : (gE n % 2 == 1) = true) :
    Reach (St T0 [n]) (St T1 [Ops.extui 1 0]) :=
  edge' lenT0 seg0 [n] _ (fact1 hc) (by
    simp only [sig0, List.map, E.eval, UOp.ev])

theorem e1 (n : Nat) (hc : (gE n % 2 == 1) = false) :
    Reach (St T0 [n]) (St T2 [gN n, Ops.addi 32 (Ops.extui 1 0) 1, gE (gN n)]) :=
  edge' lenT0 seg1 [n] _ (fact1 hc) (by
    simp only [sig1, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_zero,
      Option.getD_some, gN, gE])

theorem e2 (n s c : Nat) (hc : (c % 2 == 1) = true) :
    Reach (St T2 [n, s, c]) (St T1 [s]) :=
  edge' lenT2 seg2 [n, s, c] _ (fact1 hc) (by
    simp only [sig2, List.map, E.eval, List.getD, List.getElem?_cons_succ,
      List.getElem?_cons_zero, Option.getD_some])

theorem e3 (n s c : Nat) (hc : (c % 2 == 1) = false) :
    Reach (St T2 [n, s, c]) (St T2 [gN n, Ops.addi 32 s 1, gE (gN n)]) :=
  edge' lenT2 seg3 [n, s, c] _ (fact1 hc) (by
    simp only [sig3, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_succ,
      List.getElem?_cons_zero, Option.getD_some, gN, gE])

/-! ## The loop and the whole function -/

/-- From the loop head with C state `(n, steps)` (template 2 = `[n, steps, n == 1]`). -/
theorem loop_reach : ∀ f n s res, colLoop f n s = some res →
    Reach (St T2 [n, s, gE n]) (St T1 [res]) := by
  intro f; induction f with
  | zero => intro _ _ _ h; simp [colLoop] at h
  | succ f ih =>
    intro n s res h
    simp only [colLoop, ne_eq_not] at h
    by_cases hc : isT (gE n) = true
    · simp only [hc, Bool.not_true, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at h
      subst h; exact e2 n s (gE n) hc
    · simp only [hc, Bool.not_false, ↓reduceIte] at h
      have s3 := e3 n s (gE n) (by simpa [isT] using hc)
      rw [gN_eq] at s3
      exact reach_trans s3 (ih _ _ res h)

theorem reach_collatzC {fuel n r : Nat} (h : collatzC fuel n = some r) :
    Reach (St T0 [n]) (St T1 [r]) := by
  unfold collatzC at h
  cases fuel with
  | zero => simp [colLoop] at h
  | succ f =>
    simp only [colLoop, ne_eq_not] at h
    by_cases hc : isT (gE n) = true
    · simp only [hc, Bool.not_true, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at h
      subst h; have s0 := e0 n hc; rw [extui10] at s0; exact s0
    · simp only [hc, Bool.not_false, ↓reduceIte] at h
      have s1 := e1 n (by simpa [isT] using hc)
      rw [gN_eq, extui10] at s1
      exact reach_trans s1 (loop_reach f _ _ r h)

/-! ## Every schedule -/

theorem cnt_lmap (P : List Nat) (env : List Nat) (l : List (List E)) :
    cnt P (ofL (lmap env l)) = (P.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (n : Nat) : GcdHw.Inv spine (St T0 [n]) := by
  unfold GcdHw.Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (r : Nat) : Terminal (step G) (St T1 [r]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro x hx
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T1)) = true) x hx

theorem ofL_sp {V : Type} (n : Nat) (es : List (Nat × List V)) (c : Nat) :
    ofL (sp n es) c = if c < n then (es.lookup c).getD [] else [] := by
  unfold ofL sp; rw [List.getD_eq_getElem?_getD, List.getElem?_map]
  by_cases h : c < n
  · rw [List.getElem?_range h]; simp [h]
  · rw [List.getElem?_eq_none (by simp; omega)]; simp [h]

/-- The initial store: `n` and one start token; nothing else. -/
theorem init_store (n : Nat) :
    St T0 [n] chN = [n] ∧ St T0 [n] chStart = [0] ∧ ∀ c, 2 ≤ c → St T0 [n] c = [] := by
  refine ⟨rfl, rfl, fun c hc => ?_⟩
  simp only [St, ofL_lmap, List.map_eq_nil_iff, T0, ofL_sp]
  have h0 : (c == 0) = false := by simp; omega
  have h1 : (c == 1) = false := by simp; omega
  split <;> simp [List.lookup, h0, h1]

/-- The final store: the result on `out0`, the end token on `end`, nothing else. -/
theorem final_store (r : Nat) :
    St T1 [r] chOut = [r] ∧ St T1 [r] chEnd = [0] ∧
    ∀ c, c ≠ chOut → c ≠ chEnd → St T1 [r] c = [] := by
  refine ⟨rfl, rfl, fun c h1 h2 => ?_⟩
  simp only [St, ofL_lmap, List.map_eq_nil_iff, T1, ofL_sp]
  have h3 : (c == 3) = false := by simp [chEnd] at h2; simpa using h2
  have h47 : (c == 47) = false := by simp [chOut] at h1; simpa using h1
  split <;> simp [List.lookup, h3, h47]

/-- **The imported collatz graph computes the C step count, whenever the C
loop terminates.** -/
theorem collatz_hw_graph_computes_collatzC {fuel n r : Nat} (h : collatzC fuel n = some r) :
    (∃ k, Run (step G) (St T0 [n]) k (St T1 [r])) ∧
    (∀ m t, Run (step G) (St T0 [n]) m t → Terminal (step G) t →
      t = St T1 [r] ∧ t chOut = [r] ∧ t chEnd = [0]) ∧
    (∃ k, ∀ m u, Run (step G) (St T0 [n]) m u → m ≤ k) := by
  obtain ⟨k, hk⟩ := reach_collatzC h
  refine ⟨⟨k, hk⟩, fun m t ht hT => ?_, ⟨k, fun m u hu => ?_⟩⟩
  · have e := (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv n)
      hk (final_terminal r) ht hT).1
    subst e; exact ⟨rfl, (final_store r).1, (final_store r).2.1⟩
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv n)
      hk (final_terminal r) hu

/-! ## Liveness, conditional on termination of the C loop -/

theorem closedG : Closed (step G) (GcdHw.Inv spine) :=
  closed_of_check spine rules spine_nodup spine_ok

theorem diamondG : DiamondOn (step G) (GcdHw.Inv spine) :=
  wfOn_diamond (wfOn_of_check spine rules spine_nodup ins_ok outs_ok)

/-- If the C loop returns `r` on `n`, every partial run can be completed and
every completion ends in the final store with `[r]`, after the same number of
firings. -/
theorem collatz_hw_graph_live {fuel n r : Nat} (h : collatzC fuel n = some r) :
    ∀ m u, Run (step G) (St T0 [n]) m u →
      ∃ k, Run (step G) u k (St T1 [r]) ∧
        ∀ k' t, Run (step G) u k' t → Terminal (step G) t → t = St T1 [r] ∧ k' = k := by
  intro m u hu
  obtain ⟨k, hk⟩ := reach_collatzC h
  have hT := final_terminal r
  obtain ⟨_, hk'⟩ := prefix_run closedG diamondG hu hk hT (init_inv n)
  refine ⟨k - m, hk', fun k' t hk'' ht => ?_⟩
  have := (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv n)
    hk hT (run_trans hu hk'') ht)
  exact ⟨this.1, by omega⟩

theorem run_of_seq {σ : Nat → Store Nat Nat}
    (hσ : ∀ i, ∃ l, step G (σ i) l = some (σ (i + 1))) : ∀ i, Run (step G) (σ 0) i (σ i) := by
  intro i; induction i with
  | zero => exact Run.refl _
  | succ i ih =>
    obtain ⟨l, hl⟩ := hσ i
    exact run_trans ih (Run.cons l hl (Run.refl _))

theorem collatz_hw_graph_no_infinite_run {fuel n r : Nat} (h : collatzC fuel n = some r) :
    ¬ ∃ σ : Nat → Store Nat Nat, σ 0 = St T0 [n] ∧ ∀ i, ∃ l, step G (σ i) l = some (σ (i + 1)) := by
  rintro ⟨σ, h0, hσ⟩
  obtain ⟨K, hK⟩ := (collatz_hw_graph_computes_collatzC h).2.2
  have := hK (K + 1) (σ (K + 1)) (h0 ▸ run_of_seq hσ (K + 1))
  omega

theorem collatz_hw_graph_maximal {fuel n r : Nat} (h : collatzC fuel n = some r)
    {m : Nat} {t : Store Nat Nat} (hr : Run (step G) (St T0 [n]) m t)
    (hmax : ∀ l, step G t l = none) : t chOut = [r] :=
  ((collatz_hw_graph_computes_collatzC h).2.1 m t hr hmax).2.1

/-! ## A finite range where termination is checked -/

/-- The kernel's own `main` vector and the figure in its header comment
("27 takes 111"), evaluated on the C transcription. -/
example : collatzC 200 27 = some 111 := by decide +kernel

/-- For `1 <= n < 256` the C loop terminates within fuel 200 (kernel `decide`
on the C transcription; no claim beyond this range). -/
theorem collatz_terminates_small : ∀ n, n < 256 → 1 ≤ n → (collatzC 200 n).isSome = true := by
  decide +kernel

theorem collatz_hw_graph_small {n : Nat} (h1 : 1 ≤ n) (h2 : n < 256) :
    ∃ r, collatzC 200 n = some r ∧
      (∀ m t, Run (step G) (St T0 [n]) m t → Terminal (step G) t → t chOut = [r]) ∧
      ¬ ∃ σ : Nat → Store Nat Nat, σ 0 = St T0 [n] ∧ ∀ i, ∃ l, step G (σ i) l = some (σ (i + 1)) := by
  have hs := collatz_terminates_small n h2 h1
  cases hc : collatzC 200 n with
  | none => rw [hc] at hs; cases hs
  | some r =>
    exact ⟨r, rfl, fun m t ht hT => ((collatz_hw_graph_computes_collatzC hc).2.1 m t ht hT).2.1,
      collatz_hw_graph_no_infinite_run hc⟩

end Formal.Net.CollatzHw
