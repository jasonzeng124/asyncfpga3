import Formal.Net.OpsGcd

/-!
# Probe C-8j (1): a non-vacuity witness for 8f's `gcd_circuit`

`GcdHyps a b ch j0A j1A j0B j1B` bundles EVERY hypothesis of
`Formal.Net.Ops.Gcd.gcd_circuit` (the 15 cell gate models, the environment,
the two initial-token buffers, `H_BUNDLE` on all 25 channels);
`gcd_circuit_hyps` is `gcd_circuit` restated over it.

`gcd_witness`: for every odd `b` there is an explicit run with `a = 0`
satisfying all of `GcdHyps 0 b` in which `out` latches a token (`TokAt` at
t = 23) whose value is `Nat.gcd 0 b = b`. So the hypothesis set is
satisfiable by a run that delivers, not only by the all-quiet run.

The run (`Wip/C8j/gcd_run.py`): every gate moves to its function of the
previous tick (unit delay, a legal instance of the unbounded-delay SI/DI
models); the sources offer one token each; each initial-token buffer is a
2-PLACE buffer (it holds the initial `0` and accepts the next select token
while that is still being consumed). The table `tbl` (bitmasks of the 25
request wires, 25 acknowledge wires and the 4 internal mux C-elements, one row
per tick, `fin` from t = 31 on) is generated by the script; Lean re-checks
every gate rule on every step by kernel evaluation (`decide`).

Why `a = 0` only: `Formal.Net.Ops.Live.gcd_stuck` proves that for `a ≠ 0` no run
satisfying `GcdHyps` ever raises `out.req`: the 8b graph has no storage on its
data loop, so the loop's first token can never be acknowledged. The script
also finds that a 1-place initial-token buffer deadlocks even at `a = 0`
(observation, not a theorem here).
-/

namespace Formal.Net.Ops.Witness
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.Ops.Gcd
open Formal.Net.Ops.Fork Formal.Net.Ops.Join Formal.Net.Ops.Steer Formal.Net.Ops.Mux
open GC

/-! ## The hypotheses of `gcd_circuit`, bundled -/

structure GcdHyps (a b : Nat) (ch : GC → Chan) (j0A j1A j0B j1B : Trace) : Prop where
  H_MUXA : Mux tst (ch inA) (ch backA) (ch sA) (ch hA) j0A j1A
  H_MUXB : Mux tst (ch inB) (ch backB) (ch sB) (ch hB) j0B j1B
  H_FORKA : Fork (ch hA) [ch hA1, ch hA2]
  H_ISNZ : Join gNZ [ch hA1] (ch cnd)
  H_FORKC : Fork (ch cnd) [ch cA, ch cB, ch sA', ch sB']
  H_JOINA : Join gEnc [ch cA, ch hA2] (ch jA)
  H_BRA : Steer selE (· / 2) (ch jA) (fun b => ch (coutA b))
  H_JOINB : Join gEnc [ch cB, ch hB] (ch jB)
  H_BRB : Steer selE (· / 2) (ch jB) (fun b => ch (coutB b))
  H_SNKA : Sink (ch aF)
  H_FORKAT : Fork (ch aT) [ch a1, ch a2]
  H_FORKBT : Fork (ch bT) [ch b1, ch b2]
  H_SUB : Join gSub [ch a1, ch b1] (ch backA)
  H_MIN : Join gMin [ch a2, ch b2] (ch backB)
  H_SRCA : OpProto ch [] [inA] ∧ OpData ch [] [inA] (fun σ => ∀ k, σ inA k = a)
  H_SRCB : OpProto ch [] [inB] ∧ OpData ch [] [inB] (fun σ => ∀ k, σ inB k = b)
  H_INITBUFA : OpProto ch [sA'] [sA] ∧ OpData ch [sA'] [sA] (ibEq sA' sA)
  H_INITBUFB : OpProto ch [sB'] [sB] ∧ OpData ch [sB'] [sB] (ibEq sB' sB)
  H_ENV_OUT : OpProto ch [out] []
  H_BUNDLE : ∀ c, Held (ch c)

theorem gcd_circuit_hyps (a b : Nat) (hb : b % 2 = 1) (ha : a = 0 ∨ a % 2 = 1)
    (ch : GC → Chan) (j0A j1A j0B j1B : Trace) (H : GcdHyps a b ch j0A j1A j0B j1B) :
    ∀ k e, TokAt (ch out) k e → (ch out).dat e = Nat.gcd a b :=
  gcd_circuit a b hb ha ch j0A j1A j0B j1B H.H_MUXA H.H_MUXB H.H_FORKA H.H_ISNZ H.H_FORKC
    H.H_JOINA H.H_BRA H.H_JOINB H.H_BRB H.H_SNKA H.H_FORKAT H.H_FORKBT H.H_SUB H.H_MIN
    H.H_SRCA H.H_SRCB H.H_INITBUFA H.H_INITBUFB H.H_ENV_OUT H.H_BUNDLE

/-! ## The run as a table -/

/-- One tick: request bits, acknowledge bits (bit `idx c`), mux C-elements
(bits 0..3 = j0A j1A j0B j1B). -/
structure St where
  rq : Nat
  ak : Nat
  jj : Nat

def bit (n i : Nat) : Bool := (n >>> i) % 2 == 1

def idx : GC → Nat
  | inA => 0 | inB => 1 | sA => 2 | sB => 3 | backA => 4 | backB => 5 | hA => 6 | hB => 7
  | hA1 => 8 | hA2 => 9 | cnd => 10 | cA => 11 | cB => 12 | sA' => 13 | sB' => 14
  | jA => 15 | jB => 16 | aT => 17 | aF => 18 | bT => 19 | out => 20 | a1 => 21 | a2 => 22
  | b1 => 23 | b2 => 24

def allGC : List GC := [inA, inB, sA, sB, backA, backB, hA, hB, hA1, hA2, cnd, cA, cB, sA', sB',
  jA, jB, aT, aF, bT, out, a1, a2, b1, b2]

theorem mem_allGC (c : GC) : c ∈ allGC := by cases c <;> simp [allGC]

def at' : List St → St → Nat → St
  | [], d, _ => d
  | s :: _, _, 0 => s
  | _ :: l, d, t + 1 => at' l d t

def chk (P : St → St → Bool) : List St → St → Bool
  | [], d => P d d
  | s :: l, d => P s (at' l d 0) && chk P l d

theorem chk_all (P : St → St → Bool) : ∀ l d, chk P l d = true →
    ∀ t, P (at' l d t) (at' l d (t + 1)) = true := by
  intro l
  induction l with
  | nil => intro d h t; exact h
  | cons s l ih =>
    intro d h t
    simp only [chk, Bool.and_eq_true] at h
    cases t with
    | zero => exact h.1
    | succ t => exact ih d h.2 t

theorem at'_fin : ∀ (l : List St) (d : St) (t : Nat), l.length ≤ t → at' l d t = d := by
  intro l
  induction l with
  | nil => intro d t _; rfl
  | cons s l ih =>
    intro d t h
    cases t with
    | zero => simp at h
    | succ t => exact ih d t (by simp at h; omega)

def tbl : List St := [
  ⟨0, 0, 0⟩,
  ⟨15, 0, 0⟩,
  ⟨15, 0, 5⟩,
  ⟨207, 0, 5⟩,
  ⟨975, 0, 5⟩,
  ⟨1999, 0, 5⟩,
  ⟨32719, 0, 5⟩,
  ⟨131023, 24576, 5⟩,
  ⟨1441743, 24576, 5⟩,
  ⟨1441743, 1335296, 5⟩,
  ⟨1441743, 1433600, 5⟩,
  ⟨1441743, 1440384, 5⟩,
  ⟨1441743, 1441418, 5⟩,
  ⟨1441733, 1441674, 5⟩,
  ⟨1441733, 1441738, 1⟩,
  ⟨1441605, 1441743, 1⟩,
  ⟨1441600, 1441743, 1⟩,
  ⟨1441600, 1441743, 0⟩,
  ⟨1441536, 1441743, 0⟩,
  ⟨1440768, 1441743, 0⟩,
  ⟨1439744, 1441743, 0⟩,
  ⟨1409024, 1441743, 0⟩,
  ⟨1310720, 1417167, 0⟩,
  ⟨0, 1417167, 0⟩,
  ⟨0, 106447, 0⟩,
  ⟨0, 8143, 0⟩,
  ⟨0, 1359, 0⟩,
  ⟨0, 325, 0⟩,
  ⟨8, 69, 0⟩,
  ⟨8, 5, 0⟩,
  ⟨8, 0, 0⟩]
def fin : St := ⟨12, 0, 0⟩

def S (t : Nat) : St := at' tbl fin t

theorem allT (P : St → St → Bool) (h : chk P tbl fin = true) : ∀ t, P (S t) (S (t + 1)) = true :=
  chk_all P tbl fin h

theorem S_fin (t : Nat) (h : 31 ≤ t) : S t = fin := at'_fin tbl fin t (by simp [tbl]; omega)

def R (c : GC) (t : Nat) : Bool := bit (S t).rq (idx c)
def K (c : GC) (t : Nat) : Bool := bit (S t).ak (idx c)
def J (i : Nat) (t : Nat) : Bool := bit (S t).jj i

/-- The data: constant on every channel (`a = 0`, so every select is 0). -/
def dv (b : Nat) : GC → Nat
  | inA => 0 | inB => b | sA => 0 | sB => 0 | hA => 0 | hB => b | hA1 => 0 | hA2 => 0
  | cnd => gNZ [0] | cA => gNZ [0] | cB => gNZ [0] | sA' => gNZ [0] | sB' => gNZ [0]
  | jA => gEnc [gNZ [0], 0] | jB => gEnc [gNZ [0], b]
  | aT => gEnc [gNZ [0], 0] / 2 | aF => gEnc [gNZ [0], 0] / 2
  | bT => gEnc [gNZ [0], b] / 2 | out => gEnc [gNZ [0], b] / 2
  | a1 => gEnc [gNZ [0], 0] / 2 | a2 => gEnc [gNZ [0], 0] / 2
  | b1 => gEnc [gNZ [0], b] / 2 | b2 => gEnc [gNZ [0], b] / 2
  | backA => gSub [gEnc [gNZ [0], 0] / 2, gEnc [gNZ [0], b] / 2]
  | backB => gMin [gEnc [gNZ [0], 0] / 2, gEnc [gNZ [0], b] / 2]

def wch (b : Nat) (c : GC) : Chan := ⟨R c, K c, fun _ => dv b c⟩

/-! ## From the table to the gate rules -/

/-- `x` moves (from `x` to `x'`) only to a value every `y ∈ l` has. -/
def mv (x x' : Bool) (l : List Bool) : Bool := x' == x || l.all (· == x')

theorem mv_ok {x x' : Bool} {l : List Bool} (h : mv x x' l = true) (hne : x' ≠ x) :
    ∀ y ∈ l, y = x' := by
  intro y hy
  simp only [mv, Bool.or_eq_true, beq_iff_eq, List.all_eq_true] at h
  rcases h with h | h
  · exact absurd h hne
  · simpa using h y hy

theorem rq_mv (o : GC) (l : St → List Bool)
    (h : chk (fun s s' => mv (bit s.rq (idx o)) (bit s'.rq (idx o)) (l s)) tbl fin = true) :
    ∀ t, R o (t + 1) ≠ R o t → ∀ y ∈ l (S t), y = R o (t + 1) :=
  fun t => mv_ok (allT _ h t)

theorem ak_mv (o : GC) (l : St → List Bool)
    (h : chk (fun s s' => mv (bit s.ak (idx o)) (bit s'.ak (idx o)) (l s)) tbl fin = true) :
    ∀ t, K o (t + 1) ≠ K o t → ∀ y ∈ l (S t), y = K o (t + 1) :=
  fun t => mv_ok (allT _ h t)

theorem jj_mv (i : Nat) (l : St → List Bool)
    (h : chk (fun s s' => mv (bit s.jj i) (bit s'.jj i) (l s)) tbl fin = true) :
    ∀ t, J i (t + 1) ≠ J i t → ∀ y ∈ l (S t), y = J i (t + 1) :=
  fun t => mv_ok (allT _ h t)

/-- Both protocol rules on one channel, as a Boolean step check. -/
def rulesB (i : Nat) (s s' : St) : Bool :=
  (bit s'.rq i == bit s.rq i || bit s.rq i == bit s.ak i) &&
  (bit s'.ak i == bit s.ak i || bit s.ak i != bit s.rq i)

theorem rules_bool (r a r' a' : Bool) (h : ((r' == r || r == a) && (a' == a || a != r)) = true) :
    (r' ≠ r → r = a) ∧ (a' ≠ a → a ≠ r) := by
  cases r <;> cases a <;> cases r' <;> cases a' <;> simp_all

/-- Every channel of the run obeys the four-phase protocol at every step. -/
theorem rules_all : chk (fun s s' => allGC.all (fun c => rulesB (idx c) s s')) tbl fin = true := by
  decide

theorem wrules (b : Nat) (c : GC) (t : Nat) : Rules (wch b c) t := by
  have h := allT _ rules_all t
  simp only [List.all_eq_true] at h
  exact rules_bool _ _ _ _ (h c (mem_allGC c))

theorem init_all (c : GC) : R c 0 = false ∧ K c 0 = false := by cases c <;> decide

theorem m0 {α : Type} {a : α} {l : List α} : a ∈ a :: l := by simp
theorem m1 {α : Type} {a b : α} {l : List α} : b ∈ a :: b :: l := by simp
theorem m2 {α : Type} {a b c : α} {l : List α} : c ∈ a :: b :: c :: l := by simp
theorem m3 {α : Type} {a b c d : α} {l : List α} : d ∈ a :: b :: c :: d :: l := by simp

theorem mem2 {α : Type} {x a b : α} (h : x ∈ [a, b]) : x = a ∨ x = b := by simpa using h
theorem mem1 {α : Type} {x a : α} (h : x ∈ [a]) : x = a := by simpa using h
theorem mem4 {α : Type} {x a b c d : α} (h : x ∈ [a, b, c, d]) : x = a ∨ x = b ∨ x = c ∨ x = d := by
  simpa using h

/-! ### Cell instances -/

theorem sel_jA : selE (gEnc [gNZ [0], 0]) = false := by decide
theorem sel_jB (b : Nat) : selE (gEnc [gNZ [0], b]) = false := by
  simp [selE, gEnc, gNZ]

theorem w_mux (b : Nat) (x y c z : GC) (i0 i1 : Nat) (hc : dv b c = 0)
    (hd : ∀ t, (wch b z).dat t = if tst ((wch b c).dat t) then (wch b y).dat t else (wch b x).dat t)
    (h0 : chk (fun s s' => mv (bit s.jj i0) (bit s'.jj i0)
      [bit s.rq (idx x), bit s.rq (idx c) && !tst 0]) tbl fin = true)
    (h1 : chk (fun s s' => mv (bit s.jj i1) (bit s'.jj i1)
      [bit s.rq (idx y), bit s.rq (idx c) && tst 0]) tbl fin = true)
    (hz : chk (fun s s' => mv (bit s.rq (idx z)) (bit s'.rq (idx z))
      [bit s.jj i0 || bit s.jj i1]) tbl fin = true)
    (hx : chk (fun s s' => mv (bit s.ak (idx x)) (bit s'.ak (idx x))
      [bit s.jj i0, bit s.ak (idx z)]) tbl fin = true)
    (hy : chk (fun s s' => mv (bit s.ak (idx y)) (bit s'.ak (idx y))
      [bit s.jj i1, bit s.ak (idx z)]) tbl fin = true)
    (hca : chk (fun s s' => mv (bit s.ak (idx c)) (bit s'.ak (idx c))
      [bit s.ak (idx z)]) tbl fin = true)
    (hi : J i0 0 = false ∧ J i1 0 = false) :
    Mux tst (wch b x) (wch b y) (wch b c) (wch b z) (J i0) (J i1) where
  cj0 := fun t hne => by
    have := jj_mv i0 _ h0 t hne
    show R x t = J i0 (t + 1) ∧ (R c t && !tst (dv b c)) = J i0 (t + 1)
    rw [hc]; exact ⟨this _ m0, this _ m1⟩
  cj1 := fun t hne => by
    have := jj_mv i1 _ h1 t hne
    show R y t = J i1 (t + 1) ∧ (R c t && tst (dv b c)) = J i1 (t + 1)
    rw [hc]; exact ⟨this _ m0, this _ m1⟩
  zr := fun t hne => (rq_mv z _ hz t hne _ m0).symm
  xa := fun t hne => by
    have := ak_mv x _ hx t hne
    exact ⟨this _ m0, this _ m1⟩
  ya := fun t hne => by
    have := ak_mv y _ hy t hne
    exact ⟨this _ m0, this _ m1⟩
  ca := fun t hne => (ak_mv c _ hca t hne _ m0).symm
  dat := hd
  i0 := hi.1
  i1 := hi.2
  iz := (init_all z).1
  ix := (init_all x).2
  iy := (init_all y).2
  ic := (init_all c).2

theorem w_fork2 (b : Nat) (a o1 o2 : GC) (hd : dv b o1 = dv b a ∧ dv b o2 = dv b a)
    (hw1 : chk (fun s s' => mv (bit s.rq (idx o1)) (bit s'.rq (idx o1)) [bit s.rq (idx a)]) tbl fin = true)
    (hw2 : chk (fun s s' => mv (bit s.rq (idx o2)) (bit s'.rq (idx o2)) [bit s.rq (idx a)]) tbl fin = true)
    (hc : chk (fun s s' => mv (bit s.ak (idx a)) (bit s'.ak (idx a))
      [bit s.ak (idx o1), bit s.ak (idx o2)]) tbl fin = true) :
    Fork (wch b a) [wch b o1, wch b o2] where
  ne := by simp
  wire := fun o ho t hne => by
    rcases mem2 ho with rfl | rfl
    · exact (rq_mv o1 _ hw1 t hne _ m0).symm
    · exact (rq_mv o2 _ hw2 t hne _ m0).symm
  cel := fun t hne o ho => by
    have := ak_mv a _ hc t hne
    rcases mem2 ho with rfl | rfl
    · exact this _ m0
    · exact this _ m1
  dat := fun o ho t => by
    rcases mem2 ho with rfl | rfl
    · exact hd.1
    · exact hd.2
  initA := (init_all a).2
  initO := fun o ho => by rcases mem2 ho with rfl | rfl <;> exact (init_all _).1

theorem w_fork4 (b : Nat) (a o1 o2 o3 o4 : GC)
    (hd : dv b o1 = dv b a ∧ dv b o2 = dv b a ∧ dv b o3 = dv b a ∧ dv b o4 = dv b a)
    (hw1 : chk (fun s s' => mv (bit s.rq (idx o1)) (bit s'.rq (idx o1)) [bit s.rq (idx a)]) tbl fin = true)
    (hw2 : chk (fun s s' => mv (bit s.rq (idx o2)) (bit s'.rq (idx o2)) [bit s.rq (idx a)]) tbl fin = true)
    (hw3 : chk (fun s s' => mv (bit s.rq (idx o3)) (bit s'.rq (idx o3)) [bit s.rq (idx a)]) tbl fin = true)
    (hw4 : chk (fun s s' => mv (bit s.rq (idx o4)) (bit s'.rq (idx o4)) [bit s.rq (idx a)]) tbl fin = true)
    (hc : chk (fun s s' => mv (bit s.ak (idx a)) (bit s'.ak (idx a))
      [bit s.ak (idx o1), bit s.ak (idx o2), bit s.ak (idx o3), bit s.ak (idx o4)]) tbl fin = true) :
    Fork (wch b a) [wch b o1, wch b o2, wch b o3, wch b o4] where
  ne := by simp
  wire := fun o ho t hne => by
    rcases mem4 ho with rfl | rfl | rfl | rfl
    · exact (rq_mv o1 _ hw1 t hne _ m0).symm
    · exact (rq_mv o2 _ hw2 t hne _ m0).symm
    · exact (rq_mv o3 _ hw3 t hne _ m0).symm
    · exact (rq_mv o4 _ hw4 t hne _ m0).symm
  cel := fun t hne o ho => by
    have := ak_mv a _ hc t hne
    rcases mem4 ho with rfl | rfl | rfl | rfl
    · exact this _ m0
    · exact this _ m1
    · exact this _ m2
    · exact this _ m3
  dat := fun o ho t => by
    rcases mem4 ho with rfl | rfl | rfl | rfl
    · exact hd.1
    · exact hd.2.1
    · exact hd.2.2.1
    · exact hd.2.2.2
  initA := (init_all a).2
  initO := fun o ho => by rcases mem4 ho with rfl | rfl | rfl | rfl <;> exact (init_all _).1

theorem w_join1 (b : Nat) (g : List Nat → Nat) (i o : GC) (hd : dv b o = g [dv b i])
    (hc : chk (fun s s' => mv (bit s.rq (idx o)) (bit s'.rq (idx o)) [bit s.rq (idx i)]) tbl fin = true)
    (hw : chk (fun s s' => mv (bit s.ak (idx i)) (bit s'.ak (idx i)) [bit s.ak (idx o)]) tbl fin = true) :
    Join g [wch b i] (wch b o) where
  ne := by simp
  cel := fun t hne i' hi => by
    rw [mem1 hi]; exact rq_mv o _ hc t hne _ m0
  wire := fun i' hi t hne => by
    rw [mem1 hi] at hne ⊢; exact (ak_mv i _ hw t hne _ m0).symm
  dat := fun _ => hd
  initO := (init_all o).1
  initI := fun i' hi => by rw [mem1 hi]; exact (init_all i).2

theorem w_join2 (b : Nat) (g : List Nat → Nat) (i1 i2 o : GC) (hd : dv b o = g [dv b i1, dv b i2])
    (hc : chk (fun s s' => mv (bit s.rq (idx o)) (bit s'.rq (idx o))
      [bit s.rq (idx i1), bit s.rq (idx i2)]) tbl fin = true)
    (hw1 : chk (fun s s' => mv (bit s.ak (idx i1)) (bit s'.ak (idx i1)) [bit s.ak (idx o)]) tbl fin = true)
    (hw2 : chk (fun s s' => mv (bit s.ak (idx i2)) (bit s'.ak (idx i2)) [bit s.ak (idx o)]) tbl fin = true) :
    Join g [wch b i1, wch b i2] (wch b o) where
  ne := by simp
  cel := fun t hne i' hi => by
    have := rq_mv o _ hc t hne
    rcases mem2 hi with rfl | rfl
    · exact this _ m0
    · exact this _ m1
  wire := fun i' hi t hne => by
    rcases mem2 hi with rfl | rfl
    · exact (ak_mv i1 _ hw1 t hne _ m0).symm
    · exact (ak_mv i2 _ hw2 t hne _ m0).symm
  dat := fun _ => hd
  initO := (init_all o).1
  initI := fun i' hi => by rcases mem2 hi with rfl | rfl <;> exact (init_all _).2

theorem w_steer (b : Nat) (j : GC) (cout : Bool → GC) (hs : selE (dv b j) = false)
    (hd : ∀ bb, dv b (cout bb) = dv b j / 2)
    (hT : chk (fun s s' => mv (bit s.rq (idx (cout true))) (bit s'.rq (idx (cout true)))
      [bit s.rq (idx j) && (false == true)]) tbl fin = true)
    (hF : chk (fun s s' => mv (bit s.rq (idx (cout false))) (bit s'.rq (idx (cout false)))
      [bit s.rq (idx j) && (false == false)]) tbl fin = true)
    (ho : chk (fun s s' => mv (bit s.ak (idx j)) (bit s'.ak (idx j))
      [bit s.ak (idx (cout true)) || bit s.ak (idx (cout false))]) tbl fin = true) :
    Steer selE (· / 2) (wch b j) (fun bb => wch b (cout bb)) where
  lut := fun bb t hne => by
    show R (cout bb) (t + 1) = (R j t && (selE (dv b j) == bb))
    rw [hs]
    cases bb
    · exact (rq_mv _ _ hF t hne _ m0).symm
    · exact (rq_mv _ _ hT t hne _ m0).symm
  orr := fun t hne => (ak_mv j _ ho t hne _ m0).symm
  dat := fun bb _ => hd bb
  initJ := (init_all j).2
  initO := fun bb => (init_all _).1

/-! ### The environment -/

theorem w_src (b : Nat) (c : GC) (v : Nat) (hv : dv b c = v) :
    OpProto (wch b) [] [c] ∧ OpData (wch b) [] [c] (fun σ => ∀ k, σ c k = v) := by
  refine ⟨{ ag := ?_, initIn := ?_, initOut := ?_ }, ?_⟩
  · intro t _ _ _ _
    refine ⟨fun _ h => (by cases h), fun c' hc => ?_⟩
    rw [mem1 hc]; exact (wrules b c t).1
  · intro _ h; cases h
  · intro c' hc; rw [mem1 hc]; exact (init_all c).1
  · intro _ _ c' hc k r _ σ _ hE
    rw [mem1 hc]; rw [hE k]; exact hv.symm

/-- At least `k+1` events before `r`: the `k`-th one is at some `e < r`. -/
theorem cnt_ge (f : Nat → Bool) : ∀ r k, k + 1 ≤ cnt f r → ∃ e, e < r ∧ f e = true ∧ cnt f e = k := by
  intro r
  induction r with
  | zero => intro k h; simp [cnt] at h
  | succ r ih =>
    intro k h
    by_cases h1 : k + 1 ≤ cnt f r
    · obtain ⟨e, he, h2, h3⟩ := ih k h1; exact ⟨e, by omega, h2, h3⟩
    · simp only [cnt] at h
      cases hf : f r
      · simp [hf] at h; omega
      · simp [hf] at h; exact ⟨r, by omega, hf, by omega⟩

theorem rise_late (c : GC) (t : Nat) (h : 31 ≤ t) : riseB (R c) t = false := by
  simp [riseB, R, S_fin t h, S_fin (t + 1) (by omega)]

/-- The initial-token buffer feeding `o` from `i`: offers of `o` are at 0 and
`r1` only, the input's single offer is at 5 < r1. -/
theorem w_ibuf (b : Nat) (i o : GC) (r1 : Nat) (hr1 : r1 < 31) (h5 : 5 < r1)
    (hvi : dv b i = 0) (hvo : dv b o = 0)
    (hrise : ∀ t, t < 31 → riseB (R o) t = true → t = 0 ∨ t = r1)
    (hc1 : cnt (riseB (R o)) r1 = 1) (hoi : OffAt (wch b i) 0 5) :
    OpProto (wch b) [i] [o] ∧ OpData (wch b) [i] [o] (ibEq i o) := by
  refine ⟨⟨fun t _ _ _ _ => ⟨fun c' hc => ?_, fun c' hc => ?_⟩, fun c' hc => ?_, fun c' hc => ?_⟩, ?_⟩
  · rw [mem1 hc]; exact (wrules b i t).2
  · rw [mem1 hc]; exact (wrules b o t).1
  · rw [mem1 hc]; exact (init_all i).2
  · rw [mem1 hc]; exact (init_all o).1
  · intro _ _ c' hc k r hoff σ hag hE
    rw [mem1 hc] at hoff ⊢
    show σ o k = dv b o
    rw [hvo]
    cases k with
    | zero => exact hE.1
    | succ k =>
      rw [hE.2 k]
      have hr : r < 31 := by
        rcases Nat.lt_or_ge r 31 with h | h
        · exact h
        · have h2 : riseB (R o) r = true := hoff.1
          rw [rise_late o r h] at h2; cases h2
      rcases hrise r hr hoff.1 with rfl | rfl
      · have h2 : cnt (riseB (R o)) 0 = k + 1 := hoff.2
        simp [cnt] at h2
      · have hk : k = 0 := by
          have h2 : cnt (riseB (R o)) _ = k + 1 := hoff.2
          rw [hc1] at h2; omega
        subst hk
        rw [hag i 0 5 h5 hoi]; exact hvi

theorem w_env_out (b : Nat) : OpProto (wch b) [out] [] where
  ag := fun t _ _ _ _ => ⟨fun c' hc => by rw [mem1 hc]; exact (wrules b out t).2,
    fun _ h => by cases h⟩
  initIn := fun c' hc => by rw [mem1 hc]; exact (init_all out).2
  initOut := fun _ h => by cases h

theorem w_held (b : Nat) (c : GC) : Held (wch b c) := fun _ _ _ => rfl

/-! ## The witness -/

theorem w_sink (b : Nat) : Sink (wch b aF) where
  wire := fun t hne => (ak_mv aF (fun s => [bit s.rq (idx aF)]) (by decide) t hne _ m0).symm
  init := (init_all aF).2

/-- Non-vacuity of `gcd_circuit`: for every odd `b` there is a run satisfying
every hypothesis of `gcd_circuit` with `a = 0` in which `out` latches its
first token (at t = 23), and that token is `Nat.gcd 0 b`. -/
theorem gcd_witness (b : Nat) :
    ∃ (ch : GC → Chan) (j0A j1A j0B j1B : Trace), GcdHyps 0 b ch j0A j1A j0B j1B ∧
      TokAt (ch out) 0 23 ∧ (ch out).dat 23 = Nat.gcd 0 b := by
  refine ⟨wch b, J 0, J 1, J 2, J 3, ?_, ?_, ?_⟩
  · exact {
      H_MUXA := w_mux b inA backA sA hA 0 1 rfl (fun _ => rfl) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) ⟨(by decide), (by decide)⟩
      H_MUXB := w_mux b inB backB sB hB 2 3 rfl (fun _ => rfl) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) ⟨(by decide), (by decide)⟩
      H_FORKA := w_fork2 b hA hA1 hA2 ⟨rfl, rfl⟩ (by decide) (by decide) (by decide)
      H_ISNZ := w_join1 b gNZ hA1 cnd rfl (by decide) (by decide)
      H_FORKC := w_fork4 b cnd cA cB sA' sB' ⟨rfl, rfl, rfl, rfl⟩ (by decide) (by decide) (by decide) (by decide) (by decide)
      H_JOINA := w_join2 b gEnc cA hA2 jA rfl (by decide) (by decide) (by decide)
      H_BRA := w_steer b jA coutA sel_jA (fun bb => by cases bb <;> rfl) (by decide) (by decide) (by decide)
      H_JOINB := w_join2 b gEnc cB hB jB rfl (by decide) (by decide) (by decide)
      H_BRB := w_steer b jB coutB (sel_jB b) (fun bb => by cases bb <;> rfl) (by decide) (by decide) (by decide)
      H_SNKA := w_sink b
      H_FORKAT := w_fork2 b aT a1 a2 ⟨rfl, rfl⟩ (by decide) (by decide) (by decide)
      H_FORKBT := w_fork2 b bT b1 b2 ⟨rfl, rfl⟩ (by decide) (by decide) (by decide)
      H_SUB := w_join2 b gSub a1 b1 backA rfl (by decide) (by decide) (by decide)
      H_MIN := w_join2 b gMin a2 b2 backB rfl (by decide) (by decide) (by decide)
      H_SRCA := w_src b inA 0 rfl
      H_SRCB := w_src b inB b rfl
      H_INITBUFA := w_ibuf b sA' sA 30 (by decide) (by decide) (by simp [dv, gNZ]) rfl (by decide) (by decide)
        (show riseB (R sA') 5 = true ∧ cnt (riseB (R sA')) 5 = 0 from (by decide))
      H_INITBUFB := w_ibuf b sB' sB 27 (by decide) (by decide) (by simp [dv, gNZ]) rfl (by decide) (by decide)
        (show riseB (R sB') 5 = true ∧ cnt (riseB (R sB')) 5 = 0 from (by decide))
      H_ENV_OUT := w_env_out b
      H_BUNDLE := w_held b }
  · show fallB (K out) 23 = true ∧ cnt (fallB (K out)) 23 = 0
    decide
  · show gEnc [gNZ [0], b] / 2 = Nat.gcd 0 b
    simp [gEnc, gNZ]

/-- The witness is consistent with `gcd_circuit`: every token latched on `out`
in any run satisfying `GcdHyps 0 b` is `b`. -/
theorem gcd_witness_value (b : Nat) (hb : b % 2 = 1) (ch : GC → Chan) (j0A j1A j0B j1B : Trace)
    (H : GcdHyps 0 b ch j0A j1A j0B j1B) : ∀ k e, TokAt (ch out) k e → (ch out).dat e = b := by
  intro k e h
  rw [gcd_circuit_hyps 0 b hb (Or.inl rfl) ch j0A j1A j0B j1B H k e h, Nat.gcd_zero_left]

end Formal.Net.Ops.Witness
