import Formal.Net.PipeWitData
import Formal.Net.CapstoneCutSpine

/-!
# Probe C-pipe: the capstone's cell models admit REORDERED outputs under a pipelined environment

**Problem, plainly.** THE goal (formal/PROGRAM.md, owner 2026-10-31) lets the environment offer
pair k+1 as soon as pair k's input handshake completes, and asks that the k-th output be the
gcd of the k-th pair. The handshake-level theorems about gcd_hw (C-8l..8s3, `gcd_rig_all`)
assume, for every operator of the 465-channel CapNet network, its cell model (`CellR`), and
bundling on every channel (`Held`), with a SEQUENTIAL environment.

**Proved (kernel):** there is a run `chP` of the network in which
* every non-source operator meets its cell model (`CellR`, the capstone's H_CELLS without the
  sources) and every channel is bundled (`Held`);
* the three source channels (a = 0, b = 1, start = 2) obey the four-phase protocol
  (a request changes only to the negation of its acknowledge), and carry pair 1 =
  gcd_rig.v's vector 9, (a, b) = (65536, 4096), offered at tick 0 (requests low at reset) and vector 4, (1, 1),
  at their next offer at tick 142;
* out0's FIRST offer (tick 272) carries 1 = gcd 1 1 and its SECOND (tick 1044) carries
  4096 = gcd 65536 4096.
So under the capstone's own cell models, a pipelined environment gets the results in the
wrong order: the k-th output is not the gcd of the k-th pair.

**Not shown:** the run uses unit gate delays (one delay assignment); nothing here is about the
prjxray band or the bitstream. Data: `PipeWitData` (generated by
formal/tools/pipe/gen_pipewit.py from formal/tools/pipe/hwsim.py; untrusted, re-checked here).
-/

namespace Formal.Net.CapNet.PipeWit
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.CapNet Formal.Net.CapNet.Gcd
open Formal.Net.CapNet.RigWit

set_option maxRecDepth 100000

/-- The run. -/
def chP : Fin NC → Chan := wch cdA

def isSrc {n : Nat} : K n → Bool
  | .src .. => true
  | _ => false

/-- Every non-source operator passes the C-wit checker. -/
def nsChk (k : K NC) : Bool := isSrc k || kChkR cdA (srcV 0 0) k

theorem pcells1 : (ops.take 92).all nsChk = true := by decide +kernel
theorem pcells2 : ((ops.drop 92).take 92).all nsChk = true := by decide +kernel
theorem pcells3 : (((ops.drop 92).drop 92).take 92).all nsChk = true := by decide +kernel
theorem pcells4 : (((ops.drop 92).drop 92).drop 92).all nsChk = true := by decide +kernel

theorem pcells_all : ops.all nsChk = true := by
  rw [← List.take_append_drop 92 ops, List.all_append, pcells1, ← List.take_append_drop 92 (ops.drop 92),
    List.all_append, pcells2, ← List.take_append_drop 92 ((ops.drop 92).drop 92), List.all_append, pcells3,
    pcells4]; rfl

/-- H_CELLS (as `CellR`) for every non-source operator. -/
theorem p_cells : ∀ o : Fin NO, isSrc (opAt o) = false → CellR chP (srcV 0 0) (opAt o) := by
  intro o hs
  have h : nsChk (opAt o) = true := List.all_eq_true.mp pcells_all _ getD_mem
  simp only [nsChk, hs, Bool.false_or] at h
  exact kChkR_sound (srcV 0 0) (opAt o) h

theorem cds_len : cds.length = NC := by decide +kernel

theorem held_all : cds.all heldChk = true := by decide +kernel

/-- H_BUNDLE for every channel. -/
theorem p_held : ∀ c : Fin NC, Held (chP c) := by
  intro c
  apply held_of
  apply List.all_eq_true.mp held_all
  unfold cdA
  have h : c.val < cds.length := by rw [cds_len]; exact c.isLt
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_mem h

/-- The four-phase protocol on an environment-driven channel: its request changes only to the
negation of its acknowledge (rises only while the acknowledge is low, falls only while it is
high). No timing. -/
def FourPhaseEnv (z : Chan) : Prop := ∀ t, z.req (t + 1) ≠ z.req t → z.req (t + 1) = !z.ack t

def envChkP (z : Fin NC) : Bool := (cdA z).rq.all (fun e => rqv cdA z (e + 1) == !akv cdA z e)

theorem env_sound {z : Fin NC} (h : envChkP z = true) : FourPhaseEnv (chP z) := by
  intro t hmv
  have := step_ofR h hmv
  simpa [chP, wch, CD.ch] using this

def cA : Fin NC := ⟨0, by decide⟩
def cB : Fin NC := ⟨1, by decide⟩
def cS : Fin NC := ⟨2, by decide⟩

/-- The three sources are exactly channels 0, 1, 2 (a, b, start). -/
theorem srcs : ops.filterMap (fun k => match k with | .src z w _ => some (z.val, w) | _ => none) =
    [(0, 0), (1, 1), (2, 2)] := by decide +kernel

theorem p_env : FourPhaseEnv (chP cA) ∧ FourPhaseEnv (chP cB) ∧ FourPhaseEnv (chP cS) :=
  ⟨env_sound (by decide +kernel), env_sound (by decide +kernel), env_sound (by decide +kernel)⟩

/-- Pair 1 (vector 9) is offered at tick 0, pair 2 (vector 4) at tick 142. -/
theorem p_inputs :
    (OffAt (chP cA) 0 0 ∧ (chP cA).dat 1 = 65536 ∧ OffAt (chP cB) 0 0 ∧ (chP cB).dat 1 = 4096) ∧
    (OffAt (chP cA) 1 142 ∧ (chP cA).dat 143 = 1 ∧ OffAt (chP cB) 1 142 ∧ (chP cB).dat 143 = 1) ∧
    (OffAt (chP cS) 0 0 ∧ OffAt (chP cS) 1 142) := by
  refine ⟨⟨⟨?_, ?_⟩, ?_, ⟨?_, ?_⟩, ?_⟩, ⟨⟨?_, ?_⟩, ?_, ⟨?_, ?_⟩, ?_⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> decide +kernel

/-- out0's first offer carries 1, its second 4096. -/
theorem p_out0 :
    (OffAt (chP out0) 0 272 ∧ (chP out0).dat 273 = 1) ∧
    (OffAt (chP out0) 1 1044 ∧ (chP out0).dat 1045 = 4096) := by
  refine ⟨⟨⟨?_, ?_⟩, ?_⟩, ⟨⟨?_, ?_⟩, ?_⟩⟩ <;> decide +kernel

theorem gcds : Nat.gcd 1 1 = 1 ∧ Nat.gcd 65536 4096 = 4096 := by decide

/-- **Reordering under the capstone's cell models.** A run of the gcd_hw CapNet network meeting
every non-source cell model and bundling on every channel, with four-phase sources offering
gcd_rig's vector 9 (65536, 4096) and then vector 4 (1, 1), whose first output is gcd 1 1 = 1
and second is gcd 65536 4096 = 4096. -/
theorem gcd_hw_pipelined_reorder_handshake :
    ∃ ch : Fin NC → Chan,
      (∀ o : Fin NO, isSrc (opAt o) = false → CellR ch (srcV 0 0) (opAt o)) ∧
      (∀ c, Held (ch c)) ∧
      (FourPhaseEnv (ch cA) ∧ FourPhaseEnv (ch cB) ∧ FourPhaseEnv (ch cS)) ∧
      (OffAt (ch cA) 0 0 ∧ (ch cA).dat 1 = 65536 ∧ OffAt (ch cB) 0 0 ∧ (ch cB).dat 1 = 4096) ∧
      (OffAt (ch cA) 1 142 ∧ (ch cA).dat 143 = 1 ∧ OffAt (ch cB) 1 142 ∧ (ch cB).dat 143 = 1) ∧
      (OffAt (ch out0) 0 272 ∧ (ch out0).dat 273 = Nat.gcd 1 1) ∧
      (OffAt (ch out0) 1 1044 ∧ (ch out0).dat 1045 = Nat.gcd 65536 4096) := by
  refine ⟨chP, p_cells, p_held, p_env, p_inputs.1, p_inputs.2.1, ?_, ?_⟩
  · rw [gcds.1]; exact p_out0.1
  · rw [gcds.2]; exact p_out0.2

end Formal.Net.CapNet.PipeWit
