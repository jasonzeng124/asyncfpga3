import Formal.Net.IpowCapWalk
import Formal.Net.IpowCapRing

/-!
# Probe C-8y: circuit-level safety of ipow (the second kernel through the gcd_hw pipeline)

The concrete circuit network of `ipow_ps` (`IpowCapNet`, generated by
`formal/tools/capnet/capnet.py` from bdc's graph and bdc's link placement: 101 channels,
83 operators) is proved safe under exactly the hypotheses of gcd_hw's
`CapNet.Gcd.gcd_hw_circuit_safe''`, with the same gate models (`CapNet.Cell`):

* `ipow_circuit_safe3`: for every base `b` and every i32 bit pattern `e < 2^32`, every run
  `ch` of the network meeting H_CELLS (every operator meets its 8f/8j/8l gate model), H_BUNDLE
  (every channel bundled) and H_START_ONCE (start offered at most once) latches on `out0` only
  `ipowSpec b e` (= b^e mod 2^32 when e < 2^31 as an i32, else 1), and the latched list at
  every time is that value repeated once per close. H_WALK is PROVED (`ipow_hw_walk`, C-8s's
  proof instantiated).
* `ipow_circuit_safe`: the same with H_WALK as a hypothesis instead of `e < 2^32` (gcd_hw's
  `gcd_hw_circuit_safe''` form).
* `ipow_walk_run_exists`: a complete traced token run (`Good b e y`, the run H_WALK asks
  about) exists for every `b` and every i32 bit pattern `e < 2^32`. For `e ≥ 2^32` none does
  and the theorem is vacuous (bdc's graph only sees `e` mod 2^32 through its i32 ops, but the
  token-level theorem 8v proved is stated for `e < 2^32`).
* `ipowhw_ring_ge3` (`IpowCapRing`): every cycle of bdc's ipow graph carries >= 3 link
  stages; `ipowhw_not_ge4`: one cycle carries exactly 3 (tight); `ipowhw_has_cycle`.

The intermediate results carry the gcd names with the `ipow_hw_` prefix (`ipow_hw_forced`,
`ipow_hw_cut`, `ipow_hw_arbiters_uncontended'`), in the instantiated files.
-/

namespace Formal.Net.IpowCap
open Formal.Net Formal.Net.Handshake Formal.Net.Ops Formal.Net.GcdHw
open Formal.Net.CapNet hiding R Hh Hh_pr Hh_cn NoEnd JOK FoldOK OpChk

/-- **Circuit-level safety of ipow** (base `b`, exponent `e`): `ipow_hw_circuit_safe''` with
the kernel's argument names. -/
theorem ipow_circuit_safe (b e : Nat) (ch : Fin NC → Chan)
    (H_CELLS : ∀ o : Fin NO, Cell ch (srcV b e) (opAt o))
    (H_BUNDLE : ∀ c, Held (ch c))
    (H_START_ONCE : ∀ t, cnt (riseB (ch start).req) t ≤ 1)
    (H_WALK : ∃ y, Good b e y ∧ WalkOK (σY b e y) (omOf b e y)) :
    (∀ k v, TokAt (ch out0) k v → (ch out0).dat v = IpowHw.ipowSpec b e) ∧
    (∀ t, closedVals (ch out0) t =
      List.replicate (cnt (fallB (ch out0).ack) t) (IpowHw.ipowSpec b e)) :=
  ipow_hw_circuit_safe'' b e ch H_CELLS H_BUNDLE H_START_ONCE H_WALK

/-- **Circuit-level safety of ipow** from the gate models, bundling and a one-invocation
environment only (H_WALK proved by `ipow_hw_walk`). -/
theorem ipow_circuit_safe3 (b e : Nat) (he : e < 2 ^ 32) (ch : Fin NC → Chan)
    (H_CELLS : ∀ o : Fin NO, Cell ch (srcV b e) (opAt o))
    (H_BUNDLE : ∀ c, Held (ch c))
    (H_START_ONCE : ∀ t, cnt (riseB (ch start).req) t ≤ 1) :
    (∀ k v, TokAt (ch out0) k v → (ch out0).dat v = IpowHw.ipowSpec b e) ∧
    (∀ t, closedVals (ch out0) t =
      List.replicate (cnt (fallB (ch out0).ack) t) (IpowHw.ipowSpec b e)) :=
  ipow_hw_circuit_safe3 b e he ch H_CELLS H_BUNDLE H_START_ONCE

/-- The complete token run H_WALK is about exists on every i32 exponent. -/
theorem ipow_walk_run_exists (b : Nat) {e : Nat} (he : e < 2 ^ 32) : ∃ y, Good b e y :=
  good_exists b he

/-- The environment's `start` source is the network's `start` channel, and `out0` carries the
token graph's `out0` (channel 57) history: the two names in the statement are the right
channels (kernel-checked). -/
theorem ipow_ports : opAt (prodOf start) = .src start 2 0 ∧ tab.d out0.val = .hist 57 1 :=
  ⟨prod_start, out0_desc⟩

end Formal.Net.IpowCap
