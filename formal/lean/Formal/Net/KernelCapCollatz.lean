import Formal.Net.KernelCap
import Formal.Net.KernelCapChk
import Formal.Net.CollatzCapData
import Formal.Net.CollatzHwProof

/-!
# Probe C-8y2: collatz through the kernel-parametric capstone (the third kernel at circuit level)

collatz (`kernels/collatz/collatz.c`) has ONE data argument (`n`, channel 0) and start on
channel 1 (`nIn = 2`): the shape C-8y's text-copy pipeline refused. Its token level is C-8v's
(`CollatzHwProof`: the C transcription `collatzC`, `collatz_hw_graph_computes_collatzC`); the
network, spine and walk tables are generated by `capnet.py --kernel collatz kdata`
(`CollatzCapData`). No proof text is copied: `collatzKP` discharges the `KP` obligations, the
data checks by `decide +kernel` (through `KernelCapChk`), the C-reference facts from C-8v's
theorems.

The C function is partial (the Collatz conjecture for positive `n`; it loops for `n = 0` and
some negative i32 inputs), so the kernel's second argument is the FUEL: `spec n fuel` is the
C result when `collatzC fuel n` terminates, and `dom n fuel` says it does. The circuit ignores
the fuel (`srcVal n _ 0 = n`, start offers 0). collatz has no 3-input arbiter cascade; as for
ipow (C-8y), the cascade constants point at its 2-input control_merge0 (rules 15/16:
`cm 17|33 → 31`, index 32), and `acc` at circuit channel 0 (`g0.0`, not on the spine), so the
walk never takes the cascade branches.

`collatz_circuit_safe`: for every `n` and every fuel on which the C function returns `r`,
every run of the 81-channel network meeting H_CELLS, H_BUNDLE and H_START_ONCE latches only `r`
on `out0`. `collatz_circuit_safe_small`: for `1 ≤ n < 256` with no termination hypothesis
(C-8v's kernel-checked `collatz_terminates_small`).
-/

namespace Formal.Net.KCap.CollatzInst
open Formal.Net Formal.Net.Kahn Formal.Net.GcdHw Formal.Net.Handshake Formal.Net.Ops
open Formal.Net.CapNet hiding R Hh Hh_pr Hh_cn NoEnd JOK FoldOK OpChk
open Formal.Net.KCap

set_option maxRecDepth 100000

/-- The value source `which` offers: `n` on source 0, the start token's 0 on source 1. -/
def srcC (n _fuel which : Nat) : Nat := if which = 0 then n else 0

/-- collatz's data. -/
@[reducible] def collatzKD : KD where
  rules := CollatzHw.rules
  spine := CollatzHw.spine
  init n _ := CollatzHw.St CollatzHw.T0 [n]
  final r := CollatzHw.St CollatzHw.T1 [r]
  spec n fuel := (CollatzHw.collatzC fuel n).getD 0
  dom n fuel := (CollatzHw.collatzC fuel n).isSome = true
  chOut := CollatzHw.chOut
  chEnd := CollatzHw.chEnd
  nIn := CollatzCap.nIn
  srcVal := srcC
  NC := CollatzCap.NC
  NO := CollatzCap.NO
  nzC := inferInstance
  nzO := inferInstance
  ops := CollatzCap.ops
  tab := CollatzCap.tab
  prodT := CollatzCap.prodT
  consT := CollatzCap.consT
  out0 := CollatzCap.out0
  out0d := CollatzCap.out0d
  start := CollatzCap.start
  spL := CollatzCap.spL
  spN := CollatzCap.spN
  grpL := CollatzCap.grpL
  rhoL := CollatzCap.rhoL
  adjL := CollatzCap.adjL
  alL := CollatzCap.alL
  lcL := CollatzCap.lcL
  recs := CollatzCap.recs
  acc := 0
  cq1 := 17
  cq2 := 33
  cq3 := 999
  cres := 31
  cidx := 32
  cl1 := 15
  cl2 := 16

attribute [local instance] collatzKD

theorem good_run' (n fuel : Nat) (h : (CollatzHw.collatzC fuel n).isSome = true) :
    ∃ k, Run (step KCap.G) (KD.init n fuel) k (KD.final (KD.spec n fuel)) := by
  obtain ⟨r, hr⟩ := Option.isSome_iff_exists.mp h
  have e : (CollatzHw.collatzC fuel n).getD 0 = r := by rw [hr]; rfl
  show ∃ k, Run (step (graph CollatzHw.rules)) (CollatzHw.St CollatzHw.T0 [n]) k
    (CollatzHw.St CollatzHw.T1 [(CollatzHw.collatzC fuel n).getD 0])
  rw [e]
  exact (CollatzHw.collatz_hw_graph_computes_collatzC hr).1

theorem init_src' (a b w : Nat) (hw : w + 1 < 2) :
    CollatzHw.St CollatzHw.T0 [a] w = [srcC a b w] := by
  match w, hw with
  | 0, _ => exact (CollatzHw.init_store a).1

/-- collatz's proof obligations: data checks by kernel evaluation, C-reference facts from C-8v. -/
theorem collatzKP : KP where
  spine_nodup := CollatzHw.spine_nodup
  ins_ok := CollatzHw.ins_ok
  outs_ok := CollatzHw.outs_ok
  side_ok := by decide +kernel
  closedG := CollatzHw.closedG
  init_inv n _ := CollatzHw.init_inv n
  init_empty a _ c h := (CollatzHw.init_store a).2.2 c h
  init_src := init_src'
  init_start a _ := (CollatzHw.init_store a).2.1
  src_start _ _ := rfl
  final_out r := (CollatzHw.final_store r).1
  final_empty r c h1 h2 := (CollatzHw.final_store r).2.2 c h2 h1
  good_run := good_run'
  env_np := env_np_of (by decide +kernel)
  out_nc := by decide +kernel
  out_ge := by decide
  ops_ok := ops_ok_of (by decide +kernel) (by decide +kernel)
  rank_ok := rank_ok_of (by decide +kernel)
  nf_pos := by decide
  prod_out := prod_out_of (by decide +kernel)
  cons_in := cons_in_of (by decide +kernel)
  prod_mem := prod_mem_of (by decide +kernel)
  cons_mem := cons_mem_of (by decide +kernel)
  out0_desc := by decide +kernel
  spok := spok_of (by decide +kernel) (by decide +kernel)
  noloop := noloop_of (by decide +kernel)
  sp_start := by decide +kernel
  prod_start := rfl
  spN_chk := by decide +kernel
  recs_chk := by decide +kernel
  cOK_chk := by decide +kernel
  recs_glob := by decide +kernel
  init_chk := by decide +kernel
  grp_start := by decide +kernel
  spine_noend := by decide +kernel
  cmPair_chk := by decide +kernel
  lab_chk := by decide +kernel
  r154 := by decide +kernel
  r155 := by decide +kernel
  cq12 := by decide
  cq31 := by decide
  cq32 := by decide
  cq1_sp := by decide +kernel
  cq2_sp := by decide +kernel
  idx_ge := by decide
  start_acc := by decide

attribute [local instance] collatzKP

/-- **collatz at circuit level.** For every `n` and every fuel on which the C function
(`collatzC`, transcribed from `kernels/collatz/collatz.c`) returns `r`: every run `ch` of the
concrete collatz network whose operators meet their gate models (H_CELLS), whose channels are
bundled (H_BUNDLE) and whose start source is offered at most once (H_START_ONCE) latches only `r`
on `out0`, and the latched list at every time is `r` repeated. -/
theorem collatz_circuit_safe (n fuel r : Nat) (hr : CollatzHw.collatzC fuel n = some r)
    (ch : Fin CollatzCap.NC → Chan)
    (H_CELLS : ∀ o : Fin CollatzCap.NO, Cell ch (srcC n fuel) (KCap.opAt o))
    (H_BUNDLE : ∀ c, Held (ch c))
    (H_START_ONCE : ∀ t, Handshake.cnt (riseB (ch CollatzCap.start).req) t ≤ 1) :
    (∀ k v, TokAt (ch CollatzCap.out0) k v → (ch CollatzCap.out0).dat v = r) ∧
    (∀ t, closedVals (ch CollatzCap.out0) t =
      List.replicate (Handshake.cnt (fallB (ch CollatzCap.out0).ack) t) r) := by
  have hd : KD.dom n fuel := by show (CollatzHw.collatzC fuel n).isSome = true; rw [hr]; rfl
  have hs : KD.spec n fuel = r := by show (CollatzHw.collatzC fuel n).getD 0 = r; rw [hr]; rfl
  have := kernel_circuit_safe n fuel hd ch H_CELLS H_BUNDLE H_START_ONCE
  rw [hs] at this
  exact this

/-- For `1 ≤ n < 256`, unconditionally (fuel 200; C-8v's kernel-checked termination). -/
theorem collatz_circuit_safe_small (n : Nat) (h1 : 1 ≤ n) (h2 : n < 256)
    (ch : Fin CollatzCap.NC → Chan)
    (H_CELLS : ∀ o : Fin CollatzCap.NO, Cell ch (srcC n 200) (KCap.opAt o))
    (H_BUNDLE : ∀ c, Held (ch c))
    (H_START_ONCE : ∀ t, Handshake.cnt (riseB (ch CollatzCap.start).req) t ≤ 1) :
    ∃ r, CollatzHw.collatzC 200 n = some r ∧
      (∀ k v, TokAt (ch CollatzCap.out0) k v → (ch CollatzCap.out0).dat v = r) ∧
      (∀ t, closedVals (ch CollatzCap.out0) t =
        List.replicate (Handshake.cnt (fallB (ch CollatzCap.out0).ack) t) r) := by
  obtain ⟨r, hr⟩ := Option.isSome_iff_exists.mp (CollatzHw.collatz_terminates_small n h2 h1)
  exact ⟨r, hr, collatz_circuit_safe n 200 r hr ch H_CELLS H_BUNDLE H_START_ONCE⟩

/-- The example in the kernel's header comment: n = 27 takes 111 steps. -/
example : CollatzHw.collatzC 200 27 = some 111 := by decide +kernel

/-- The two names in the statement are the right channels (kernel-checked): `start` is the
environment's start source (`which = nIn - 1 = 1`), `out0` carries the token graph's out0
(channel 47) history. -/
theorem collatz_ports : KCap.opAt (KCap.prodOf CollatzCap.start) = .src CollatzCap.start 1 0 ∧
    CollatzCap.tab.d CollatzCap.out0.val = .hist 47 0 :=
  ⟨rfl, by decide +kernel⟩

end Formal.Net.KCap.CollatzInst
