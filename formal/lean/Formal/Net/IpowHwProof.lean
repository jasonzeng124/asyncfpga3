import Formal.Net.IpowHwSeg

/-!
# The imported ipow graph computes the C ipow, on every schedule (probe C-8v)

Core Lean only. Hand-written; the graph (`rules`) and the schedule certificates
(`seg*`) are GENERATED by `formal/tools/dfimport/mlir2lean.py` from
`cloud/fixtures/frontend/ipow/comp/handshake_transformed.mlir`, the MLIR that
`cells/hw/build_hw.sh ipow_ps` and `cells/hw/build_bench.sh ipow` feed bdc
(from `build/frontend/ipow/...`, restored from that fixture).

## The C function
`ipowC` transcribes `kernels/ipow/ipow.c` by hand (NOT the MLIR, NOT a run's
output): `int r = 1; while (e > 0) { if ((e & 1) == 1) r = r * b; b = b * b;
e = e >> 1; } return r;` with `int` as i32 two's complement bit patterns
(`Nat` below `2^32`) and the shared integer ops `Formal.Net.GcdHw.Ops`
(wrap-around `*`, i.e. the hardware's `muli`, not C's UB on signed overflow).
The loop is fuelled; `none` = fuel ran out.

The graph does NOT have the C loop's shape: Dynamatic rotated it (the entry
block tests `e > 0` once, the loop body ends with the test on the shifted `e`),
and replaced `(e & 1) == 1` by an i1 `trunci`/`andi`/`cmpi eq ... false` that
picks `r` in a `select`. `gR_eq` proves that rewrite agrees with the C.

## The theorem
`ipow_hw_graph_computes_ipowC`: for all naturals `b e` and any fuel on which
`ipowC` returns `r`, from the store with one token on each of `b`, `e`, `start`:
some schedule reaches `final r` (`[r]` on `out0`, the end token, nothing else);
EVERY complete run (any schedule, any arbitration of the 2 two-input
control_merges) ends there, after the same number of firings; no run is longer.
H_ONE_INVOCATION is proved from the initial store (`init_inv`), not assumed.
-/

namespace Formal.Net.IpowHw

open Formal.Net.Kahn Formal.Net.GcdHw

/-! ## The C function (kernels/ipow/ipow.c) -/

def isT (v : Nat) : Bool := v % 2 == 1

/-- `while (e > 0) { if ((e & 1) == 1) r = r * b; b = b * b; e = e >> 1; } return r;` -/
def ipowLoop : Nat → Nat → Nat → Nat → Option Nat
  | 0, _, _, _ => none
  | f + 1, r, b, e =>
    if isT (Ops.cmpi .sgt 32 e 0) then
      ipowLoop f (if isT (Ops.cmpi .eq 32 (Ops.andi 32 e 1) 1) then Ops.muli 32 r b else r)
        (Ops.muli 32 b b) (Ops.shrsi 32 e 1)
    else some r

/-- `int ipow(int b, int e) { int r = 1; while ... }` -/
def ipowC (fuel b e : Nat) : Option Nat := ipowLoop fuel 1 b e

/-! ## What the graph computes, and Dynamatic's i1 rewrite -/

/-- The fused region `andi0+cmpi1+muli0+select0`: `(e:i1 & true) == false ? r : r * b`. -/
def gR (r b e : Nat) : Nat :=
  Ops.select (Ops.cmpi .eq 1 (Ops.andi 1 (Ops.trunci 1 e) 1) 0) r (Ops.muli 32 r b)
/-- The loop condition `e > 0` (cmpi0 at entry, cmpi2 in the body). -/
def gC (e : Nat) : Nat := Ops.cmpi .sgt 32 e 0

theorem andi1_trunc (v : Nat) : Ops.andi 1 (Ops.trunci 1 v) 1 = v % 2 := by
  simp only [Ops.andi, Ops.trunci, Nat.and_one_is_mod, Nat.pow_one]; omega

theorem andi32_one (v : Nat) : Ops.andi 32 v 1 = v % 2 := by
  simp only [Ops.andi, Nat.and_one_is_mod]; omega

/-- Dynamatic's i1 rewrite of `(e & 1) == 1` agrees with the C. -/
theorem gR_eq (r b e : Nat) :
    gR r b e = if isT (Ops.cmpi .eq 32 (Ops.andi 32 e 1) 1) then Ops.muli 32 r b else r := by
  unfold gR; rw [andi1_trunc, andi32_one]
  have : e % 2 = 0 ∨ e % 2 = 1 := by omega
  rcases this with h | h <;> simp [Ops.cmpi, Ops.select, Ops.b2n, isT, h]

theorem extui11 : Ops.extui 1 1 = 1 := by decide

/-! ## Gluing the certificates (same scheme as C-8i's GcdHwProof) -/

abbrev G := graph rules

def St (t : List (List E)) (env : List Nat) : Store Nat Nat := ofL (lmap env t)

def Reach (s t : Store Nat Nat) : Prop := ∃ n, Run (step G) s n t

theorem reach_trans {s u t : Store Nat Nat} (h1 : Reach s u) (h2 : Reach u t) : Reach s t :=
  let ⟨_, a⟩ := h1; let ⟨_, b⟩ := h2; ⟨_, run_trans a b⟩

theorem edge {F : List (E × Bool)} {sched : List Nat} {sig : List E} {Ti Tj : List (List E)}
    (hl : Ti.length = N) (h : execL (symVI F) rules Ti sched = some (Tj.map (List.map (E.subst sig))))
    (env : List Nat) (hF : FactsOK env F) : Reach (St Ti env) (St Tj (sig.map (E.eval env))) := by
  have := sym_run bounded_ok hl sched h env hF
  rw [lmap_subst] at this
  exact ⟨_, this⟩

theorem edge' {F : List (E × Bool)} {sched : List Nat} {sig : List E} {Ti Tj : List (List E)}
    (hl : Ti.length = N) (h : execL (symVI F) rules Ti sched = some (Tj.map (List.map (E.subst sig))))
    (env env' : List Nat) (hF : FactsOK env F) (he : sig.map (E.eval env) = env') :
    Reach (St Ti env) (St Tj env') := he ▸ edge hl h env hF

theorem fact1 {env : List Nat} {e : E} {b : Bool} (h : (e.eval env % 2 == 1) = b) :
    FactsOK env [(e, b)] := by
  intro p hp; simp only [List.mem_singleton] at hp; subst hp; exact h

theorem lenT0 : T0.length = N := by decide +kernel
theorem lenT1 : T1.length = N := by decide +kernel

/-! ## One lemma per certified segment -/

/-- entry, `e > 0`: into the rotated loop, after its first body (`r = 1`). -/
theorem e0 (b e : Nat) (hc : (gC e % 2 == 1) = true) :
    Reach (St T0 [b, e])
      (St T1 [gR (Ops.extui 1 1) b e, Ops.muli 32 b b, Ops.shrsi 32 e 1, gC (Ops.shrsi 32 e 1)]) :=
  edge' lenT0 seg0 [b, e] _ (fact1 hc) (by
    simp only [sig0, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_succ,
      List.getElem?_cons_zero, Option.getD_some, gR, gC])

/-- entry, `e <= 0`: the result is the literal 1 (`extui` of `true`). -/
theorem e1 (b e : Nat) (hc : (gC e % 2 == 1) = false) :
    Reach (St T0 [b, e]) (St T2 [Ops.extui 1 1]) :=
  edge' lenT0 seg1 [b, e] _ (fact1 hc) (by
    simp only [sig1, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_succ,
      List.getElem?_cons_zero, Option.getD_some, gR, gC])

/-- loop head (template 1 = `[r, b, e, e > 0]`), condition true: one more body. -/
theorem e2 (r b e c : Nat) (hc : (c % 2 == 1) = true) :
    Reach (St T1 [r, b, e, c])
      (St T1 [gR r b e, Ops.muli 32 b b, Ops.shrsi 32 e 1, gC (Ops.shrsi 32 e 1)]) :=
  edge' lenT1 seg2 [r, b, e, c] _ (fact1 hc) (by
    simp only [sig2, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_succ,
      List.getElem?_cons_zero, Option.getD_some, gR, gC])

/-- loop head, condition false: exit with `r`. -/
theorem e3 (r b e c : Nat) (hc : (c % 2 == 1) = false) :
    Reach (St T1 [r, b, e, c]) (St T2 [r]) :=
  edge' lenT1 seg3 [r, b, e, c] _ (fact1 hc) (by
    simp only [sig3, List.map, E.eval, BOp.ev, UOp.ev, List.getD, List.getElem?_cons_succ,
      List.getElem?_cons_zero, Option.getD_some, gR, gC])

/-! ## The loop and the whole function -/

theorem tF {v : Nat} (h : ¬ isT v = true) : (v % 2 == 1) = false := by
  simpa [isT] using h

/-- The rotated loop: from the loop head with C state `(r, b, e)`, the graph
reaches `final` with whatever the C loop returns from that state. -/
theorem loop_reach : ∀ f r b e res, ipowLoop f r b e = some res →
    Reach (St T1 [r, b, e, gC e]) (St T2 [res]) := by
  intro f; induction f with
  | zero => intro _ _ _ _ h; simp [ipowLoop] at h
  | succ f ih =>
    intro r b e res h
    simp only [ipowLoop] at h
    by_cases hc : isT (Ops.cmpi .sgt 32 e 0) = true
    · simp only [hc, ↓reduceIte] at h
      have s := e2 r b e (gC e) hc
      rw [gR_eq] at s
      exact reach_trans s (ih _ _ _ res h)
    · simp only [hc, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at h; subst h
      exact e3 r b e (gC e) (tF hc)

theorem reach_ipowC {fuel b e r : Nat} (h : ipowC fuel b e = some r) :
    Reach (St T0 [b, e]) (St T2 [r]) := by
  unfold ipowC at h
  cases fuel with
  | zero => simp [ipowLoop] at h
  | succ f =>
    simp only [ipowLoop] at h
    by_cases hc : isT (Ops.cmpi .sgt 32 e 0) = true
    · simp only [hc, ↓reduceIte] at h
      have s := e0 b e hc
      rw [extui11, gR_eq] at s
      exact reach_trans s (loop_reach f _ _ _ r h)
    · simp only [hc, Bool.false_eq_true, ↓reduceIte, Option.some.injEq] at h; subst h
      have s := e1 b e (tF hc)
      rw [extui11] at s
      exact s

/-! ## Every schedule -/

theorem cnt_lmap (P : List Nat) (env : List Nat) (l : List (List E)) :
    cnt P (ofL (lmap env l)) = (P.map fun c => (ofL l c).length).sum := by
  unfold cnt; congr 1; apply List.map_congr_left; intro c _; simp [ofL_lmap]

theorem init_inv (b e : Nat) : GcdHw.Inv spine (St T0 [b, e]) := by
  unfold GcdHw.Inv St; rw [cnt_lmap]; decide +kernel

theorem final_terminal (r : Nat) : Terminal (step G) (St T2 [r]) := by
  apply terminal_of_dead
  rw [List.all_eq_true]; intro x hx
  rw [St, dead_lmap]
  exact List.all_eq_true.mp (by decide +kernel : rules.all (Rule.dead (ofL T2)) = true) x hx

theorem ofL_sp {V : Type} (n : Nat) (es : List (Nat × List V)) (c : Nat) :
    ofL (sp n es) c = if c < n then (es.lookup c).getD [] else [] := by
  unfold ofL sp; rw [List.getD_eq_getElem?_getD, List.getElem?_map]
  by_cases h : c < n
  · rw [List.getElem?_range h]; simp [h]
  · rw [List.getElem?_eq_none (by simp; omega)]; simp [h]

/-- The initial store: `b`, `e`, and one start token; nothing else. -/
theorem init_store (b e : Nat) :
    St T0 [b, e] chB = [b] ∧ St T0 [b, e] chE = [e] ∧ St T0 [b, e] chStart = [0] ∧
    ∀ c, 3 ≤ c → St T0 [b, e] c = [] := by
  refine ⟨rfl, rfl, rfl, fun c hc => ?_⟩
  simp only [St, ofL_lmap, List.map_eq_nil_iff, T0, ofL_sp]
  have h0 : (c == 0) = false := by simp; omega
  have h1 : (c == 1) = false := by simp; omega
  have h2 : (c == 2) = false := by simp; omega
  split <;> simp [List.lookup, h0, h1, h2]

/-- The final store: the result on `out0`, the end token on `end`. -/
theorem final_store (r : Nat) :
    St T2 [r] chOut = [r] ∧ St T2 [r] chEnd = [0] := ⟨rfl, rfl⟩

/-- The final store has nothing on any channel but `out0` and `end`. -/
theorem final_store_only (r : Nat) : ∀ c, c ≠ chOut → c ≠ chEnd → St T2 [r] c = [] := by
  intro c h1 h2
  simp only [St, ofL_lmap, List.map_eq_nil_iff, T2, ofL_sp]
  have h4 : (c == 4) = false := by simp [chEnd] at h2; simpa using h2
  have h57 : (c == 57) = false := by simp [chOut] at h1; simpa using h1
  split <;> simp [List.lookup, h4, h57]

/-- **The imported ipow graph computes the C ipow.** For every input on which
the C function returns `r` (with some fuel), a complete run reaching
`[r]` on `out0` exists; every complete run, under any schedule and any
arbitration, ends in that same store after the same number of firings; and no
run (complete or not) is longer. -/
theorem ipow_hw_graph_computes_ipowC {fuel b e r : Nat} (h : ipowC fuel b e = some r) :
    (∃ n, Run (step G) (St T0 [b, e]) n (St T2 [r])) ∧
    (∀ m t, Run (step G) (St T0 [b, e]) m t → Terminal (step G) t → t = St T2 [r]) ∧
    (∃ n, ∀ m u, Run (step G) (St T0 [b, e]) m u → m ≤ n) := by
  obtain ⟨n, hn⟩ := reach_ipowC h
  refine ⟨⟨n, hn⟩, fun m t ht hT => ?_, ⟨n, fun m u hu => ?_⟩⟩
  · exact (determinate spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv b e)
      hn (final_terminal r) ht hT).1
  · exact no_longer spine rules spine_nodup ins_ok outs_ok spine_ok (init_inv b e)
      hn (final_terminal r) hu

end Formal.Net.IpowHw
