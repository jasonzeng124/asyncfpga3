import Formal.Net.Ops

/-!
# Probe C-8l (1b): bdc's one-level N-way mux (`emit_muxn`, N = 3)

`bdc/emit.py` `emit_muxn(width, 3)` (`bdc_muxn3_W`), the cell bdc emits for
gcd_hw's 3-way loop-header mux (`mux` on i2):

    sel[k]  = ctl_req & (s == k)          s = ctl_data (2 bits)
    j_k     = C(in_k_req, sel[k])         bd_c2 uj_k
    z_req   = delta(|j)                   LUT1 uor + request_delay (matched line)
    in_k_ack = C(j_k, z_ack)              bd_c2 ua_k
    ctl_ack = z_ack
    z_data  = in_s_data                   (_data_mux)

It is NOT a tree of 2-way muxes (its header: a tree would need the index at
every level, and a forked index deadlocks); C-8j found its SI reachable set.

Gate model `MuxN sel xs c z j` (SI gates, binary; same primitive models as 8f's
`OpsMux`): H_CEL_SI on `j_k` and `in_k_ack` (the `sel[k]` AND is folded into
the `j_k` excitation, i.e. lumped with the C-element: H_LUT_SI on a gate whose
only moving input during a control transaction is `ctl_req`, because `s` is
held by H_BUNDLE of the control channel), H_DELAY_LUMPED (OR + matched delay one
unbounded inertial node), H_WIRE_DI on `ctl_ack`, H_DATA_COMB for `z_data`
(the real data-mux delay is in `Held z`). The select `s` is any function
`sel : Nat → Nat` of the control bus; values ≥ 3 select nothing (the control
token then waits forever, which is safe).

The state space (13 wires, `s` clipped to 0..3) has 648 reachable states
(594 with `s < 3`, C-8j's count), found by `Wip/C8l/muxn_reach.py`; the counter
differences are a function of the state, so the table is ONE bitmask `TB` over
the 15-bit state code (a byte per code: member bit + 4 counters).
`muxn_closed_s` re-checks closure by kernel `decide`, split by the select value
(4 declarations) to keep each kernel run small. Lookups are kernel GMP
arithmetic (`Nat.shiftRight`, `%`), not list search.

Proved: `muxn_proto` (causal AG), `muxn_op` with the token equation
`σ z k = σ (xs m) (#{i < k : sel (σ c i) = m})` where `m = sel (σ c k) < 3`.
-/

namespace Formal.Net.Ops.MuxN
open Formal.Net Formal.Net.Handshake Formal.Net.Ops

def b2n (b : Bool) : Nat := if b then 1 else 0

/-- The 13 wires of the cell (plus the environment's) and the clipped select. -/
structure MS where
  r0 : Bool
  r1 : Bool
  r2 : Bool
  a0 : Bool
  a1 : Bool
  a2 : Bool
  cr : Bool
  ca : Bool
  zr : Bool
  za : Bool
  j0 : Bool
  j1 : Bool
  j2 : Bool
  s : Nat
  deriving DecidableEq

/-- GENERATED by `Wip/C8l/muxn_reach.py -lean`: byte `code e` of `TB` is
`1 + 2*dc + 4*d0 + 16*d1 + 64*d2` for a reachable state, `0` otherwise. -/
def TB : Nat := 

def code (e : MS) : Nat :=
  b2n e.r0 + 2 * b2n e.r1 + 4 * b2n e.r2 + 8 * b2n e.a0 + 16 * b2n e.a1 + 32 * b2n e.a2 +
  64 * b2n e.cr + 128 * b2n e.ca + 256 * b2n e.zr + 512 * b2n e.za + 1024 * b2n e.j0 +
  2048 * b2n e.j1 + 4096 * b2n e.j2 + 8192 * e.s

def byte (e : MS) : Nat := (TB >>> (8 * code e)) % 256
def mem (e : MS) : Bool := byte e % 2 == 1
def dcOf (e : MS) : Nat := (byte e >>> 1) % 2
def dkOf (e : MS) (k : Nat) : Nat := (byte e >>> (2 + 2 * k)) % 4

def rq (e : MS) (m : Nat) : Bool := if m = 0 then e.r0 else if m = 1 then e.r1 else e.r2
def ak (e : MS) (m : Nat) : Bool := if m = 0 then e.a0 else if m = 1 then e.a1 else e.a2

/-- What the closure check concludes about one allowed step. -/
def Concl (e : MS) (r0 r1 r2 a0 a1 a2 cr ca zr za j0 j1 j2 : Bool) (s : Nat) : Prop :=
  let n : MS := ⟨r0, r1, r2, a0, a1, a2, cr, ca, zr, za, j0, j1, j2, s⟩
  mem n = true ∧
  dcOf n + b2n (!e.zr && zr) = dcOf e + b2n (!e.cr && cr) ∧
  dkOf n 0 + b2n (!e.cr && cr && s == 0) = dkOf e 0 + b2n (!e.r0 && r0) ∧
  dkOf n 1 + b2n (!e.cr && cr && s == 1) = dkOf e 1 + b2n (!e.r1 && r1) ∧
  dkOf n 2 + b2n (!e.cr && cr && s == 2) = dkOf e 2 + b2n (!e.r2 && r2) ∧
  ((!e.zr && zr) = true → e.cr = true ∧ e.ca = false ∧ e.za = false ∧ dcOf e = 1 ∧
     e.s < 3 ∧ rq e e.s = true ∧ ak e e.s = false ∧ dkOf e e.s = 1)

instance (e : MS) (r0 r1 r2 a0 a1 a2 cr ca zr za j0 j1 j2 : Bool) (s : Nat) :
    Decidable (Concl e r0 r1 r2 a0 a1 a2 cr ca zr za j0 j1 j2 s) := by
  unfold Concl; exact inferInstance

/-- The closure property for the states whose select is `s0`. -/
def ClosedAt (e : MS) : Prop :=
    mem e = true →
    ∀ r0 : Bool, (r0 ≠ e.r0 → e.r0 = e.a0) →
    ∀ r1 : Bool, (r1 ≠ e.r1 → e.r1 = e.a1) →
    ∀ r2 : Bool, (r2 ≠ e.r2 → e.r2 = e.a2) →
    ∀ cr : Bool, (cr ≠ e.cr → e.cr = e.ca) →
    ∀ za : Bool, (za ≠ e.za → e.za ≠ e.zr) →
    ∀ j0 : Bool, (j0 ≠ e.j0 → e.r0 = j0 ∧ (e.cr && e.s == 0) = j0) →
    ∀ j1 : Bool, (j1 ≠ e.j1 → e.r1 = j1 ∧ (e.cr && e.s == 1) = j1) →
    ∀ j2 : Bool, (j2 ≠ e.j2 → e.r2 = j2 ∧ (e.cr && e.s == 2) = j2) →
    ∀ zr : Bool, (zr ≠ e.zr → zr = (e.j0 || e.j1 || e.j2)) →
    ∀ a0 : Bool, (a0 ≠ e.a0 → e.j0 = a0 ∧ e.za = a0) →
    ∀ a1 : Bool, (a1 ≠ e.a1 → e.j1 = a1 ∧ e.za = a1) →
    ∀ a2 : Bool, (a2 ≠ e.a2 → e.j2 = a2 ∧ e.za = a2) →
    ∀ ca : Bool, (ca ≠ e.ca → ca = e.za) →
    ∀ s : Nat, s < 4 → (s ≠ e.s → ¬ ((e.cr || e.ca) = true ∧ (cr || ca) = true)) →
    Concl e r0 r1 r2 a0 a1 a2 cr ca zr za j0 j1 j2 s

set_option synthInstance.maxSize 4096 in
set_option synthInstance.maxHeartbeats 400000 in
instance (e : MS) : Decidable (ClosedAt e) := by unfold ClosedAt; exact inferInstance

def Closed (s0 : Nat) : Prop :=
  ∀ e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 : Bool,
    ClosedAt ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, s0⟩

instance (s0 : Nat) : Decidable (Closed s0) := by unfold Closed; exact inferInstance

set_option maxRecDepth 100000 in
theorem closed0 : Closed 0 := by decide +kernel
set_option maxRecDepth 100000 in
theorem closed1 : Closed 1 := by decide +kernel
set_option maxRecDepth 100000 in
theorem closed2 : Closed 2 := by decide +kernel
set_option maxRecDepth 100000 in
theorem closed3 : Closed 3 := by decide +kernel

/-- Guarantees: they need only the cell's own gates at the step. -/
def GuarAt (e : MS) : Prop :=
    mem e = true →
    ∀ zr : Bool, (zr ≠ e.zr → zr = (e.j0 || e.j1 || e.j2)) →
    ∀ a0 : Bool, (a0 ≠ e.a0 → e.j0 = a0 ∧ e.za = a0) →
    ∀ a1 : Bool, (a1 ≠ e.a1 → e.j1 = a1 ∧ e.za = a1) →
    ∀ a2 : Bool, (a2 ≠ e.a2 → e.j2 = a2 ∧ e.za = a2) →
    ∀ ca : Bool, (ca ≠ e.ca → ca = e.za) →
    (a0 ≠ e.a0 → e.a0 ≠ e.r0) ∧ (a1 ≠ e.a1 → e.a1 ≠ e.r1) ∧ (a2 ≠ e.a2 → e.a2 ≠ e.r2) ∧
    (ca ≠ e.ca → e.ca ≠ e.cr) ∧ (zr ≠ e.zr → e.zr = e.za)

set_option synthInstance.maxSize 4096 in
set_option synthInstance.maxHeartbeats 400000 in
instance (e : MS) : Decidable (GuarAt e) := by unfold GuarAt; exact inferInstance

def Guar (s0 : Nat) : Prop :=
  ∀ e0 e1 e2 e3 e4 e5 e6 e7 e8 e9 e10 e11 e12 : Bool,
    GuarAt ⟨e0, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, s0⟩

instance (s0 : Nat) : Decidable (Guar s0) := by unfold Guar; exact inferInstance

set_option maxRecDepth 100000 in
theorem guar0 : Guar 0 := by decide +kernel
set_option maxRecDepth 100000 in
theorem guar1 : Guar 1 := by decide +kernel
set_option maxRecDepth 100000 in
theorem guar2 : Guar 2 := by decide +kernel
set_option maxRecDepth 100000 in
theorem guar3 : Guar 3 := by decide +kernel

theorem closed_all : ∀ s0, s0 < 4 → Closed s0 := by
  intro s0 h
  rcases (show s0 = 0 ∨ s0 = 1 ∨ s0 = 2 ∨ s0 = 3 by omega) with rfl | rfl | rfl | rfl
  · exact closed0
  · exact closed1
  · exact closed2
  · exact closed3

theorem guar_all : ∀ s0, s0 < 4 → Guar s0 := by
  intro s0 h
  rcases (show s0 = 0 ∨ s0 = 1 ∨ s0 = 2 ∨ s0 = 3 by omega) with rfl | rfl | rfl | rfl
  · exact guar0
  · exact guar1
  · exact guar2
  · exact guar3

end Formal.Net.Ops.MuxN
