/-!
# THE target's `uselect0` unit, timed (shard C, 2026-11-10; GENERATED by formal/tools/compute/ps/psunitT.py)

**Problem.** `PS.Uselect0.uselect0_ps` says what the decoded `uselect0` gates compute once settled (zero-delay
equations). In every behaviour of THE decoded netlist, for every sane `(g, κ)`: if the unit's input nodes
hold on `[T0, T1]`, from when on is the output the op of the inputs?

**Proved.** `uselect0_settled`: for every sane `p` and every `x` with `Behaves p DecodedPS.net x`, if every
input node of the unit (every node of the certificate's input map `maps.psi`) is constant on `[T0, T1]`,
then for every `t` with `T0 + ⌈(1+κ)g⌉ · 6361 ≤ t ≤ T1` the gates driving `S` are settled at `x · t`.
`uselect0_settled_circ` / `uselect0_timed_circ`: the same for every behaviour of THE theorem's circuit
(`circuit net boundary`; the listed gates drive no environment node, decided).
`uselect0_timed`: hence the output word at `t` is the op (`slt(e0, e1) ? e0 : e1` (32 bits)) of the input words at `t`.
`6361` = `D`, the unit's longest prjxray slow-max path (ps), as computed by the generator and checked
(`SN ≤ D` for every listed gate).

Route: identical to `Uselect1T` (certificate `Gen/Compute/PSMap/Uselect0T`, untrusted `psmapT.py`; every gate
picked from a decoded chunk; `SpecSettleSym.certN_sound_net`; output-uniqueness from `net_wf`).

**Not shown.** That the inputs hold (the token protocol / bundling); the side conditions the untimed
theorem keeps as hypotheses are still hypotheses here.
-/

namespace Formal.Net.Compute.PS.Uselect0T
open Formal.Target Formal.Timing.SpecSettle Formal.Net.Compute Formal.Net.Compute.OnDecoded
open Formal.Net.Compute.PS.Uselect0 Formal.Net.GcdHw

namespace G
export Formal.Gen.Compute.PSMap.Uselect0T (pickR stepP chunk seg A gs pcs nP oAll Kof SN known bnd pieceOK
  pieces_ok cover_ok known_ok ptT)
end G
open G

/-- The unit's slow-max depth (ps). -/
abbrev D : Nat := Formal.Gen.Compute.PSMap.Uselect0T.D

theorem D_eq : D = 6361 := rfl

theorem pickR_sub : ∀ (l : List Gate) (ds : List Nat) (g : Gate), g ∈ pickR l ds → g ∈ l
  | [], ds, g, h => by
    have e : pickR [] ds = [] := rfl
    rw [e] at h; exact absurd h List.not_mem_nil
  | a :: l, ds, g, h => by
    have e : pickR (a :: l) ds = stepP a (pickR l) ds := rfl
    rw [e] at h
    match ds, h with
    | [], h => simp [stepP] at h
    | 0 :: ds, h =>
      simp only [stepP, List.mem_cons] at h
      rcases h with rfl | h
      · exact List.mem_cons_self
      · exact List.mem_cons_of_mem _ (pickR_sub l ds g h)
    | (d + 1) :: ds, h =>
      simp only [stepP] at h
      exact List.mem_cons_of_mem _ (pickR_sub l (d :: ds) g h)

open Formal.Gen.Compute.PSMap.Uselect0 in
theorem chunk_sub (c : Nat) (g : Gate) (h : g ∈ chunk c) : g ∈ DecodedPS.net.gates := by
  unfold chunk at h
  split at h
  · exact gin007 g h
  · exact gin033 g h
  · exact gin034 g h
  · exact gin035 g h
  · exact gin036 g h
  · exact gin037 g h
  · exact gin039 g h
  · exact gin041 g h
  · exact absurd h List.not_mem_nil

theorem seg_sub (s : Nat × List Nat) (g : Gate) (h : g ∈ seg s) : g ∈ DecodedPS.net.gates :=
  chunk_sub s.1 g (pickR_sub _ _ g h)

theorem A_sub (i : Nat) (g : Gate) (h : g ∈ A i) : g ∈ DecodedPS.net.gates := by
  unfold A at h
  obtain ⟨s, -, hs⟩ := List.mem_flatMap.mp h
  exact seg_sub s g hs

theorem gs_mem (g : Gate) (h : g ∈ gs) : ∃ i, i < nP ∧ g ∈ A i := by
  unfold gs at h
  obtain ⟨l, hl, hg⟩ := List.mem_flatten.mp h
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hl
  exact ⟨i, List.mem_range.mp hi, hg⟩

theorem gs_sub : ∀ g ∈ gs, g ∈ DecodedPS.net.gates := fun g h => by
  obtain ⟨i, -, hg⟩ := gs_mem g h
  exact A_sub i g hg

theorem A_mem_gs {i : Nat} (hi : i < nP) {g : Gate} (h : g ∈ A i) : g ∈ gs := by
  unfold gs
  exact List.mem_flatten.mpr ⟨A i, List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩, h⟩

theorem certOKN_app (SN' : Nat → Nat) : ∀ (K : List Nat) (a b : List Gate), certOKN SN' K a = true →
    certOKN SN' ((a.map Gate.out).reverse ++ K) b = true → certOKN SN' K (a ++ b) = true
  | K, [], b, _, h2 => by simpa using h2
  | K, g :: a, b, h1, h2 => by
    simp only [certOKN, Bool.and_eq_true] at h1
    simp only [List.cons_append, certOKN, Bool.and_eq_true]
    refine ⟨h1.1, certOKN_app SN' (g.out :: K) a b h1.2 ?_⟩
    simpa [List.map_cons, List.reverse_cons, List.append_assoc] using h2

theorem Kof_zero (os : List (List Nat)) (K : List Nat) : Kof os K 0 = K := by
  cases os <;> rfl

theorem chain (SN' : Nat → Nat) : ∀ (As : List (List Gate)) (os : List (List Nat)) (K : List Nat),
    As.length = os.length →
    (∀ i, i < As.length → certOKN SN' (Kof os K i) (As.getD i []) = true ∧
      (As.getD i []).map Gate.out = os.getD i []) →
    certOKN SN' K As.flatten = true
  | [], _, _, _, _ => rfl
  | a :: As, [], _, hl, _ => by simp at hl
  | a :: As, o :: os, K, hl, h => by
    obtain ⟨h1, h2⟩ := h 0 (by simp)
    rw [Kof_zero] at h1
    simp only [List.getD_cons_zero] at h1 h2
    simp only [List.flatten_cons]
    refine certOKN_app SN' K a _ h1 ?_
    rw [h2]
    apply chain SN' As os (o.reverse ++ K) (by simpa using hl)
    intro i hi
    have := h (i + 1) (by simp; omega)
    simp only [List.getD_cons_succ] at this
    exact this

theorem oAll_len : oAll.length = nP := rfl

theorem getD_As {i : Nat} (hi : i < nP) : ((List.range nP).map A).getD i [] = A i := by
  simp [List.getD_eq_getElem?_getD, hi]

theorem piece (i : Nat) (hi : i < nP) :
    certOKN SN (Kof oAll known i) (A i) = true ∧ (A i).map Gate.out = oAll.getD i [] ∧
      ∀ g ∈ A i, bnd g = true := by
  have h := pieces_ok i hi
  unfold pieceOK at h
  simp only [Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at h
  exact ⟨h.1.1, h.1.2, h.2⟩

theorem cert_ok : certOKN SN known gs = true := by
  unfold gs
  apply chain SN _ oAll known (by simp [oAll_len])
  intro i hi
  simp only [List.length_map, List.length_range] at hi
  rw [getD_As hi]
  exact ⟨(piece i hi).1, (piece i hi).2.1⟩

theorem bnd_gs : ∀ g ∈ gs, bnd g = true := fun g h => by
  obtain ⟨i, hi, hg⟩ := gs_mem g h
  exact (piece i hi).2.2 g hg

theorem cover : ∀ n ∈ S, ∃ g ∈ gs, g.out = n := by
  intro n hn
  have h := (mem_iff _ _).mp (cover_ok n hn)
  by_cases hj : ptT.find n < nP
  · rw [← (piece _ hj).2.1] at h
    obtain ⟨g, hg, rfl⟩ := List.mem_map.mp h
    exact ⟨g, A_mem_gs hj hg, rfl⟩
  · have e : oAll.getD (ptT.find n) [] = [] := by
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by rw [oAll_len]; omega)]; rfl
    rw [e] at h
    exact absurd h List.not_mem_nil

theorem known_mem (n : Nat) (h : n ∈ known) : ∃ e ∈ maps.psi, n = e.2.2 := by
  obtain ⟨e, he, rfl⟩ := List.mem_map.mp h
  exact ⟨e, he, rfl⟩

set_option maxRecDepth 100000 in
/-- Every listed gate drives a node outside the environment's nodes (decided on the explicit output lists). -/
theorem outs_not_env : oAll.all (fun l => l.all (fun n => !(DecodedPS.boundary.env.contains n))) = true := by
  decide +kernel

theorem out_not_env (g : Gate) (h : g ∈ gs) : g.out ∉ DecodedPS.boundary.envNodes := by
  obtain ⟨i, hi, hg⟩ := gs_mem g h
  have hm : g.out ∈ oAll.getD i [] := by
    rw [← (piece i hi).2.1]; exact List.mem_map.mpr ⟨g, hg, rfl⟩
  have hl : oAll.getD i [] ∈ oAll := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by rw [oAll_len]; exact hi)]
    exact List.getElem_mem _
  have := List.all_eq_true.mp (List.all_eq_true.mp outs_not_env _ hl) g.out hm
  simpa [Boundary.envNodes] using this

/-- The listed gates are gates of THE theorem's circuit (`Spec.circuit`: the decoded netlist without the gates
driving environment nodes). -/
theorem gs_sub_circ : ∀ g ∈ gs, g ∈ (circuit DecodedPS.net DecodedPS.boundary).gates := fun g h =>
  List.mem_filter.mpr ⟨gs_sub g h, by simpa using out_not_env g h⟩

set_option maxRecDepth 100000 in
/-- The settle argument for any well-formed netlist `N` containing the listed gates. -/
theorem settled_gen {N : Net} (hN : N.WF) (hsubN : ∀ g ∈ gs, g ∈ N.gates)
    (p : DelayPar) (hp : Sane p) (x : Beh) (hb : Behaves p N x) (T0 T1 : Nat)
    (hin : ∀ e ∈ maps.psi, ∀ t, T0 ≤ t → t ≤ T1 → x e.2.2 t = x e.2.2 T0)
    (t : Nat) (ht0 : T0 + cScale p * D ≤ t) (ht1 : t ≤ T1) :
    Settled DecodedPS.net S (fun w => x w t) := by
  have hk : ∀ n ∈ known, ConstW (fun n => T0 + cScale p * SN n) (fun _ => T1) x n := by
    intro n hn t' h1 h2
    have h0 : SN n = 0 := by
      have := List.all_eq_true.mp known_ok n hn
      simpa using this
    simp only [h0, Nat.mul_zero, Nat.add_zero] at h1 ⊢
    obtain ⟨e, he, rfl⟩ := known_mem n hn
    exact hin e he t' h1 h2
  have hset := certN_sound_net hp hN hb SN T0 T1 known gs hsubN hk cert_ok
  have win : ∀ n, SN n ≤ D → T0 + cScale p * SN n ≤ t := fun n h =>
    le_trans (Nat.add_le_add_left (Nat.mul_le_mul_left _ h) _) ht0
  intro g hg hgS
  obtain ⟨g', hg', hout⟩ := cover g.out hgS
  have e : g' = g := List.inj_on_of_nodup_map DecodedPS.net_wf.2 (gs_sub g' hg') hg hout
  subst e
  have hb' := bnd_gs g' hg'
  simp only [bnd, Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range] at hb'
  exact (hset g' hg').2 t (win _ hb'.1) ht1 (fun i hi => ⟨win _ (hb'.2 i hi), ht1⟩)

/-- **THE target's decoded `uselect0` unit settles.** For every sane `(g, κ)` and every behaviour of the
decoded netlist: if every input node of the unit holds on `[T0, T1]`, the gates driving `S` are settled at
every `t` with `T0 + ⌈(1+κ)g⌉·6361 ≤ t ≤ T1`. -/
theorem uselect0_settled (p : DelayPar) (hp : Sane p) (x : Beh) (hb : Behaves p DecodedPS.net x)
    (T0 T1 : Nat)
    (hin : ∀ e ∈ maps.psi, ∀ t, T0 ≤ t → t ≤ T1 → x e.2.2 t = x e.2.2 T0)
    (t : Nat) (ht0 : T0 + cScale p * D ≤ t) (ht1 : t ≤ T1) :
    Settled DecodedPS.net S (fun w => x w t) :=
  settled_gen DecodedPS.net_wf gs_sub p hp x hb T0 T1 hin t ht0 ht1

/-- The same for every behaviour of THE theorem's circuit (`Behaves p (circuit net boundary) x`). -/
theorem uselect0_settled_circ (p : DelayPar) (hp : Sane p) (x : Beh)
    (hb : Behaves p (circuit DecodedPS.net DecodedPS.boundary) x) (T0 T1 : Nat)
    (hin : ∀ e ∈ maps.psi, ∀ t, T0 ≤ t → t ≤ T1 → x e.2.2 t = x e.2.2 T0)
    (t : Nat) (ht0 : T0 + cScale p * D ≤ t) (ht1 : t ≤ T1) :
    Settled DecodedPS.net S (fun w => x w t) :=
  settled_gen (Formal.Net.CViewPS.circuit_wf DecodedPS.net_wf) gs_sub_circ p hp x hb T0 T1 hin t ht0 ht1

/-- **THE target's decoded `uselect0` unit, timed:** with the inputs held on `[T0, T1]`, the output at every
`t ∈ [T0 + ⌈(1+κ)g⌉·6361, T1]` is `slt(e0, e1) ? e0 : e1` (32 bits) of the input words at `t`. -/
theorem uselect0_timed (p : DelayPar) (hp : Sane p) (x : Beh) (hb : Behaves p DecodedPS.net x)
    (T0 T1 : Nat)
    (hin : ∀ e ∈ maps.psi, ∀ t, T0 ≤ t → t ≤ T1 → x e.2.2 t = x e.2.2 T0)
    (t : Nat) (ht0 : T0 + cScale p * D ≤ t) (ht1 : t ≤ T1) :
    word ((fun w => x w t) ∘ zNode) 32 = (if Ops.flip 32 (word ((fun w => x w t) ∘ e0Node) 32) < Ops.flip 32 (word ((fun w => x w t) ∘ e1Node) 32) then (word ((fun w => x w t) ∘ e0Node) 32) else (word ((fun w => x w t) ∘ e1Node) 32)) % 2 ^ 32 :=
  uselect0_ps _ (uselect0_settled p hp x hb T0 T1 hin t ht0 ht1)

/-- `uselect0_timed` for every behaviour of THE theorem's circuit. -/
theorem uselect0_timed_circ (p : DelayPar) (hp : Sane p) (x : Beh)
    (hb : Behaves p (circuit DecodedPS.net DecodedPS.boundary) x) (T0 T1 : Nat)
    (hin : ∀ e ∈ maps.psi, ∀ t, T0 ≤ t → t ≤ T1 → x e.2.2 t = x e.2.2 T0)
    (t : Nat) (ht0 : T0 + cScale p * D ≤ t) (ht1 : t ≤ T1) :
    word ((fun w => x w t) ∘ zNode) 32 = (if Ops.flip 32 (word ((fun w => x w t) ∘ e0Node) 32) < Ops.flip 32 (word ((fun w => x w t) ∘ e1Node) 32) then (word ((fun w => x w t) ∘ e0Node) 32) else (word ((fun w => x w t) ∘ e1Node) 32)) % 2 ^ 32 :=
  uselect0_ps _ (uselect0_settled_circ p hp x hb T0 T1 hin t ht0 ht1)

end Formal.Net.Compute.PS.Uselect0T
