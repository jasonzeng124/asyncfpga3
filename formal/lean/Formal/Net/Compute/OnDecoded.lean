import Formal.Target.Spec
import Formal.Net.Compute.Word

/-!
# A yosys cell netlist, checked against the DECODED gates of a netlist (shard C, 2026-11-09)

**Problem.** `Formal.Net.Compute` proves that the yosys cells of each `bdc_fused_*` unit compute the
unit's MLIR op (`run`, `unitVal`). THE theorem is about the decoded netlist (`Formal.Target.Spec`'s
`Net`: k-input gates with an INIT, pips and site hops as copy gates, CARRY4 outputs and MUXF as
k-input gates). This file proves, once, that a decidable certificate check transfers a cell
netlist's values to the decoded nodes, for every valuation of the decoded nodes in which the
needed gates are settled.

* `Settled N S v`: every gate of `N` whose output is in `S` has `v out = INIT[addr of v at its pins]`,
  exactly `Spec.GateOK`'s output equation with every read at the current value (zero delay).
* `GC`: a gate's content (out, k, INIT, pins) without name or arcs; `subOK` (merge walk) checks a
  sorted list of them against a chunk of the decoded gate list.
* A certificate: maps `phi` (yosys net -> decoded node) and `psi` (input bit -> decoded node), and per
  cell a boundary node list `B` and a list `L` of decoded gates in topological order. `cellOK`
  checks, for every assignment of `B`, that evaluating `L` gives at `phi o` the cell's value at
  output `o` (with the cell's input wires read at their mapped nodes); a pin of an `L` gate that
  is neither in `B` nor an earlier output of `L` must be don't-care at that assignment (`gOK`).
* `corr_sound`: `topoOK` + every `cellOK` + `Settled N (D.map out) v` (with `D` the checked gates)
  -> every mapped net's `run` value is `v` at its node.

Trusted: nothing beyond the definitions (no hypothesis); the certificate data is generated by
untrusted Python (`formal/tools/compute/ps/psmap.py`) and only checked here.
Not covered: timing (when the nodes are settled), glitches; that the routed JSON is right (it is
only a hint).
-/

namespace Formal.Net.Compute.OnDecoded
open Formal.Target Formal.Net.Compute

/-! ## Settled gates -/

/-- A gate's logical content. -/
structure GC where
  out : Nat
  k : Nat
  init : Nat
  ins : List Nat
  deriving DecidableEq, Repr

def GC.ofGate (g : Gate) : GC := ⟨g.out, g.k, g.init, g.ins⟩

/-- The gate's output value when its pins read `v` (Spec's `addr`, pin 0 the LSB). -/
def GC.eval (c : GC) (v : Nat → Bool) : Bool := c.init.testBit (addr c.k fun i => v (c.ins.getD i 0))

/-- **Settled**: every gate of `N` driving a node of `S` has its output equal to its INIT bit at
the address of its pins' current values. -/
def Settled (N : Net) (S : List Nat) (v : Nat → Bool) : Prop :=
  ∀ g ∈ N.gates, g.out ∈ S → v g.out = g.init.testBit (addr g.k fun i => v (g.ins.getD i 0))

/-! ## Small Boolean helpers (kernel-friendly) -/

def mem (x : Nat) : List Nat → Bool
  | [] => false
  | y :: l => x == y || mem x l

theorem mem_iff (x : Nat) : ∀ l : List Nat, mem x l = true ↔ x ∈ l
  | [] => by simp [mem]
  | y :: l => by simp [mem, mem_iff x l]

def memGC (c : GC) : List GC → Bool
  | [] => false
  | d :: l => (c.out == d.out && decide (c = d)) || memGC c l

theorem memGC_sound (c : GC) : ∀ l : List GC, memGC c l = true → c ∈ l
  | [] => by simp [memGC]
  | d :: l => by
    simp only [memGC, Bool.or_eq_true, Bool.and_eq_true, decide_eq_true_eq]
    rintro (⟨-, rfl⟩ | h)
    · exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (memGC_sound c l h)

def allBelow : Nat → (Nat → Bool) → Bool
  | 0, _ => true
  | n + 1, f => f n && allBelow n f

theorem allBelow_sound : ∀ (n : Nat) (f : Nat → Bool), allBelow n f = true → ∀ m, m < n → f m = true
  | 0, _, _, m, h => absurd h (Nat.not_lt_zero m)
  | n + 1, f, h, m, hm => by
    simp only [allBelow, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hm with hm | rfl
    · exact allBelow_sound n f h.2 m hm
    · exact h.1

/-- Merge walk: every entry of the sorted list `cs` is the content of a gate of `gs`. -/
def subOK : List Gate → List GC → Bool
  | _, [] => true
  | [], _ :: _ => false
  | g :: gs, c :: cs => if g.out == c.out then (decide (GC.ofGate g = c) && subOK gs cs) else subOK gs (c :: cs)

theorem subOK_sound : ∀ (gs : List Gate) (cs : List GC), subOK gs cs = true → ∀ c ∈ cs, ∃ g ∈ gs, GC.ofGate g = c
  | _, [], _, c, hc => absurd hc List.not_mem_nil
  | [], _ :: _, h, _, _ => by simp [subOK] at h
  | g :: gs, c :: cs, h, c', hc' => by
    simp only [subOK] at h
    split at h
    · simp only [Bool.and_eq_true, decide_eq_true_eq] at h
      rcases List.mem_cons.mp hc' with rfl | hc'
      · exact ⟨g, List.mem_cons_self, h.1⟩
      · obtain ⟨g', hg', e⟩ := subOK_sound gs cs h.2 c' hc'
        exact ⟨g', List.mem_cons_of_mem _ hg', e⟩
    · obtain ⟨g', hg', e⟩ := subOK_sound gs (c :: cs) h c' hc'
      exact ⟨g', List.mem_cons_of_mem _ hg', e⟩

/-! ## Addresses -/

theorem addr_lt (f : Nat → Bool) : ∀ k, addr k f < 2 ^ k
  | 0 => by simp [addr]
  | k + 1 => by
    have := addr_lt f k
    simp only [addr, Nat.pow_succ]
    split <;> omega

theorem addr_eq_word (f : Nat → Bool) : ∀ k, addr k f = word f k
  | 0 => rfl
  | k + 1 => by
    simp only [addr, word, addr_eq_word f k]
    have hl : word f k < 2 ^ k := addr_eq_word f k ▸ addr_lt f k
    split
    · exact (Nat.or_two_pow_eq_add_of_lt hl).symm
    · simp

theorem testBit_addr (f : Nat → Bool) (k i : Nat) : (addr k f).testBit i = (decide (i < k) && f i) := by
  rw [addr_eq_word, testBit_word]

theorem addr_congr {f g : Nat → Bool} : ∀ k, (∀ i, i < k → f i = g i) → addr k f = addr k g
  | 0, _ => rfl
  | k + 1, h => by
    simp only [addr]
    rw [addr_congr k (fun i hi => h i (by omega)), h k (by omega)]

/-! ## Local evaluation of decoded gates

Values are kept in a list, most recent first; a local gate reads pin `j` at distance `dist[j]`
from the head (`distOK` checks statically that the node at that distance is the pin's node; a
distance past the end means the pin is unavailable, and the gate must not depend on it there). -/

/-- **Don't-care core.** If the INIT's bit at every address agreeing with `base` on the mask `m`
equals its bit at `base`, two pin valuations that agree on the masked pins give the same bit. -/
theorem dc_eq (k init : Nat) (avail f g : Nat → Bool)
    (h : allBelow (2 ^ k) (fun x => x &&& addr k avail != addr k (fun j => g j && (addr k avail).testBit j) ||
      init.testBit x == init.testBit (addr k (fun j => g j && (addr k avail).testBit j))) = true)
    (hfg : ∀ j, j < k → avail j = true → f j = g j) :
    init.testBit (addr k f) = init.testBit (addr k g) := by
  have hx := allBelow_sound _ _ h
  have key : ∀ f' : Nat → Bool, (∀ j, j < k → avail j = true → f' j = g j) →
      init.testBit (addr k f') = init.testBit (addr k (fun j => g j && (addr k avail).testBit j)) := by
    intro f' hf
    have hand : addr k f' &&& addr k avail = addr k (fun j => g j && (addr k avail).testBit j) := by
      apply Nat.eq_of_testBit_eq; intro i
      rw [Nat.testBit_and, testBit_addr, testBit_addr, testBit_addr, testBit_addr]
      by_cases hi : i < k
      · simp only [hi, decide_true, Bool.true_and]
        by_cases ha : avail i = true
        · rw [hf i hi ha, ha]
        · simp only [Bool.not_eq_true] at ha
          rw [ha, Bool.and_false, Bool.and_false]
      · simp [hi]
    have := hx (addr k f') (addr_lt _ k)
    simp only [Bool.or_eq_true, bne_iff_ne, ne_eq, beq_iff_eq] at this
    rcases this with h1 | h1
    · exact absurd hand h1
    · exact h1
  rw [key f hfg, key g (fun _ _ _ => rfl)]

/-- Cheap list reads for the kernel. -/
def nthB : List Bool → Nat → Bool
  | [], _ => false
  | b :: _, 0 => b
  | _ :: l, n + 1 => nthB l n

def nthN : List Nat → Nat → Nat
  | [], _ => 0
  | b :: _, 0 => b
  | _ :: l, n + 1 => nthN l n

theorem nthB_eq : ∀ (l : List Bool) (n : Nat), nthB l n = l.getD n false
  | [], _ => by simp [nthB]
  | _ :: _, 0 => by simp [nthB]
  | _ :: l, n + 1 => by simp [nthB, nthB_eq l n]

theorem nthN_eq : ∀ (l : List Nat) (n : Nat), nthN l n = l.getD n 0
  | [], _ => by simp [nthN]
  | _ :: _, 0 => by simp [nthN]
  | _ :: l, n + 1 => by simp [nthN, nthN_eq l n]

/-- A local gate of a certificate: its content and, per pin, the distance of its value from the
head of the value list. -/
structure LG where
  g : GC
  dist : List Nat
  deriving Repr

/-- Pin `j` of `c` read from the value list `vs`. -/
def rdv (vs : List Bool) (c : LG) (j : Nat) : Bool := nthB vs (nthN c.dist j)

/-- The gate's value on the value list (a copy gate, k = 1 and INIT = 2, is read directly). -/
def LG.ev (c : LG) (vs : List Bool) : Bool :=
  if c.g.k == 1 && c.g.init == 2 then rdv vs c 0 else c.g.init.testBit (addr c.g.k (rdv vs c))

theorem LG.ev_eq (c : LG) (vs : List Bool) : c.ev vs = c.g.init.testBit (addr c.g.k (rdv vs c)) := by
  unfold LG.ev
  split
  · rename_i h
    simp only [Bool.and_eq_true, beq_iff_eq] at h
    rw [h.1, h.2]
    cases hr : rdv vs c 0 <;> simp [addr, hr] <;> decide
  · rfl

/-- Evaluate the gates in order, pushing each value (strict). -/
def runV : List LG → List Bool → List Bool
  | [], vs => vs
  | c :: L, vs => match c.ev vs with
    | true => runV L (true :: vs)
    | false => runV L (false :: vs)

theorem runV_cons (c : LG) (L : List LG) (vs : List Bool) : runV (c :: L) vs = runV L (c.ev vs :: vs) := by
  cases h : c.ev vs <;> simp [runV, h]

/-- At one assignment: a gate with an unavailable pin (distance ≥ `len`) does not depend on it. -/
def dcOK (len : Nat) (vs : List Bool) (c : LG) : Bool :=
  if allBelow c.g.k (fun j => decide (c.dist.getD j 0 < len)) then true else
    allBelow (2 ^ c.g.k) (fun x =>
      x &&& addr c.g.k (fun j => decide (c.dist.getD j 0 < len)) !=
        addr c.g.k (fun j => rdv vs c j && (addr c.g.k (fun j => decide (c.dist.getD j 0 < len))).testBit j) ||
      c.g.init.testBit x == c.g.init.testBit
        (addr c.g.k (fun j => rdv vs c j && (addr c.g.k (fun j => decide (c.dist.getD j 0 < len))).testBit j)))

def evOK : Nat → List LG → List Bool → Bool
  | _, [], _ => true
  | len, c :: L, vs => dcOK len vs c && match c.ev vs with
    | true => evOK (len + 1) L (true :: vs)
    | false => evOK (len + 1) L (false :: vs)

theorem evOK_cons (len : Nat) (c : LG) (L : List LG) (vs : List Bool) :
    evOK len (c :: L) vs = (dcOK len vs c && evOK (len + 1) L (c.ev vs :: vs)) := by
  cases h : c.ev vs <;> simp [evOK, h]

/-- Static check: pin lists of length `k`, and every available distance names the pin's node in
the node list `avr` (most recent first). -/
def distOK : List Nat → List LG → Bool
  | _, [] => true
  | avr, c :: L => (c.g.ins.length == c.g.k) &&
      (List.range c.g.k).all (fun j => decide (avr.length ≤ c.dist.getD j 0) ||
        avr.getD (c.dist.getD j 0) 0 == c.g.ins.getD j 0) &&
      distOK (c.g.out :: avr) L

/-- The node list after the local gates (most recent first). -/
def avrOf (B : List Nat) (L : List LG) : List Nat := (L.map (·.g.out)).reverse ++ B.reverse

/-- Value list `vs` holds `v` at the nodes of `avr`. -/
def Agree (v : Nat → Bool) (avr : List Nat) (vs : List Bool) : Prop :=
  vs.length = avr.length ∧ ∀ i, i < avr.length → vs.getD i false = v (avr.getD i 0)

theorem agree_cons {v : Nat → Bool} {avr : List Nat} {vs : List Bool} (h : Agree v avr vs) (n : Nat) (b : Bool)
    (hb : b = v n) : Agree v (n :: avr) (b :: vs) := by
  refine ⟨by simp [h.1], fun i hi => ?_⟩
  cases i with
  | zero => simpa using hb
  | succ i => simpa using h.2 i (by simpa using hi)

theorem ev_sound {v : Nat → Bool} {avr : List Nat} {vs : List Bool} (h : Agree v avr vs) {c : LG}
    (hk : c.g.ins.length = c.g.k)
    (hd : ∀ j, j < c.g.k → c.dist.getD j 0 < avr.length → avr.getD (c.dist.getD j 0) 0 = c.g.ins.getD j 0)
    (hdc : dcOK avr.length vs c = true) : c.ev vs = c.g.eval v := by
  have hav : ∀ j, j < c.g.k → decide (c.dist.getD j 0 < avr.length) = true → rdv vs c j = v (c.g.ins.getD j 0) := by
    intro j hj ha
    simp only [decide_eq_true_eq] at ha
    simp only [rdv]; rw [nthB_eq, nthN_eq, h.2 _ ha, hd j hj ha]
  unfold dcOK at hdc
  rw [LG.ev_eq]
  unfold GC.eval
  split at hdc
  · rename_i hall
    rw [addr_congr c.g.k (fun j hj => hav j hj (allBelow_sound _ _ hall j hj))]
  · exact (dc_eq c.g.k c.g.init _ (fun j => v (c.g.ins.getD j 0)) (rdv vs c) hdc
      (fun j hj ha => (hav j hj ha).symm)).symm

/-- **Local soundness.** -/
theorem runV_sound (v : Nat → Bool) : ∀ (L : List LG) (avr : List Nat) (vs : List Bool),
    Agree v avr vs → (∀ c ∈ L, v c.g.out = c.g.eval v) → distOK avr L = true → evOK avr.length L vs = true →
    Agree v ((L.map (·.g.out)).reverse ++ avr) (runV L vs)
  | [], avr, vs, h, _, _, _ => by simpa [runV] using h
  | c :: L, avr, vs, h, hs, hd, he => by
    rw [evOK_cons] at he
    simp only [distOK, Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.mem_range, Bool.or_eq_true,
      decide_eq_true_eq] at hd
    simp only [Bool.and_eq_true] at he
    have hev : c.ev vs = c.g.eval v := ev_sound h hd.1.1
      (fun j hj hlt => (hd.1.2 j hj).resolve_left (by omega)) he.1
    have h' := agree_cons h c.g.out (c.ev vs) (by rw [hev, hs c List.mem_cons_self])
    have := runV_sound v L (c.g.out :: avr) (c.ev vs :: vs) h' (fun d hd' => hs d (List.mem_cons_of_mem _ hd'))
      hd.2 (by simpa using he.2)
    rw [runV_cons]
    simpa using this
/-! ## Assignments of a boundary list -/

/-- Assignment number `m` of the boundary list `B`: node `B[i]` gets bit `i` of `m`. -/
def aOf (B : List Nat) (m : Nat) : Nat → Bool := fun x => m.testBit (B.idxOf x)

def encN : List Nat → (Nat → Bool) → Nat
  | [], _ => 0
  | l :: S, v => (if v l then 1 else 0) + 2 * encN S v

theorem testBit_encN (v : Nat → Bool) : ∀ (S : List Nat), S.Nodup → ∀ l ∈ S,
    (encN S v).testBit (S.idxOf l) = v l
  | [], _, l, hl => by simp at hl
  | x :: S, hnd, l, hl => by
    simp only [List.nodup_cons] at hnd
    by_cases hx : l = x
    · subst hx
      simp only [List.idxOf_cons_self, encN]
      cases v l <;> simp [Nat.testBit_zero]
    · have hlS : l ∈ S := by simpa [hx] using hl
      have hi : (x :: S).idxOf l = S.idxOf l + 1 := by
        simp [List.idxOf_cons, Ne.symm hx]
      rw [hi, encN]
      have := testBit_encN v S hnd.2 l hlS
      rw [← this]
      cases v x
      · simp only [Bool.false_eq_true, if_false, Nat.zero_add]
        rw [Nat.testBit_succ, Nat.mul_div_cancel_left _ (by decide)]
      · simp only [if_true]
        rw [Nat.testBit_succ]
        congr 1
        omega

theorem encN_lt (v : Nat → Bool) : ∀ S : List Nat, encN S v < 2 ^ S.length
  | [] => by simp [encN]
  | l :: S => by
    have := encN_lt v S
    simp only [encN, List.length_cons, Nat.pow_succ]
    cases v l <;> simp <;> omega

theorem exists_aOf (v : Nat → Bool) (B : List Nat) (hnd : B.Nodup) :
    ∃ m, m < 2 ^ B.length ∧ ∀ x ∈ B, aOf B m x = v x :=
  ⟨encN B v, encN_lt v B, fun x hx => testBit_encN v B hnd x hx⟩

/-! ## The correspondence certificate -/

def lk : List (Nat × Nat) → Nat → Option Nat
  | [], _ => none
  | (a, d) :: l, n => if a == n then some d else lk l n

def lk2 : List (Nat × Nat × Nat) → Nat → Nat → Option Nat
  | [], _, _ => none
  | (p, k, d) :: l, p', k' => if p == p' && k == k' then some d else lk2 l p' k'

/-- `phi`: yosys net -> decoded node; `psi`: (input port, bit) -> decoded node. -/
structure Maps where
  phi : List (Nat × Nat)
  psi : List (Nat × Nat × Nat)

/-- A cell wire read through the maps from a valuation of decoded nodes. -/
def Maps.rd (M : Maps) (a : Nat → Bool) : W → Bool
  | .c0 => false
  | .c1 => true
  | .inp p k => match lk2 M.psi p k with | some d => a d | none => false
  | .net n => match lk M.phi n with | some d => a d | none => false

/-- A cell's certificate: boundary nodes, local decoded gates (topological order), the entries
of the global maps that the cell uses (`cellOK` checks they agree with the global ones), and for
each mapped output net the distance of its node in the final value list. -/
structure CC where
  B : List Nat
  L : List LG
  M : Maps
  outd : List (Nat × Nat)

def wireOK (M : Maps) (B : List Nat) : W → Bool
  | .c0 => true
  | .c1 => true
  | .inp p k => match lk2 M.psi p k with | some d => mem d B | none => false
  | .net n => match lk M.phi n with | some d => mem d B | none => false

/-- The cell-local maps agree with the global ones on wire `w`. -/
def wireEq (M M' : Maps) : W → Bool
  | .c0 => true
  | .c1 => true
  | .inp p k => decide (lk2 M.psi p k = lk2 M'.psi p k)
  | .net n => decide (lk M.phi n = lk M'.phi n)

def valsAt (cc : CC) (c : Cell) (a : Nat → Bool) (vs : List Bool) : Bool :=
  c.outs.all fun o => match lk cc.outd o with
    | some dd => (c.vals (cc.M.rd a)).getD (c.outs.idxOf o) false == vs.getD dd false
    | none => true

/-- `evOK` and `runV` in one strict pass, handing the final value list to `k`. -/
def runK (len : Nat) : List LG → List Bool → (List Bool → Bool) → Bool
  | [], vs, k => k vs
  | c :: L, vs, k => dcOK len vs c && match c.ev vs with
    | true => runK (len + 1) L (true :: vs) k
    | false => runK (len + 1) L (false :: vs) k

theorem runK_eq (k : List Bool → Bool) : ∀ (len : Nat) (L : List LG) (vs : List Bool),
    runK len L vs k = (evOK len L vs && k (runV L vs))
  | _, [], _ => by simp [runK, evOK, runV]
  | len, c :: L, vs => by
    rw [evOK_cons, runV_cons]
    cases h : c.ev vs <;> simp [runK, h, runK_eq k (len + 1) L, Bool.and_assoc]

/-- The initial value list of assignment `m` (strict). -/
def initV (B : List Nat) (m : Nat) : List Bool := (B.map (aOf B m)).reverse

/-- One assignment: the don't-care checks and the output values. -/
def asgOK (cc : CC) (c : Cell) (m : Nat) : Bool :=
  runK cc.B.length cc.L (initV cc.B m) (valsAt cc c (aOf cc.B m))

def dfltCell : Cell := .inv .c0 0
def dfltCC : CC := ⟨[], [], ⟨[], []⟩, []⟩

/-- The assignment-independent part of the per-cell check. -/
def cellStatic (M : Maps) (D : List GC) (c : Cell) (cc : CC) : Bool :=
  c.ins.all (fun w => wireEq M cc.M w && wireOK cc.M cc.B w) &&
  c.outs.all (fun o => decide (lk M.phi o = lk cc.M.phi o)) && decide cc.B.Nodup &&
  cc.L.all (fun g => memGC g.g D) && distOK cc.B.reverse cc.L &&
  c.outs.all (fun o => match lk cc.M.phi o with
    | some d => (match lk cc.outd o with
      | some dd => decide (dd < (avrOf cc.B cc.L).length) && (avrOf cc.B cc.L).getD dd 0 == d
      | none => false)
    | none => true)

/-- **The per-cell check.** -/
def cellOK (M : Maps) (D : List GC) (c : Cell) (cc : CC) : Bool :=
  cellStatic M D c cc && allBelow (2 ^ cc.B.length) (asgOK cc c)

theorem allBelow_of : ∀ (n : Nat) (f : Nat → Bool), (∀ m, m < n → f m = true) → allBelow n f = true
  | 0, _, _ => rfl
  | n + 1, f, h => by
    simp only [allBelow, Bool.and_eq_true]
    exact ⟨h n (by omega), allBelow_of n f (fun m hm => h m (by omega))⟩

/-- Assignments `lo .. hi-1` of one cell (for chunked kernel checks). -/
def asgRange (cc : CC) (c : Cell) (lo hi : Nat) : Bool :=
  allBelow (hi - lo) fun j => asgOK cc c (lo + j)

/-- A cell whose assignments are checked in `P` parts of 64. -/
theorem cellOK_of_parts {M : Maps} {D : List GC} {c : Cell} {cc : CC} (hs : cellStatic M D c cc = true)
    (P : Nat) (hP : 2 ^ cc.B.length ≤ 64 * P)
    (hp : ∀ p, p < P → asgRange cc c (64 * p) (64 * p + 64) = true) : cellOK M D c cc = true := by
  simp only [cellOK, hs, Bool.true_and]
  apply allBelow_of
  intro m hm
  have h := allBelow_sound _ _ (hp (m / 64) (by omega)) (m % 64) (by omega)
  rwa [show 64 * (m / 64) + m % 64 = m by omega] at h

/-- The full check for the cells listed in `is`. -/
def idxOK (M : Maps) (D : List GC) (cells : List Cell) (certs : List CC) (is : List Nat) : Bool :=
  is.all fun i => cellOK M D (cells.getD i dfltCell) (certs.getD i dfltCC)

/-- The static check for the cells listed in `is`. -/
def idxStatic (M : Maps) (D : List GC) (cells : List Cell) (certs : List CC) (is : List Nat) : Bool :=
  is.all fun i => cellStatic M D (cells.getD i dfltCell) (certs.getD i dfltCC)

theorem idxOK_sound {M : Maps} {D : List GC} {cells : List Cell} {certs : List CC} {is : List Nat}
    (h : idxOK M D cells certs is = true) (i : Nat) (hi : i ∈ is) :
    cellOK M D (cells.getD i dfltCell) (certs.getD i dfltCC) = true :=
  List.all_eq_true.mp h i hi

theorem idxStatic_sound {M : Maps} {D : List GC} {cells : List Cell} {certs : List CC} {is : List Nat}
    (h : idxStatic M D cells certs is = true) (i : Nat) (hi : i ∈ is) :
    cellStatic M D (cells.getD i dfltCell) (certs.getD i dfltCC) = true :=
  List.all_eq_true.mp h i hi

/-- Cells in topological order: every net a cell reads is an output of an earlier cell. -/
def topoOK : List Cell → List Nat → Bool
  | [], _ => true
  | c :: cs, done => (insNets c).all (fun n => mem n done) && topoOK cs (c.outs ++ done)

/-- Cells `lo .. hi-1` pass `cellOK` (for chunked kernel checks). -/
def rangeOK (M : Maps) (D : List GC) (cells : List Cell) (certs : List CC) (lo hi : Nat) : Bool :=
  allBelow (hi - lo) fun j => cellOK M D (cells.getD (lo + j) dfltCell) (certs.getD (lo + j) dfltCC)

theorem rangeOK_sound {M : Maps} {D : List GC} {cells : List Cell} {certs : List CC} {lo hi : Nat}
    (h : rangeOK M D cells certs lo hi = true) :
    ∀ i, lo ≤ i → i < hi → cellOK M D (cells.getD i dfltCell) (certs.getD i dfltCC) = true := by
  intro i h1 h2
  have := allBelow_sound _ _ h (i - lo) (by omega)
  rwa [show lo + (i - lo) = i by omega] at this

theorem agree_init (v : Nat → Bool) (B : List Nat) (a : Nat → Bool) (h : ∀ x ∈ B, a x = v x) :
    Agree v B.reverse (B.map a).reverse := by
  refine ⟨by simp, fun i hi => ?_⟩
  rw [← List.map_reverse, List.getD_eq_getElem?_getD, List.getElem?_map,
    List.getElem?_eq_getElem (by simpa using hi), Option.map_some, Option.getD_some,
    List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.getD_some]
  exact h _ (List.mem_reverse.mp (List.getElem_mem _))

theorem cell_sound {M : Maps} {D : List GC} {v : Nat → Bool} (hD : ∀ c ∈ D, v c.out = c.eval v)
    {c : Cell} {cc : CC} (hok : cellOK M D c cc = true) {env : Leaf → Bool} {cur : Nat → Bool}
    (hin : ∀ p k d, lk2 M.psi p k = some d → env (.inp p k) = v d)
    (hnet : ∀ n, W.net n ∈ c.ins → ∀ d, lk M.phi n = some d → cur n = v d) :
    ∀ o ∈ c.outs, ∀ d, lk M.phi o = some d → (c.vals (wv env cur)).getD (c.outs.idxOf o) false = v d := by
  simp only [cellOK, cellStatic, Bool.and_eq_true, List.all_eq_true, decide_eq_true_eq] at hok
  obtain ⟨⟨⟨⟨⟨⟨hw, heo⟩, hnd⟩, hL⟩, hdist⟩, hout⟩, hall⟩ := hok
  obtain ⟨m, hm, hag⟩ := exists_aOf v cc.B hnd
  have hm' := allBelow_sound _ _ hall m hm
  simp only [asgOK, runK_eq, initV, Bool.and_eq_true] at hm'
  obtain ⟨hev, hvals⟩ := hm'
  have hLs : ∀ g ∈ cc.L, v g.g.out = g.g.eval v := fun g hg => hD g.g (memGC_sound g.g D (hL g hg))
  have hloc := runV_sound v cc.L cc.B.reverse _ (agree_init v cc.B _ hag) hLs hdist
    (by simpa using hev)
  have hrd : ∀ w ∈ c.ins, cc.M.rd (aOf cc.B m) w = wv env cur w := by
    intro w hwm
    obtain ⟨he1, h1⟩ := hw w hwm
    cases w with
    | c0 => rfl
    | c1 => rfl
    | inp p k =>
      simp only [wireOK] at h1
      simp only [wireEq, decide_eq_true_eq] at he1
      simp only [Maps.rd, wv]
      split at h1
      · rename_i d hd
        rw [hag d ((mem_iff _ _).mp h1), hin p k d (he1.trans hd)]
      · exact absurd h1 (by simp)
    | net n =>
      simp only [wireOK] at h1
      simp only [wireEq, decide_eq_true_eq] at he1
      simp only [Maps.rd, wv]
      split at h1
      · rename_i d hd
        rw [hag d ((mem_iff _ _).mp h1), hnet n hwm d (he1.trans hd)]
      · exact absurd h1 (by simp)
  have hv : c.vals (cc.M.rd (aOf cc.B m)) = c.vals (wv env cur) := vals_congr c hrd rfl
  intro o ho d hd
  have hd' : lk cc.M.phi o = some d := (heo o ho).symm.trans hd
  have h3 := hout o ho
  rw [hd'] at h3
  simp only at h3
  split at h3
  · rename_i dd hdd
    simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h3
    have h2 := List.all_eq_true.mp hvals o ho
    simp only [hdd, beq_iff_eq] at h2
    rw [← hv, h2, hloc.2 dd (by simpa [avrOf] using h3.1)]
    have := h3.2
    simp only [avrOf] at this
    rw [this]
  · exact absurd h3 (by simp)

/-- The run invariant: every mapped net of `done` has its node's value. -/
def Inv (M : Maps) (v : Nat → Bool) (cur : Nat → Bool) (done : List Nat) : Prop :=
  ∀ n ∈ done, ∀ d, lk M.phi n = some d → cur n = v d

theorem run_sound {M : Maps} {D : List GC} {v : Nat → Bool} (hD : ∀ c ∈ D, v c.out = c.eval v)
    {env : Leaf → Bool} (hin : ∀ p k d, lk2 M.psi p k = some d → env (.inp p k) = v d) :
    ∀ (cells : List Cell) (cert : Nat → CC) (done : List Nat) (cur : Nat → Bool),
      topoOK cells done = true → (∀ i, i < cells.length → cellOK M D (cells.getD i dfltCell) (cert i) = true) →
      Inv M v cur done → Inv M v (run env [] cells cur) (cells.flatMap Cell.outs ++ done)
  | [], _, _, _, _, _, hI => by simpa [run] using hI
  | c :: cs, cert, done, cur, ht, hc, hI => by
    simp only [topoOK, Bool.and_eq_true, List.all_eq_true] at ht
    have hc0 : cellOK M D c (cert 0) = true := by simpa using hc 0 (by simp)
    have hnet : ∀ n, W.net n ∈ c.ins → ∀ d, lk M.phi n = some d → cur n = v d := by
      intro n hn d hd
      have : n ∈ insNets c := by
        simp only [insNets, List.mem_filterMap]; exact ⟨.net n, hn, rfl⟩
      exact hI n ((mem_iff _ _).mp (ht.1 n this)) d hd
    have hcs := cell_sound hD hc0 hin hnet
    have hI' : Inv M v (step env [] cur c) (c.outs ++ done) := by
      intro n hn d hd
      simp only [step]
      by_cases ho : n ∈ c.outs
      · simp only [ho, if_true, cutv, List.not_mem_nil, if_false]
        exact hcs n ho d hd
      · simp only [ho, if_false]
        exact hI n (by simpa [ho] using hn) d hd
    have := run_sound hD hin cs (fun i => cert (i + 1)) (c.outs ++ done) _ ht.2
      (fun i hi => by simpa using hc (i + 1) (by simp; omega)) hI'
    intro n hn d hd
    apply this n _ d hd
    simp only [List.flatMap_cons, List.mem_append] at hn ⊢
    tauto

/-- **Correspondence soundness.** If the checked gates `D` are gates of `N`, the cells are in
topological order and every cell passes `cellOK`, then in every valuation `v` of `N`'s nodes in
which the gates of `D` are settled, and for every input environment that reads each input bit at
its mapped node, the cell netlist's `run` value of every mapped net is `v` at its node. -/
theorem corr_sound {M : Maps} {D : List GC} {N : Net} (hD : ∀ c ∈ D, ∃ g ∈ N.gates, GC.ofGate g = c)
    {cells : List Cell} {cert : Nat → CC} (htopo : topoOK cells [] = true)
    (hcells : ∀ i, i < cells.length → cellOK M D (cells.getD i dfltCell) (cert i) = true)
    {v : Nat → Bool} (hS : Settled N (D.map GC.out) v) {env : Leaf → Bool}
    (hin : ∀ p k d, lk2 M.psi p k = some d → env (.inp p k) = v d) :
    ∀ n ∈ cells.flatMap Cell.outs, ∀ d, lk M.phi n = some d → run env [] cells (fun _ => false) n = v d := by
  have hD' : ∀ c ∈ D, v c.out = c.eval v := by
    intro c hc
    obtain ⟨g, hg, rfl⟩ := hD c hc
    exact hS g hg (List.mem_map.mpr ⟨_, hc, rfl⟩)
  have := run_sound hD' hin cells cert [] (fun _ => false) htopo hcells (fun n h => by simp at h)
  intro n hn d hd
  exact this n (by simpa using hn) d hd

/-! ## Words -/

theorem word_congr {f g : Nat → Bool} : ∀ n, (∀ i, i < n → f i = g i) → word f n = word g n
  | 0, _ => rfl
  | n + 1, h => by
    simp only [word]
    rw [word_congr n (fun i hi => h i (by omega)), h n (by omega)]

theorem lk2_mem : ∀ (l : List (Nat × Nat × Nat)) (p k d : Nat), lk2 l p k = some d → (p, k, d) ∈ l
  | [], _, _, _, h => by simp [lk2] at h
  | (p', k', d') :: l, p, k, d, h => by
    simp only [lk2] at h
    split at h
    · rename_i hc
      simp only [Bool.and_eq_true, beq_iff_eq] at hc
      obtain ⟨rfl, rfl⟩ := hc
      cases h
      exact List.mem_cons_self
    · exact List.mem_cons_of_mem _ (lk2_mem l p k d h)

/-- The input node of port `p`, bit `k`. -/
def inNode (M : Maps) (p k : Nat) : Nat := (lk2 M.psi p k).getD 0

/-- Two input ports of width `w` read from the decoded nodes: `inEnv [x0, x1]` with
`xp = word (v ∘ inNode M p) w` reads every mapped input bit at its node. -/
theorem inEnv2_ok (M : Maps) (w : Nat)
    (hpsi : M.psi.all (fun e => decide (e.1 < 2) && decide (e.2.1 < w)) = true) (v : Nat → Bool) :
    ∀ p k d, lk2 M.psi p k = some d →
      inEnv [word (fun k => v (inNode M 0 k)) w, word (fun k => v (inNode M 1 k)) w] (.inp p k) = v d := by
  intro p k d h
  have hm := List.all_eq_true.mp hpsi _ (lk2_mem _ _ _ _ h)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hm
  have hd : inNode M p k = d := by simp [inNode, h]
  simp only [inEnv]
  rcases (show p = 0 ∨ p = 1 by omega) with rfl | rfl <;>
  · simp only [List.getD_cons_zero, List.getD_cons_succ]
    rw [testBit_word]
    simp [hm.2, hd]

