import Formal.Net.Compute.Word
import Formal.Net.GcdHwLib
import Formal.Gen.Compute.GcdD.Uori0
import Formal.Gen.Compute.GcdD.Uori1
import Formal.Gen.Compute.GcdD.Ucmpi2
import Formal.Gen.Compute.GcdD.Ucmpi3

/-!
# H_COMPUTE_FN for gcd_hw's bit-local compute units (uori0, uori1, ucmpi2, ucmpi3)

Problem statement. For each of these four `bdc_fused_*` units of gcd_hw, the combinational
cone of `z_data` in the committed yosys `synth_xilinx` netlist (route d's synthesis;
`Formal.Gen.Compute.GcdD.*`, generated by `formal/tools/compute/extract.py`) computes, for
EVERY input value, the operation bdc wrote in the unit's Verilog:

| unit | bdc Verilog (`bdc/emit.py` on the gcd fixture) | theorem |
|---|---|---|
| uori0, uori1 | `z = e0 \| e1` (32 bits) | `uori0_fn`, `uori1_fn`: `= Ops.ori 32 a b` |
| ucmpi2 | `z = ((e0 & 1) == e1)` (1 bit) | `ucmpi2_fn`: `= Ops.cmpi .eq 1 (Ops.andi 1 a 1) b` |
| ucmpi3 | `z = ((e0 & e1) == 0)` (1 bit) | `ucmpi3_fn`: `= Ops.cmpi .eq 1 (Ops.andi 1 a b) 0` |

Proof: every output bit depends on at most two input bits (computed support), so each bit is
checked exhaustively (`BitLocal`, kernel `decide`), then assembled bit by bit.

Assumed / not covered: the LUT/MUXF/CARRY4 Boolean semantics (shard A's primitive models;
LUT = its INIT table); that the netlist is the one placed (the bitstream import 11f/11g
proves the placed instances compute these yosys cells); timing (H_COMPUTE_DELAY, rule A);
glitches; the other 16 compute units of gcd_hw.
-/

namespace Formal.Net.Compute.GcdD
open Formal.Net.Compute Formal.Net.GcdHw Formal.Gen.Compute.GcdD

/-! ## uori0, uori1: bitwise OR -/

def orS (i : Nat) : List Leaf := [.inp 0 i, .inp 1 i]
def orSpec (_ : Nat) (l : List Bool) : Bool := l.getD 0 false || l.getD 1 false

theorem uori0_cert : BitLocal Uori0.cells Uori0.outs orS orSpec := by decide
theorem uori1_cert : BitLocal Uori1.cells Uori1.outs orS orSpec := by decide

theorem or_fn {cells : List Cell} {outs : List W} (hl : outs.length = 32)
    (h : BitLocal cells outs orS orSpec) (a b : Nat) :
    unitVal cells outs [a, b] = Ops.ori 32 a b := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [testBit_unitVal, hl, Ops.ori, Nat.testBit_mod_two_pow, Nat.testBit_or]
  by_cases hi : i < 32
  · simp only [hi, decide_true, Bool.true_and]
    rw [bitLocal_sound h (by rw [hl]; exact hi)]
    rfl
  · simp [hi]

/-- **uori0 computes `e0 | e1`** for every pair of inputs. -/
theorem uori0_fn (a b : Nat) : unitVal Uori0.cells Uori0.outs [a, b] = Ops.ori 32 a b :=
  or_fn rfl uori0_cert a b

/-- **uori1 computes `e0 | e1`** for every pair of inputs. -/
theorem uori1_fn (a b : Nat) : unitVal Uori1.cells Uori1.outs [a, b] = Ops.ori 32 a b :=
  or_fn rfl uori1_cert a b

/-! ## ucmpi2, ucmpi3: one-bit compares -/

def b0S (_ : Nat) : List Leaf := [.inp 0 0, .inp 1 0]
def eqSpec (_ : Nat) (l : List Bool) : Bool := (l.getD 0 false == l.getD 1 false)
def nandSpec (_ : Nat) (l : List Bool) : Bool := !(l.getD 0 false && l.getD 1 false)

theorem ucmpi2_cert : BitLocal Ucmpi2.cells Ucmpi2.outs b0S eqSpec := by decide
theorem ucmpi3_cert : BitLocal Ucmpi3.cells Ucmpi3.outs b0S nandSpec := by decide

theorem word1 (f : Nat → Bool) : word f 1 = if f 0 then 1 else 0 := by
  cases h : f 0 <;> simp [word, h]

theorem tb0 (x : Nat) : x.testBit 0 = decide (x % 2 = 1) := by
  rw [Nat.testBit_zero]

/-- **ucmpi2 computes `(e0 & 1) == e1`** (one-bit ports) for every pair of inputs. -/
theorem ucmpi2_fn (a b : Nat) :
    unitVal Ucmpi2.cells Ucmpi2.outs [a, b] = Ops.cmpi .eq 1 (Ops.andi 1 a 1) b := by
  have h := bitLocal_sound ucmpi2_cert (i := 0) (by decide) (inEnv [a, b])
  simp only [unitVal, show Ucmpi2.outs.length = 1 from rfl, word1]
  rw [h]
  simp only [b0S, eqSpec, List.map, inEnv, List.getD, List.getElem?_cons_zero,
    List.getElem?_cons_succ, Option.getD_some, tb0, Ops.cmpi, Ops.andi, Ops.b2n,
    Nat.and_one_is_mod]
  rcases Nat.mod_two_eq_zero_or_one a with ha | ha <;>
    rcases Nat.mod_two_eq_zero_or_one b with hb | hb <;> simp [ha, hb]

theorem mod2_eq (x : Nat) : x % 2 = if x.testBit 0 then 1 else 0 := by
  rw [tb0]; rcases Nat.mod_two_eq_zero_or_one x with h | h <;> simp [h]

/-- **ucmpi3 computes `(e0 & e1) == 0`** (one-bit ports) for every pair of inputs. -/
theorem ucmpi3_fn (a b : Nat) :
    unitVal Ucmpi3.cells Ucmpi3.outs [a, b] = Ops.cmpi .eq 1 (Ops.andi 1 a b) 0 := by
  have h := bitLocal_sound ucmpi3_cert (i := 0) (by decide) (inEnv [a, b])
  simp only [unitVal, show Ucmpi3.outs.length = 1 from rfl, word1]
  rw [h]
  simp only [b0S, nandSpec, List.map, inEnv, List.getD, List.getElem?_cons_zero,
    List.getElem?_cons_succ, Option.getD_some, Ops.cmpi, Ops.andi, Ops.b2n, Nat.pow_one,
    Nat.mod_mod, Nat.zero_mod]
  rw [mod2_eq (a &&& b), Nat.testBit_and]
  rcases Bool.eq_false_or_eq_true (a.testBit 0) with h1 | h1 <;>
    rcases Bool.eq_false_or_eq_true (b.testBit 0) with h2 | h2 <;> simp [h1, h2]

end Formal.Net.Compute.GcdD
