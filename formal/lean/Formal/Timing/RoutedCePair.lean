import Formal.Timing.RoutedCePairS1Fork
import Formal.Timing.RoutedCePairS1Loop
import Formal.Timing.RoutedCePairS1Input
import Formal.Net.Fasm.CePairS1

/-!
# 10a's verified checker on a REAL routed netlist: ce_pair, seed 1 (probe C-10d)

Data: `Formal/Timing/RoutedCePairS1{Fork,Loop,Input}.lean`, generated by
`formal/tools/routed2lean/routed2lean.py` from the physical netlist that 11b's
`fasm2lean` reads back from the seed-1 bitstream (two LUT6 C-elements,
`q1 = bd_c2(a,b,rst)` at SLICE_X42Y95.BLUT, `q2 = bd_c2n(q1,c,rst)` at
SLICE_X42Y94.ALUT, nextpnr 9c732bc6303458df, `--freq 100 --seed 1`).
One arc per pip (4-corner prjxray intrinsic delay), per route RC (Elmore) term,
per LUT site input pin and per LUT6 cell arc `Ak → O6`.  Each sink has its own
chain (H_ROUTE per sink, as 11b).  Feedback loops are unrolled once (`…@lap`).

Interval variants (all on the same nodes and arcs):
* `indep`  H_INDEP: every element independently in `[fast_min, slow_max]`.
* `fast`, `slow`  H_ONE_CORNER: the whole die at one prjxray corner,
  every element in `[corner_min, corner_max]`, RC term in `[0, E]`.
* `fastE`, `slowE`  H_ONE_CORNER + H_RC_EXACT: the RC term is prjxray's fixed
  Elmore number `E` (timing.py: delay = intrinsic(corner) + RC, RC corner-free).
* `sdf`  nextpnr's SDF numbers on the same paths (for comparison; not a bound).

The relative-timing property checked (`Fork`, launch = q1's O6 edge):
**RT_FB: q1's feedback reaches its own pin B1 before q2's output can switch.**
Rationale: in a pipeline the next change of q1's inputs is caused (through the
environment) by q2's output, so if the loop has closed before q2 fires, q1's
inputs are held long enough (B's `c2_follow_hold` hold requirement), with no
credit for any environment delay (H_ENV_ZERO, conservative).
-/

namespace Formal.Timing.Routed
open Formal.Timing Formal.Net

/-! ## Well-formedness (kernel `decide`) -/

theorem fork_wf_indep : CePairS1Fork.indep.WF := by decide +kernel
theorem fork_wf_fast : CePairS1Fork.fast.WF := by decide +kernel
theorem fork_wf_slow : CePairS1Fork.slow.WF := by decide +kernel
theorem fork_wf_fastE : CePairS1Fork.fastE.WF := by decide +kernel
theorem fork_wf_slowE : CePairS1Fork.slowE.WF := by decide +kernel
theorem loop_wf_indep : CePairS1Loop.indep.WF := by decide +kernel

/-- The generated buckets are well labelled (so `winB`/`checkB` take the one-pass path). -/
theorem fork_buckets : bucketsOK CePairS1Fork.indepB = true := by decide +kernel

/-! ## Windows: agreement with 11b's numbers, disagreement with the SDF -/

/-- Feedback route q1.O6 → B1 under H_INDEP is exactly fasm2lean's `pinDelay`
for that pin, `(213, 709)`. -/
theorem fork_fb_eq_11b : winB CePairS1Fork.indepB CePairS1Fork.fb = some (Formal.Net.Fasm.CePairS1.pinDelay[1]![0]!) := by
  decide +kernel

/-- Inter-cell route q1.O6 → q2's pin A1 is fasm2lean's `pinDelay`, `(262, 859)`. -/
theorem fork_q2pin_eq_11b :
    winB CePairS1Fork.indepB CePairS1Fork.q2pin = some (Formal.Net.Fasm.CePairS1.pinDelay[0]![0]!) := by
  decide +kernel

/-- From input `a` at q1's physical pin B4, the feedback reaches B1 in
`[258, 833]` ps: the upper end is 11b's hold length in `q1_follow_hold_s1_ps`
(`124 + 709`, LUT6 slow max + the feedback route), now computed by the checker. -/
theorem loop_fb_window : winB CePairS1Loop.indepB CePairS1Loop.fb = some (258, 833) := by decide +kernel

theorem loop_fb_hi_eq_11b :
    (winB CePairS1Loop.indepB CePairS1Loop.fb).map Prod.snd = some (124 + (Formal.Net.Fasm.CePairS1.pinDelay[1]![0]!).2) := by
  decide +kernel

/-- **Semantic form.** In every run of the routed loop under H_INDEP (any delay
of every element inside its prjxray interval, glitches allowed), the feedback
pin B1 switches only between 258 and 833 ps after `a` switches at B4. -/
theorem loop_fb_in_window {sig : Nat → Trace} (r : Run CePairS1Loop.indep sig) :
    ∀ t, changes (sig CePairS1Loop.fb) t → 258 ≤ t ∧ t ≤ 833 := by
  intro t ht
  obtain ⟨e, l, hw, h1, h2⟩ := changes_in_winB loop_wf_indep r _ t ht
  rw [loop_fb_window] at hw
  cases hw
  exact ⟨h1, h2⟩

/-- nextpnr's SDF puts the feedback route at 295 ps, the inter-cell route at
435 ps: both BELOW the slow-corner minimum of the same routes (534 and 650),
because the SDF has a flat 25 ps for the LUT site pins B1/A1 (prjxray: 420/428
ps slow min). -/
theorem fork_sdf_vs_slow :
    winB CePairS1Fork.sdfB CePairS1Fork.fb = some (295, 295) ∧
    winB CePairS1Fork.slowB CePairS1Fork.fb = some (534, 709) ∧
    winB CePairS1Fork.sdfB CePairS1Fork.q2pin = some (435, 435) ∧
    winB CePairS1Fork.slowB CePairS1Fork.q2pin = some (650, 859) := by
  decide +kernel

/-! ## The RT_FB check under each corner hypothesis (kernel `decide`) -/

theorem fork_check_indep : checkB CePairS1Fork.indepB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = false := by decide +kernel
theorem fork_check_fast : checkB CePairS1Fork.fastB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = false := by decide +kernel
theorem fork_check_slow : checkB CePairS1Fork.slowB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = true := by decide +kernel
theorem fork_check_fastE : checkB CePairS1Fork.fastEB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = true := by decide +kernel
theorem fork_check_slowE : checkB CePairS1Fork.slowEB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = true := by decide +kernel
theorem fork_check_sdf : checkB CePairS1Fork.sdfB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = true := by decide +kernel

/-- Slacks (ps): H_INDEP −402, fast −8, slow +41, fastE +50, slowE +99, SDF +264. -/
theorem fork_slacks :
    slackB CePairS1Fork.indepB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = some (-402) ∧
    slackB CePairS1Fork.fastB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = some (-8) ∧
    slackB CePairS1Fork.slowB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = some 41 ∧
    slackB CePairS1Fork.fastEB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = some 50 ∧
    slackB CePairS1Fork.slowEB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = some 99 ∧
    slackB CePairS1Fork.sdfB CePairS1Fork.q2 [CePairS1Fork.fb] 0 = some 264 := by
  decide +kernel

/-! ## What the checks mean (soundness and exactness, from 10a) -/

/-- **The routed instance, proved (H_ONE_CORNER + H_RC_EXACT).** If the whole die
sits at one prjxray corner (fast or slow) and every routing RC term is prjxray's
Elmore number, then in every run (per-event delays anywhere inside the corner's
intervals, any LUT functions, glitches passed), every change of q1's feedback
pin B1 happens no later than every change of q2's output. -/
theorem ce_pair_s1_rt_fb_oneCornerE {sig : Nat → Trace}
    (H_ONE_CORNER : Nonempty (Run CePairS1Fork.fastE sig) ∨ Nonempty (Run CePairS1Fork.slowE sig)) :
    ∀ s t, changes (sig CePairS1Fork.fb) s → changes (sig CePairS1Fork.q2) t → s ≤ t := by
  intro s t hs ht
  rcases H_ONE_CORNER with ⟨⟨r⟩⟩ | ⟨⟨r⟩⟩
  · have := checkB_sound fork_wf_fastE fork_check_fastE r CePairS1Fork.fb List.mem_cons_self s t hs ht
    omega
  · have := checkB_sound fork_wf_slowE fork_check_slowE r CePairS1Fork.fb List.mem_cons_self s t hs ht
    omega

/-- The same at the slow corner without H_RC_EXACT (RC anywhere in `[0, E]`). -/
theorem ce_pair_s1_rt_fb_slow {sig : Nat → Trace} (r : Run CePairS1Fork.slow sig) :
    ∀ s t, changes (sig CePairS1Fork.fb) s → changes (sig CePairS1Fork.q2) t → s ≤ t := by
  intro s t hs ht
  have := checkB_sound fork_wf_slow fork_check_slow r CePairS1Fork.fb List.mem_cons_self s t hs ht
  omega

/-- The feedback and q2 cones share only the launch (per-sink chains). -/
theorem fork_separated (net : Netlist) (h : net.arcs.map (fun a => (a.src, a.dst)) =
    CePairS1Fork.indep.arcs.map (fun a => (a.src, a.dst))) :
    Separated net (fun v => CePairS1Fork.fb_part.contains v) := by
  have hs : Separated CePairS1Fork.indep (fun v => CePairS1Fork.fb_part.contains v) := by decide +kernel
  intro a ha h0
  have : (a.src, a.dst) ∈ CePairS1Fork.indep.arcs.map (fun a => (a.src, a.dst)) := by
    rw [← h]; exact List.mem_map_of_mem ha
  obtain ⟨b, hb, hab⟩ := List.mem_map.1 this
  simp only [Prod.mk.injEq] at hab
  rw [← hab.1, ← hab.2]
  exact hs b hb (by rw [hab.1]; exact h0)

/-- **H_INDEP is not just pessimistic here, it is violated.** With every element
independently in `[fast_min, slow_max]` there is a fixed-delay run (one delay
per element) in which q2's output switches before q1's feedback has reached
B1 (10a's `check_exact_disjoint`). So RT_FB holds only under a corner
correlation hypothesis, which is 10b's point, now on a routed instance. -/
theorem ce_pair_s1_rt_fb_indep_violated : ∃ d ∈ [CePairS1Fork.fb], ∃ sig,
    Nonempty (FixedRun CePairS1Fork.indep sig) ∧
    ∃ s t, changes (sig d) s ∧ changes (sig CePairS1Fork.q2) t ∧ t < s + 0 :=
  check_exact_disjoint fork_wf_indep (fork_separated _ rfl) (by decide +kernel) (by decide +kernel)
    (by
      have h := winB_eq CePairS1Fork.indepB fork_wf_indep CePairS1Fork.q2
      rw [show CePairS1Fork.indep = ofBuckets CePairS1Fork.indepB from rfl, ← h]; decide +kernel)
    (by
      have h := checkB_eq _ fork_wf_indep CePairS1Fork.q2 [CePairS1Fork.fb] 0
      rw [fork_check_indep] at h; exact h.symm)

/-- Also violated at the fast corner when the RC term may be 0 (`fast`): the
verdict at the fast corner depends on the RC lower bound (8 ps). -/
theorem ce_pair_s1_rt_fb_fast_violated : ∃ d ∈ [CePairS1Fork.fb], ∃ sig,
    Nonempty (FixedRun CePairS1Fork.fast sig) ∧
    ∃ s t, changes (sig d) s ∧ changes (sig CePairS1Fork.q2) t ∧ t < s + 0 :=
  check_exact_disjoint fork_wf_fast (fork_separated _ rfl) (by decide +kernel) (by decide +kernel)
    (by
      have h := winB_eq CePairS1Fork.fastB fork_wf_fast CePairS1Fork.q2
      rw [show CePairS1Fork.fast = ofBuckets CePairS1Fork.fastB from rfl, ← h]; decide +kernel)
    (by
      have h := checkB_eq _ fork_wf_fast CePairS1Fork.q2 [CePairS1Fork.fb] 0
      rw [fork_check_fast] at h; exact h.symm)

/-! ## The input path (launch at a's IOB), windows only -/

theorem input_wf_indep : CePairS1Input.indep.WF := by decide +kernel

/-- `a` (IOB I pin) → q1 → q2: windows at q1's B4 pin, q1, q2 (H_INDEP) and the SDF. -/
theorem input_windows :
    winB CePairS1Input.indepB CePairS1Input.b4 = some (334, 1163) ∧
    winB CePairS1Input.indepB CePairS1Input.q1 = some (379, 1287) ∧
    winB CePairS1Input.indepB CePairS1Input.q2 = some (686, 2270) ∧
    winB CePairS1Input.sdfB CePairS1Input.q2 = some (1664, 1664) := by
  decide +kernel

end Formal.Timing.Routed
