import Formal.Timing.RoutedMuller64S1
import Formal.Timing.RoutedMuller64S1Wave

/-!
# RT_FB on every C-element of a routed 64-stage Muller pipeline (probe C-10d)

Data: `RoutedMuller64S1.lean`, generated by `formal/tools/routed2lean/rt_all.py`
from the physical netlist 11b's `fasm2lean` reads back from the bitstream of
`formal/tools/routed2lean/pipe/muller_pipe.v` (N = 64 stages of `bd_c2n`,
`c[i] = C(c[i-1], ~c[i+1])`, nextpnr 9c732bc6303458df, `--freq 100 --seed 1`,
cells/flow.sh options).  64 entries, one per C-element: the DAG launched at its
O6 edge (its feedback route, both neighbours' input routes, their LUT arcs and
their routes back), 54-62 nodes, 55-62 arcs each, 3.6k arcs per variant.

RT_FB(i): the feedback of `c[i]` reaches its own LUT pin before either
neighbour's response to `c[i]`'s edge reaches one of `c[i]`'s pins.  If it fails,
`c[i]`'s inputs disagree while its pin still shows the old output, and the LUT
(majority with the feedback) flips back: the hazard B's `c2_follow_hold`
excludes by hypothesis.  Result, per interval variant (`rt_all.py` report):

| variant | H_ | RT_FB holds |
|---|---|---|
| indep | H_INDEP | 22 / 64 |
| fast  | H_ONE_CORNER (RC in [0,E]) | 48 / 64 |
| slow  | H_ONE_CORNER (RC in [0,E]) | 50 / 64 |
| fastE | H_ONE_CORNER + H_RC_EXACT | 52 / 64 |
| slowE | H_ONE_CORNER + H_RC_EXACT | 52 / 64 |
| sdf   | nextpnr's numbers (not a bound) | 63 / 64 |

Every passing entry is PROVED for all runs (`rtOne_sound`), and every failing
entry has a fixed-delay run that really violates RT_FB (`rtOne_exact`: request
and data cones share only the launch), so in each model the count is exact.
-/

namespace Formal.Timing.Routed
open Formal.Timing Formal.Net

theorem m64_length : Muller64S1.slowE.length = 64 := by decide +kernel

theorem m64_wf_indep : Muller64S1.indep.all wfOne = true := by decide +kernel
theorem m64_wf_slowE : Muller64S1.slowE.all wfOne = true := by decide +kernel
theorem m64_wf_fastE : Muller64S1.fastE.all wfOne = true := by decide +kernel
theorem m64_wf_sdf : Muller64S1.sdf.all wfOne = true := by decide +kernel

theorem m64_sep_indep : Muller64S1.indep.all sepOne = true := by decide +kernel
theorem m64_sep_slowE : Muller64S1.slowE.all sepOne = true := by decide +kernel
theorem m64_sep_fastE : Muller64S1.fastE.all sepOne = true := by decide +kernel

/-- How many of the 64 routed C-elements pass RT_FB, per variant (kernel `decide`). -/
theorem m64_counts :
    (Muller64S1.indep.filter rtOne).length = 22 ∧
    (Muller64S1.fast.filter rtOne).length = 48 ∧
    (Muller64S1.slow.filter rtOne).length = 50 ∧
    (Muller64S1.fastE.filter rtOne).length = 52 ∧
    (Muller64S1.slowE.filter rtOne).length = 52 ∧
    (Muller64S1.sdf.filter rtOne).length = 63 := by
  decide +kernel

/-- **Proved safe:** under H_ONE_CORNER (slow die) + H_RC_EXACT, every routed
C-element that passes the check satisfies RT_FB in every run (any per-event
delays inside the slow-corner intervals, glitches passed, any LUT functions). -/
theorem m64_rt_sound_slowE : ∀ e ∈ Muller64S1.slowE, rtOne e = true → ∀ {sig : Nat → Trace},
    Run (ofBuckets e.1) sig → ∀ r ∈ e.2.1, ∀ s t, changes (sig e.2.2.1) s → changes (sig r) t → s ≤ t :=
  fun e he h _ run => rtOne_sound e (List.all_eq_true.1 m64_wf_slowE e he) h run

theorem m64_rt_sound_fastE : ∀ e ∈ Muller64S1.fastE, rtOne e = true → ∀ {sig : Nat → Trace},
    Run (ofBuckets e.1) sig → ∀ r ∈ e.2.1, ∀ s t, changes (sig e.2.2.1) s → changes (sig r) t → s ≤ t :=
  fun e he h _ run => rtOne_sound e (List.all_eq_true.1 m64_wf_fastE e he) h run

/-- **Really violated:** every failing entry has a fixed-delay run (one delay per
element, inside the slow-corner intervals) in which a neighbour's response
reaches the C-element before its own feedback does. -/
theorem m64_rt_violated_slowE : ∀ e ∈ Muller64S1.slowE, rtOne e = false →
    ∃ r ∈ e.2.1, ∃ sig, Nonempty (FixedRun (ofBuckets e.1) sig) ∧
      ∃ s t, changes (sig e.2.2.1) s ∧ changes (sig r) t ∧ t < s :=
  fun e he h => rtOne_exact e (List.all_eq_true.1 m64_wf_slowE e he) (List.all_eq_true.1 m64_sep_slowE e he) h

theorem m64_rt_violated_fastE : ∀ e ∈ Muller64S1.fastE, rtOne e = false →
    ∃ r ∈ e.2.1, ∃ sig, Nonempty (FixedRun (ofBuckets e.1) sig) ∧
      ∃ s t, changes (sig e.2.2.1) s ∧ changes (sig r) t ∧ t < s :=
  fun e he h => rtOne_exact e (List.all_eq_true.1 m64_wf_fastE e he) (List.all_eq_true.1 m64_sep_fastE e he) h

theorem m64_rt_violated_indep : ∀ e ∈ Muller64S1.indep, rtOne e = false →
    ∃ r ∈ e.2.1, ∃ sig, Nonempty (FixedRun (ofBuckets e.1) sig) ∧
      ∃ s t, changes (sig e.2.2.1) s ∧ changes (sig r) t ∧ t < s :=
  fun e he h => rtOne_exact e (List.all_eq_true.1 m64_wf_indep e he) (List.all_eq_true.1 m64_sep_indep e he) h

/-- The worst C-element at the slow corner, SLICE_X38Y98.ALUT (entry 43):
feedback on the slow site pin A3 via a FAN_ALT/FAN_BOUNCE detour, neighbours on
A2/A4.  Slack −138 ps (`slackB`); a concrete violating fixed-delay run exists. -/
theorem m64_worst_slowE :
    (Muller64S1.slowE[43]!).2.2.1 = 32 ∧
    slackB (Muller64S1.slowE[43]!).1 46 [32] 0 = some (-138) ∧
    rtOne (Muller64S1.slowE[43]!) = false := by
  decide +kernel

/-! ## Scale: one 1227-arc routed DAG (`RoutedMuller64S1Wave`, launch = `req` at its IOB,
the whole pipeline unrolled, 1165 nodes), windows by kernel `decide` in about 1 s -/

theorem wave_wf : Muller64S1Wave.indep.WF := by decide +kernel

/-- `req` at its IOB to the output port `qn` (64 C-elements in series, no
acknowledge): H_INDEP window, and the slow corner with H_RC_EXACT. -/
theorem wave_qn :
    winB Muller64S1Wave.indepB Muller64S1Wave.qn = some (13922, 47367) ∧
    winB Muller64S1Wave.slowEB Muller64S1Wave.qn = some (38420, 47367) ∧
    winB Muller64S1Wave.sdfB Muller64S1Wave.qn = some (32476, 32476) := by
  decide +kernel

/-- In every run of the routed pipeline (H_INDEP), `qn` switches only inside
[13.922, 47.367] ns after `req` switches. -/
theorem wave_qn_in_window {sig : Nat → Trace} (r : Run Muller64S1Wave.indep sig) :
    ∀ t, changes (sig Muller64S1Wave.qn) t → 13922 ≤ t ∧ t ≤ 47367 := by
  intro t ht
  obtain ⟨e, l, hw, h1, h2⟩ := changes_in_winB wave_wf r _ t ht
  rw [wave_qn.1] at hw
  cases hw
  exact ⟨h1, h2⟩

end Formal.Timing.Routed
