    nPass Muller64S1.indep = 22 ∧
    nPass Muller64S1.fast = 48 ∧
    nPass Muller64S1.slow = 50 ∧
    nPass Muller64S1.fastE = 52 ∧
    nPass Muller64S1.slowE = 52 ∧
    nPass Muller64S1.sdf = 63 := by decide +kernel
theorem m64s1_worst :
    worstSlack Muller64S1.indep = some (-643) ∧
    worstSlack Muller64S1.fast = some (-117) ∧
    worstSlack Muller64S1.slow = some (-187) ∧
    worstSlack Muller64S1.fastE = some (-47) ∧
    worstSlack Muller64S1.slowE = some (-138) ∧
    worstSlack Muller64S1.sdf = some (-7) := by decide +kernel
theorem m64s1_wf : Muller64S1.indep.all wfOne = true ∧ Muller64S1.fastE.all wfOne = true ∧ Muller64S1.slowE.all wfOne = true := by
  decide +kernel
theorem m64s1_sep : Muller64S1.indep.all sepOne = true ∧ Muller64S1.fastE.all sepOne = true ∧ Muller64S1.slowE.all sepOne = true := by
  decide +kernel
/-- Seed 1, H_ONE_CORNER (slow die) + H_RC_EXACT: passing C-elements are safe in every run,
failing ones (12 of 64) really violate RT_FB in some fixed-delay run. -/
theorem m64s1_slowE :
    (∀ e ∈ Muller64S1.slowE, rtOne e = true → ∀ {sig : Nat → Trace}, Run (ofBuckets e.1) sig →
      ∀ r ∈ e.2.1, ∀ s t, changes (sig e.2.2.1) s → changes (sig r) t → s ≤ t) ∧
    (∀ e ∈ Muller64S1.slowE, rtOne e = false → ∃ r ∈ e.2.1, ∃ sig, Nonempty (FixedRun (ofBuckets e.1) sig) ∧
      ∃ s t, changes (sig e.2.2.1) s ∧ changes (sig r) t ∧ t < s) :=
  ⟨rt_sound_of _ m64s1_wf.2.2, rt_violated_of _ m64s1_wf.2.2 m64s1_sep.2.2⟩

