theorem m64s1_pass :
    nPass RtFbM64S1.indep = 26 ∧
    nPass RtFbM64S1.fast = 46 ∧
    nPass RtFbM64S1.slow = 50 ∧
    nPass RtFbM64S1.fastE = 64 ∧
    nPass RtFbM64S1.slowE = 61 ∧
    nPass RtFbM64S1.sdf = 63 := by decide +kernel
theorem m64s1_worst :
    worstSlack RtFbM64S1.indep = some (-708) ∧
    worstSlack RtFbM64S1.fast = some (-65) ∧
    worstSlack RtFbM64S1.slow = some (-90) ∧
    worstSlack RtFbM64S1.fastE = some (6) ∧
    worstSlack RtFbM64S1.slowE = some (-20) ∧
    worstSlack RtFbM64S1.sdf = some (-7) := by decide +kernel
theorem m64s1_wf : RtFbM64S1.indep.all wfOne = true ∧ RtFbM64S1.fastE.all wfOne = true ∧ RtFbM64S1.slowE.all wfOne = true := by
  decide +kernel
theorem m64s1_sep : RtFbM64S1.indep.all sepOne = true ∧ RtFbM64S1.fastE.all sepOne = true ∧ RtFbM64S1.slowE.all sepOne = true := by
  decide +kernel
/-- Seed 1, H_ONE_CORNER (slow die) + H_RC_EXACT: passing C-elements are safe in every run,
failing ones (3 of 64) really violate RT_FB in some fixed-delay run. -/
theorem m64s1_slowE :
    (∀ e ∈ RtFbM64S1.slowE, rtOne e = true → ∀ {sig : Nat → Trace}, Run (ofBuckets e.1) sig →
      ∀ r ∈ e.2.1, ∀ s t, changes (sig e.2.2.1) s → changes (sig r) t → s ≤ t) ∧
    (∀ e ∈ RtFbM64S1.slowE, rtOne e = false → ∃ r ∈ e.2.1, ∃ sig, Nonempty (FixedRun (ofBuckets e.1) sig) ∧
      ∃ s t, changes (sig e.2.2.1) s ∧ changes (sig r) t ∧ t < s) :=
  ⟨rt_sound_of _ m64s1_wf.2.2, rt_violated_of _ m64s1_wf.2.2 m64s1_sep.2.2⟩

