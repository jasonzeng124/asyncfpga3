/-- **The round trip**: the re-encoded gates plus the leftover features are the target's features, each once. -/
theorem roundtrip : ((gates.flatMap (feats pre)) ++ lft.map get).Perm tf := by
  rw [hcover, ← List.map_append]
  exact perm_map_getD tf _ (by rw [tf_length]; exact hperm)

