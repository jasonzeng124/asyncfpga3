/-- **The witness is a behaviour of the circuit** (Spec.Behaves at the slow corner, g = 1, κ = 0). -/
theorem pc (n : Nat) (hn : n < 200097) : P + Dm ≤ cut n := (perAll n hn).1

theorem pp (n : Nat) (hn : n < 200097) : PerOn (D n) P (cut n - Dm) (hor n) :=
  perOn_of_chk _ (by have := pc n hn; omega) (perAll n hn).2

theorem beh_ok : Behaves pSlow (circuit net boundary) (extC D cut P) := by
  refine ⟨1, by norm_num, le_refl _, fun g hg => ?_⟩
  simp only [circuit, Boundary.envNodes, List.mem_filter, decide_eq_true_eq] at hg
  obtain ⟨hgm, hno⟩ := hg
  obtain ⟨hl1, hl2, hout, hins, _, harc⟩ := gates_wf g hgm
  obtain ⟨hc, hdm, hhor⟩ := (allC g hgm : Pc g) (of_decide_eq_true hno)
  have hmi : ∀ i, i < g.k → g.ins.getD i 0 ∈ g.ins := fun i hi => getD_mem _ _ (by omega)
  have hio : ∀ i, i < g.k → g.ins.getD i 0 < 200097 := fun i hi => hins _ (hmi i hi)
  have hho : g.winEnd cut P ≤ hor g.out := hhor _ List.mem_cons_self
  have hhi : ∀ i, i < g.k → g.winEnd cut P ≤ hor (g.ins.getD i 0) := fun i hi =>
    hhor _ (List.mem_cons_of_mem _ (hmi i hi))
  exact gateOK_cut D cut g hP (le_winEnd_out cut P g).2 hdm hl2
    (fun e he => ⟨(harc e he).2.2.1, (harc e he).2.1⟩) (le_winEnd_out cut P g).1 (le_winEnd_in cut P g)
    (pc _ hout) (fun i hi => pc _ (hio i hi)) hc
    (perOn_mono (pp _ hout) (by omega) hho)
    (fun i hi => perOn_mono (pp _ (hio i hi)) (le_refl _)
      (by have := le_winEnd_in cut P g i hi; have := hhi i hi; omega))
    (fun i hi => perOn_mono (pp _ (hio i hi)) (by omega) (hhi i hi))

theorem arbChk : ∀ a ∈ arbs, (D a.q).ok = true ∧ (∀ n ∈ a.ins, (D n).ok = true) ∧
