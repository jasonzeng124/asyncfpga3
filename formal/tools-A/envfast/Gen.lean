import Formal.Core.EnvFast.Models

/-!
Certificate / table generator for `Formal.Core.EnvFast` (UNTRUSTED: every number
it prints is checked by the kernel). Run from formal/lean:

    ../slot.sh lake env sh -c 'LEAN_PATH=$PWD/.lake/checkfile:$LEAN_PATH lean ../tools-A/envfast/Gen.lean'

(after `../check.sh … Formal/Core/EnvFast/Models.lean` has put the oleans in .lake/checkfile).

It writes `Formal/Core/EnvFast/Tables.lean`, `Link2Cert.lean` and `MergeCert.lean`.
To add a model: define it in `EnvFast/Models.lean`, add its LUT outputs to `luts`,
emit its certificate below, then write the `CModel` and chunk theorems.
Reachable sets come from `Env.reachTree` (interpreted); certificates are
emitted in balanced-BST preorder so that `EnvFast.mkTree` builds a balanced tree.
-/

open Formal.Core.LutTree Formal.Core.LutCells Formal.Core.LutAudit Formal.Core.Env Formal.Core.EnvFast

def ttOf (L : LutInst) (o : OutSel) (k : Nat) : Nat :=
  (vecs k).foldl (fun acc w => if outB L o w then acc ||| (1 <<< addrOf w) else acc) 0

def hzOf (L : LutInst) (o : OutSel) (k : Nat) : Nat :=
  (vecs k).foldl (fun acc a => (vecs k).foldl (fun acc b =>
    if okCls (classify L o a b) then acc ||| (1 <<< (addrOf a * 2 ^ k + addrOf b)) else acc) acc) 0

def hex (n : Nat) : String := "0x" ++ String.ofList (Nat.toDigits 16 n)

partial def balanced (xs : Array Nat) (lo hi : Nat) (out : Array Nat) : Array Nat :=
  if lo ≥ hi then out else
    let mid := (lo + hi) / 2
    balanced xs (mid + 1) hi (balanced xs lo mid (out.push xs[mid]!))

def certOf (M : Model) (fuel : Nat) : List Nat :=
  let xs := ((reachTree M fuel).toList.toArray).qsort (· < ·)
  (balanced xs 0 xs.size #[]).toList

def emitList (name doc : String) (l : List Nat) : String :=
  s!"/-- {doc} ({l.length} states) -/\ndef {name} : List Nat := [\n" ++
    ",\n".intercalate (l.map fun x => "  " ++ hex x) ++ "]\n"

partial def chunksOf (l : List Nat) (k : Nat) : List (List Nat) :=
  if l.length ≤ k then [l] else l.take k :: chunksOf (l.drop k) k

/-- A certificate split into chunks of `k` states: `name_i` and `name : List (List Nat)`. -/
def emitChunks (name doc : String) (l : List Nat) (k : Nat) : String := Id.run do
  let cs := chunksOf l k
  let mut s := ""
  let mut i := 0
  for c in cs do
    s := s ++ emitList s!"{name}_{i}" s!"{doc}, chunk {i}" c ++ "\n"
    i := i + 1
  s := s ++ s!"/-- {doc}: {l.length} states in {cs.length} chunks. -/\ndef {name} : List (List Nat) :=\n  [" ++
    ", ".intercalate ((List.range cs.length).map fun j => s!"{name}_{j}") ++ "]\n"
  return s

/-- (Lean name, constant name, output) of the LUT outputs to tabulate. -/
def luts : List (String × String × LutInst × OutSel) :=
  [("bd_c2_u_O", "bd_c2_u", bd_c2_u, .O), ("bd_c2n_u_O", "bd_c2n_u", bd_c2n_u, .O),
   ("bd_latch_u_L38_O5", "bd_latch_u_L38", bd_latch_u_L38, .O5),
   ("bd_latch_u_L38_O6", "bd_latch_u_L38", bd_latch_u_L38, .O6),
   ("bd_latch_u_L44_O", "bd_latch_u_L44", bd_latch_u_L44, .O),
   ("bd_merge_uor_O", "bd_merge_uor", bd_merge_uor, .O),
   ("bd_merge_usel_O", "bd_merge_usel", bd_merge_usel, .O)]

def oname : OutSel → String | .O => ".O" | .O5 => ".O5" | .O6 => ".O6"

def tablesFile : String := Id.run do
  let mut s := "import Formal.Core.EnvFast\n\n/-!\n# Formal.Core.EnvFast.Tables — LUT truth and hazard tables\n\nGENERATED by `formal/tools-A/envfast/Gen.lean` (untrusted); each table is checked\nagainst `LutAudit.outB` / `LutAudit.classify` on every vector by `decide +kernel`.\n-/\n\nnamespace Formal.Core.EnvFast.Tables\n\nopen Formal.Core.LutCells Formal.Core.EnvFast\n\n"
  for (nm, cn, L, o) in luts do
    let k := nfree (opins L o)
    s := s ++ s!"def tt_{nm} : Nat := {hex (ttOf L o k)}\n"
    s := s ++ s!"def hz_{nm} : Nat :=\n  {hex (hzOf L o k)}\n"
    s := s ++ s!"theorem tt_{nm}_ok : ttOK {cn} {oname o} {k} tt_{nm} = true := by decide +kernel\n"
    s := s ++ s!"theorem hz_{nm}_ok : hzOK {cn} {oname o} {k} hz_{nm} = true := by decide +kernel\n\n"
  return s ++ "end Formal.Core.EnvFast.Tables\n"

def certFile (mod doc : String) (defs : List (String × String × List Nat)) (k : Nat := 128) : String :=
  s!"/-!\n# Formal.Core.EnvFast.{mod} — certificate data\n\nGENERATED by `formal/tools-A/envfast/Gen.lean` (untrusted data: reachable states\nin balanced-BST preorder, split into chunks of {k}; only the checker is trusted). {doc}\n-/\n\nnamespace Formal.Core.EnvFast.Certs\n\n" ++
  "\n".intercalate (defs.map fun (n, d, l) => emitChunks n d l k) ++ "\nend Formal.Core.EnvFast.Certs\n"

#eval show IO Unit from do
  IO.FS.writeFile "Formal/Core/EnvFast/Tables.lean" tablesFile
  let c := certOf (link2Model ⟨true, true, true, false⟩) 100000
  IO.println s!"link2 HLI: {c.length}"
  let d := certOf (link2Model ⟨true, true, true, true⟩) 100000
  IO.println s!"link2 HLIR: {d.length}"
  let e := certOf (linkModel ⟨true, true, true, false⟩) 100000
  IO.println s!"link1 HLI: {e.length}"
  IO.FS.writeFile "Formal/Core/EnvFast/Link2Cert.lean" (certFile "Link2Cert" "bd_link W = 2 and W = 1."
    [("link2_HLI", "`link2Model ⟨true, true, true, false⟩`", c),
     ("link2_HLIR", "`link2Model ⟨true, true, true, true⟩`", d),
     ("link1_HLI", "`Env.linkModel ⟨true, true, true, false⟩`", e)])
  let m1 := certOf (mergeModel ⟨true, true⟩) 100000
  let m0 := certOf (mergeModel ⟨false, true⟩) 100000
  IO.println s!"merge excl: {m1.length}, merge free: {m0.length}"
  IO.FS.writeFile "Formal/Core/EnvFast/MergeCert.lean" (certFile "MergeCert" "bd_merge control path."
    [("merge_excl", "`mergeModel ⟨true, true⟩`", m1), ("merge_free", "`mergeModel ⟨false, true⟩`", m0)])
