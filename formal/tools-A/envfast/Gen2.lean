import Formal.Core.EnvFast.MuxModels
import Std.Data.HashMap

/-!
Certificate / table generator for `Formal.Core.EnvFast.{Mux,MergeData}` (UNTRUSTED:
every number it prints is checked by the kernel). Same recipe as `Gen.lean`, which is
left untouched (its outputs `Tables.lean`, `Link2Cert.lean`, `MergeCert.lean` are not
written here). Run from formal/lean, with the oleans of `Data.lean` and
`MuxModels.lean` on LEAN_PATH (any overlay of `.lake/build/lib/lean` that also holds
them, e.g. the one `check.sh` builds):

    ../slot.sh lake env sh -c 'LEAN_PATH=<overlay>:$LEAN_PATH lean ../tools-A/envfast/Gen2.lean'

It writes `Formal/Core/EnvFast/Tables2.lean`, `MuxCert.lean`, `MergeDataCert.lean`,
and prints the per-chunk theorem lines to paste into `Mux.lean` / `MergeData.lean`.
Reachable sets come from a hash-map BFS over `Env.succs` (interpreted); certificates
are emitted in balanced-BST preorder so that `kmkTree` builds a balanced tree.
-/

open Formal.Core.LutTree Formal.Core.LutCells Formal.Core.LutAudit Formal.Core.Env Formal.Core.EnvFast

def ttOf (L : LutInst) (o : OutSel) (k : Nat) : Nat :=
  (vecs k).foldl (fun acc w => if outB L o w then acc ||| (1 <<< addrOf w) else acc) 0

def hzOf (L : LutInst) (o : OutSel) (k : Nat) : Nat :=
  (vecs k).foldl (fun acc a => (vecs k).foldl (fun acc b =>
    if okCls (classify L o a b) then acc ||| (1 <<< (addrOf a * 2 ^ k + addrOf b)) else acc) acc) 0

def hex (n : Nat) : String := "0x" ++ String.ofList (Nat.toDigits 16 n)

partial def balanced (xs : Array Nat) (lo hi : Nat) (out : Array Nat) : Array Nat :=
  if lo ≥ hi then out else
    let mid := (lo + hi) / 2
    balanced xs (mid + 1) hi (balanced xs lo mid (out.push xs[mid]!))

/-- Reachable set by BFS (hash set). -/
def reachList (M : Model) : List Nat := Id.run do
  let mut seen : Std.HashMap Nat Unit := {}
  let mut q : Array Nat := #[]
  for s in M.inits do
    if !seen.contains s then seen := seen.insert s (); q := q.push s
  let mut i := 0
  while i < q.size do
    let s := q[i]!
    i := i + 1
    for (_, s') in succs M s do
      if !seen.contains s' then seen := seen.insert s' (); q := q.push s'
  return q.toList

def certOf (M : Model) : List Nat :=
  let xs := (reachList M).toArray.qsort (· < ·)
  (balanced xs 0 xs.size #[]).toList

def emitList (name doc : String) (l : List Nat) : String :=
  s!"/-- {doc} ({l.length} states) -/\ndef {name} : List Nat := [\n" ++
    ",\n".intercalate (l.map fun x => "  " ++ hex x) ++ "]\n"

partial def chunksOf (l : List Nat) (k : Nat) : List (List Nat) :=
  if l.length ≤ k then [l] else l.take k :: chunksOf (l.drop k) k

def emitChunks (name doc : String) (l : List Nat) (k : Nat) : String := Id.run do
  let cs := chunksOf l k
  let mut s := ""
  let mut i := 0
  for c in cs do
    s := s ++ emitList s!"{name}_{i}" s!"{doc}, chunk {i}" c ++ "\n"
    i := i + 1
  s := s ++ s!"/-- {doc}: {l.length} states in {cs.length} chunks. -/\ndef {name} : List (List Nat) :=\n  [" ++
    ", ".intercalate ((List.range cs.length).map fun j => s!"{name}_{j}") ++ "]\n"
  return s

/-- Chunk theorem lines and the dispatch proof (to paste). `chk` is the
`kchunk …`/`kchunkD …` prefix up to the tree argument. -/
def chunkThms (name pfx chk : String) (l : List Nat) (k : Nat) : String := Id.run do
  let cs := chunksOf l k
  let mut s := ""
  for j in List.range cs.length do
    s := s ++ s!"theorem {pfx}_c{j} : {chk} (kmkTree {name}.flatten) {name}_{j} = true := by decide +kernel\n"
  s := s ++ s!"-- dispatch:\n    intro c hc\n    simp only [{name}, List.mem_cons, List.not_mem_nil, or_false] at hc\n    rcases hc with " ++
    " | ".intercalate ((List.range cs.length).map fun _ => "rfl") ++ "\n" ++
    String.join ((List.range cs.length).map fun j => s!"    · exact {pfx}_c{j}\n")
  return s

/-- (Lean name, constant name, output) of the LUT outputs to tabulate (those not
already in `Tables.lean`). -/
def luts : List (String × String × LutInst × OutSel) :=
  [("bd_mux_uj0_O", "bd_mux_uj0", bd_mux_uj0, .O), ("bd_mux_uj1_O", "bd_mux_uj1", bd_mux_uj1, .O),
   ("bd_mux_uor_O", "bd_mux_uor", bd_mux_uor, .O),
   ("bd_datamux_u_L215_O", "bd_datamux_u_L215", bd_datamux_u_L215, .O),
   ("bd_datamux_u_L209_O5", "bd_datamux_u_L209", bd_datamux_u_L209, .O5),
   ("bd_datamux_u_L209_O6", "bd_datamux_u_L209", bd_datamux_u_L209, .O6)]

def oname : OutSel → String | .O => ".O" | .O5 => ".O5" | .O6 => ".O6"

def tablesFile : String := Id.run do
  let mut s := "import Formal.Core.EnvFast\n\n/-!\n# Formal.Core.EnvFast.Tables2 — LUT truth and hazard tables (bd_mux, bd_datamux)\n\nGENERATED by `formal/tools-A/envfast/Gen2.lean` (untrusted); each table is checked\nagainst `LutAudit.outB` / `LutAudit.classify` on every vector by `decide +kernel`.\n-/\n\nnamespace Formal.Core.EnvFast.Tables\n\nopen Formal.Core.LutCells Formal.Core.EnvFast\n\n"
  for (nm, cn, L, o) in luts do
    let k := nfree (opins L o)
    s := s ++ s!"def tt_{nm} : Nat := {hex (ttOf L o k)}\n"
    s := s ++ s!"def hz_{nm} : Nat :=\n  {hex (hzOf L o k)}\n"
    s := s ++ s!"theorem tt_{nm}_ok : ttOK {cn} {oname o} {k} tt_{nm} = true := by decide +kernel\n"
    s := s ++ s!"theorem hz_{nm}_ok : hzOK {cn} {oname o} {k} hz_{nm} = true := by decide +kernel\n\n"
  return s ++ "end Formal.Core.EnvFast.Tables\n"

def certFile (mod doc : String) (defs : List (String × String × List Nat)) (k : Nat := 128) : String :=
  s!"/-!\n# Formal.Core.EnvFast.{mod} — certificate data\n\nGENERATED by `formal/tools-A/envfast/Gen2.lean` (untrusted data: reachable states\nin balanced-BST preorder, split into chunks of {k}; only the checker is trusted). {doc}\n-/\n\nnamespace Formal.Core.EnvFast.Certs\n\n" ++
  "\n".intercalate (defs.map fun (n, d, l) => emitChunks n d l k) ++ "\nend Formal.Core.EnvFast.Certs\n"

#eval show IO Unit from do
  IO.FS.writeFile "Formal/Core/EnvFast/Tables2.lean" tablesFile
  let a := certOf (muxModel ⟨true⟩)
  let b := certOf (muxZaModel ⟨true, true, true⟩)
  let c := certOf (muxCrModel ⟨true, true, true⟩)
  let d := certOf (muxDModel ⟨true, true⟩)
  IO.println s!"mux {a.length}, muxZa {b.length}, muxCr {c.length}, muxD {d.length}"
  IO.FS.writeFile "Formal/Core/EnvFast/MuxCert.lean" (certFile "MuxCert" "bd_mux."
    [("mux_R", "`muxModel ⟨true⟩`", a), ("mux_ZA", "`muxZaModel ⟨true, true, true⟩`", b),
     ("mux_CR", "`muxCrModel ⟨true, true, true⟩`", c), ("mux_D", "`muxDModel ⟨true, true⟩`", d)])
  IO.FS.writeFile "/tmp/envmux/mux_chunks.txt" (
    chunkThms "mux_R" "muxR" "kchunk CR (kmuxQ CR)" a 128 ++
    chunkThms "mux_ZA" "muxZA" "kchunk CZA (kmuxQ CZA)" b 128 ++
    chunkThms "mux_CR" "muxCR" "kchunk CCR (kmuxQ CCR)" c 128 ++
    chunkThms "mux_D" "muxD" "kchunkD CD muxDSpecK (kmuxDQ CD)" d 128)
  let e := certOf (mergeDModel 1 ⟨true, true, true⟩)
  let f := certOf (mergeDModel 1 ⟨true, false, true⟩)
  let g := certOf (mergeDModel 2 ⟨true, false, true⟩)
  IO.println s!"mergeD1 {e.length}, mergeD1 noSelFast {f.length}, mergeD2 noSelFast {g.length}"
  IO.FS.writeFile "Formal/Core/EnvFast/MergeDataCert.lean" (certFile "MergeDataCert" "bd_merge with data."
    [("mergeD1_S", "`mergeDModel 1 ⟨true, true, true⟩`", e), ("mergeD1_N", "`mergeDModel 1 ⟨true, false, true⟩`", f),
     ("mergeD2_N", "`mergeDModel 2 ⟨true, false, true⟩`", g)])
  IO.FS.writeFile "/tmp/envmux/merge_chunks.txt" (
    chunkThms "mergeD1_S" "mD1S" "kchunkD (CM1 ⟨true, true, true⟩) mergeDSpecK (kmergeDQ 1 (CM1 ⟨true, true, true⟩))" e 128 ++
    chunkThms "mergeD1_N" "mD1N" "kchunkD (CM1 ⟨true, false, true⟩) mergeDSpecK (kmergeDQ 1 (CM1 ⟨true, false, true⟩))" f 128 ++
    chunkThms "mergeD2_N" "mD2N" "kchunkD (CM2 ⟨true, false, true⟩) mergeDSpecK (kmergeDQ 2 (CM2 ⟨true, false, true⟩))" g 128)
