+#!/bin/bash
+#CLUSTER array=1-32 cores=2 mem=16G time=240
+# ringplace1: PROGRAM "General first" item 6 as a rule -- bdc's ring placement (BDC_AUTO=1 BDC_RING_PLACE=1: PLACE_WEIGHT
+# x8 on every loop ring's handshake nets, the rings from the token floor's walk graph; research/data/suite/ringplace.md)
+# against the same build without it, placement the only variable: suite4's final sizes (flow v3) and suite4's seeds,
+# xorshift / collatz / collatz64 / ipow x seeds 1-8 (task = 8 * kernel + seed; research/data/suite/farm/ringplace1.txt).
+# Per task (research/tools/suite/ringplace_ab.sh): both arms built and run (P from the timed event graph, the critical
+# cycle's wire share from cycle_wire.py), A's sdf checked against suite4's; on B the static rule at A's sizes and 2
+# draws (K = 40000 + 100 S + j); on A the same draws where suite4 never judged the route (xorshift 7, collatz 1,
+# collatz64 6 / 7 have no final sizes and take the kernel's board candidate's; collatz64 8 timed out before its draws),
+# and every point B fails.
+# PREDICTION (local: xorshift s8 / s1, collatz s6 / s3, see ringplace.md): the median paired dP within +-0.5 ns of zero
+# (the hand weightings, levers 4 / 10 / 10b, moved P by -1.9 to +1.3 ns per seed with no sign); B's inter-unit wire on
+# the critical cycle lower than A's on most seeds, its delay-chain and intra-unit wire not; draws pass where the rule
+# stays clean on B.
+set -uo pipefail
+read -r K S Z NDA NDB REF <<< "$(sed -n "${TASK}p" research/data/suite/farm/ringplace1.txt)"
+export PNR_TIMEOUT=3600 CA_JOBS=1 DRAW_JOBS=2
+echo "ringplace1 kernel $K seed $S sizes $Z" > "$OUT/task.txt"
+research/tools/suite/ringplace_ab.sh "$K" "$S" "$Z" "$NDA" "$NDB" "$REF" > "$OUT/summary.txt" 2>&1
+cp "$RUNS/ringplace/${K}_$S/"*.txt "$RUNS/ringplace/${K}_$S/"*.tsv "$OUT/" 2>/dev/null
+cat "$OUT/result.txt" >> "$OUT/task.txt" 2>/dev/null
+exit 0
