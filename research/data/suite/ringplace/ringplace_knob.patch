+RING_ATTR = "BDC_RING_PLACE"
+
+
+def ring_place(mods, report):
+    """BDC_RING_PLACE (bdc/emit.py, BDC_AUTO=1 BDC_RING_PLACE=1): PLACE_WEIGHT on every handshake net of a ring.
+
+    The kernel module carries `w=K;<instances of group 0>;<instances of group 1>;...` (the loop rings of the token
+    floor's walk graph, see emit.py).  A control LUT belongs to a group when its kernel instance does: a cell of the
+    kernel module named `<inst>.<...>` (a library cell flattened into it), or any cell of a generated submodule
+    instantiated as `<inst>` (a fused operator, an arbitrated merge).  A net is weighted K when a control LUT of a
+    group other than a delay chain's interior link touches it and no control LUT outside that group does (reset
+    excluded): the hops between a ring's stages and inside them, not its entry or exit, not a matched delay's own
+    chain (weighting that would shorten the delay itself).  The attribute is removed, so the netlist nextpnr reads
+    differs from the flag-off one only by these PLACE_WEIGHT attributes.  A submodule instantiated more than once is
+    not entered (one netname cannot weight one instance's net): its cells count as outside every group and the
+    report says so.  Returns the number of nets weighted."""
+    n_nets = 0
+    for kname, km in sorted(mods.items()):
+        spec = km.get("attributes", {}).pop(RING_ATTR, None)
+        if spec is None:
+            continue
+        parts = [p for p in str(spec).split(";") if p.strip()]
+        weight = int(parts[0].split("=", 1)[1])
+        grp = {u: k for k, p in enumerate(parts[1:]) for u in p.split()}
+        counts, _top = instantiation_counts(mods)
+        if counts.get(kname, 0) != 1:
+            print(f"WARNING: ring_place: {kname} is instantiated {counts.get(kname, 0)} times; not weighted")
+            continue
+        unit_of_type = {}
+        shared = []
+        for cname, c in km.get("cells", {}).items():
+            if is_user_module(mods, c["type"]):
+                if counts.get(c["type"], 0) == 1:
+                    unit_of_type[c["type"]] = cname
+                elif cname in grp:
+                    shared.append(cname)
+        leaves, rst = flatten(mods, kname, counts)
+        rings, inside, outside, site = defaultdict(set), set(), set(), {}
+        n_cells = 0
+        for mname, cname, c, conns in leaves:
+            if not is_control_cell(cname, c):
+                continue
+            unit = cname.split(".")[0] if mname == kname else unit_of_type.get(mname)
+            k = grp.get(unit)
+            interior = ".chain.g[" in cname
+            n_cells += k is not None and not interior
+            for p, gids in conns.items():
+                for b, g in zip(c["connections"][p], gids):
+                    if g is None or g in rst:
+                        continue
+                    if k is None:
+                        outside.add(g)
+                        continue
+                    rings[g].add(k)
+                    if not interior:
+                        inside.add(g)
+                        site.setdefault(g, (mname, b))
+        for g in sorted(inside - outside, key=str):
+            if len(rings[g]) != 1:
+                continue
+            mname, b = site[g]
+            netnames = mods[mname].setdefault("netnames", {})
+            single = [n for n, nn in netnames.items() if nn["bits"] == [b]]
+            if single:
+                target = netnames[sorted(single)[0]]
+            else:
+                target = {"hide_name": 1, "bits": [b], "attributes": {}}
+                netnames[f"$bd_ring_place${b}"] = target
+            target.setdefault("attributes", {})[WEIGHT_ATTR] = weight
+            n_nets += 1
+        if report:
+            print(f"ring_place {kname}: {len(parts) - 1} ring group(s), {len(grp)} instance(s), {n_cells} control "
+                  f"LUT(s); {n_nets} handshake net(s) weighted x{weight}"
+                  + (f"; shared submodule(s) not entered: {sorted(shared)}" if shared else ""))
+    return n_nets
+
