+#!/usr/bin/env bash
+# ringplace_ab.sh KERNEL SEED SIZES_VH [NDA] [NDB] [SUITE4_SDF] -- research/data/suite/ringplace.md's A/B on one placer
+# seed: the same sizes, the same seed, placement the only variable.
+#   A  lane2.sh BDC_AUTO=1                      (with a suite4 route's own sizes and seed: suite4's route, byte for byte)
+#   B  lane2.sh BDC_AUTO=1 BDC_RING_PLACE=1     (bdc's ring placement: PLACE_WEIGHT on every loop ring's handshake nets)
+# Both arms: the full stack and the timed event graph (P), research/tools/eventgraph/cycle_wire.py (the critical
+# cycle's wire share), fasm_equiv and ffmux_scan.  B: the static rule (corner_audit CA_SIZERULE=1 at the draw model's two
+# worst vertices, as research/tools/auto/auto_size.sh runs it) on the route as built with A's sizes, then NDB draws
+# (bench_gate.sh draw:K, K = 40000 + 100 * SEED + j).  A: NDA draws at the same K (suite4 judged its own routes 8 / 8 at
+# K = 10000 + ...; NDA > 0 where it did not), and every K that fails on B is also drawn on A (is it the placement or
+# the model point?).  SUITE4_SDF (optional): the md5 prefix of suite4's route for this seed; the result says whether A
+# reproduced it.  Expected values come from the C (the kernel's oracle), never from a run.
+# Writes $RUNS/ringplace/KERNEL_SEED/{result.txt, line_[AB].txt, wire_[AB].txt, rule_B.txt, draw_*.txt, ...}.
+set -uo pipefail
+K=$1; S=$2; Z=$(readlink -f "$3"); NDA=${4:-0}; NDB=${5:-2}; REF=${6:--}
+R=$(cd "$(dirname "$0")/../../.." && pwd); RUNS=${RUNS:-/home/user/runs}; export RUNS
+export PNR_TIMEOUT=${PNR_TIMEOUT:-3600}
+O=$RUNS/ringplace/${K}_$S; mkdir -p "$O"; D=${K}_bench_gen
+case $K in
+  xorshift) V=research/data/eventgraph/gate/xor19.hex; PV=research/data/fifteen/vec_xorshift.hex; OR="research/tools/fifteen/kernel_oracle.sh xorshift";;
+  collatz) V=research/data/eventgraph/gate/col18.hex; PV=research/data/fifteen/vec_collatz.hex; OR="research/tools/fifteen/kernel_oracle.sh collatz";;
+  collatz64) V=research/data/eventgraph/gate/c6419.hex; PV=research/data/fifteen/vec_c64_871.hex; OR="research/tools/fifteen/kernel_oracle.sh collatz64";;
+  ipow) V=research/data/eventgraph/gate/ipow17.hex; PV=research/data/fifteen/vec_ipow.hex; OR="research/tools/fifteen/kernel_oracle.sh ipow";;
+  *) echo "$K $S status=NO-VECTORS (ringplace_ab.sh knows the four suite4 kernels)" | tee "$O/result.txt"; exit 0;;
+esac
+fin() { echo "$K $S $*" | tee "$O/result.txt"; exit 0; }
+( cd "$R" && $OR < "$V" ) > "$O/exp.txt" 2> "$O/oracle.err" || fin "status=NO-ORACLE"
+[ "$(grep -c . "$O/exp.txt")" = "$(grep -c . "$R/$V")" ] || fin "status=NO-ORACLE (line count)"
+
+arm() {   # arm A|B: the build, the full stack, the wire share
+  local a=$1 N=rp$1_${K}_$S env="BDC_AUTO=1"
+  [ "$a" = B ] && env="BDC_AUTO=1 BDC_RING_PLACE=1"
+  "$R/research/tools/fifteen/lane2.sh" "rp$a" "$N" "$K" "$Z" "$S" "$R/$PV" $env > "$O/build_$a.log" 2>&1
+  tail -1 "$O/build_$a.log" > "$O/line_$a.txt"
+  python3 "$R/research/tools/eventgraph/cycle_wire.py" "$R/research/data/eventgraph/graphs/$N" > "$O/wire_$a.txt" 2>&1
+  cp "$RUNS/hw/$N/rloc.log" "$O/rloc_$a.txt" 2>/dev/null
+  for f in check.txt arcs.tsv nodes.tsv; do cp "$R/research/data/eventgraph/graphs/$N/$f" "$O/${a}_$f" 2>/dev/null; done
+}
+arm A & arm B & wait
+
+field() { grep -o "$2=[^ ]*" "$O/$1" 2>/dev/null | head -1 | cut -d= -f2; }
+summ() {  # summ A|B: sdf P wire% inter-unit wire, bits
+  local L; L=$(cat "$O/line_$1.txt" 2>/dev/null)
+  local eq; eq=$(echo "$L" | grep -q 'NOT EQUIVALENT' && echo NOT-EQUIVALENT || (echo "$L" | grep -q 'EQUIVALENT' && echo EQUIVALENT || echo EQUIV?))
+  local ff; ff=$(echo "$L" | grep -q 'FFMUX-FLAG' && echo FFMUX-FLAG || echo ffmux-clean)
+  echo "sdf=$(echo "$L" | awk '{print $2}') P=$(echo "$L" | grep -o 'P=[0-9A-Z]*' | cut -d= -f2) wire%=$(field wire_$1.txt 'wire%') inter=$(grep -o 'inter=[0-9]*([0-9]*)' "$O/wire_$1.txt" | cut -d= -f2) $eq $ff"
+}
+SA=$(summ A); SB=$(summ B)
+PA=$(echo "$SA" | grep -o ' P=[0-9]*' | cut -d= -f2); PB=$(echo "$SB" | grep -o ' P=[0-9]*' | cut -d= -f2)
+dP=NA; [ -n "$PA" ] && [ -n "$PB" ] && dP=$((PB - PA))
+same=""; [ "$REF" != - ] && { [ "$(echo "$SA" | grep -o 'sdf=[0-9a-f]*' | cut -d= -f2)" = "$REF" ] && same=" A=suite4-route" || same=" A!=suite4-route($REF)"; }
+
+# the static rule on B's route at A's sizes (auto_size.sh's rule(), both corners merged): CLEAN or how many rows short
+rule() {
+  local NI=rpB_${K}_$S; local HW=$RUNS/hw/$NI RD=$RUNS/r/$NI CA=$RUNS/ca/$NI
+  [ -f "$RD/xray.sdf" ] || { echo "rule=NA"; return; }
+  rm -rf "$CA"; mkdir -p "$CA/seed1/pnr"
+  ln -sf "$RD/xray.sdf" "$CA/seed1/pnr/soak_xray.sdf"; ln -sf "$HW/${D}_routed.json" "$CA/seed1/pnr/soak_routed.json"
+  cp "$Z" "$CA/seed1/pnr/sizes.vh"
+  local c dirs=()
+  for c in 0.20 0.31; do
+    BD_SKEW_STEER_SELF=1 CA_JOINAWARE=1 BD_SKEW_AND_JOIN=1 CA_SIZERULE=1 \
+      python3 "$R/research/tools/corner_audit.py" "$CA/seed1" --prefix bridge_i.udut. \
+        --band "$c" --inst-rx '\.chain\.g\[\d+\]\.u$:0.20' --out "$CA/rule_$c" > "$O/rule_B_$c.txt" 2>&1 &
+  done; wait
+  for c in 0.20 0.31; do [ -f "$CA/rule_$c/negative_sized.tsv" ] || { echo "rule=FAILED"; return; }; dirs+=("$CA/rule_$c"); done
+  python3 "$R/research/tools/auto/merge_rules.py" "$CA/rule" "${dirs[@]}" > /dev/null 2>&1
+  [ -f "$CA/rule/negative_sized.tsv" ] || { echo "rule=FAILED"; return; }
+  cp "$CA/rule/negative_sized.tsv" "$O/rule_B_negative.tsv"
+  local neg; neg=$(tail -n +2 "$CA/rule/negative_sized.tsv" | grep -c .)
+  [ "$neg" = 0 ] && echo "rule=clean" || echo "rule=not-clean($neg)"
+}
+RB=$(rule)
+
+draw() {  # draw A|B K
+  local a=$1 k=$2 N=rp$1_${K}_$S; local HW=$RUNS/hw/$N RD=$RUNS/r/$N W=$RUNS/g/rp$1_${K}_$S/d$2
+  mkdir -p "$W"; cp "$RD/xray.sdf" "$W/xray.sdf" 2>/dev/null
+  local g; g=$("$R/research/tools/eventgraph/bench_gate.sh" "$HW" "$D" "$W" "$R/$V" "$O/exp.txt" "draw:$k" 2>&1 | tail -1)
+  echo "$a draw $k $(cut -d' ' -f3-8 "$W/draw_$k.txt" 2>/dev/null) :: ${g:-none}" > "$O/draw_${a}_$k.txt"
+  rm -rf "$W/draw_$k"
+}
+board() { echo "$1" | grep -q ' EQUIVALENT ffmux-clean'; }
+ks=(); for j in $(seq 1 "$NDB"); do ks+=($((40000 + 100 * S + j))); done
+# B's draws two at a time, then A at the same points (NDA of them, plus every point B failed)
+if board "$SB"; then
+  for k in ${ks[@]+"${ks[@]}"}; do draw B "$k" & while [ "$(jobs -rp | wc -l)" -ge 2 ]; do sleep 5; done; done; wait
+fi
+ka=(); for j in $(seq 1 "$NDA"); do ka+=($((40000 + 100 * S + j))); done
+for k in ${ks[@]+"${ks[@]}"}; do grep -q ":: PASS " "$O/draw_B_$k.txt" 2>/dev/null || ka+=("$k"); done
+if board "$SA" && [ "${#ka[@]}" -gt 0 ]; then
+  for k in $(printf '%s\n' "${ka[@]}" | sort -u); do draw A "$k" & while [ "$(jobs -rp | wc -l)" -ge 2 ]; do sleep 5; done; done; wait
+fi
+cnt() { local a=$1 n=0 p=0 f; for f in "$O"/draw_${a}_*.txt; do [ -f "$f" ] || continue; n=$((n + 1)); grep -q ":: PASS " "$f" && p=$((p + 1)); done; echo "$p/$n"; }
+cat "$O"/draw_*.txt > "$O/draws.txt" 2>/dev/null
+fin "dP=$dP | A $SA draws=$(cnt A)$same | B $SB $RB draws=$(cnt B)"
