+def ring_place_groups(func, linked, depth, exclude, lines, starts, fusion=None):
+    """[[instance, ...] per ring group], from the kernel module's emitted lines.
+
+    `starts` is [(node index or None, first line)] in emission order: the lines from one start to the next were
+    written for that node (None: emit_links(), whose instances are the links).  An instance named ulink_<channel>
+    or ulink_<channel>_folink belongs to the group of its channel, or to none (an entry or exit channel); any other
+    instance to its node's group (a fused cell: any member's)."""
+    try:
+        from . import slack
+    except ImportError:
+        import slack
+    chans, out = token_graph(func, linked, depth, exclude)
+    adj = {s: {t for t, _w in nxt} for s, nxt in enumerate(out)}
+    rings = []
+    for comp in slack.tarjan_scc(list(range(len(out))), adj):
+        js = {s // 2 for s in comp}
+        if slack._is_cycle(comp, adj) and any(chans[j][5] for j in js):
+            rings.append(js)
+    up = list(range(len(rings)))
+
+    def find(x):
+        while up[x] != x:
+            up[x] = up[up[x]]
+            x = up[x]
+        return x
+
+    first = {}
+    for k, js in enumerate(rings):
+        for j in js:
+            for v in chans[j][1:3]:
+                if v in first:
+                    up[find(k)] = find(first[v])
+                else:
+                    first[v] = k
+    node_grp = {v: find(k) for v, k in first.items()}
+    chan_grp = {vname(chans[j][0]): find(k) for k, js in enumerate(rings) for j in js}
+    members = {}
+    if fusion is not None:
+        for anchor, region in fusion.anchor_region.items():
+            members[anchor] = region.node_ids
+    groups = collections.defaultdict(list)
+    bounds = list(starts) + [(None, len(lines))]
+    for (node, s0), (_, s1) in zip(bounds, bounds[1:]):
+        for line in lines[s0:s1]:
+            m = _RP_INST.match(line)
+            if not m:
+                continue
+            inst = m.group(1)
+            if inst.startswith("ulink_"):
+                ch = inst[len("ulink_"):]
+                ch = ch[:-len("_folink")] if ch.endswith("_folink") else ch
+                if ch in chan_grp:
+                    groups[chan_grp[ch]].append(inst)
+                continue
+            if node is None:
+                continue
+            k = next((node_grp[v] for v in members.get(node, [node]) if v in node_grp), None)
+            if k is not None:
+                groups[k].append(inst)
+    order = sorted(groups, key=lambda k: min(v for v, g in node_grp.items() if g == k))
+    return [sorted(set(groups[k])) for k in order]
+
